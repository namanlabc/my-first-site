---
import Layout from '../layouts/Layout.astro';

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
---

<Layout title="404: Page Not Found" description="The page you're looking for does not exist.">
  <div class="text-center py-16 flex flex-col items-center justify-center">
    <div class="text-6xl font-serif font-bold text-accent mb-6 select-none animate-pulse">404</div>
    <h1 class="text-2xl font-serif font-semibold text-text mb-4">You've wandered off the map</h1>
    <p class="text-base text-text/75 leading-relaxed font-serif max-w-md mb-8">
      There are no algorithms here to nudge you back on track, and no search engines tracking your footprints. 
      Just a quiet, empty clearing.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 font-mono text-xs">
      <a href={baseUrl} class="px-4 py-2 border border-border-subtle hover:border-accent hover:text-accent rounded transition-all no-underline animate-fade-in">
        &larr; Back to Safety
      </a>
      <a href={`${baseUrl}archive`} class="px-4 py-2 border border-border-subtle hover:border-accent hover:text-accent rounded transition-all no-underline animate-fade-in">
        Explore the Archive &rarr;
      </a>
    </div>
  </div>
</Layout>
