---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Page not found" description="This route does not exist on Naman.blog.">
  <section class="shell shell--content not-found" aria-labelledby="not-found-title">
    <div class="not-found__route" aria-hidden="true">
      <span>you</span><i></i><b>?</b>
    </div>
    <p class="not-found__code">Error 404 / route missing</p>
    <h1 id="not-found-title">This idea wandered off the map.</h1>
    <p>The address may have changed, or this page never made it out of the notebook.</p>
    <div class="not-found__links">
      <a class="button-link" href={base}>Return home <span aria-hidden="true">→</span></a>
      <a class="text-link" href={`${base}archive/`}>Browse the writing</a>
    </div>
  </section>
</Layout>
