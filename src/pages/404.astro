---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout title="Page not found" description="This page could not be found on Naman.blog."><div class="inner-page"><header class="page-hero"><h1>Page not found</h1><p>The link may be incorrect, or the page may have moved.</p><a class="text-link" href={base}>Return home →</a></header></div></Layout>
