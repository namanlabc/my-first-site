---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Page not found" description="This route does not exist on Naman.blog.">
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="page-kicker">404 / wrong turn</p>
    <div class="not-found__route" aria-hidden="true"><span>you</span><i></i><b>?</b></div>
    <h1 id="not-found-title">This route wandered off somewhere.</h1>
    <p>Either the link is wrong, or I moved something and forgot to leave directions.</p>
    <div>
      <a href={base}>Return home →</a>
      <a href={`${base}archive/`}>Browse writing</a>
    </div>
  </section>
</Layout>
