---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import WritingItem from '../components/WritingItem.astro';
import PlayfulCrew from '../components/home/PlayfulCrew.astro';
import ProjectToy from '../components/home/ProjectToy.astro';
import { projects } from '../data/projects';
import '../styles/home-world.css';

const posts = await getCollection('blog');
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout bodyClass="home-world-page">
  <div class="naman-world">
    <section class="world-hero world-shell" aria-labelledby="home-title">
      <div class="world-hero__copy reveal-up">
        <p class="world-kicker"><i></i> building things on the internet</p>
        <h1 id="home-title">I make things.<br />Then make them better.</h1>
        <p class="world-hero__intro">
          SEO, websites, apps, open-source tools, and the occasional idea that gets far more serious than it was supposed to.
        </p>
        <div class="world-hero__actions">
          <a class="world-button world-button--ink" href="#projects">See what I’m making <span aria-hidden="true">↓</span></a>
          <a class="world-button" href={`${base}about/`}>About me</a>
        </div>
      </div>

      <div class="world-hero__aside reveal-up" data-delay="1">
        <PlayfulCrew />
        <div class="world-hero__note" aria-hidden="true">
          <small>currently</small>
          <strong>building, breaking,<br />fixing, repeating.</strong>
        </div>
      </div>
    </section>

    <div class="world-shell world-proof reveal-up">
      <p>I like useful things, clear interfaces, weird ideas, and the final ten percent that makes something feel finished.</p>
      <div aria-label="What I work on"><span>SEO</span><span>products</span><span>open source</span><span>experiments</span></div>
    </div>

    <section id="projects" class="world-section world-shell" aria-labelledby="projects-title">
      <div class="world-heading reveal-up">
        <div><p>01 / selected work</p><h2 id="projects-title">Things I decided should exist.</h2></div>
        <a href={`${base}projects/`}>All projects →</a>
      </div>

      <div class="project-story-grid">
        {projects.slice(0, 4).map((project, index) => (
          <article class="project-story reveal-up" data-delay={String(index % 2)}>
            <div class="project-story__visual"><ProjectToy visual={project.visual} /></div>
            <div class="project-story__copy">
              <div class="project-story__meta"><span>{project.kind}</span><em>{project.status}</em></div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              {project.href ? (
                <a class="project-story__link" href={project.href} target={project.external ? '_blank' : undefined} rel={project.external ? 'noopener noreferrer' : undefined}>Open project ↗</a>
              ) : (
                <span class="project-story__link">Still cooking…</span>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="world-night" aria-labelledby="night-title">
      <div class="world-shell world-night__grid">
        <div class="world-night__copy reveal-up">
          <p>02 / the usual process</p>
          <h2 id="night-title">One idea. One unnecessarily late night.</h2>
          <p>Most projects begin as one annoying problem, one “what if?”, or one page I’m convinced could be better.</p>
        </div>

        <div class="world-night__steps reveal-up" data-delay="1">
          <article><span>8:17 PM</span><strong>“Wait. What if…”</strong><p>The idea becomes interesting enough to ruin the evening.</p></article>
          <article><span>11:42 PM</span><strong>Now it has folders.</strong><p>This was definitely supposed to be a quick experiment.</p></article>
          <article><span>2:08 AM</span><strong>Why is this button 2px off?</strong><p>The dangerous stage where details suddenly matter a lot.</p></article>
          <article><span>6:11 AM</span><strong>Okay. Ship it.</strong><p>Good enough to be real. Not finished enough to stop improving.</p></article>
        </div>
      </div>
    </section>

    <section class="world-writing world-shell" aria-labelledby="recent-writing-title">
      <div class="world-writing__head reveal-up">
        <div><p>03 / notes from the process</p><h2 id="recent-writing-title">Writing things down before I forget them.</h2></div>
        <a href={`${base}archive/`}>Full archive →</a>
      </div>
      <div class="writing-list reveal-up" data-delay="1">
        {recentPosts.map((post) => (
          <WritingItem
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            href={`${base}blog/${post.id}/`}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>

    <section class="world-final world-shell reveal-up" aria-labelledby="final-title">
      <div>
        <p>still making things</p>
        <h2 id="final-title">See you somewhere on the internet.</h2>
        <div class="world-final__links">
          <a href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer">X ↗</a>
          <a href={`${base}about/`}>About →</a>
        </div>
      </div>
      <PlayfulCrew compact label="The little building crew signing off" />
    </section>
  </div>

  <script>
    const elements = [...document.querySelectorAll<HTMLElement>('.reveal-up')];
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          (entry.target as HTMLElement).classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      }, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });
      elements.forEach((element) => observer.observe(element));
    } else {
      elements.forEach((element) => element.classList.add('is-visible'));
    }
  </script>
</Layout>
