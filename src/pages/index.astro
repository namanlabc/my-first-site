---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HomeMascot from '../components/HomeMascot.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import SiteIcon from '../components/SiteIcon.astro';
import '../styles/home.css';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = posts.slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const work = [
  {
    name: 'SmallMB',
    detail: 'Android file utility',
    href: 'https://smallmb.com/',
    icon: 'android' as const,
  },
  {
    name: 'Astro SEO Audit',
    detail: 'Open-source SEO tool',
    href: 'https://github.com/namanlabc/astro-seo-audit',
    icon: 'audit' as const,
  },
  {
    name: 'Get Random Letter',
    detail: 'Browser tools',
    href: 'https://getrandomletter.com/',
    icon: 'shuffle' as const,
  },
];
---

<Layout description="Naman Patel makes software, works on websites, and writes about what he learns.">
  <article class="bear-home">
    <section class="bear-intro" aria-labelledby="home-title">
      <HomeMascot />
      <h1 id="home-title">Hi, I’m Naman.</h1>
      <div class="bear-intro__copy">
        <p>I write, build things on the internet, read manga, and play games.</p>
        <p>This site has my notes, projects, and other things I wanted to keep.</p>
      </div>
      <p class="bear-now"><SiteIcon name="spark" /> <span>Currently improving SmallMB and writing a long-form fantasy novel.</span></p>
    </section>

    <section class="bear-section" aria-labelledby="made-title">
      <div class="bear-section__head">
        <SiteIcon name="work" />
        <h2 id="made-title">Work</h2>
      </div>

      <div class="bear-links">
        {work.map(project => (
          <a class="bear-link" href={project.href} target="_blank" rel="noopener noreferrer">
            <span class="bear-link__icon"><SiteIcon name={project.icon} /></span>
            <span class="bear-link__copy">
              <strong>{project.name}</strong>
              <small>{project.detail}</small>
            </span>
            <SiteIcon name="external" />
          </a>
        ))}
      </div>
      <a class="bear-more" href={`${base}projects/`}>Selected projects <span aria-hidden="true">→</span></a>
    </section>

    <section class="bear-section" aria-labelledby="experience-title">
      <div class="bear-section__head">
        <SiteIcon name="about" />
        <h2 id="experience-title">Experience</h2>
      </div>

      <a class="bear-experience" href={`${base}experience/`} aria-labelledby="experience-title">
        <span class="bear-experience__copy">
          <strong>Search, websites, then software.</strong>
          <small>I started with SEO and publishing. The tools I wanted eventually pulled me into web and Android development.</small>
        </span>
        <span class="bear-experience__tools" aria-label="Tools I work with">
          <span class="tool-mark tool-mark--search-console" aria-hidden="true"></span>
          <span class="tool-mark tool-mark--wordpress" aria-hidden="true"></span>
          <span class="tool-mark tool-mark--astro" aria-hidden="true"></span>
          <span class="tool-mark tool-mark--kotlin" aria-hidden="true"></span>
          <span class="tool-mark tool-mark--github" aria-hidden="true"></span>
        </span>
        <span class="bear-experience__arrow" aria-hidden="true">→</span>
      </a>
    </section>

    <section class="bear-section" aria-labelledby="github-title">
      <div class="bear-section__head bear-section__head--split">
        <span class="bear-section__label">
          <SiteIcon name="github" />
          <h2 id="github-title">GitHub</h2>
        </span>
        <span class="bear-section__range">Aug — now</span>
      </div>
      <GitHubActivity />
    </section>

    <section class="bear-section" aria-labelledby="writing-title">
      <div class="bear-section__head">
        <SiteIcon name="writing" />
        <h2 id="writing-title">Recent notes</h2>
      </div>

      <div class="bear-writing">
        {recentPosts.map(post => (
          <a class="bear-writing__row" href={`${base}blog/${post.id}/`}>
            <strong>{post.data.title}</strong>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: '2-digit' })}
            </time>
          </a>
        ))}
      </div>

      <a class="bear-more" href={`${base}archive/`}>All writing <span aria-hidden="true">→</span></a>
    </section>

    <section class="bear-section bear-section--last" aria-labelledby="about-title">
      <div class="bear-section__head">
        <SiteIcon name="book" />
        <h2 id="about-title">A little more</h2>
      </div>
      <div class="bear-paragraphs">
        <p>I like manga, games, design, and small websites. I’m also writing a fantasy novel.</p>
      </div>
      <a class="bear-more" href={`${base}about/`}>About me <span aria-hidden="true">→</span></a>
    </section>
  </article>
</Layout>
