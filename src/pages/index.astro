---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import WritingItem from '../components/WritingItem.astro';
import { projects } from '../data/projects';

const posts = await getCollection('blog');
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout>
  <main class="ultra-home">
    <section class="hero shell shell--wide" aria-labelledby="home-title">
      <div class="hero-copy reveal">
        <p class="eyebrow"><span></span> building useful things on the internet</p>
        <h1 id="home-title">I make things.<br />Then make them <em>better.</em></h1>
        <p class="hero-intro">SEO, websites, apps, odd little tools, and whatever idea refuses to leave my head.</p>
        <div class="hero-actions">
          <a class="btn btn-dark" href="#projects">See what I’m making <span>↓</span></a>
          <a class="btn btn-light" href={`${base}about/`}>About me</a>
        </div>
        <div class="hero-meta" aria-label="What I work on">
          <span>SEO</span><span>products</span><span>open source</span><span>experiments</span>
        </div>
      </div>

      <div class="hero-scene reveal" aria-label="A small pixel-art crew building things together">
        <div class="status-chip"><i></i> status: making stuff <b>✓</b></div>
        <div class="float-note"><small>CURRENTLY</small><strong>building, breaking,<br />fixing, repeating.</strong></div>

        <div class="pixel-stage" aria-hidden="true">
          <div class="pixel pet pet-blue"><i></i><i></i><b></b><span></span></div>
          <div class="pixel pet pet-cream"><div class="sprout"><i></i><i></i></div><i></i><i></i><b></b><span></span></div>
          <div class="pixel laptop"><div class="screen"><i></i></div><span></span></div>
          <div class="pixel pet pet-orange"><div class="flame"><i></i></div><i></i><i></i><b></b><span></span></div>
          <div class="cursor-shape"></div>
        </div>
      </div>
    </section>

    <section class="intro-strip shell shell--wide reveal">
      <p>I like useful things, clear interfaces, weird ideas, and the final 10% that makes something feel finished.</p>
      <div class="online-pill"><i></i> online somewhere</div>
    </section>

    <section id="projects" class="section shell shell--wide" aria-labelledby="projects-title">
      <div class="section-head reveal">
        <div>
          <p>01 / SELECTED WORK</p>
          <h2 id="projects-title">A few things I decided<br />should exist.</h2>
        </div>
        <a href={`${base}projects/`}>All projects ↗</a>
      </div>

      <div class="project-grid">
        {projects.slice(0, 4).map((project, index) => (
          <article class:list={['project-card', `project-card--${index + 1}`, 'reveal']}>
            <div class="project-visual" aria-hidden="true">
              {index === 0 && <div class="compress-visual"><div class="file file-a">18MB</div><span>→</span><div class="file file-b">640KB</div><div class="tiny-face orange"><i></i><i></i></div></div>}
              {index === 1 && <div class="audit-visual"><div class="audit-window"><div><i></i><i></i><i></i></div><strong>92</strong><span>SEO score</span></div><div class="glass"></div><div class="tiny-face blue"><i></i><i></i></div></div>}
              {index === 2 && <div class="wheel-visual"><div class="letter-wheel"><span>A</span><span>B</span><span>C</span><span>D</span></div><div class="pointer"></div><div class="tiny-face green"><i></i><i></i></div></div>}
              {index === 3 && <div class="page-visual"><div class="mini-page"><i></i><i></i><i></i><i></i></div><div class="mug"></div><div class="tiny-face cream"><i></i><i></i></div></div>}
            </div>
            <div class="project-copy">
              <div class="project-top"><span>{project.kind}</span><em>{project.status}</em></div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              {project.href ? <a href={project.href} target={project.external ? '_blank' : undefined} rel={project.external ? 'noopener noreferrer' : undefined}>Open project <span>↗</span></a> : <span class="coming">still cooking…</span>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="process shell shell--wide reveal" aria-labelledby="process-title">
      <div class="process-copy">
        <p>02 / THE PROCESS</p>
        <h2 id="process-title">Most things begin with<br />one annoying little thought.</h2>
        <p>Then it becomes a tab, then a folder, then somehow a real thing on the internet.</p>
      </div>
      <div class="process-track">
        <div class="track-line"></div>
        <article><span class="time blue-time">8:17 PM</span><strong>“Wait. What if…”</strong><small>an idea becomes interesting enough to ruin the evening.</small></article>
        <article><span class="time yellow-time">11:42 PM</span><strong>Now it has folders.</strong><small>this was supposed to be a quick experiment.</small></article>
        <article><span class="time orange-time">2:08 AM</span><strong>Why is this 2px off?</strong><small>the dangerous stage where details suddenly matter.</small></article>
        <article><span class="time green-time">6:11 AM</span><strong>Okay. Ship it.</strong><small>good enough to be real, not finished enough to stop improving.</small></article>
        <div class="pixel process-pet"><i></i><i></i><b></b></div>
      </div>
    </section>

    <section class="section shell shell--wide experiments" aria-labelledby="experiments-title">
      <div class="section-head reveal">
        <div><p>03 / EXPERIMENTS</p><h2 id="experiments-title">Small ideas get room<br />to become weird.</h2></div>
        <a href={`${base}projects/`}>Browse everything ↗</a>
      </div>
      <div class="experiment-list reveal">
        <a href="https://getrandomletter.com/" target="_blank" rel="noopener noreferrer"><span class="exp-icon exp-blue">A</span><div><small>BROWSER TOY</small><strong>Spin a letter.</strong><p>Then somehow build five more tools around it.</p></div><b>↗</b></a>
        <a href="https://github.com/namanlabc/astro-seo-audit" target="_blank" rel="noopener noreferrer"><span class="exp-icon exp-green">✓</span><div><small>OPEN SOURCE</small><strong>Audit what Astro actually ships.</strong><p>Because source code is not the final HTML.</p></div><b>↗</b></a>
        <a href={`${base}projects/`}><span class="exp-icon exp-orange">✦</span><div><small>ONGOING</small><strong>Make something useful.</strong><p>Then obsess over the tiny parts.</p></div><b>→</b></a>
      </div>
    </section>

    <section class="writing shell shell--wide" aria-labelledby="recent-writing-title">
      <div class="section-head reveal">
        <div><p>04 / WRITING</p><h2 id="recent-writing-title">Notes from making<br />things the hard way.</h2></div>
        <a href={`${base}archive/`}>Full archive ↗</a>
      </div>
      <div class="writing-card reveal">
        <div class="writing-list">
          {recentPosts.map((post) => (
            <WritingItem title={post.data.title} description={post.data.description} pubDate={post.data.pubDate} href={`${base}blog/${post.id}/`} tags={post.data.tags} />
          ))}
        </div>
        <div class="writer-mascot" aria-hidden="true"><div class="pixel writer-face"><i></i><i></i><b></b></div><span>✎</span></div>
      </div>
    </section>

    <section class="final-card shell shell--wide reveal" aria-labelledby="final-title">
      <div>
        <p>STILL MAKING THINGS</p>
        <h2 id="final-title">See you somewhere<br />on the internet.</h2>
        <div class="final-links"><a href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer">X ↗</a><a href={`${base}about/`}>About →</a></div>
      </div>
      <div class="final-scene" aria-hidden="true"><div class="status-chip final-status"><i></i> status: shipped <b>✓</b></div><div class="pixel final-pet final-blue"><i></i><i></i></div><div class="pixel final-pet final-cream"><i></i><i></i></div><div class="pixel final-pet final-orange"><i></i><i></i></div></div>
    </section>
  </main>

  <script>
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });
    reveals.forEach((item) => observer.observe(item));
  </script>
</Layout>

<style>
  :global(body){background:#fbfbf8;color:#111214}
  :global(.site-header){background:rgba(251,251,248,.9)!important;backdrop-filter:blur(16px);border-bottom:1px solid #ecece7!important}
  .ultra-home{overflow:hidden;background:#fbfbf8}
  .shell--wide{max-width:1180px}
  .hero{min-height:760px;display:grid;grid-template-columns:minmax(0,.92fr) minmax(420px,1.08fr);align-items:center;gap:64px;padding-top:96px;padding-bottom:92px}
  .eyebrow,.section-head p,.process-copy>p,.final-card>div>p{font:700 11px/1.2 'Space Mono',monospace;letter-spacing:.09em;color:#686b70;text-transform:uppercase}
  .eyebrow{display:flex;align-items:center;gap:10px}.eyebrow span{width:8px;height:8px;border-radius:50%;background:#25c46a;box-shadow:0 0 0 4px #e5f8ec}
  .hero h1{font-size:clamp(58px,6.5vw,94px);line-height:.94;letter-spacing:-.065em;margin:24px 0 26px;max-width:720px;color:#0d0e10}
  .hero h1 em{font-style:normal;color:#245fe8}
  .hero-intro{font-size:20px;line-height:1.55;color:#666970;max-width:620px;margin:0}
