  .process{display:grid;grid-template-columns:.78fr 1.22fr;gap:70px;padding-top:110px;padding-bottom:120px}.process-copy{align-self:start;position:sticky;top:120px}.process-copy>p:last-child{font-size:17px;line-height:1.6;color:#6b6e73;max-width:460px;margin-top:22px}.process-track{position:relative;background:#fff;border:1px solid #e6e6e0;border-radius:24px;padding:12px 30px 12px 70px;box-shadow:0 12px 36px rgba(21,23,27,.04)}.track-line{position:absolute;left:35px;top:54px;bottom:54px;width:2px;background:#e5e6e0}.process-track article{position:relative;padding:31px 0 30px;border-bottom:1px solid #eeeeea}.process-track article:last-of-type{border-bottom:0}.process-track article:before{content:"";position:absolute;left:-41px;top:40px;width:10px;height:10px;border-radius:50%;background:#fff;border:3px solid #151619}.time{display:inline-block;font:700 10px 'Space Mono',monospace;padding:5px 7px;border-radius:6px;margin-bottom:9px}.blue-time{background:#eaf0ff;color:#245fe8}.yellow-time{background:#fff6ce;color:#8a6a00}.orange-time{background:#fff0e5;color:#cf5c12}.green-time{background:#eaf9ef;color:#198a4b}.process-track strong{display:block;font-size:22px;letter-spacing:-.02em;margin-bottom:5px}.process-track small{font-size:13px;color:#74777c}.process-pet{position:absolute;right:18px;bottom:-28px;width:64px;height:70px;background:#6689f1;border:4px solid #17181b;border-radius:18px;transform:rotate(4deg)}.process-pet i,.writer-face i,.final-pet i{position:absolute;width:5px;height:8px;background:#17181b;top:28px}.process-pet i:first-child,.writer-face i:first-child,.final-pet i:first-child{left:17px}.process-pet i:nth-child(2),.writer-face i:nth-child(2),.final-pet i:nth-child(2){right:17px}.process-pet b{position:absolute;width:18px;height:6px;border-bottom:3px solid #17181b;border-radius:50%;left:20px;top:42px}
