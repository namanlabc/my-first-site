---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ReferenceArt from '../components/ReferenceArt.astro';
import ReferenceProjectMark from '../components/ReferenceProjectMark.astro';
import '../styles/reference.css';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = posts.slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const work = [
  {
    name: 'SmallMB',
    detail: 'Android file utility',
    href: 'https://smallmb.com/',
    kind: 'smallmb' as const,
  },
  {
    name: 'Astro SEO Audit',
    detail: 'Open-source SEO tool',
    href: 'https://github.com/namanlabc/astro-seo-audit',
    kind: 'audit' as const,
  },
  {
    name: 'Get Random Letter',
    detail: 'Browser tools',
    href: 'https://getrandomletter.com/',
    kind: 'letters' as const,
  },
];
---

<Layout description="Naman Patel builds software and websites, and writes about what he learns.">
  <article class="reference-home">
    <section class="reference-hero" aria-labelledby="home-title">
      <div class="reference-hero__copy">
        <h1 id="home-title">Naman Patel</h1>
        <p class="reference-hero__lead">Software, websites and writing.</p>
        <p class="reference-hero__sub">I build useful tools and write about what I learn.</p>
      </div>

      <div class="reference-hero__art">
        <ReferenceArt variant="hero" />
      </div>
    </section>

    <section class="reference-section" aria-labelledby="made-title">
      <div class="reference-section__head">
        <span class="reference-section__index">01</span>
        <h2 id="made-title">Things I’ve made</h2>
      </div>

      <div class="reference-projects">
        {work.map(project => (
          <a class="reference-project" href={project.href} target="_blank" rel="noopener noreferrer">
            <ReferenceProjectMark kind={project.kind} />
            <span class="reference-project__copy">
              <strong>{project.name}</strong>
              <small>{project.detail}</small>
            </span>
            <span class="reference-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="reference-section" aria-labelledby="writing-title">
      <div class="reference-section__head">
        <span class="reference-section__index">02</span>
        <h2 id="writing-title">Recent writing</h2>
      </div>

      <div class="reference-writing">
        {recentPosts.map(post => (
          <a class="reference-writing-row" href={`${base}blog/${post.id}/`}>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })}
            </time>
            <strong>{post.data.title}</strong>
            <span class="reference-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <a class="reference-all-writing" href={`${base}archive/`}>All writing <span aria-hidden="true">→</span></a>
    </section>
  </article>
</Layout>
