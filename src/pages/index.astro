---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectPoster from '../components/ProjectPoster.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TechnicalWorkbench from '../components/TechnicalWorkbench.astro';
import WritingItem from '../components/WritingItem.astro';
import { projects } from '../data/projects';

const posts = await getCollection('blog');
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout>
  <section class="home-hero shell shell--wide" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <h1 id="home-title">Hi, I’m Naman.</h1>
      <p class="home-hero__intro">
        I work on SEO, build websites and useful tools, and write about what I learn while making them.
      </p>
      <p class="home-hero__aside">
        Most of it starts with me wondering, “could I make this better?” Then I disappear into it for a while.
      </p>
    </div>
    <aside class="home-now" aria-label="What Naman is doing now">
      <span>Right now</span>
      <p>Improving Get Random Letter, shipping SmallMB, and figuring out what Astro SEO Audit should catch next.</p>
      <div>
        <a href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer">X ↗</a>
        <a href={`${base}about/`}>About me →</a>
      </div>
    </aside>
  </section>

  <section class="home-projects shell shell--wide" aria-labelledby="selected-work-title">
    <SectionHeading
      id="selected-work-title"
      title="What I’m working on"
      href={`${base}projects/`}
      linkLabel="All projects"
    />
    <div class="project-poster-grid">
      {projects.map((project) => <ProjectPoster project={project} />)}
    </div>
  </section>

  <section class="home-experience page-section shell shell--wide" aria-labelledby="home-experience-title">
    <SectionHeading
      id="home-experience-title"
      title="A few things I’m good at"
      description="The useful part isn’t knowing tool names. It’s knowing how the pieces connect when something actually has to ship."
      href={`${base}experience/`}
      linkLabel="My experience"
    />

    <div class="experience-preview-grid">
      <article class="experience-preview">
        <TechnicalWorkbench variant="seo" compact={true} />
        <div class="experience-preview__copy">
          <span>01</span>
          <h3>SEO & content</h3>
          <p>Search intent, technical SEO, content systems, schema, publishing, and reading the data after the page goes live.</p>
          <div class="experience-preview__tags" aria-label="SEO tools and skills">
            <span>Search Console</span><span>WordPress</span><span>Ahrefs</span><span>Schema</span>
          </div>
        </div>
      </article>

      <article class="experience-preview">
        <TechnicalWorkbench variant="web" compact={true} />
        <div class="experience-preview__copy">
          <span>02</span>
          <h3>Product & web</h3>
          <p>Turning a rough idea into structure, interface, code, QA, and the awkward final ten percent before it feels finished.</p>
          <div class="experience-preview__tags" aria-label="Web development tools and skills">
            <span>Astro</span><span>Tailwind</span><span>GitHub</span><span>VS Code</span>
          </div>
        </div>
      </article>

      <article class="experience-preview experience-preview--ai">
        <TechnicalWorkbench variant="workflow" compact={true} />
        <div class="experience-preview__copy">
          <span>03</span>
          <h3>Tools, agents & workflow</h3>
          <p>Moving between Android, AI coding agents, model routing, automation, CI, QA, and releases without treating any one tool like magic.</p>
          <div class="experience-preview__ai-ready"><b>AI READY</b><span>agentic coding · model routing · supervised shipping</span></div>
          <div class="experience-preview__tags" aria-label="AI, Android and workflow tools">
            <span>Claude</span><span>Codex</span><span>OpenCode</span><span>OpenRouter</span><span>Antigravity</span><span>Android / CI</span>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="page-section page-section--writing shell shell--wide" aria-labelledby="recent-writing-title">
    <SectionHeading
      id="recent-writing-title"
      title="Recent writing"
      description="I write when I learn something worth remembering—or when an opinion refuses to leave me alone."
      href={`${base}archive/`}
      linkLabel="Full archive"
    />
    <div class="writing-list">
      {recentPosts.map((post) => (
        <WritingItem
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          href={`${base}blog/${post.id}/`}
          tags={post.data.tags}
        />
      ))}
    </div>
  </section>

  <section class="now-note shell shell--wide" aria-labelledby="now-title">
    <div>
      <h2 id="now-title">Away from the keyboard</h2>
      <p>
        If I’m not building something, I’m probably watching <em>One Piece</em>, drinking chai, or telling myself I’ll stop after one more chapter.
      </p>
    </div>
    <a class="arrow-link" href={`${base}about/#off-screen`}>More about me <span aria-hidden="true">→</span></a>
  </section>
</Layout>

<style>
  .home-experience {
    border-top: 1px solid var(--rule);
  }

  .experience-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.7rem);
  }

  .experience-preview {
    min-width: 0;
  }

  .experience-preview__copy {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.2rem 0.8rem;
    padding-top: 0.95rem;
  }

  .experience-preview__copy > span {
    grid-row: 1 / span 4;
    padding-top: 0.2rem;
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.62rem;
  }

  .experience-preview__copy h3 {
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .experience-preview__copy p {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .experience-preview__ai-ready {
    grid-column: 2;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.6rem;
    padding: 0.38rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--rule));
    background: color-mix(in srgb, var(--accent-soft) 60%, var(--surface));
    font-family: var(--mono);
  }

  .experience-preview__ai-ready b {
    flex: 0 0 auto;
    color: var(--accent);
    font-size: 0.48rem;
    letter-spacing: 0.07em;
  }

  .experience-preview__ai-ready span {
    color: var(--muted);
    font-size: 0.46rem;
    line-height: 1.35;
  }

  .experience-preview__tags {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem;
    margin-top: 0.65rem;
  }

  .experience-preview__tags span {
    padding: 0.18rem 0.35rem;
    border: 1px solid var(--rule-strong);
    color: var(--faint);
    background: color-mix(in srgb, var(--surface) 64%, transparent);
    font-family: var(--mono);
    font-size: 0.5rem;
  }

  .experience-preview--ai .experience-preview__tags span:nth-child(-n+5) {
    color: var(--ink);
    border-color: color-mix(in srgb, var(--ink) 32%, var(--rule));
    background: var(--surface);
  }

  @media (max-width: 860px) {
    .experience-preview-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
