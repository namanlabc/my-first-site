---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const products = [
  { name: 'SmallMB', note: 'The stubborn file-size fixer', description: 'Compress photos and PDFs, resize images, and convert files without sending them away.', href: 'https://smallmb.com/', className: 'smallmb' },
  { name: 'GeoSpoof', note: 'A geotag photo editor', description: 'Change GPS location, date, map stamps and EXIF data on Android.', href: `${base}projects/`, className: 'geospoof' },
  { name: 'CatToy', note: 'Built for a very different user', description: 'A tiny hunting game where cats chase mice, lizards, fish and flies.', href: `${base}projects/`, className: 'cattoy' },
];
---

<Layout description="Small useful software, field notes, and one very long fantasy story by Naman Patel.">
  <div class="home-shell">
    <section class="personal-hero" aria-labelledby="home-title">
      <div class="hero-intro">
        <p class="hero-label">Naman Patel · builder &amp; writer</p>
        <h1 id="home-title">I make small, useful software.</h1>
        <p class="hero-lede">Then I write about the parts that surprised me. Occasionally, I disappear into a fantasy world of my own.</p>
      </div>
      <aside class="desk-note" aria-label="What Naman is doing now">
        <span class="desk-note-pin" aria-hidden="true"></span><p>Right now</p>
        <strong>Shipping Android apps and trying to finish the next chapter.</strong>
        <a href={base + 'about/'}>More about me →</a>
      </aside>
    </section>

    <section class="workbench" aria-labelledby="work-title">
      <header class="section-intro"><div><span>01</span><h2 id="work-title">On my workbench</h2></div><a href={base + 'projects/'}>Everything I’ve made →</a></header>
      <div class="project-stories">
        {products.map((product) => (
          <article class:list={['project-story', `project-story--${product.className}`]}>
            <a class="story-art" href={product.href} aria-label={`View ${product.name}`}>
              {product.className === 'smallmb' && <><div class="file file--large"><span>12.4</span><small>MB</small></div><div class="compression-line">→</div><div class="file file--small"><span>842</span><small>KB</small></div></>}
              {product.className === 'geospoof' && <><div class="map-grid"></div><div class="map-route"></div><div class="map-pin"><i></i></div><span class="coordinates">22.5972° N<br />80.3714° E</span></>}
              {product.className === 'cattoy' && <><div class="mouse"><i></i><b></b><span></span></div><div class="paw paw--one">●</div><div class="paw paw--two">●</div><div class="chase-line"></div></>}
            </a>
            <div class="story-copy"><span>{product.note}</span><h3><a href={product.href}>{product.name}</a></h3><p>{product.description}</p><a class="story-link" href={product.href}>See the project ↗</a></div>
          </article>
        ))}
      </div>
    </section>

    <section class="notebook" aria-labelledby="notes-title">
      <header class="section-intro"><div><span>02</span><h2 id="notes-title">From the notebook</h2></div><a href={base + 'archive/'}>Read all notes →</a></header>
      <div class="note-list">
        {posts.map((post) => <a class="note-entry" href={`${base}blog/${post.id}/`}><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: '2-digit' })}</time><span>{post.data.title}</span><b aria-hidden="true">↗</b></a>)}
      </div>
    </section>

    <section class="fiction-shelf" aria-labelledby="fiction-title">
      <div class="fiction-mark" aria-hidden="true"><span>十</span></div>
      <div class="fiction-copy"><span>03 · Somewhere beyond the software</span><h2 id="fiction-title">The Idiot God</h2><p>A long fantasy adventure I’m writing about distant kingdoms, dangerous seas and a power called Shinzui.</p></div>
      <a href="https://www.wattpad.com/story/416937465" target="_blank" rel="noopener noreferrer">Read on Wattpad ↗</a>
    </section>
  </div>
</Layout>
