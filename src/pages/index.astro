---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const posts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const work = [
 {name:'SmallMB',description:'An Android app for compressing photos and PDFs on your device.',href:'https://smallmb.com/'},
 {name:'Astro SEO Audit',description:'An open-source CLI that checks the HTML your Astro site ships.',href:'https://github.com/namanlabc/astro-seo-audit'},
 {name:'Get Random Letter',description:'Six browser tools for games, classrooms, and quick decisions.',href:'https://getrandomletter.com/'},
];
---
<Layout>
  <div class="portfolio">
    <section class="portfolio-intro" aria-labelledby="home-title">
      <div class="intro-copy">
        <h1 id="home-title">Naman Patel</h1>
        <p>I work on SEO and build useful software.</p>
        <p class="intro-description">Currently making Android utilities, open-source tools, and small things for the web. This is where I share my work and what I learn.</p>
        <a class="text-link" href={`${base}about/`}>More about me <span aria-hidden="true">→</span></a>
      </div>
      <figure class="intro-illustration">
        <img src={`${base}images/observer-maker.webp`} alt="An illustrated maker considering a small idea" width="1280" height="853" />
        <figcaption>still figuring it out</figcaption>
      </figure>
    </section>
    <section class="portfolio-section" aria-labelledby="work-title">
      <div class="section-heading"><h2 id="work-title">Selected work</h2><a href={`${base}projects/`}>All projects <span aria-hidden="true">→</span></a></div>
      <div class="work-list">{work.map(project => <a class="work-link" href={project.href} target="_blank" rel="noopener noreferrer"><div><h3>{project.name}</h3><p>{project.description}</p></div><span class="link-arrow" aria-hidden="true">↗</span></a>)}</div>
    </section>
    <section class="portfolio-section" aria-labelledby="writing-title">
      <div class="section-heading"><h2 id="writing-title">Recent writing</h2><a href={`${base}archive/`}>All writing <span aria-hidden="true">→</span></a></div>
      <div class="recent-writing">{posts.map(post => <a href={`${base}blog/${post.id}/`}><h3>{post.data.title}</h3><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</time></a>)}</div>
    </section>
  </div>
</Layout>
