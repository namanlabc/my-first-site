---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const posts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const work = [
 {name:'SmallMB',line:'Make a file fit the form.',description:'Photos and PDFs, made small enough to send. An Android utility that keeps the work on your device.',kind:'Android utility',action:'Open SmallMB',href:'https://smallmb.com/',visual:'smallmb'},
 {name:'Astro SEO Audit',line:'See what your site actually ships.',description:'A check on the HTML an Astro site sends to the browser, with useful findings instead of a mysterious score.',kind:'Open source',action:'See the tool',href:'https://github.com/namanlabc/astro-seo-audit',visual:'audit'},
 {name:'Get Random Letter',line:'A useful bit of nonsense.',description:'One alphabet wheel became six small browser tools for games, classrooms, and little decisions.',kind:'Web tools',action:'Play with it',href:'https://getrandomletter.com/',visual:'wheel'},
];
const featuredPost = posts[0];
const recentPosts = posts.slice(1, 4);
---
<Layout>
  <div class="portfolio">
    <section class="portfolio-intro" aria-labelledby="home-title">
      <div class="intro-copy">
        <p class="intro-kicker">Naman Patel <span aria-hidden="true">/</span> independent maker</p>
        <h1 id="home-title">I build small software for real problems.</h1>
        <p class="intro-description">Then I write down what I learn. Android utilities, open-source tools, and tiny web experiments—built, shipped, and improved in public.</p>
        <div class="intro-actions">
          <a class="contact-button" href="mailto:contact@naman.blog?subject=Let%27s%20build%20something%20useful" aria-label="Build something useful with Naman via contact@naman.blog">Want to build something useful?<span aria-hidden="true">↗</span></a>
          <a class="text-link" href={`${base}about/`}>A little about me<span aria-hidden="true">→</span></a>
        </div>
        <p class="intro-now"><span>Currently</span> making SmallMB easier to use.</p>
      </div>
      <figure class="intro-illustration">
        <img src={`${base}images/maker-hero-v2.webp`} alt="An illustrated maker walking with a backpack, coffee, and a rolled note" width="724" height="900" />
      </figure>
    </section>
    <section class="portfolio-section" aria-labelledby="work-title">
      <div class="section-heading"><div><p class="section-kicker">01 / things I’ve shipped</p><h2 id="work-title">A few ideas that made it out of my head.</h2></div><a href={`${base}projects/`}>All projects <span aria-hidden="true">→</span></a></div>
      <div class="work-grid">
        {work.map((project, index) => <a class:list={['work-card', `work-card--${project.visual}`]} href={project.href} target="_blank" rel="noopener noreferrer">
          <div class="work-art" aria-hidden="true">
            {project.visual === 'smallmb' && <div class="file-art"><span class="file-art__back"></span><span class="file-art__front"><b>MB</b><i></i><i></i><i></i></span><span class="file-art__arrow">↓</span></div>}
            {project.visual === 'audit' && <div class="audit-art"><span class="audit-art__bar"><i></i><i></i><i></i></span><span class="audit-art__line audit-art__line--long"></span><span class="audit-art__line"></span><span class="audit-art__line audit-art__line--short"></span><span class="audit-art__check">✓</span></div>}
            {project.visual === 'wheel' && <div class="wheel-art"><span class="wheel-art__hub">?</span><i>A</i><i>B</i><i>C</i><i>D</i><i>E</i><i>F</i></div>}
          </div>
          <div class="work-card-body">
            <div class="work-card-meta"><span>0{index + 1}</span><span>{project.kind}</span></div>
            <h3>{project.name}</h3>
            <p class="work-card-line">{project.line}</p>
            <p class="work-card-description">{project.description}</p>
            <span class="work-card-link">{project.action} <span aria-hidden="true">↗</span></span>
          </div>
        </a>)}
      </div>
    </section>
    <section class="portfolio-section" aria-labelledby="writing-title">
      <div class="section-heading"><div><p class="section-kicker">02 / from the notebook</p><h2 id="writing-title">The useful parts of the rabbit holes.</h2></div><a href={`${base}archive/`}>All writing <span aria-hidden="true">→</span></a></div>
      {featuredPost && <a class="featured-writing" href={`${base}blog/${featuredPost.id}/`}>
        {featuredPost.data.image && <img src={`${base}${featuredPost.data.image.replace(/^\//, '')}`} alt={featuredPost.data.imageAlt ?? ''} width="1536" height="1024" loading="lazy" />}
        <div class="featured-writing-copy"><p class="featured-writing-kicker">Latest note</p><h3>{featuredPost.data.title}</h3><p>{featuredPost.data.description}</p><span>Read the note <span aria-hidden="true">↗</span></span></div>
      </a>}
      <div class="recent-writing">{recentPosts.map(post => <a href={`${base}blog/${post.id}/`}><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</time><span aria-hidden="true">↗</span></a>)}</div>
    </section>
    <section class="portfolio-closing" aria-label="Contact Naman">
      <p>Still pulling the thread.</p>
      <h2>Have something worth building?</h2>
      <a href="mailto:contact@naman.blog?subject=Have%20something%20worth%20building%3F">Tell me about it <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</Layout>
