---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Invention from '../components/Invention.astro';
import WritingItem from '../components/WritingItem.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 5);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const inventions = [
  {kind:'smallmb' as const, name:'SmallMB', line:'Big files. Small problem.', description:'Photos and PDFs, made small enough to send. An Android utility that keeps the work on your device.', href:'https://smallmb.com/', link:'Meet SmallMB'},
  {kind:'audit' as const, name:'Astro SEO Audit', line:'A second pair of eyes.', description:'A check on the HTML your Astro site actually ships. Because the tiny things are easy to miss.', href:'https://github.com/namanlabc/astro-seo-audit', link:'See the open-source tool'},
  {kind:'wheel' as const, name:'Get Random Letter', line:'A useful bit of nonsense.', description:'One alphabet wheel became a collection of browser tools for games, classrooms, and little decisions.', href:'https://getrandomletter.com/', link:'Play with the real thing'},
];
---
<Layout>
  <section class="inventions-home" aria-labelledby="home-title">
    <header class="inventions-intro">
      <div><p class="small-label">Naman Patel / independent maker</p><h1 id="home-title">Small inventions.<br /><em>Long rabbit holes.</em></h1></div>
      <div class="intro-note"><p>I work on search, build things I want to use, and write about what happens along the way.</p><a href={`${base}about/`}>A little about me ↗</a></div>
    </header>
    <div class="inventions-heading"><p><span class="hand-note">Please do touch.</span> Three things you can try right here.</p><span class="small-label">Selected work / 01—03</span></div>
    <div class="inventions-stage" data-stage>
      <nav class="invention-selector" aria-label="Choose a project to try">
        {inventions.map((item, i) => <button type="button" data-select={item.kind} aria-controls={`home-${item.kind}`} aria-pressed={i === 0 ? 'true' : 'false'}><span>0{i+1}</span>{i === 1 ? 'SEO Audit' : i === 2 ? 'Letter wheel' : item.name}</button>)}
      </nav>
      <div class="inventions-grid">
        {inventions.map((item, i) => <article id={`home-${item.kind}`} data-panel={item.kind} class:list={['invention-chapter', {'is-selected': i === 0}]}>
          <Invention kind={item.kind} id={`home-${item.kind}`} />
          <div class="invention-story"><h2>{item.line}</h2><p>{item.description}</p><a href={item.href} target="_blank" rel="noopener noreferrer">{item.link} ↗</a></div>
        </article>)}
      </div>
    </div>
    <div class="stage-colophon"><a href={`${base}projects/`}>The rest of the projects →</a><p>Some useful. Some odd. All mine.</p></div>
  </section>
  <section class="notes-section" aria-labelledby="writing-title">
    <header class="notes-heading"><div><p class="small-label">From the notebook</p><h2 id="writing-title">The things I learned<br /><em>by doing the thing.</em></h2></div><a href={`${base}archive/`}>All writing ↗</a></header>
    {posts[0] && <a class="featured-dispatch" href={`${base}blog/${posts[0].id}/`}>
      {posts[0].data.image && <img src={`${base}${posts[0].data.image.replace(/^\//, '')}`} alt={posts[0].data.imageAlt ?? ''} width="1536" height="1024" loading="lazy" />}
      <div><span class="hand-note">the latest rabbit hole</span><h3>{posts[0].data.title}</h3><p>{posts[0].data.description}</p><span class="dispatch-link">Read the note ↗</span></div>
    </a>}
    <div class="writing-list">{posts.slice(1).map(post => <WritingItem title={post.data.title} pubDate={post.data.pubDate} href={`${base}blog/${post.id}/`} tags={post.data.tags} />)}</div>
  </section>
  <section class="maker-signoff">
    <img src={`${base}images/observer-maker.webp`} alt="" width="1280" height="853" loading="lazy" />
    <div><span class="hand-note">still pulling the thread.</span><h2>Behind the work,<br />there’s just me.</h2><p>SEO, software, One Piece, and a reliably unfinished cup of chai.</p><a href={`${base}about/`}>Meet Naman →</a></div>
  </section>
  <script>
    document.querySelectorAll<HTMLElement>('[data-stage]').forEach(stage => {
      stage.classList.add('is-interactive');
      stage.querySelectorAll<HTMLButtonElement>('[data-select]').forEach(button => {
        button.addEventListener('click', () => {
          stage.querySelectorAll<HTMLButtonElement>('[data-select]').forEach(choice => choice.setAttribute('aria-pressed', String(choice === button)));
          stage.querySelectorAll<HTMLElement>('[data-panel]').forEach(panel => panel.classList.toggle('is-selected', panel.dataset.panel === button.dataset.select));
        });
      });
    });
  </script>
</Layout>
