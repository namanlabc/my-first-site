---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const featuredPost = posts[0];
const recentPosts = posts.slice(1, 4);

const work = [
  {
    name: 'SmallMB', note: 'for stubborn upload limits',
    description: 'Photos and PDFs compressed to the size you actually need. It works offline, because a private file should stay private.',
    kind: 'Android app', status: 'Shipped', href: 'https://smallmb.com/', visual: 'smallmb',
  },
  {
    name: 'Astro SEO Audit', note: 'for mistakes hiding in the HTML',
    description: 'An open-source CLI that inspects what an Astro site really ships and explains the SEO problems it finds.',
    kind: 'Open source', status: 'On npm', href: 'https://github.com/namanlabc/astro-seo-audit', visual: 'audit',
  },
  {
    name: 'Get Random Letter', note: 'for decisions too small for a meeting',
    description: 'A letter wheel that grew into six tiny browser tools for classrooms, games and indecisive afternoons.',
    kind: 'Web tools', status: 'Live', href: 'https://getrandomletter.com/', visual: 'letters',
  },
];
---

<Layout>
  <div class="home-sheet">
    <section class="home-opening" aria-labelledby="home-title">
      <div class="opening-note" aria-hidden="true"><span>currently</span>making SmallMB<br />less annoying</div>
      <div class="opening-copy">
        <p class="hand-note">I keep noticing annoying little things.</p>
        <h1 id="home-title">So I make software for the little frictions I can’t ignore.</h1>
        <p class="opening-intro">I’m Naman. I made <a href="https://smallmb.com/">SmallMB</a> for stubborn file limits, <a href="https://github.com/namanlabc/astro-seo-audit">Astro SEO Audit</a> for invisible SEO mistakes, and a wheel for decisions that don’t deserve a meeting.</p>
        <div class="opening-links">
          <a href="#work">See what escaped the notebook <span aria-hidden="true">↓</span></a>
          <a href="mailto:contact@naman.blog?subject=I%20have%20a%20little%20friction">contact@naman.blog <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <figure class="observer-field">
        <svg viewBox="0 0 330 310" role="img" aria-labelledby="observer-title observer-desc">
          <title id="observer-title">The Observer measuring an imperfect shape</title>
          <desc id="observer-desc">A hand-drawn eye studies a crooked square using a ruler and pencil.</desc>
          <path class="observer-orbit" d="M38 150C84 76 179 60 269 119C220 205 118 229 38 150Z" />
          <circle class="observer-iris" cx="153" cy="145" r="45" />
          <circle class="observer-pupil" cx="160" cy="146" r="15" />
          <path class="observer-glance" d="M153 145l9-5" />
          <path class="observer-square" d="M211 34l72 18-16 68-69-13z" />
          <path class="observer-coral" d="M222 49l42 11M218 66l31 8M214 83l48 12" />
          <path class="observer-ruler" d="M52 229l195 31-4 25-195-31z" />
          <path class="observer-ticks" d="M72 235l-3 17M94 239l-2 10M116 242l-3 17M138 246l-2 10M160 249l-3 17M182 253l-2 10M204 256l-3 17M226 260l-2 10" />
          <path class="observer-pencil" d="M76 54l20-17 93 112-20 17zM76 54l-10-14 30-3" />
          <path class="observer-spark" d="M286 166l18-5M282 180l15 7M292 148l8-14" />
        </svg>
        <figcaption>notice → measure → make → repeat</figcaption>
      </figure>
    </section>

    <section class="work-ledger" id="work" aria-labelledby="work-title">
      <header class="ledger-heading">
        <div><p>Selected work / 2026</p><h2 id="work-title">Things that escaped the notebook.</h2></div>
        <p>Three useful things.<br />Zero grand visions.</p>
      </header>
      <div class="project-ledger">
        {work.map((project, index) => (
          <a class:list={['project-row', `project-row--${project.visual}`]} href={project.href} target="_blank" rel="noopener noreferrer">
            <span class="project-number">0{index + 1}</span>
            <div class="project-copy">
              <p class="project-kind">{project.kind} <i>·</i> {project.status}</p>
              <h3>{project.name}</h3>
              <p class="project-note">{project.note}</p>
              <p class="project-description">{project.description}</p>
              <span class="project-visit">Visit project <i aria-hidden="true">↗</i></span>
            </div>
            <div class="project-mark" aria-hidden="true">
              {project.visual === 'smallmb' && <div class="compression-mark"><span class="compression-before">4.8 MB</span><span class="compression-arrow">↓</span><span class="compression-after">980 KB</span><i></i><i></i></div>}
              {project.visual === 'audit' && <div class="html-mark"><span>&lt;title&gt;</span><b>✓</b><span>&lt;meta&gt;</span><b>✓</b><span>&lt;h1&gt;</span><b>?</b><i>view source, not vibes</i></div>}
              {project.visual === 'letters' && <div class="letter-mark"><span>A</span><span>R</span><span>K</span><span>?</span><span>M</span><b>spin</b></div>}
            </div>
          </a>
        ))}
      </div>
      <a class="all-work-link" href={`${base}projects/`}>The full project shelf <span aria-hidden="true">→</span></a>
    </section>

    <section class="notes-index" aria-labelledby="notes-title">
      <header class="notes-heading">
        <p>Recent notes</p>
        <h2 id="notes-title">What I learned after pressing publish.</h2>
        <a href={`${base}archive/`}>Browse every note <span aria-hidden="true">→</span></a>
      </header>
      <div class="notes-list">
        {featuredPost && <a class="note-row note-row--featured" href={`${base}blog/${featuredPost.id}/`}><span class="note-date">Latest</span><div><h3>{featuredPost.data.title}</h3><p>{featuredPost.data.description}</p></div><span aria-hidden="true">↗</span></a>}
        {recentPosts.map(post => <a class="note-row" href={`${base}blog/${post.id}/`}><time class="note-date" datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', {month:'short', day:'numeric'})}</time><div><h3>{post.data.title}</h3></div><span aria-hidden="true">↗</span></a>)}
      </div>
    </section>

    <section class="home-signoff" aria-label="Contact Naman">
      <p class="hand-note">There is probably a simpler version.</p>
      <h2>Have a useful problem?</h2>
      <p>Tell me the messy version. I’ll ask better questions.</p>
      <a href="mailto:contact@naman.blog?subject=I%20have%20a%20useful%20problem">Write to Naman <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</Layout>
