---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import NovelFeature from '../components/NovelFeature.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import '../styles/home.css';
const posts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const work = [
 {name:'SmallMB', detail:'Photo and PDF tools for Android.', kind:'Android', href:'https://smallmb.com/'},
 {name:'Astro SEO Audit', detail:'An open-source tool for finding SEO mistakes.', kind:'Open source', href:'https://github.com/namanlabc/astro-seo-audit'},
 {name:'Get Random Letter', detail:'Small browser tools for letters, words and numbers.', kind:'Web', href:'https://getrandomletter.com/'},
];
---
<Layout description="Software, stories and notes by Naman Patel. Explore my projects and read The Idiot God, a fantasy adventure.">
 <article class="bear-home">
  <section class="bear-intro" aria-labelledby="home-title">
   <p class="folio-label">Software, stories &amp; other pursuits</p>
   <h1 id="home-title">Naman Patel<span class="intro-period">.</span></h1>
   <p class="intro-copy">I build small tools and write about what I learn.<br class="desktop-break"/> Somewhere along the way, I started writing a world of my own.</p>
   <img class="intro-figure" src={base+'images/pillar-serpent.webp'} alt="" width="1024" height="1536" loading="eager" decoding="async" aria-hidden="true" />
  </section>
  <section class="bear-section" aria-labelledby="novel-title">
   <div class="folio-heading"><h2 id="novel-title">The novel</h2><span>In progress</span></div>
   <NovelFeature />
   <img class="section-figure section-figure--shiva" src={base+'images/shiva-fragment.webp'} alt="" width="1024" height="1536" loading="lazy" decoding="async" aria-hidden="true" />
  </section>
  <section class="bear-section" aria-labelledby="work-title">
   <div class="folio-heading"><h2 id="work-title">Selected work</h2><a href={base+'projects/'}>All projects ↗</a></div>
   <div class="folio-work">{work.map(item => <a href={item.href} target="_blank" rel="noopener noreferrer" class="folio-work-row"><span><strong>{item.name}</strong><small>{item.detail}</small></span><span class="folio-kind">{item.kind} <span aria-hidden="true">↗</span></span></a>)}</div>
  </section>
  <section class="bear-section" aria-labelledby="notes-title">
   <div class="folio-heading"><h2 id="notes-title">Recent notes</h2><a href={base+'archive/'}>All notes ↗</a></div>
   <div class="folio-notes">{posts.map(post => <a class="folio-note" href={base+'blog/'+post.id+'/'}><strong>{post.data.title}</strong><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US',{month:'short',day:'numeric'})}</time></a>)}</div>
  </section>
  <section class="bear-section" aria-labelledby="background-title">
   <div class="folio-heading"><h2 id="background-title">A little background</h2><a href={base+'experience/'}>Experience ↗</a></div>
   <p class="folio-paragraph">I started with writing, search and websites. Wanting better tools eventually led me into web and Android development. I still like the part where an idea becomes something you can use.</p>
  </section>
  <section class="bear-section" aria-labelledby="github-title">
   <div class="folio-heading"><h2 id="github-title">At the workbench</h2><span>GitHub · Aug to now</span></div>
   <GitHubActivity />
  </section>
  <section class="bear-section" aria-labelledby="about-title">
   <div class="folio-heading"><h2 id="about-title">Away from the keyboard</h2><a href={base+'about/'}>About me ↗</a></div>
   <p class="folio-paragraph">Manga, games, stories with enormous worlds, and a surprising amount of time spent fixing little details.</p>
  </section>
 </article>
</Layout>
