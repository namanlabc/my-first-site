---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Query blog posts and sort by pubDate (newest first)
const posts = await getCollection('blog');
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5); // Show up to 5 recent posts

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
---

<Layout>
  <!-- Personal Introduction Section -->
  <section class="mb-14" aria-label="Introduction">
    <h2 class="text-xl font-serif font-bold text-text mb-4">Hello, I'm Naman.</h2>
    <p class="text-base text-text/85 leading-relaxed font-serif mb-4">
      I make things on the internet, tell stories, and write to make sense of the world. 
      This is my quiet corner of the web. I build simple software, think about how tech shapes 
      our lives, and share whatever sparks my curiosity.
    </p>
    <p class="text-base text-text/85 leading-relaxed font-serif mb-4">
      When I'm not building things, I'm usually watching anime — and <em class="italic">One Piece</em> 
      has been my favorite for as long as I can remember. Luffy and the crew are a constant 
      reminder to chase what matters and never give up.
    </p>
    <p class="text-base text-text/85 leading-relaxed font-serif">
      No tracking scripts, no advertisements, and no algorithms. Just words, code, and thoughts 
      cast out into the digital ether.
    </p>
  </section>

  <!-- Recent Writing Section -->
  <section class="mb-14" aria-labelledby="recent-writing-heading">
    <div class="flex items-baseline justify-between mb-6 pb-2 border-b border-border-subtle/30">
      <h3 id="recent-writing-heading" class="text-xs font-mono font-semibold tracking-wider uppercase text-text/55">
        Recent Writing
      </h3>
      <a href={`${baseUrl}archive`} class="text-xs font-mono text-accent hover:text-accent-hover transition-colors no-underline">
        All Posts &rarr;
      </a>
    </div>

    {recentPosts.length === 0 ? (
      <p class="text-sm font-mono text-text/50">No posts published yet.</p>
    ) : (
      <div class="space-y-8">
        {recentPosts.map((post) => {
          const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });

          return (
            <article class="group relative flex flex-col gap-1">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <h4 class="text-lg font-serif font-semibold text-text group-hover:text-accent transition-colors">
                  <a href={`${baseUrl}blog/${post.id}`} class="no-underline block">
                    {post.data.title}
                  </a>
                </h4>
                <time datetime={post.data.pubDate.toISOString()} class="text-xs font-mono text-text/45 shrink-0">
                  {formattedDate}
                </time>
              </div>
              <p class="text-sm text-text/75 leading-relaxed font-serif">
                {post.data.description}
              </p>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex gap-2 mt-1">
                  {post.data.tags.map((tag) => (
                    <span class="text-[11px] font-mono text-accent/70 bg-card-bg/40 px-1.5 py-0.5 rounded">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
            </article>
          );
        })}
      </div>
    )}
  </section>

  <!-- Currently Section (Signature Element) -->
  <section class="mb-14 p-5 rounded-lg border border-border-subtle/40 bg-card-bg/25 relative overflow-hidden" aria-labelledby="currently-heading">
    <!-- Quiet static accent dot (no more "live" pulse) -->
    <span class="absolute top-5 right-5 inline-flex rounded-full h-2 w-2 bg-accent" aria-hidden="true"></span>

    <h3 id="currently-heading" class="text-xs font-mono font-bold uppercase tracking-wider text-text/60 mb-4 flex items-center gap-1.5">
      [ Naman &middot; Right Now ]
    </h3>
    
    <ul class="space-y-3 text-sm font-mono text-text/80 leading-normal">
      <li class="flex items-start gap-2">
        <span class="text-accent select-none">&bull;</span>
        <span><strong class="text-text font-semibold">Watching:</strong> <em class="italic">One Piece</em> — still sailing with Luffy and the crew. It's my all-time favorite anime.</span>
      </li>
      <li class="flex items-start gap-2">
        <span class="text-accent select-none">&bull;</span>
        <span><strong class="text-text font-semibold">Reading:</strong> <em class="italic">The Anthropocene Reviewed</em> by John Green.</span>
      </li>
      <li class="flex items-start gap-2">
        <span class="text-accent select-none">&bull;</span>
        <span><strong class="text-text font-semibold">Enjoying:</strong> Warm chai, late-night anime marathons, and building this corner of the web.</span>
      </li>
    </ul>
  </section>

  <!-- Newsletter Section -->
  <section class="p-6 rounded-lg border border-dashed border-border-subtle/80 bg-card-bg/10" aria-labelledby="newsletter-heading">
    <h3 id="newsletter-heading" class="text-sm font-serif font-bold text-text mb-2">Subscribe to Naman's Notes</h3>
    <p class="text-xs font-mono text-text/60 mb-4 leading-relaxed">
      No tracking. No analytics. Unsubscribe with one click. I'll email you only when I publish new writing here.
    </p>

    <!-- Visual Mock Only Form -->
    <form class="flex flex-col sm:flex-row gap-2" onsubmit="event.preventDefault(); alert('This is a visual-only mockup! No backend is connected.');">
      <input 
        type="email" 
        placeholder="your.email@address.com" 
        required
        class="flex-1 px-3 py-2 text-sm font-mono bg-bg border border-border-subtle/60 rounded focus:border-accent focus:outline-none placeholder:text-text/30"
        aria-label="Email Address"
      />
      <button 
        type="submit" 
        class="px-4 py-2 text-xs font-mono font-bold uppercase tracking-wider text-bg bg-accent hover:bg-accent-hover rounded cursor-pointer transition-all active:scale-[0.98]"
      >
        Subscribe
      </button>
    </form>
    
    <p class="text-[10px] font-mono text-accent/60 mt-2 text-right">
      * Mock signup (no data is stored or transmitted)
    </p>
  </section>
</Layout>
