---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectItem from '../components/ProjectItem.astro';
import WritingItem from '../components/WritingItem.astro';
import { projects } from '../data/projects';

const posts = await getCollection('blog');
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
const featured = projects.slice(0, 3);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout>
  <div class="home-page">
    <section class="home-stage" aria-labelledby="home-title">
      <div class="stage-copy">
        <p class="stage-kicker">Naman notices a small problem</p>
        <h1 id="home-title">and builds<br />something around it.</h1>
      </div>

      <div class="stage-art">
        <img
          src={`${base}images/observer-maker.webp`}
          alt="An abstract figure arranging a page, a wheel, and a file into a small tower."
          width="1280"
          height="853"
          fetchpriority="high"
        />
      </div>

      <div class="stage-bottom">
        <div class="stage-intro">
          <h2>Naman Patel</h2>
          <p>I work on SEO, build useful software, and write down what the rabbit holes teach me.</p>
        </div>

        <nav class="stage-actions" aria-label="Start exploring">
          <a href={`${base}projects/`}>See the work</a>
          <a href={`${base}archive/`}>Read the notes</a>
          <button id="thought-button" type="button">Another thought</button>
        </nav>

        <div class="stage-palette" aria-label="Choose an accent colour">
          <span>pick a colour</span>
          <div>
            <button class="dot dot--coral" data-accent-choice="coral" type="button" aria-label="Use coral accent" aria-pressed="false"></button>
            <button class="dot dot--blue" data-accent-choice="blue" type="button" aria-label="Use blue accent" aria-pressed="true"></button>
            <button class="dot dot--green" data-accent-choice="green" type="button" aria-label="Use green accent" aria-pressed="false"></button>
            <button class="dot dot--yellow" data-accent-choice="yellow" type="button" aria-label="Use yellow accent" aria-pressed="false"></button>
          </div>
        </div>
      </div>

      <p class="floating-thought" id="floating-thought" aria-live="polite">make the useful thing feel obvious</p>
    </section>

    <section class="identity-strip" aria-label="What I work on">
      <span>SEO</span><i></i><span>software</span><i></i><span>open source</span><i></i><span>small internet experiments</span>
    </section>

    <section class="home-section" aria-labelledby="selected-work-title">
      <header class="section-intro">
        <p>01 / selected work</p>
        <div>
          <h2 id="selected-work-title">A few things that made it out of my head.</h2>
          <a href={`${base}projects/`}>All projects ↗</a>
        </div>
      </header>
      <div class="project-list project-list--home">
        {featured.map((project, index) => <ProjectItem project={project} index={index} />)}
      </div>
    </section>

    <section class="desk-note" aria-labelledby="desk-note-title">
      <p>the usual sequence</p>
      <h2 id="desk-note-title">Notice it. Pull the thread. Build too much. Remove half. Ship it.</h2>
      <span>Sometimes in that order.</span>
    </section>

    <section class="home-section" aria-labelledby="latest-writing-title">
      <header class="section-intro">
        <p>02 / latest writing</p>
        <div>
          <h2 id="latest-writing-title">Notes before I forget the useful part.</h2>
          <a href={`${base}archive/`}>Full archive ↗</a>
        </div>
      </header>
      <div class="writing-list">
        {recentPosts.map((post) => (
          <WritingItem
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            href={`${base}blog/${post.id}/`}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>

    <section class="home-closing">
      <p>There is more context behind all this.</p>
      <a href={`${base}about/`}>A little about me <span>→</span></a>
    </section>
  </div>

  <script>
    const thoughts = [
      'make the useful thing feel obvious',
      'the last ten percent is mostly noticing',
      'small ideas deserve real versions',
      'clarity is a feature',
      'one more rabbit hole, apparently',
    ];
    const thought = document.querySelector<HTMLElement>('#floating-thought');
    const thoughtButton = document.querySelector<HTMLButtonElement>('#thought-button');
    let thoughtIndex = 0;

    thoughtButton?.addEventListener('click', () => {
      thoughtIndex = (thoughtIndex + 1) % thoughts.length;
      if (!thought) return;
      thought.classList.remove('thought-pop');
      requestAnimationFrame(() => {
        thought.textContent = thoughts[thoughtIndex];
        thought.classList.add('thought-pop');
      });
    });
  </script>
</Layout>
