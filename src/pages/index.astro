---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const recentPosts = posts.slice(0, 3);

const work = [
  { name: 'SmallMB', detail: 'Android app', status: 'Live', mark: 'MB', className: 'smallmb', href: 'https://smallmb.com/' },
  { name: 'Astro SEO Audit', detail: 'Open-source CLI', status: 'npm', mark: '</>', className: 'audit', href: 'https://github.com/namanlabc/astro-seo-audit' },
  { name: 'Get Random Letter', detail: 'Browser tools', status: 'Live', mark: 'A?', className: 'letters', href: 'https://getrandomletter.com/' },
];
---

<Layout>
  <article class="quiet-home">
    <section class="quiet-intro" aria-labelledby="home-title">
      <svg class="home-mascot" viewBox="8 8 56 56" aria-hidden="true">
        <circle class="home-mascot-dot" cx="36" cy="36" r="25" />
        <g class="home-mascot-eyes">
          <ellipse cx="29" cy="34" rx="4.5" ry="6" />
          <ellipse cx="44" cy="34" rx="4.5" ry="6" />
        </g>
      </svg>

      <h1 id="home-title">Hey, I’m Naman.</h1>
      <p class="quiet-subtitle">I make useful little things for the internet.</p>

      <div class="quiet-prose">
        <p>Usually because something annoys me enough to build a better version. That’s how <a href="https://smallmb.com/">SmallMB</a>, <a href="https://github.com/namanlabc/astro-seo-audit">Astro SEO Audit</a>, and <a href="https://getrandomletter.com/">Get Random Letter</a> happened.</p>
        <p>I ship things, see what works, and <a href={`${base}archive/`}>write</a> about what I learn. Some projects go somewhere. Some don’t. Both are useful.</p>
      </div>
    </section>

    <section class="quiet-section" aria-labelledby="work-title">
      <h2 id="work-title">Things I’ve made</h2>
      <div class="quiet-work-list">
        {work.map(project => (
          <a class="quiet-work-row" href={project.href} target="_blank" rel="noopener noreferrer">
            <span class:list={['quiet-project-mark', `quiet-project-mark--${project.className}`]}>{project.mark}</span>
            <span class="quiet-project-name">{project.name}<small>{project.detail}</small></span>
            <span class="quiet-project-status">{project.status}</span>
            <span class="quiet-arrow" aria-hidden="true">›</span>
          </a>
        ))}
      </div>
      <a class="quiet-more" href={`${base}projects/`}>See every project</a>
    </section>

    <section class="quiet-section" aria-labelledby="writing-title">
      <h2 id="writing-title">Recent writing</h2>
      <div class="quiet-writing-list">
        {recentPosts.map(post => (
          <a href={`${base}blog/${post.id}/`}>
            <span>{post.data.title}</span>
            <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</time>
          </a>
        ))}
      </div>

      <div class="writing-actions">
        <a class="quiet-more" href={`${base}archive/`}>Read every note</a>
        <a
          class="preferred-source-link"
          href="https://www.google.com/preferences/source?q=naman.blog"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Make naman.blog a preferred source on Google"
        >
          <span class="preferred-google-mark" aria-hidden="true">G</span>
          <span>Prefer naman.blog on Google</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="quiet-contact" aria-label="Contact Naman">
      <p>Want to talk about something you’re building? <a href="mailto:contact@naman.blog?subject=Hello%20Naman">Email me</a>.</p>
      <p class="quiet-socials"><a href="https://x.com/namanlabs">X</a> · <a href="https://github.com/namanlabc/">GitHub</a> · <a href={`${base}rss.xml`}>RSS</a></p>
    </section>

    <p class="quiet-colophon">Mandla, India · <a href={`${base}about/`}>about</a> · <a href={`${base}experience/`}>experience</a></p>
  </article>
</Layout>

<style>
  .writing-actions {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    margin-top: 13px;
  }

  .writing-actions .quiet-more {
    margin: 0;
  }

  .quiet-home .preferred-source-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
  }

  .quiet-home .preferred-source-link:hover {
    color: var(--ink);
  }

  .quiet-home .preferred-source-link > span:nth-child(2) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .preferred-google-mark {
    display: grid;
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--rule) 82%, transparent);
    border-radius: 50%;
    background: #fff;
    color: #4285f4;
    font-family: Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
  }

  .quiet-socials {
    color: var(--muted);
    font-size: 14px;
  }

  @media (max-width: 640px) {
    :global(body:has(.quiet-home) .site-header) {
      min-height: 58px;
    }

    .quiet-intro {
      margin-bottom: 29px;
    }

    .quiet-prose {
      margin-top: 17px;
    }

    .quiet-prose p {
      margin-bottom: 10px;
    }

    .writing-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 11px;
      margin-top: 12px;
    }

    .quiet-home .preferred-source-link {
      font-size: 11.5px;
    }

    .quiet-contact {
      margin-top: 34px;
    }
  }
</style>
