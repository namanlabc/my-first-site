---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = (await getCollection('blog'))
 .sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf())
 .slice(0,5);

const work = [
 {name:'SmallMB', detail:'smallmb.com', description:'Photo and PDF tools for stubborn file limits.', type:'Android', status:'Live', href:'https://smallmb.com/', filter:'android'},
 {name:'GeoSpoof', detail:'Geotag photo editor', description:'Edit photo location, date, map stamps and EXIF data.', type:'Android', status:'Production', href:base+'projects/', filter:'android'},
 {name:'CatToy', detail:'A hunting game for cats', description:'A tiny interactive game built for curious paws.', type:'Android', status:'Production', href:base+'projects/', filter:'android'},
 {name:'Astro SEO Audit', detail:'namanlabc/astro-seo-audit', description:'Find SEO problems in the HTML an Astro site ships.', type:'Open source', status:'Live', href:'https://github.com/namanlabc/astro-seo-audit', filter:'open-source'},
 {name:'Get Random Letter', detail:'getrandomletter.com', description:'Small browser tools for letters, words and numbers.', type:'Web', status:'Live', href:'https://getrandomletter.com/', filter:'web'},
];

---
<Layout description="Software, stories and notes by Naman Patel.">
 <div class="directory-home">
  <section class="hero-grid" aria-labelledby="home-title">
   <div class="hero-identity">
    <h1 id="home-title">Naman<br />Patel<span>.</span></h1>
    <p class="hero-kicker">Software, stories &amp; other pursuits</p>
   </div>
   <p class="hero-copy">I build small tools and write about what I learn. Somewhere along the way, I started writing a world of my own.</p>

   <div class="hero-panel">
    <h2>Building now</h2>
    <a class="current-build" href={base+'projects/'}><span>SmallMB · GeoSpoof · CatToy</span><span aria-hidden="true">↗</span></a>
   </div>
   <div class="hero-panel hero-story">
    <h2>Away from code</h2>
    <a class="current-build" href="https://www.wattpad.com/story/416937465"><span>The Idiot God · a fantasy in progress</span><span aria-hidden="true">↗</span></a>
   </div>
  </section>

  <div class="directory-main">
   <section class="directory-section" aria-labelledby="work-heading">
    <h2 id="work-heading">Selected work</h2>
    <div class="directory-head" aria-hidden="true"><span>Project</span><span>What it does</span><span>State</span></div>
    <div class="directory-list" id="project-list">
     {work.map((item)=><a class="directory-row project-row" href={item.href}>
      <span class="row-primary"><span><strong>{item.name}</strong><small>{item.detail}</small></span></span>
      <span class="row-description">{item.description}</span><span class="row-status">{item.status}</span>
     </a>)}
    </div>
   </section>

   <section class="directory-section writing-directory" aria-labelledby="writing-heading">
    <div class="section-heading-line"><h2 id="writing-heading">Recent writing</h2><a href={base+'archive/'}>All writing ↗</a></div>
    <div class="writing-head" aria-hidden="true"><span>Date</span><span>Article</span><span>Read</span></div>
    <div class="directory-list" id="writing-list">
     {posts.map(post=><a class="writing-row" href={`${base}blog/${post.id}/`} data-search={`${post.data.title} ${post.data.description ?? ''} ${(post.data.tags ?? []).join(' ')}`}>
      <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US',{month:'short',day:'2-digit'})}</time><strong>{post.data.title}</strong><span aria-hidden="true">↗</span>
     </a>)}
    </div>
   </section>

   <section class="directory-section elsewhere" aria-labelledby="elsewhere-heading">
    <h2 id="elsewhere-heading">Writing elsewhere</h2>
    <a class="elsewhere-row" href="https://www.wattpad.com/story/416937465" target="_blank" rel="noopener noreferrer"><span><strong>The Idiot God</strong><small>A fantasy adventure I’m writing</small></span><span>In progress</span><span>Wattpad ↗</span></a>
   </section>
  </div>
 </div>
</Layout>
