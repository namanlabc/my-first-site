  .section{padding-top:120px;padding-bottom:120px}.section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:32px;margin-bottom:48px}.section-head p,.process-copy>p{margin:0 0 14px}.section-head h2,.process h2,.final-card h2{font-size:clamp(42px,5vw,70px);line-height:1;letter-spacing:-.055em;margin:0;color:#101113}.section-head>a{font-size:14px;color:#17181b;text-decoration:none;border-bottom:1px solid #c8c9c4;padding-bottom:3px}
  .project-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.project-card{background:#fff;border:1px solid #e6e6e0;border-radius:24px;overflow:hidden;box-shadow:0 12px 36px rgba(21,23,27,.045);transition:.25s ease}.project-card:hover{transform:translateY(-4px);box-shadow:0 18px 46px rgba(21,23,27,.075)}.project-visual{height:260px;position:relative;background:#f6f7f3;border-bottom:1px solid #ecece7;overflow:hidden}.project-card--2 .project-visual{background:#f3f6ff}.project-card--3 .project-visual{background:#f5f8ef}.project-card--4 .project-visual{background:#fff8ef}.project-copy{padding:27px 28px 29px}.project-top{display:flex;justify-content:space-between;gap:16px;margin-bottom:18px}.project-top span,.project-top em{font:700 10px 'Space Mono',monospace;letter-spacing:.06em;text-transform:uppercase}.project-top span{color:#73767a}.project-top em{font-style:normal;color:#1b9651;background:#ecfaf1;padding:5px 7px;border-radius:6px}.project-copy h3{font-size:30px;letter-spacing:-.035em;margin:0 0 9px}.project-copy p{color:#6a6d72;line-height:1.55;margin:0 0 22px}.project-copy a,.coming{font-size:13px;font-weight:700;color:#17181b;text-decoration:none}.compress-visual,.audit-visual,.wheel-visual,.page-visual{position:absolute;inset:0}.file{position:absolute;display:grid;place-items:center;border:3px solid #17181b;border-radius:9px;background:#fff;font:700 13px 'Space Mono',monospace;box-shadow:5px 5px 0 rgba(17,18,20,.08)}.file-a{width:104px;height:126px;left:74px;top:58px}.file-b{width:78px;height:96px;right:78px;top:78px;background:#f7e4c7}.compress-visual>span{position:absolute;left:48%;top:110px;font-size:32px;font-weight:700}.tiny-face{position:absolute;width:52px;height:58px;border:4px solid #17181b;border-radius:15px;bottom:26px}.tiny-face i{position:absolute;width:5px;height:8px;background:#17181b;top:22px}.tiny-face i:first-child{left:14px}.tiny-face i:last-child{right:14px}.tiny-face.orange{right:22px;background:#ffad5e}.tiny-face.blue{right:25px;background:#6689f1}.tiny-face.green{right:24px;background:#9bc768}.tiny-face.cream{right:26px;background:#f1e6b8}.audit-window{position:absolute;left:60px;top:47px;width:250px;height:158px;background:#fff;border:3px solid #17181b;border-radius:13px;box-shadow:8px 8px 0 #dce5ff}.audit-window>div{height:28px;border-bottom:2px solid #e7e7e2;display:flex;gap:5px;align-items:center;padding:0 9px}.audit-window>div i{width:6px;height:6px;border-radius:50%;background:#d5d6d1}.audit-window strong{display:block;font-size:58px;line-height:1;margin:28px 0 0 31px;color:#235fe8}.audit-window span{margin-left:33px;font:700 10px 'Space Mono',monospace;color:#777}.glass{position:absolute;width:79px;height:79px;border:8px solid #17181b;border-radius:50%;right:84px;top:70px}.glass:after{content:"";position:absolute;width:56px;height:8px;background:#17181b;right:-45px;bottom:-20px;transform:rotate(47deg);border-radius:8px}.letter-wheel{position:absolute;left:88px;top:44px;width:170px;height:170px;border-radius:50%;border:4px solid #17181b;background:conic-gradient(#7db5ff 0 25%,#ffd55a 25% 50%,#9ccb67 50% 75%,#ff9b58 75%);box-shadow:7px 7px 0 #dce6c9}.letter-wheel span{position:absolute;font:700 21px 'Space Mono',monospace}.letter-wheel span:nth-child(1){left:78px;top:15px}.letter-wheel span:nth-child(2){right:22px;top:73px}.letter-wheel span:nth-child(3){left:78px;bottom:15px}.letter-wheel span:nth-child(4){left:22px;top:73px}.pointer{position:absolute;left:248px;top:95px;width:30px;height:42px;background:#17181b;clip-path:polygon(100% 0,100% 100%,0 50%)}.mini-page{position:absolute;left:77px;top:42px;width:204px;height:168px;background:#fff;border:3px solid #17181b;border-radius:7px;box-shadow:8px 8px 0 #f4dfc7;padding:24px}.mini-page i{display:block;height:8px;border-radius:5px;background:#dedfd9;margin-bottom:13px}.mini-page i:first-child{width:55%;height:15px;background:#17181b}.mini-page i:nth-child(2){width:88%}.mini-page i:nth-child(3){width:70%}.mini-page i:nth-child(4){width:82%