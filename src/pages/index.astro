h:polygon(0 50%,45% 0,100% 20%,78% 75%,35% 100%)}.laptop>span{position:absolute;left:0;right:0;bottom:15px;height:18px;background:#66696f;border:5px solid #17181b;border-radius:4px}.cursor-shape{position:absolute;right:36px;top:38px;width:42px;height:54px;background:#28c96a;clip-path:polygon(0 0,100% 58%,59% 65%,48% 100%,35% 94%,45% 66%,0 78%);filter:drop-shadow(2px 2px 0 #151619);transform:rotate(-8deg)}
