  .hero-scene{position:relative;min-height:500px}.status-chip{position:absolute;right:10px;top:22px;display:flex;align-items:center;gap:8px;background:#24c665;color:#083317;padding:10px 14px;border-radius:999px;font:700 12px/1 'Space Mono',monospace;box-shadow:0 8px 24px rgba(36,198,101,.16)}.status-chip i{width:7px;height:7px;border-radius:50%;background:#fff}.status-chip b{display:grid;place-items:center;width:18px;height:18px;border-radius:50%;background:#fff;color:#24a958}.float-note{position:absolute;left:20px;top:78px;background:#fff;border:1px solid #e7e7e1;border-radius:16px;padding:13px 15px;transform:rotate(-2deg);box-shadow:0 12px 30px rgba(20,22,25,.06)}.float-note small{display:block;font:700 9px 'Space Mono',monospace;color:#a0a1a4;margin-bottom:5px}.float-note strong{font-size:14px;line-height:1.25}
