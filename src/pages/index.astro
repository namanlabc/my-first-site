---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectPoster from '../components/ProjectPoster.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WritingItem from '../components/WritingItem.astro';
import { projects } from '../data/projects';

const posts = await getCollection('blog');
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout>
  <section class="home-hero shell shell--wide" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <h1 id="home-title">Hi, I’m Naman.</h1>
      <p class="home-hero__intro">
        I work on SEO, build websites and useful tools, and write about what I learn while making them.
      </p>
      <p class="home-hero__aside">
        Most of it starts with me wondering, “could I make this better?” Then I disappear into it for a while.
      </p>
    </div>
    <aside class="home-now" aria-label="What Naman is doing now">
      <span>Right now</span>
      <p>Improving Get Random Letter, shipping SmallMB, and figuring out what Astro SEO Audit should catch next.</p>
      <div>
        <a href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer">X ↗</a>
        <a href={`${base}about/`}>About me →</a>
      </div>
    </aside>
  </section>

  <section class="home-projects shell shell--wide" aria-labelledby="selected-work-title">
    <SectionHeading
      id="selected-work-title"
      title="What I’m working on"
      href={`${base}projects/`}
      linkLabel="All projects"
    />
    <div class="project-poster-grid">
      {projects.map((project) => <ProjectPoster project={project} />)}
    </div>
  </section>

  <section class="home-experience page-section shell shell--wide" aria-labelledby="home-experience-title">
    <SectionHeading
      id="home-experience-title"
      title="A few things I’m good at"
      description="Most of what I know came from doing the work, watching what happened, and getting better at the parts that mattered."
      href={`${base}experience/`}
      linkLabel="My experience"
    />

    <div class="experience-preview-grid">
      <article class="experience-preview experience-preview--search">
        <div class="experience-preview__art" aria-hidden="true">
          <div class="search-paper">
            <small>SEARCH / CONTENT</small>
            <strong>Find the useful<br />thing people want.</strong>
            <div class="search-lines"><i></i><i></i><i></i></div>
            <span class="search-mark">↗</span>
          </div>
        </div>
        <div class="experience-preview__copy">
          <span>01</span>
          <h3>SEO & content</h3>
          <p>Research, search strategy, content structure, on-page work, and figuring out what the numbers are actually saying.</p>
        </div>
      </article>

      <article class="experience-preview experience-preview--build">
        <div class="experience-preview__art" aria-hidden="true">
          <div class="build-board">
            <div class="build-board__bar"><i></i><i></i><i></i><span>build</span></div>
            <strong>idea → page → product</strong>
            <div class="build-blocks"><i></i><i></i><i></i></div>
            <b>ship it.</b>
          </div>
        </div>
        <div class="experience-preview__copy">
          <span>02</span>
          <h3>Product & web</h3>
          <p>Turning an idea into something usable, from the structure and interface to the awkward last ten percent before it feels finished.</p>
        </div>
      </article>

      <article class="experience-preview experience-preview--workflow">
        <div class="experience-preview__art" aria-hidden="true">
          <div class="workflow-notes">
            <div><small>RESEARCH</small><strong>Understand it.</strong></div>
            <div><small>MAKE</small><strong>Build the thing.</strong></div>
            <div><small>REFINE</small><strong>Make it better.</strong></div>
          </div>
        </div>
        <div class="experience-preview__copy">
          <span>03</span>
          <h3>Tools & workflow</h3>
          <p>I’m comfortable moving between research, writing, publishing, code, and whatever tool makes the next part easier.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="page-section page-section--writing shell shell--wide" aria-labelledby="recent-writing-title">
    <SectionHeading
      id="recent-writing-title"
      title="Recent writing"
      description="I write when I learn something worth remembering—or when an opinion refuses to leave me alone."
      href={`${base}archive/`}
      linkLabel="Full archive"
    />
    <div class="writing-list">
      {recentPosts.map((post) => (
        <WritingItem
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          href={`${base}blog/${post.id}/`}
          tags={post.data.tags}
        />
      ))}
    </div>
  </section>

  <section class="now-note shell shell--wide" aria-labelledby="now-title">
    <div>
      <h2 id="now-title">Away from the keyboard</h2>
      <p>
        If I’m not building something, I’m probably watching <em>One Piece</em>, drinking chai, or telling myself I’ll stop after one more chapter.
      </p>
    </div>
    <a class="arrow-link" href={`${base}about/#off-screen`}>More about me <span aria-hidden="true">→</span></a>
  </section>
</Layout>

<style>
  .home-experience {
    border-top: 1px solid var(--rule);
  }

  .experience-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.7rem);
  }

  .experience-preview {
    min-width: 0;
  }

  .experience-preview__art {
    position: relative;
    aspect-ratio: 1.08;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
  }

  .experience-preview--search .experience-preview__art { background: #f2d74f; }
  .experience-preview--build .experience-preview__art { background: #8fcfc1; }
  .experience-preview--workflow .experience-preview__art { background: #8da8e8; }

  .experience-preview__copy {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.2rem 0.8rem;
    padding-top: 0.9rem;
  }

  .experience-preview__copy > span {
    grid-row: 1 / span 2;
    padding-top: 0.2rem;
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.62rem;
  }

  .experience-preview__copy h3 {
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .experience-preview__copy p {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .search-paper {
    position: absolute;
    inset: 12% 10%;
    padding: clamp(0.9rem, 2.4vw, 1.35rem);
    border: 1px solid #22231f;
    background: #f8f1d8;
    box-shadow: 0.8rem 0.8rem 0 #ff7658;
    transform: rotate(-2deg);
  }

  .search-paper small,
  .workflow-notes small {
    font-family: var(--mono);
    font-size: clamp(0.48rem, 0.8vw, 0.6rem);
    letter-spacing: 0.08em;
  }

  .search-paper strong {
    display: block;
    margin-top: 14%;
    font-family: var(--reading);
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .search-lines {
    margin-top: 1.2rem;
  }

  .search-lines i {
    display: block;
    width: 82%;
    height: 1px;
    margin-top: 0.55rem;
    background: #9e9b8f;
  }

  .search-lines i:nth-child(2) { width: 65%; }
  .search-lines i:nth-child(3) { width: 74%; }

  .search-mark {
    position: absolute;
    right: 10%;
    bottom: 8%;
    color: #d64e37;
    font-size: 1.6rem;
    font-weight: 700;
  }

  .build-board {
    position: absolute;
    inset: 12% 9%;
    padding: 0 1rem 1rem;
    border: 1px solid #12362e;
    color: #dff5eb;
    background: #173b32;
    box-shadow: 0.8rem 0.8rem 0 #ff7658;
    transform: rotate(1.5deg);
  }

  .build-board__bar {
    height: 2.2rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    border-bottom: 1px solid #41665c;
  }

  .build-board__bar i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: #8ab2a7;
  }

  .build-board__bar span {
    margin-left: auto;
    color: #8ab2a7;
    font-family: var(--mono);
    font-size: 0.55rem;
  }

  .build-board strong {
    display: block;
    margin-top: 1.1rem;
    font-family: var(--mono);
    font-size: clamp(0.65rem, 1.2vw, 0.85rem);
    font-weight: 500;
  }

  .build-blocks {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .build-blocks i {
    min-height: 2.2rem;
    border: 1px solid #6c9488;
    background: #245046;
  }

  .build-blocks i:first-child {
    grid-row: span 2;
  }

  .build-board b {
    display: block;
    margin-top: 0.9rem;
    color: #ff9c87;
    font-family: var(--reading);
    font-size: clamp(1rem, 2vw, 1.4rem);
    font-weight: 400;
  }

  .workflow-notes {
    position: absolute;
    inset: 10%;
    color: #1b1c20;
  }

  .workflow-notes > div {
    position: relative;
    padding: clamp(0.8rem, 2vw, 1.1rem);
    border: 1px solid #1b1c20;
    background: #f3eedc;
  }

  .workflow-notes > div:nth-child(1) { width: 88%; transform: rotate(-3deg); }
  .workflow-notes > div:nth-child(2) { width: 82%; margin: -0.3rem 0 0 auto; background: #ff7c5f; transform: rotate(2deg); }
  .workflow-notes > div:nth-child(3) { width: 90%; margin-top: -0.25rem; transform: rotate(-1deg); }

  .workflow-notes strong {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--reading);
    font-size: clamp(1rem, 2vw, 1.45rem);
    font-weight: 400;
    line-height: 1;
  }

  @media (max-width: 860px) {
    .experience-preview-grid {
      grid-template-columns: 1fr;
    }

    .experience-preview__art {
      aspect-ratio: 1.55;
    }
  }

  @media (max-width: 520px) {
    .experience-preview__art {
      aspect-ratio: 1.18;
    }
  }
</style>
