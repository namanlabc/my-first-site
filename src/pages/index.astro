---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectItem from '../components/ProjectItem.astro';
import RouteMap from '../components/RouteMap.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WritingItem from '../components/WritingItem.astro';
import { projects } from '../data/projects';

const posts = await getCollection('blog');
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout>
  <section class="home-hero shell shell--wide" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <h1 id="home-title">I’m Naman. I keep building things to see how far an <span class="home-hero__trail-word">idea can go.</span></h1>
      <p class="home-hero__intro">
        Usually it starts with one small annoyance or a random thought. Then I’m opening too many tabs, testing AI, checking search data, fixing CSS—and somehow there’s a new website.
      </p>
    </div>
    <RouteMap />
  </section>

  <div class="home-dispatch" aria-label="Current dispatch">
    <div class="shell shell--wide home-dispatch__inner">
      <strong>Current dispatch</strong>
      <span>Adding more useful tools to Get Random Letter and slowly shaping Calm WP into a theme I’d actually want to use.</span>
      <span class="home-dispatch__stamp">now / making</span>
    </div>
  </div>

  <section class="page-section shell shell--wide" aria-labelledby="selected-work-title">
    <SectionHeading
      id="selected-work-title"
      title="Things I’m making"
      description="The websites, tools, and experiments I’m actually spending my time on."
      href={`${base}projects/`}
      linkLabel="All projects"
    />
    <div class="project-list">
      {projects.map((project) => <ProjectItem project={project} />)}
    </div>
  </section>

  <section class="page-section page-section--writing shell shell--wide" aria-labelledby="recent-writing-title">
    <SectionHeading
      id="recent-writing-title"
      title="Recent writing"
      description="I write when I learn something worth remembering—or when an opinion refuses to leave me alone."
      href={`${base}archive/`}
      linkLabel="Full archive"
    />
    <div class="writing-list">
      {recentPosts.map((post) => (
        <WritingItem
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          href={`${base}blog/${post.id}/`}
          tags={post.data.tags}
        />
      ))}
    </div>
  </section>

  <section class="now-note shell shell--wide" aria-labelledby="now-title">
    <div>
      <h2 id="now-title">Away from the keyboard</h2>
      <p>
        If I’m not building something, I’m probably watching <em>One Piece</em>, drinking chai, or telling myself I’ll stop after one more chapter.
      </p>
    </div>
    <a class="arrow-link" href={`${base}about/#off-screen`}>More about me <span aria-hidden="true">→</span></a>
  </section>
</Layout>
