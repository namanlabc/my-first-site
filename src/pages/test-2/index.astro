---
import { getCollection } from 'astro:content';
import { projects } from '../../data/projects';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const projectHref = (project: (typeof projects)[number]) => {
  if (!project.href) return `${base}projects/`;
  if (project.href.startsWith('/')) return `${base}${project.href.replace(/^\//, '')}`;
  return project.href;
};

const smallmb = projects.find((project) => project.visual === 'smallmb') ?? projects[0];
const audit = projects.find((project) => project.visual === 'audit') ?? projects[1];
const wheel = projects.find((project) => project.visual === 'wheel') ?? projects[2];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#17131d" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>One More Night · Naman Patel</title>
    <meta
      name="description"
      content="One night inside Naman Patel's world — ideas, building, search, experiments, writing, and sunrise."
    />
  </head>

  <body data-time="dusk">
    <header class="night-nav">
      <a class="night-mark" href="#dusk" aria-label="One More Night home">
        <b>NP</b>
        <span>ONE MORE NIGHT</span>
      </a>
      <div class="night-clock" aria-live="polite">
        <i></i>
        <span data-clock>6:47 PM</span>
      </div>
      <div class="night-links">
        <a href={`${base}test/`}>test 01</a>
        <a href={`${base}`}>real site ↗</a>
      </div>
    </header>

    <main class="night-shell">
      <aside class="room-column" aria-label="An illustrated room changing through one night">
        <div class="room-frame" data-room data-state="dusk">
          <div class="room-grain" aria-hidden="true"></div>
          <div class="wall-shadow" aria-hidden="true"></div>

          <div class="window" aria-hidden="true">
            <div class="sky"></div>
            <div class="moon"></div>
            <div class="cloud cloud--one"></div>
            <div class="cloud cloud--two"></div>
            <div class="city">
              <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
            </div>
          </div>

          <div class="pinboard" aria-hidden="true">
            <span class="pinboard__label">things worth remembering</span>
            <div class="pin-note pin-note--why">could I make<br /><b>this better?</b></div>
            <div class="pin-note pin-note--ship">small → useful → ship</div>
            <div class="pin-note pin-note--search">intent ≠ keywords</div>
            <div class="pin-note pin-note--fall">do not redesign<br />the site again</div>
            <div class="pin-line pin-line--a"></div>
            <div class="pin-line pin-line--b"></div>
          </div>

          <div class="shelf" aria-hidden="true">
            <div class="book book--one"><span>ASTRO</span></div>
            <div class="book book--two"><span>SEARCH</span></div>
            <button class="book book--op secret-trigger" type="button" data-secret="chapter" aria-label="Inspect the small book"><span>OP</span></button>
            <div class="plant"><i></i><i></i><i></i></div>
          </div>

          <div class="lamp" aria-hidden="true">
            <div class="lamp__shade"></div>
            <div class="lamp__stem"></div>
            <div class="lamp__light"></div>
          </div>

          <div class="desk" aria-hidden="true"></div>
          <div class="desk-edge" aria-hidden="true"></div>

          <div class="monitor">
            <div class="monitor__body">
              <div class="monitor__camera"></div>
              <div class="screen">
                <div class="screen-scene screen-scene--dusk">
                  <span class="screen-kicker">notes.txt</span>
                  <strong>could I make<br />this better?</strong>
                  <small>_</small>
                </div>

                <div class="screen-scene screen-scene--ideas">
                  <span class="screen-kicker">rough ideas / unsorted</span>
                  <ul>
                    <li>compress files properly</li>
                    <li>yoast-ish audit for astro</li>
                    <li>random letter → more tools?</li>
                    <li><s>definitely sleep early</s></li>
                  </ul>
                </div>

                <div class="screen-scene screen-scene--build">
                  <span class="screen-kicker">smallmb / preview</span>
                  <div class="phone-preview">
                    <span>PHOTO.JPG</span>
                    <s>12.4 MB</s>
                    <b>842 KB</b>
                    <i>compress</i>
                  </div>
                </div>

                <div class="screen-scene screen-scene--midnight">
                  <span class="screen-kicker">naman@night:~</span>
                  <code>$ npx astro-seo-audit</code>
                  <p><b>✓</b> title + description</p>
                  <p><b>✓</b> canonical</p>
                  <p><b>✓</b> schema</p>
                  <p><em>!</em> 3 things still annoying me</p>
                  <strong>92 / 100</strong>
                </div>

                <div class="screen-scene screen-scene--weird">
                  <span class="screen-kicker">probably_not_a_good_idea/</span>
                  <div class="agent-map">
                    <b>idea</b><i></i><b>atlas</b><i></i><b>build</b><i></i><b>qa</b><i></i><b>ship?</b>
                  </div>
                  <small>status: suspiciously alive</small>
                </div>

                <div class="screen-scene screen-scene--wall">
                  <span class="screen-kicker">search console / 03:48</span>
                  <div class="mini-chart"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                  <p>the graph moved.</p>
                  <small>now figure out why.</small>
                </div>

                <div class="screen-scene screen-scene--writing">
                  <span class="screen-kicker">draft.md</span>
                  <strong>Writing is mostly<br />thinking slowly.</strong>
                  <p>And occasionally deleting the sentence I liked most.</p>
                </div>

                <div class="screen-scene screen-scene--first-light">
                  <span class="screen-kicker">05:39 / still here</span>
                  <div class="soft-list">
                    <span>SmallMB <b>launching</b></span>
                    <span>Get Random Letter <b>live</b></span>
                    <span>Astro SEO Audit <b>open source</b></span>
                  </div>
                </div>

                <div class="screen-scene screen-scene--ship">
                  <span class="screen-kicker">git / main</span>
                  <code>$ git push</code>
                  <strong>good enough to ship.</strong>
                  <p>main ← deployed</p>
                </div>

                <div class="screen-scene screen-scene--sunrise">
                  <span class="screen-kicker">06:24</span>
                  <strong>see you tonight.</strong>
                  <small>Naman Patel</small>
                </div>
              </div>
            </div>
            <div class="monitor__neck"></div>
            <div class="monitor__foot"></div>
          </div>

          <div class="keyboard" aria-hidden="true">
            {Array.from({ length: 19 }).map(() => <i></i>)}
          </div>

          <button class="mug secret-trigger" type="button" data-secret="chai" aria-label="Inspect the chai mug">
            <span class="steam steam--one"></span>
            <span class="steam steam--two"></span>
            <b>one<br />more</b>
          </button>

          <button class="wheel-object secret-trigger" type="button" data-secret="wheel" aria-label="Spin the small wheel on the desk">
            <span>A</span><span>G</span><span>M</span><span>R</span><b>•</b>
          </button>

          <div class="phone-object" aria-hidden="true"><span>01:17</span></div>
          <div class="cable" aria-hidden="true"></div>

          <button class="crumple secret-trigger" type="button" data-secret="bad-idea" aria-label="Open the crumpled note">?</button>

          <button class="drawer secret-trigger" type="button" data-secret="drawer" aria-label="Open the desk drawer">
            <span></span>
          </button>

          <button class="tiny-bug secret-trigger" type="button" data-secret="bug" aria-label="Inspect the tiny bug">•</button>

          <div class="paper-stack" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>

          <div class="sunbeam" aria-hidden="true"></div>
          <div class="dust" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>

          <div class="room-caption">
            <span data-room-time>6:47 PM</span>
            <b data-room-note>the room is still warm from the day.</b>
          </div>
        </div>
      </aside>

      <div class="story-column">
        <section class="chapter chapter--opening" id="dusk" data-scene="dusk" data-time="6:47 PM" data-note="the room is still warm from the day.">
          <div class="chapter-copy">
            <span class="chapter-time">6:47 PM</span>
            <p class="chapter-whisper">The sun has almost left.</p>
            <h1>Still awake.</h1>
            <p class="chapter-lede">
              Most things I make begin here: one ordinary evening, one small irritation, and the thought that maybe I could make it better.
            </p>
            <p>
              No grand plan. Usually just chai, too many tabs, and enough curiosity to ruin a perfectly reasonable bedtime.
            </p>
            <a class="continue" href="#ideas">stay for a while ↓</a>
          </div>
        </section>

        <section class="chapter" id="ideas" data-scene="ideas" data-time="8:26 PM" data-note="the notebook has started winning the argument.">
          <div class="chapter-copy chapter-copy--paper">
            <span class="chapter-time">8:26 PM</span>
            <p class="chapter-whisper">Nothing is a project yet.</p>
            <h2>Just scraps.</h2>
            <div class="idea-scraps">
              <span>compress files properly?</span>
              <span>yoast, but for Astro?</span>
              <span>random letter → maybe more tools</span>
              <span><s>sleep before 11</s> lol</span>
            </div>
            <p>
              I like this part because the ideas are still ugly enough to be honest. Some survive. Most deserve what happens to the crumpled paper on the desk.
            </p>
            <button class="inline-secret" type="button" data-secret="bad-idea">read the rejected one →</button>
          </div>
        </section>

        <section class="chapter" id="build" data-scene="build" data-time="10:14 PM" data-note="the lamp is doing most of the lighting now.">
          <div class="chapter-copy">
            <span class="chapter-time">10:14 PM</span>
            <p class="chapter-whisper">One idea stopped being hypothetical.</p>
            <h2>The useful little thing.</h2>
            <p>
              SmallMB began with a boring problem: make files smaller without turning the whole thing into a ceremony.
            </p>
            <a class="project-line" href={projectHref(smallmb)}>
              <span><b>{smallmb.name}</b><small>{smallmb.kind} · {smallmb.status}</small></span>
              <em>12.4 MB → 842 KB</em>
              <i>↗</i>
            </a>
            <p>
              The satisfying part isn't the feature list. It's watching a rough sketch become something I can actually tap on a phone.
            </p>
          </div>
        </section>

        <section class="chapter" id="midnight" data-scene="midnight" data-time="12:03 AM" data-note="the chai is colder. the terminal is brighter.">
          <div class="chapter-copy chapter-copy--terminal">
            <span class="chapter-time">12:03 AM</span>
            <p class="chapter-whisper">Midnight removes the decorative work.</p>
            <h2>Now fix it.</h2>
            <p>
              This is when I stop admiring the idea and start asking annoying questions: does it actually work, does search understand it, what breaks on a smaller screen, what did I forget?
            </p>
            <a class="project-line project-line--dark" href={projectHref(audit)} target={audit.external ? '_blank' : undefined} rel={audit.external ? 'noopener noreferrer' : undefined}>
              <span><b>{audit.name}</b><small>{audit.kind} · {audit.status}</small></span>
              <em>check the HTML we really shipped</em>
              <i>↗</i>
            </a>
            <p class="tiny-aside">There is also a bug in the room. Literally.</p>
          </div>
        </section>

        <section class="chapter" id="weird" data-scene="weird" data-time="2:37 AM" data-note="after two, even the sticky notes stop obeying physics.">
          <div class="chapter-copy">
            <span class="chapter-time">2:37 AM</span>
            <p class="chapter-whisper">The weird hours.</p>
            <h2>Ideas become less supervised.</h2>
            <p>
              Agents, prototypes, overcomplicated workflows, games, tiny utilities, things nobody requested — this is the hour where I let bad ideas prove whether they're actually bad.
            </p>
            <div class="folder-list">
              <button type="button" data-secret="drawer">probably_not_a_good_idea/</button>
              <span>atlas_is_doing_something/</span>
              <span>works_on_my_phone/</span>
              <span>ship_anyway/</span>
            </div>
            <p>
              Some experiments become real products. Some disappear. A few stay around purely because they make me laugh.
            </p>
          </div>
        </section>

        <section class="chapter" id="wall" data-scene="wall" data-time="3:48 AM" data-note="the wall knows more about the work than a skills section ever could.">
          <div class="chapter-copy">
            <span class="chapter-time">3:48 AM</span>
            <p class="chapter-whisper">Look away from the monitor.</p>
            <h2>The wall keeps receipts.</h2>
            <p>
              Search graphs, schema notes, Android sketches, release reminders, Astro, WordPress, GitHub, model routing — I'd rather show the evidence than write “I know tools” in a neat row of logos.
            </p>
            <div class="evidence-strip">
              <span>SEARCH INTENT</span><span>GSC</span><span>ASTRO</span><span>SCHEMA</span><span>ANDROID</span><span>GITHUB</span><span>CLAUDE</span><span>CODEX</span><span>OPENCODE</span>
            </div>
            <blockquote>“Traffic going up is fun until you have to figure out why.”</blockquote>
          </div>
        </section>

        <section class="chapter" id="writing" data-scene="writing" data-time="4:41 AM" data-note="everything is quiet enough for sentences now.">
          <div class="chapter-copy">
            <span class="chapter-time">4:41 AM</span>
            <p class="chapter-whisper">The quiet hour.</p>
            <h2>Things I wrote before I forgot them.</h2>
            <div class="writing-papers">
              {posts.map((post, index) => (
                <a class:list={['writing-paper', `writing-paper--${index + 1}`]} href={`${base}blog/${post.id}/`}>
                  <small>field note / 0{index + 1}</small>
                  <b>{post.data.title}</b>
                  <p>{post.data.description}</p>
                </a>
              ))}
            </div>
            <p class="tiny-aside">Writing usually happens when I should probably be sleeping.</p>
          </div>
        </section>

        <section class="chapter" id="first-light" data-scene="first-light" data-time="5:39 AM" data-note="blue light is sneaking in around the curtains.">
          <div class="chapter-copy">
            <span class="chapter-time">5:39 AM</span>
            <p class="chapter-whisper">You notice it late.</p>
            <h2>The room starts returning.</h2>
            <p>
              Morning light reveals the parts that didn't matter to the work but matter to the person doing it: the books, the forgotten cable, the ridiculous note on the wall, the chapter I definitely said would be the last one.
            </p>
            <button class="inline-secret" type="button" data-secret="chapter">inspect that suspicious little book →</button>
          </div>
        </section>

        <section class="chapter" id="ship" data-scene="ship" data-time="6:11 AM" data-note="finished things look surprisingly ordinary in daylight.">
          <div class="chapter-copy">
            <span class="chapter-time">6:11 AM</span>
            <p class="chapter-whisper">No confetti.</p>
            <h2>Good enough to ship.</h2>
            <p>
              The nicest moment is rarely dramatic. Something that didn't exist yesterday now exists, works, and can leave the room without me.
            </p>
            <div class="ship-shelf">
              {projects.map((project) => (
                <a href={projectHref(project)} target={project.external ? '_blank' : undefined} rel={project.external ? 'noopener noreferrer' : undefined}>
                  <span><b>{project.name}</b><small>{project.kind}</small></span>
                  <em>{project.status}</em>
                </a>
              ))}
            </div>
          </div>
        </section>

        <section class="chapter chapter--sunrise" id="sunrise" data-scene="sunrise" data-time="6:24 AM" data-note="the lamp finally isn't needed anymore.">
          <div class="chapter-copy">
            <span class="chapter-time">6:24 AM</span>
            <p class="chapter-whisper">Sunrise.</p>
            <h2>Naman Patel.</h2>
            <p class="chapter-lede">
              I build things for the web, work on search, experiment with software, and write down what I learn while making them.
            </p>
            <div class="sunrise-links">
              <a href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
              <a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer">X ↗</a>
              <a href={`${base}about/`}>About →</a>
            </div>
            <p class="goodnight">see you tonight.</p>
          </div>
        </section>
      </div>
    </main>

    <div class="secret" data-secret-popover hidden>
      <button type="button" data-secret-close aria-label="Close">×</button>
      <div data-secret-content></div>
    </div>

    <div class="zehaha" data-zehaha aria-hidden="true">zehahahaha</div>

    <script>
      const room = document.querySelector('[data-room]');
      const clock = document.querySelector('[data-clock]');
      const roomTime = document.querySelector('[data-room-time]');
      const roomNote = document.querySelector('[data-room-note]');
      const chapters = Array.from(document.querySelectorAll('[data-scene]'));
      const popover = document.querySelector('[data-secret-popover]');
      const popoverContent = document.querySelector('[data-secret-content]');
      const closeSecret = document.querySelector('[data-secret-close]');
      const zehaha = document.querySelector('[data-zehaha]');

      const secretCopy = {
        chai: '<small>THE MUG</small><strong>one more chai</strong><p>It starts steaming at sunset. By midnight it is absolutely not warm anymore. I keep drinking it anyway.</p>',
        wheel: '<small>DESK TOY / ESCAPED PROJECT</small><strong>Get Random Letter</strong><p>This was supposed to be one tiny wheel. That sentence aged badly.</p>',
        'bad-idea': '<small>REJECTED / 9:13 PM</small><strong>“AI-powered motivational wallpaper generator”</strong><p>No. Absolutely not. Back into the paper ball.</p>',
        drawer: '<small>DRAWER / DO NOT ORGANIZE</small><strong>probably_not_a_good_idea/</strong><p>draw-to-unlock · pen fight · weird games · half-built utilities · things that may return at 2:37 AM</p>',
        bug: '<small>BUG #000</small><strong>Not that kind of bug.</strong><p>This one is allowed to stay.</p>',
        chapter: '<small>BOOKMARK</small><strong>“one more chapter”</strong><p>A statement with a historically terrible success rate.</p>'
      };

      const setScene = (chapter) => {
        if (!chapter || !room) return;
        const scene = chapter.dataset.scene;
        const time = chapter.dataset.time;
        const note = chapter.dataset.note;
        room.dataset.state = scene;
        document.body.dataset.time = scene;
        if (clock) clock.textContent = time || '';
        if (roomTime) roomTime.textContent = time || '';
        if (roomNote) roomNote.textContent = note || '';
      };

      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setScene(visible.target);
      }, { threshold: [0.35, 0.5, 0.7] });

      chapters.forEach((chapter) => observer.observe(chapter));

      const openSecret = (name) => {
        if (!popover || !popoverContent || !secretCopy[name]) return;
        popoverContent.innerHTML = secretCopy[name];
        popover.hidden = false;
        requestAnimationFrame(() => popover.classList.add('is-open'));
      };

      document.querySelectorAll('[data-secret]').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const name = trigger.dataset.secret;
          if (name === 'wheel') {
            document.querySelector('.wheel-object')?.classList.add('is-spinning');
            setTimeout(() => document.querySelector('.wheel-object')?.classList.remove('is-spinning'), 900);
          }
          openSecret(name);
        });
      });

      closeSecret?.addEventListener('click', () => {
        popover?.classList.remove('is-open');
        setTimeout(() => { if (popover) popover.hidden = true; }, 180);
      });

      let zCount = 0;
      window.addEventListener('keydown', (event) => {
        if (event.key.toLowerCase() !== 'z') return;
        zCount += 1;
        clearTimeout(window.__zTimer);
        window.__zTimer = setTimeout(() => { zCount = 0; }, 900);
        if (zCount >= 3 && zehaha) {
          zehaha.classList.add('is-visible');
          setTimeout(() => zehaha.classList.remove('is-visible'), 1600);
          zCount = 0;
        }
      });
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    --ink: #f2eee5;
    --muted: #b6ad9f;
    --faint: #777063;
    --line: rgba(255,255,255,.11);
    --paper: #e9ddc7;
    --paper-ink: #2b241e;
    --amber: #e7a365;
    --amber-soft: #ffd09a;
    --blue: #7f96c8;
    --night: #17131d;
    --room-w: min(56vw, 780px);
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    --sans: Inter, Geist, "Segoe UI", system-ui, sans-serif;
    --serif: Georgia, Cambria, "Times New Roman", serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: #141118; }
  body {
    margin: 0;
    min-width: 20rem;
    color: var(--ink);
    background: #141118;
    font-family: var(--sans);
    line-height: 1.6;
    overflow-x: hidden;
    transition: background 900ms ease;
  }

  body[data-time="dusk"] { background: #211721; }
  body[data-time="ideas"] { background: #1b151f; }
  body[data-time="build"] { background: #16141d; }
  body[data-time="midnight"] { background: #10121a; }
  body[data-time="weird"] { background: #0e1018; }
  body[data-time="wall"] { background: #0d1018; }
  body[data-time="writing"] { background: #10131c; }
  body[data-time="first-light"] { background: #171c2a; }
  body[data-time="ship"] { background: #252839; }
  body[data-time="sunrise"] { background: #6f7180; }

  button, a { font: inherit; }
  a { color: inherit; }
  button { color: inherit; }

  .night-nav {
    position: fixed;
    z-index: 50;
    top: 0;
    right: 0;
    left: 0;
    min-height: 4rem;
    padding: .75rem clamp(1rem, 2.5vw, 2rem);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid rgba(255,255,255,.07);
    background: color-mix(in srgb, #0d0d11 72%, transparent);
    backdrop-filter: blur(16px);
  }

  .night-mark,
  .night-links,
  .night-clock {
    font-family: var(--mono);
    font-size: .62rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .night-mark {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    text-decoration: none;
  }

  .night-mark b {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  .night-mark span { color: var(--muted); }

  .night-clock {
    display: flex;
    align-items: center;
    gap: .45rem;
    color: var(--muted);
  }

  .night-clock i {
    width: .4rem;
    height: .4rem;
    border-radius: 50%;
    background: #eaa878;
    box-shadow: 0 0 .8rem rgba(234,168,120,.6);
    animation: pulse 2.4s ease-in-out infinite;
  }

  .night-links {
    justify-self: end;
    display: flex;
