---
import { getCollection } from 'astro:content';
import { projects } from '../../data/projects';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const projectHref = (project: (typeof projects)[number]) => {
  if (!project.href) return `${base}projects/`;
  if (project.href.startsWith('/')) return `${base}${project.href.replace(/^\//, '')}`;
  return project.href;
};

const smallmb = projects.find((project) => project.visual === 'smallmb') ?? projects[0];
const audit = projects.find((project) => project.visual === 'audit') ?? projects[1];
const wheel = projects.find((project) => project.visual === 'wheel') ?? projects[2];

const chapters = [
  { time: '6:47 PM', title: 'Still awake.', copy: 'One ordinary evening. One small irritation. One thought that maybe I could make it better.' },
  { time: '8:26 PM', title: 'The notebook opens.', copy: 'Before anything becomes a project, it is usually just a sentence with too many arrows around it.' },
  { time: '10:14 PM', title: 'Now it has a screen.', copy: 'The idea stops being theoretical. SmallMB starts as a useful little phone tool, not a pitch deck.' },
  { time: '12:03 AM', title: 'Midnight checks.', copy: 'The room gets quieter. The work gets less romantic: HTML, schema, broken details, things that actually have to pass.' },
  { time: '2:37 AM', title: 'The weird hours.', copy: 'This is when experiments multiply and the drawer labelled “probably not a good idea” becomes suspiciously important.' },
  { time: '3:48 AM', title: 'The wall remembers.', copy: 'Search graphs, release notes, Android scraps, agent routes. Skills look better as evidence than badges.' },
  { time: '4:41 AM', title: 'Quiet enough to write.', copy: 'The monitor dims. Pages come out. Writing is just another way of leaving breadcrumbs for tomorrow.' },
  { time: '5:39 AM', title: 'First light.', copy: 'The room slowly gives back details the night was hiding.' },
  { time: '6:11 AM', title: 'Good enough to ship.', copy: 'Not perfect. Real. That is usually the more useful state.' },
  { time: '6:24 AM', title: 'See you tonight.', copy: 'Naman Patel — building, search, experiments, notes, and a desk that is never quite clean.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#17131d" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>One More Night · Naman Patel</title>
    <meta name="description" content="One continuous night inside Naman Patel's room — ideas, building, search, experiments, writing, and sunrise." />
  </head>

  <body data-scene="0">
    <header class="nightbar">
      <a class="nightbar__brand" href="#chapter-0"><span>NP</span><small>ONE MORE NIGHT</small></a>
      <div class="nightbar__time"><i></i><span data-clock>6:47 PM</span></div>
      <div class="nightbar__links"><a href={`${base}test/`}>TEST 01</a><a href={`${base}`}>REAL SITE ↗</a></div>
    </header>

    <div class="progress" aria-hidden="true"><span data-progress></span></div>

    <main class="night" data-night>
      <div class="world" data-world aria-label="An illustrated room changing through one night">
        <div class="room-grain" aria-hidden="true"></div>
        <div class="wall-glow" aria-hidden="true"></div>

        <section class="window" aria-label="Window looking outside">
          <div class="sky"></div>
          <div class="moon"></div>
          <div class="sun"></div>
          <div class="cloud cloud--a"></div>
          <div class="cloud cloud--b"></div>
          <div class="city city--far"></div>
          <div class="city city--near"></div>
          <div class="passing-light"></div>
          <div class="window-frame window-frame--v"></div>
          <div class="window-frame window-frame--h"></div>
        </section>

        <section class="shelf" aria-label="Shelf with books and a plant">
          <button class="book book--one secret" type="button" data-secret="book">SEO</button>
          <button class="book book--two secret" type="button" data-secret="op">OP</button>
          <button class="book book--three secret" type="button" data-secret="book">ASTRO</button>
          <div class="plant"><i></i><i></i><i></i></div>
        </section>

        <section class="pinboard" aria-label="Pinboard of notes from the night">
          <span class="pinboard__label">THINGS WORTH REMEMBERING</span>
          <button class="pin pin--one secret" type="button" data-secret="note">could I make<br />this better?</button>
          <span class="pin pin--two">small → useful → ship</span>
          <span class="pin pin--three">intent ≠ keywords</span>
          <span class="pin pin--late pin--four">92 / 100</span>
          <span class="pin pin--late pin--five">versionCode ↑</span>
          <span class="pin pin--late pin--six">agent → QA → release</span>
          <svg viewBox="0 0 200 120" aria-hidden="true"><path d="M20 95 C65 35 105 30 180 72" /><path d="M30 35 C70 80 120 80 168 28" /></svg>
        </section>

        <section class="lamp" aria-label="Desk lamp"><div class="lamp__shade"></div><div class="lamp__arm"></div><div class="lamp__light"></div></section>

        <section class="desk" aria-label="Naman's desk">
          <div class="desk__top"></div>
          <div class="desk__edge"></div>

          <button class="mug secret" type="button" data-secret="mug" aria-label="Chai mug">
            <span class="mug__tea"></span><span class="mug__handle"></span><i class="steam steam--1"></i><i class="steam steam--2"></i><small>chai</small>
          </button>

          <button class="wheel secret" type="button" data-secret="wheel" aria-label="Tiny random letter wheel">
            <span>A</span><span>G</span><span>M</span><span>R</span><b>spin</b>
          </button>

          <button class="crumple secret" type="button" data-secret="crumple" aria-label="Crumpled paper">?</button>

          <div class="keyboard" aria-hidden="true">{Array.from({ length: 12 }).map(() => <i></i>)}</div>

          <button class="phone secret" type="button" data-secret="phone" aria-label="Phone with SmallMB">
            <span class="phone__speaker"></span>
            <div class="phone__screen">
              <small>smallmb</small><span>PHOTO.JPG</span><s>12.4 MB</s><b>842 KB</b><i>compress</i>
            </div>
          </button>

          <button class="notebook secret" type="button" data-secret="notebook" aria-label="Notebook">
            <span class="notebook__line"></span><small>idea 07</small><b>make the boring thing<br />feel simple.</b><em>→ then actually ship it</em>
          </button>

          <div class="papers" aria-hidden="true"><span></span><span></span><span></span></div>

          <button class="drawer secret" type="button" data-secret="drawer" aria-label="Desk drawer">
            <span>probably_not_a_good_idea</span><i></i>
          </button>

          <button class="bug secret" type="button" data-secret="bug" aria-label="A tiny bug"><i></i><i></i><i></i></button>
        </section>

        <section class="monitor" aria-label="Monitor showing the work of the night">
          <div class="monitor__shell">
            <div class="monitor__camera"></div>
            <div class="monitor__screens">
              <div class="screen screen--0 is-active" data-screen="0"><small>NOTES.TXT</small><p>could I make<br /><strong>this better?</strong></p><span class="caret"></span></div>

              <div class="screen screen--1" data-screen="1"><small>IDEAS / 8:26 PM</small><div class="idea-map"><b>useful?</b><i></i><b>smaller</b><i></i><b>ship</b></div><p>one evening → one annoying problem → maybe a product</p></div>

              <div class="screen screen--2" data-screen="2"><small>SMALLMB / BUILD</small><div class="app-preview"><span>PHOTO.JPG</span><s>12.4 MB</s><b>842 KB</b><footer><i>COMPRESS</i><i>RESIZE</i><i>PDF</i></footer></div><a href={projectHref(smallmb)}>opening soon →</a></div>

              <div class="screen screen--3" data-screen="3"><small>naman@night:~</small><code>$ npx astro-seo-audit<br /><span>✓</span> final HTML<br /><span>✓</span> canonical<br /><span>✓</span> schema<br /><b>92 / 100</b></code><a href={projectHref(audit)} target="_blank" rel="noopener noreferrer">open source ↗</a></div>

              <div class="screen screen--4" data-screen="4"><small>02:37 / EXPERIMENTS</small><div class="folders"><button type="button" data-secret="folder">probably_not_a_good_idea/</button><span>agents/</span><span>draw-to-unlock/</span><span>games/</span><span>mavid/</span></div><p>normal judgement has left the room.</p></div>

              <div class="screen screen--5" data-screen="5"><small>03:48 / WHAT I ACTUALLY USE</small><div class="evidence"><span>SEO</span><span>ASTRO</span><span>ANDROID</span><span>GITHUB</span><span>CLAUDE</span><span>CODEX</span><span>CI / QA</span></div><p>tools are only interesting when something ships.</p></div>

              <div class="screen screen--6" data-screen="6"><small>04:41 / DRAFTS</small><div class="draft-list">{posts.map((post, index) => <a href={`${base}blog/${post.id}/`}><span>0{index + 1}</span><b>{post.data.title}</b></a>)}</div></div>

              <div class="screen screen--7" data-screen="7"><small>05:39 / FIRST LIGHT</small><p>the room was always messier than it looked.</p><div class="tiny-status"><span>chai</span><b>cold</b><span>tabs</span><b>too many</b><span>sleep</span><b>later</b></div></div>

              <div class="screen screen--8" data-screen="8"><small>06:11 / RELEASE</small><code>$ git push origin main<br /><span>✓</span> build<br /><span>✓</span> deploy<br /><b>good enough to ship.</b></code><div class="release-projects">{projects.slice(0, 4).map((project) => <a href={projectHref(project)} target={project.external ? '_blank' : undefined} rel={project.external ? 'noopener noreferrer' : undefined}><span>{project.name}</span><small>{project.status}</small></a>)}</div></div>

              <div class="screen screen--9" data-screen="9"><small>06:24 / NAMAN PATEL</small><h2>see you tonight.</h2><p>I build things for the web, work on search, experiment with software, and write down what I learn.</p><div class="final-links"><a href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer">X ↗</a><a href={`${base}about/`}>About →</a></div></div>
            </div>
          </div>
          <div class="monitor__neck"></div><div class="monitor__stand"></div>
        </section>

        <div class="morning-reveal" aria-hidden="true"><span class="photo">NP<br /><small>keep making</small></span><span class="chapter-mark">one more<br />chapter?</span></div>

        <div class="toast" role="status" aria-live="polite" data-toast></div>
      </div>

      <div class="chapters" aria-label="One night timeline">
        {chapters.map((chapter, index) => (
          <section class="chapter" id={`chapter-${index}`} data-chapter={index}>
            <article class:list={['story', index % 2 ? 'story--right' : 'story--left']}>
              <span class="story__time">{chapter.time}</span>
              <span class="story__eyebrow">{index === 0 ? 'THE SUN HAS ALMOST LEFT.' : index === 9 ? 'MORNING.' : `0${index + 1} / ONE MORE NIGHT`}</span>
              <h1>{chapter.title}</h1>
              <p>{chapter.copy}</p>
              {index === 0 && <small>scroll slowly. the room keeps everything.</small>}
              {index === 4 && <small>the drawer opens. unfortunately.</small>}
              {index === 6 && <small>the papers on the monitor are real posts.</small>}
              {index === 9 && <a href={`${base}`}>back to the daylight site ↗</a>}
            </article>
          </section>
        ))}
      </div>
    </main>

    <script>
      const body = document.body;
      const chapters = Array.from(document.querySelectorAll('[data-chapter]'));
      const screens = Array.from(document.querySelectorAll('[data-screen]'));
      const clock = document.querySelector('[data-clock]');
      const progress = document.querySelector('[data-progress]');
      const toast = document.querySelector('[data-toast]');
      const times = ['6:47 PM','8:26 PM','10:14 PM','12:03 AM','2:37 AM','3:48 AM','4:41 AM','5:39 AM','6:11 AM','6:24 AM'];
      let activeScene = 0;
      let toastTimer;

      function setScene(index) {
        activeScene = Number(index);
        body.dataset.scene = String(activeScene);
        if (clock) clock.textContent = times[activeScene] ?? times[0];
        screens.forEach((screen, i) => screen.classList.toggle('is-active', i === activeScene));
      }

      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setScene(visible.target.dataset.chapter);
      }, { threshold: [0.35, 0.55, 0.75] });

      chapters.forEach((chapter) => observer.observe(chapter));

      function updateProgress() {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = max > 0 ? window.scrollY / max : 0;
        progress?.style.setProperty('--progress', `${Math.max(0, Math.min(1, ratio)) * 100}%`);
      }
      addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();

      function say(message) {
        if (!toast) return;
        toast.textContent = message;
        toast.classList.add('is-visible');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('is-visible'), 2600);
      }

      document.querySelectorAll('[data-secret]').forEach((el) => {
        el.addEventListener('click', () => {
          const secret = el.dataset.secret;
          if (secret === 'mug') say(activeScene < 3 ? 'still warm ☕' : activeScene < 7 ? 'this chai has seen things.' : 'cold. completely abandoned.');
          if (secret === 'wheel') { el.classList.remove('is-spinning'); void el.offsetWidth; el.classList.add('is-spinning'); say('R. destiny has spoken.'); }
          if (secret === 'crumple') say('“build a social network for potatoes” — rejected, 8:59 PM.');
          if (secret === 'drawer' || secret === 'folder') { body.classList.toggle('drawer-open'); say('you were specifically not supposed to open this.'); }
          if (secret === 'notebook' || secret === 'note') say('most projects begin with handwriting this bad.');
          if (secret === 'phone') say('12.4 MB → 842 KB. boring problem, satisfying result.');
          if (secret === 'bug') { el.classList.add('caught'); say('bug fixed. ship it before another appears.'); }
          if (secret === 'op') say('one more chapter. historically, a lie.');
          if (secret === 'book') say('research material. definitely.');
        });
      });

      addEventListener('keydown', (event) => {
        if (event.key.toLowerCase() === 'z') {
          body.classList.remove('zehaha'); void body.offsetWidth; body.classList.add('zehaha');
          say('ZEHAHAHAHA — the room approves.');
        }
      });

      setScene(0);
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    --header-h: 3.35rem;
    --ink: #f5efe4;
    --muted: #b7aea5;
    --faint: #807a78;
    --line: rgba(245,239,228,.13);
    --night: #111016;
    --wall: #392b31;
    --desk: #654738;
    --lamp: #f0a667;
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    --serif: Georgia, Cambria, "Times New Roman", serif;
    --ui: Inter, system-ui, sans-serif;
  }

  * { box-sizing: border-box; }
  html { background: var(--night); scroll-behavior: smooth; }
  body { margin: 0; min-width: 20rem; min-height: 100vh; overflow-x: hidden; background: var(--night); color: var(--ink); font-family: var(--ui); }
  button, a { font: inherit; }
  a { color: inherit; text-decoration: none; }
  button { color: inherit; }

  .nightbar {
    position: fixed; inset: 0 0 auto; z-index: 100; height: var(--header-h); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 0 .95rem; border-bottom: 1px solid var(--line); background: rgba(14,13,18,.92); backdrop-filter: blur(16px);
    font-family: var(--mono); font-size: .58rem; letter-spacing: .1em; text-transform: uppercase;
  }
  .nightbar__brand, .nightbar__time, .nightbar__links { display: flex; align-items: center; gap: .65rem; }
  .nightbar__brand span { width: 1.65rem; aspect-ratio: 1; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; font-size: .5rem; }
  .nightbar__brand small { font-size: inherit; color: var(--muted); }
  .nightbar__time i { width: .38rem; aspect-ratio: 1; border-radius: 50%; background: var(--lamp); box-shadow: 0 0 .8rem rgba(240,166,103,.65); }
  .nightbar__links { justify-self: end; gap: .9rem; color: var(--muted); }
  .nightbar a:hover { color: #fff; }

  .progress { position: fixed; z-index: 101; top: var(--header-h); left: 0; width: 100%; height: 1px; background: rgba(255,255,255,.05); }
  .progress span { display: block; width: var(--progress,0%); height: 100%; background: linear-gradient(90deg,#e99b66,#8598e9,#f0c79f); transition: width 80ms linear; }

  .night { position: relative; }
  .world { position: fixed; z-index: 1; inset: var(--header-h) 0 0; overflow: hidden; background: var(--wall); transition: background 1.2s ease; isolation: isolate; }
  .world::after { content:""; position:absolute; inset:0; z-index:50; pointer-events:none; box-shadow: inset 0 0 8rem rgba(0,0,0,.38); transition: opacity 1s ease; }
  .room-grain { position:absolute; inset:0; z-index:49; pointer-events:none; opacity:.14; background-image: repeating-radial-gradient(circle at 0 0, transparent 0 2px, rgba(255,255,255,.06) 2.5px 3px); background-size:5px 5px; mix-blend-mode:soft-light; }
  .wall-glow { position:absolute; inset:0; background: radial-gradient(circle at 73% 35%, rgba(240,166,103,.16), transparent 31%), radial-gradient(circle at 22% 20%, rgba(107,102,168,.08), transparent 28%); transition: opacity 1.2s ease, background 1.2s ease; }

  .window { position:absolute; left:5.5%; top:7%; width:25%; height:29%; overflow:hidden; border: .45rem solid #1a171c; background:#15131d; box-shadow: 0 1rem 2rem rgba(0,0,0,.22); }
  .sky { position:absolute; inset:0; background: linear-gradient(#d78274 0%, #83647d 46%, #38334f 100%); transition: background 1.5s ease; }
  .moon { position:absolute; width:1.8rem; aspect-ratio:1; border-radius:50%; left:73%; top:22%; background:#f7ebc7; box-shadow:0 0 2rem rgba(247,235,199,.25); opacity:0; transform:translateY(1rem); transition: all 1.5s ease; }
  .sun { position:absolute; width:2.4rem; aspect-ratio:1; border-radius:50%; left:18%; top:66%; background:#ffc486; box-shadow:0 0 2.5rem #ffc486; opacity:0; transition:all 1.5s ease; }
  .cloud { position:absolute; width:4rem; height:1rem; border-radius:999px; background:rgba(42,39,57,.55); filter:blur(1px); transition:all 1.2s ease; }
  .cloud::before,.cloud::after { content:""; position:absolute; bottom:0; border-radius:50%; background:inherit; }
  .cloud::before { width:1.8rem; height:1.8rem; left:.65rem; }.cloud::after { width:1.25rem; height:1.25rem; right:.6rem; }
  .cloud--a { top:27%; left:7%; }.cloud--b { top:53%; right:-6%; transform:scale(.75); }
  .city { position:absolute; right:0; bottom:0; left:0; height:27%; background: linear-gradient(90deg,#11131d 0 7%,transparent 7% 11%,#13151f 11% 22%,transparent 22% 25%,#0e1018 25% 44%,transparent 44% 49%,#151720 49% 68%,transparent 68% 72%,#10121b 72% 100%); }
  .city--far { height:19%; opacity:.55; transform:translateX(-3%); }.city--near { height:12%; filter:brightness(.8); }
  .passing-light { position:absolute; bottom:9%; left:-10%; width:1.2rem; height:.18rem; border-radius:999px; background:#ffd283; opacity:0; }
  .window-frame { position:absolute; z-index:4; background:#19161c; }.window-frame--v { width:.4rem; top:0; bottom:0; left:50%; transform:translateX(-50%); }.window-frame--h { height:.4rem; right:0; left:0; top:54%; }

  .shelf { position:absolute; left:5.7%; top:38%; width:24.5%; height:7.5%; border-bottom:.8rem solid #5a4034; display:flex; align-items:flex-end; gap:.45rem; padding-left:1.5rem; }
  .book { border:0; border-radius:.1rem .1rem 0 0; width:2.1rem; height:4.5rem; padding:.35rem 0; writing-mode:vertical-rl; font-family:var(--mono); font-size:.45rem; letter-spacing:.08em; cursor:pointer; box-shadow: inset 0 0 0 1px rgba(0,0,0,.15); }
  .book--one { background:#8a5351; }.book--two { height:3.8rem; background:#536878; }.book--three { height:4.9rem; background:#aa784e; }
  .plant { position:relative; width:3.2rem; height:2.3rem; margin-left:.65rem; background:#725340; clip-path:polygon(15% 35%,85% 35%,72% 100%,28% 100%); }
  .plant i { position:absolute; bottom:1.2rem; left:50%; width:.65rem; height:2.2rem; border-radius:100% 0 100% 0; transform-origin:bottom; background:#55765d; }.plant i:nth-child(1){transform:rotate(-40deg)}.plant i:nth-child(2){height:2.7rem;transform:translateX(-50%)}.plant i:nth-child(3){transform:rotate(40deg) scaleX(-1)}

  .pinboard { position:absolute; top:8%; right:5.5%; width:27%; height:26%; padding:1.3rem; background:#765943; border:.5rem solid #4b372e; box-shadow:0 1rem 2.2rem rgba(0,0,0,.18); }
  .pinboard__label { position:absolute; top:.55rem; left:.7rem; font: .42rem var(--mono); letter-spacing:.12em; color:#e7cfb2; }
  .pin { position:absolute; border:0; padding:.45rem .6rem; color:#44362f; background:#efe0bf; font: .58rem/1.2 var(--serif); transform:rotate(var(--r)); box-shadow:0 .2rem .35rem rgba(0,0,0,.12); transition:opacity .8s ease, transform .8s ease; }
  .pin--one{left:12%;top:30%;--r:-5deg;cursor:pointer}.pin--two{right:9%;top:22%;--r:3deg;background:#d7dfd2}.pin--three{right:13%;bottom:16%;--r:-2deg;background:#d9cce0}.pin--four{left:12%;bottom:12%;--r:4deg}.pin--five{left:42%;top:50%;--r:-3deg;background:#cfdbe4}.pin--six{right:4%;top:54%;--r:4deg;background:#e0d2b7}
  .pin--late { opacity:0; transform:translateY(.4rem) rotate(var(--r)); }
  .pinboard svg { position:absolute; inset:28% 8% 8%; width:84%; height:64%; opacity:.25; fill:none; stroke:#f2dfc8; stroke-width:1; }

  .lamp { position:absolute; right:19%; top:32%; width:8rem; height:23rem; z-index:3; }
  .lamp__shade { position:absolute; top:0; left:1.1rem; width:5.6rem; height:2.8rem; border-radius:60% 60% 18% 18%; background:#6b5963; transform:rotate(7deg); }
  .lamp__arm { position:absolute; top:2.2rem; left:3.7rem; width:.35rem; height:14rem; background:#55494f; transform:rotate(9deg); transform-origin:top; }
  .lamp__light { position:absolute; top:2rem; left:-3rem; width:13rem; height:20rem; clip-path:polygon(38% 0,62% 0,100% 100%,0 100%); background:linear-gradient(rgba(246,176,108,.28),rgba(246,176,108,.03)); filter:blur(6px); transition:opacity 1.2s ease; }

  .desk { position:absolute; z-index:5; left:2.8%; right:2.8%; bottom:0; height:28%; }
  .desk__top { position:absolute; inset:0 0 18%; border-radius:.4rem .4rem 0 0; background:linear-gradient(#795747,#624436); box-shadow:0 -1rem 2rem rgba(0,0,0,.1), inset 0 1px rgba(255,255,255,.08); transition:background 1.2s ease; }
