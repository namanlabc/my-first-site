---
import { getCollection } from 'astro:content';
import { projects } from '../../data/projects';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const projectHref = (project: (typeof projects)[number]) => {
  if (!project.href) return `${base}projects/`;
  if (project.href.startsWith('/')) return `${base}${project.href.replace(/^\//, '')}`;
  return project.href;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121315" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>The Observer · Naman Patel</title>
    <meta name="description" content="An experimental visual identity for Naman Patel — independent builder, web and search." />
  </head>

  <body>
    <header class="masthead">
      <a class="mark" href="#top" aria-label="Naman Patel home"><span>NP</span><small>01</small></a>
      <nav aria-label="Test navigation">
        <a href="#work">Works</a>
        <a href="#profile">Profile</a>
        <a href="#notes">Notes</a>
      </nav>
      <div class="masthead__right">
        <span>IND / 2026</span>
        <a href={`${base}`}>Real site ↗</a>
      </div>
    </header>

    <main>
      <section class="hero" id="top" aria-labelledby="hero-name">
        <div class="hero__ghost" aria-hidden="true">N</div>

        <div class="hero__meta hero__meta--left">
          <span>INDEPENDENT BUILDER</span>
          <span>WEB / SEARCH / SOFTWARE</span>
        </div>

        <div class="observer-wrap" data-parallax>
          <svg class="observer" viewBox="0 0 760 1020" role="img" aria-label="The Observer, an abstract editorial figure representing Naman's visual identity">
            <defs>
              <linearGradient id="coat" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#e8e1d6" />
                <stop offset="1" stop-color="#bcb7af" />
              </linearGradient>
              <linearGradient id="shadow" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#383b40" />
                <stop offset="1" stop-color="#191b1f" />
              </linearGradient>
              <filter id="softShadow" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="0" dy="24" stdDeviation="18" flood-color="#000" flood-opacity=".22" />
              </filter>
            </defs>

            <ellipse cx="405" cy="950" rx="210" ry="24" fill="#090a0c" opacity=".35" />

            <g filter="url(#softShadow)">
              <path class="leg leg--back" d="M331 684 L412 684 L432 926 L370 939 Z" fill="#25282d" />
              <path class="leg" d="M415 678 L500 660 L525 921 L462 940 Z" fill="#101214" />
              <path d="M360 925 L432 922 L444 950 L347 951 Z" fill="#0c0d0f" />
              <path d="M461 924 L525 918 L548 945 L456 953 Z" fill="#0c0d0f" />

              <path class="coat-back" d="M238 340 Q300 280 419 298 Q526 322 557 420 L525 739 Q442 789 293 752 L219 499 Z" fill="url(#shadow)" />
              <path class="coat" d="M268 338 Q338 285 430 304 Q488 318 529 374 L487 730 Q405 771 300 738 L243 488 Z" fill="url(#coat)" />

              <path class="coat-panel coat-panel--blue" d="M284 365 L351 329 L353 724 L299 738 L259 484 Z" fill="#536a7b" opacity=".94" />
              <path class="coat-panel coat-panel--rust" d="M439 319 L502 350 L486 704 L433 733 Z" fill="#9c5740" />

              <path class="arm arm--left" d="M252 397 Q187 448 161 599 Q180 622 216 618 L308 469 Z" fill="#c9c3b9" />
              <path class="arm arm--right" d="M505 372 Q585 438 613 575 L575 604 L478 473 Z" fill="#25282d" />

              <path class="hand" d="M158 596 Q151 624 169 642 Q192 659 216 618 L203 590 Z" fill="#b9a596" />
              <path class="hand" d="M575 589 Q590 627 619 617 Q641 608 626 583 L606 557 Z" fill="#b9a596" />

              <path class="neck" d="M350 288 L428 288 L442 330 Q385 353 334 324 Z" fill="#b9a596" />
              <ellipse class="head" cx="387" cy="207" rx="91" ry="111" fill="#b9a596" transform="rotate(-7 387 207)" />
              <path class="hair" d="M292 192 Q310 87 406 89 Q491 96 502 179 Q470 140 424 135 Q366 126 319 170 L306 237 Q288 221 292 192 Z" fill="#17191d" />
              <path class="face-shadow" d="M438 140 Q478 189 452 266 Q420 304 374 308 Q410 260 406 207 Q404 170 438 140 Z" fill="#927f73" opacity=".48" />

              <path class="eye" d="M333 207 Q347 201 361 207" stroke="#292b30" stroke-width="4" fill="none" stroke-linecap="round" />
              <path class="eye" d="M411 197 Q425 191 439 197" stroke="#292b30" stroke-width="4" fill="none" stroke-linecap="round" />

              <rect class="notebook" x="548" y="548" width="77" height="106" rx="4" fill="#e9e2d4" transform="rotate(8 548 548)" />
              <path d="M560 573 L606 580 M558 588 L599 594 M556 604 L607 611" stroke="#9c5740" stroke-width="3" opacity=".8" />

              <circle class="motif motif--wheel" cx="325" cy="463" r="27" fill="none" stroke="#121315" stroke-width="5" />
              <path d="M325 437 V489 M299 463 H351" stroke="#121315" stroke-width="3" opacity=".7" />
              <rect class="motif motif--device" x="454" y="465" width="31" height="55" rx="7" fill="none" stroke="#e8e1d6" stroke-width="4" />
              <path class="graph-line" d="M292 590 C323 565 349 602 379 570 C404 544 435 579 469 538" fill="none" stroke="#202327" stroke-width="5" stroke-linecap="round" />
              <circle cx="469" cy="538" r="6" fill="#9c5740" />

              <path class="seam" d="M357 329 L389 716" stroke="#77736e" stroke-width="2" stroke-dasharray="9 11" opacity=".8" />
              <path class="seam" d="M462 342 L430 704" stroke="#e8e1d6" stroke-width="2" stroke-dasharray="8 12" opacity=".55" />

              <rect class="note-tab" x="303" y="520" width="36" height="12" rx="3" fill="#d6a34a" transform="rotate(-6 303 520)" />
              <rect class="note-tab" x="400" y="616" width="42" height="13" rx="3" fill="#708fa5" transform="rotate(3 400 616)" />

              <path class="tiny-mark" d="M478 407 l8 -9 l8 9 l8 -9" stroke="#f0e8da" stroke-width="3" fill="none" stroke-linecap="round" />
            </g>
          </svg>
        </div>

        <div class="hero__identity">
          <h1 id="hero-name">Naman Patel</h1>
          <p>independent builder / web / search</p>
        </div>

        <div class="hero__meta hero__meta--right">
          <span>THE OBSERVER / MAKER</span>
          <span>EXPERIMENT 002</span>
        </div>

        <a class="hero__scroll" href="#work">↓</a>
      </section>

      <section class="work-intro" id="work">
        <span>SELECTED WORK / 01—05</span>
        <p>Things made quietly, then released into the world.</p>
      </section>

      <section class="works" aria-label="Selected projects">
        {projects.slice(0, 5).map((project, index) => (
          <article class:list={['work', `work--${index + 1}`, `work--${project.visual ?? 'notes'}`]}>
            <div class="work__meta">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <span>{project.kind}</span>
              <span>{project.status}</span>
            </div>

            <a class="work__visual" href={projectHref(project)} target={project.external ? '_blank' : undefined} rel={project.external ? 'noopener noreferrer' : undefined}>
              {project.visual === 'smallmb' && (
                <div class="composition composition--phone">
                  <div class="phone-object">
                    <div class="phone-object__screen"><small>smallmb</small><span>PHOTO.JPG</span><s>12.4 MB</s><b>842 KB</b><i>compress</i></div>
                  </div>
                  <div class="orbit-label">ON DEVICE</div>
                  <div class="mass mass--blue"></div>
                  <div class="mass mass--bone"></div>
                  <span class="huge-type">MB</span>
                </div>
              )}

              {project.visual === 'audit' && (
                <div class="composition composition--audit">
                  <div class="audit-score"><span>site health</span><b>92</b><small>/100</small></div>
                  <div class="audit-sheet"><code>$ astro-seo-audit</code><p>✓ title + description</p><p>✓ canonical</p><p>✓ schema</p></div>
                  <svg class="audit-line" viewBox="0 0 600 300" aria-hidden="true"><path d="M20 230 C140 110 220 250 340 120 C430 25 520 180 580 70" /></svg>
                  <span class="huge-type">SEO</span>
                </div>
              )}

              {project.visual === 'wheel' && (
                <div class="composition composition--wheel">
                  <div class="wheel-object"><span>A</span><span>G</span><span>M</span><span>R</span><b>spin</b></div>
                  <div class="wheel-shadow"></div>
                  <span class="huge-type">RND</span>
                  <div class="orbit-label">LIVE / BROWSER</div>
                </div>
              )}

              {project.visual === 'calm' && (
                <div class="composition composition--calm">
                  <div class="paper-object"><small>CALM / 001</small><h3>Less noise.<br />More reading.</h3><p></p><p></p><p></p></div>
                  <div class="leaf-mark">✦</div>
                  <span class="huge-type">CALM</span>
                </div>
              )}

              {project.visual === 'notes' && (
                <div class="composition composition--notes">
                  <div class="note-object note-object--a"><small>FIELD NOTE / 08</small><b>I wanted Yoast for Astro,<br />so I built it.</b></div>
                  <div class="note-object note-object--b"><small>FIELD NOTE / 09</small><b>Some websites are<br />never really finished.</b></div>
                  <span class="huge-type">NP</span>
                </div>
              )}
            </a>

            <div class="work__copy">
              <h2>{project.name}</h2>
              <p>{project.description}</p>
              <a href={projectHref(project)} target={project.external ? '_blank' : undefined} rel={project.external ? 'noopener noreferrer' : undefined}>View project ↗</a>
            </div>
          </article>
        ))}
      </section>

      <section class="profile" id="profile">
        <div class="profile__index">PROFILE / 06</div>
        <div class="profile__statement">
          <p>I work where search, software, and small useful products overlap.</p>
          <p class="profile__soft">Most of the interesting part happens between the idea and the moment it becomes real.</p>
        </div>
        <div class="profile__facts">
          <span><small>Based</small><b>Mandla, India</b></span>
          <span><small>Focus</small><b>Search / Web / Product</b></span>
          <span><small>Bias</small><b>Make it useful</b></span>
        </div>
        <div class="profile__links">
          <a href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer">X ↗</a>
          <a href={`${base}about/`}>About ↗</a>
        </div>
      </section>

      <section class="notes" id="notes">
        <header class="notes__head">
          <span>FIELD NOTES / 07</span>
          <p>Writing, experiments, and things worth keeping.</p>
        </header>

        <div class="notes__list">
          {posts.map((post, index) => (
            <a class="note-row" href={`${base}blog/${post.id}/`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
              <b>↗</b>
            </a>
          ))}
        </div>
      </section>

      <footer class="footer">
        <div><strong>Naman Patel</strong><span>Observer / Maker</span></div>
        <a href="#top">Back to top ↑</a>
      </footer>
    </main>

    <script>
      const figure = document.querySelector('[data-parallax]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (figure && !reduce) {
        window.addEventListener('pointermove', (event) => {
          const x = (event.clientX / window.innerWidth - 0.5) * 10;
          const y = (event.clientY / window.innerHeight - 0.5) * 6;
          figure.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        });
      }
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    --bg: #121315;
    --panel: #181a1d;
    --ink: #ebe5db;
    --muted: #9a958e;
    --line: rgba(235,229,219,.14);
    --blue: #536a7b;
    --rust: #9c5740;
    --bone: #d7d0c5;
    --gold: #d1a456;
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    --ui: Inter, Geist, "Segoe UI", system-ui, sans-serif;
    --serif: Georgia, Cambria, "Times New Roman", serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--bg); }
  body { margin: 0; min-width: 20rem; background: var(--bg); color: var(--ink); font-family: var(--ui); }
  a { color: inherit; text-decoration: none; }
  ::selection { background: var(--rust); color: #fff; }

  .masthead {
    position: fixed;
    z-index: 30;
    top: 0;
    left: 0;
    right: 0;
    height: 4.6rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 1.2rem;
    border-bottom: 1px solid rgba(235,229,219,.08);
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px);
  }

  .mark { justify-self: start; display: inline-flex; align-items: baseline; gap: .35rem; font-family: var(--mono); }
  .mark span { font-size: .72rem; font-weight: 700; letter-spacing: .12em; }
  .mark small, .masthead nav a, .masthead__right { font-family: var(--mono); font-size: .56rem; letter-spacing: .11em; text-transform: uppercase; }
  .mark small { color: var(--rust); }
  .masthead nav { display: flex; gap: 1.4rem; }
  .masthead nav a, .masthead__right a { color: var(--muted); transition: color 160ms ease; }
  .masthead nav a:hover, .masthead__right a:hover { color: var(--ink); }
  .masthead__right { justify-self: end; display: flex; gap: 1rem; color: var(--muted); }

  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: 6.5rem 1rem 2rem;
    border-bottom: 1px solid var(--line);
  }

  .hero__ghost {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -51%);
    font-family: var(--serif);
    font-size: min(74vw, 58rem);
    line-height: .75;
    color: transparent;
    -webkit-text-stroke: 1px rgba(235,229,219,.055);
    user-select: none;
  }

  .observer-wrap { position: relative; z-index: 2; width: min(49vw, 35rem); transition: transform 220ms ease-out; }
  .observer { display: block; width: 100%; height: auto; overflow: visible; }
  .observer .coat, .observer .coat-panel, .observer .graph-line, .observer .note-tab { transition: transform 400ms cubic-bezier(.16,1,.3,1); transform-box: fill-box; transform-origin: center; }
  .observer-wrap:hover .coat-panel--blue { transform: translateX(-7px); }
  .observer-wrap:hover .coat-panel--rust { transform: translateX(7px); }
  .observer-wrap:hover .graph-line { transform: translateY(-4px); }
  .observer-wrap:hover .note-tab { transform: translateY(-5px) rotate(-2deg); }

  .hero__identity { position: absolute; z-index: 3; left: 1.4rem; bottom: 1.5rem; }
  .hero__identity h1 { margin: 0; font-family: var(--serif); font-size: clamp(2.2rem, 5vw, 4.8rem); font-weight: 400; line-height: .95; letter-spacing: -.05em; }
  .hero__identity p { margin: .5rem 0 0; color: var(--muted); font-family: var(--mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .1em; }

  .hero__meta { position: absolute; z-index: 3; display: grid; gap: .3rem; font-family: var(--mono); font-size: .52rem; letter-spacing: .11em; color: var(--muted); }
  .hero__meta--left { top: 6.4rem; left: 1.4rem; }
  .hero__meta--right { right: 1.4rem; bottom: 1.8rem; text-align: right; }
  .hero__scroll { position: absolute; left: 50%; bottom: 1.5rem; transform: translateX(-50%); color: var(--muted); }

  .work-intro {
    min-height: 40svh;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding: 3rem 1.4rem;
    border-bottom: 1px solid var(--line);
  }
  .work-intro span { font-family: var(--mono); font-size: .58rem; letter-spacing: .12em; color: var(--muted); }
  .work-intro p { margin: 0; max-width: 32rem; font-family: var(--serif); font-size: clamp(1.6rem, 3.3vw, 3rem); line-height: 1.05; letter-spacing: -.035em; }

  .work {
    min-height: 100svh;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1.25fr) minmax(18rem, .65fr);
    border-bottom: 1px solid var(--line);
  }
  .work__meta { padding: 1.4rem 1rem; border-right: 1px solid var(--line); display: grid; align-content: space-between; font-family: var(--mono); font-size: .52rem; letter-spacing: .1em; color: var(--muted); writing-mode: vertical-rl; transform: rotate(180deg); }
  .work__visual { position: relative; min-height: 100svh; overflow: hidden; background: #15171a; }
  .work__copy { display: flex; flex-direction: column; justify-content: end; padding: clamp(2rem, 5vw, 5rem) clamp(1.4rem, 4vw, 3.5rem); border-left: 1px solid var(--line); }
  .work__copy h2 { margin: 0; font-family: var(--serif); font-size: clamp(2.6rem, 5vw, 5rem); font-weight: 400; letter-spacing: -.055em; line-height: .95; }
  .work__copy p { margin: 1rem 0 0; max-width: 34rem; color: var(--muted); font-size: .94rem; line-height: 1.7; }
  .work__copy > a { margin-top: 1.5rem; font-family: var(--mono); font-size: .62rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink); }

  .composition { position: absolute; inset: 0; overflow: hidden; }
  .huge-type { position: absolute; left: -.02em; bottom: -.13em; font-family: var(--serif); font-size: min(28vw, 23rem); line-height: .8; color: rgba(235,229,219,.045); letter-spacing: -.08em; white-space: nowrap; }
  .orbit-label { position: absolute; font-family: var(--mono); font-size: .52rem; letter-spacing: .12em; color: var(--muted); }

  .composition--phone { background: linear-gradient(150deg,#182027,#121315 58%); }
  .phone-object { position: absolute; left: 48%; top: 50%; width: min(34vw, 18rem); aspect-ratio: .52; transform: translate(-50%,-50%) rotate(-7deg); border-radius: 2.2rem; padding: .55rem; background: #0f1114; border: 1px solid #3c4046; box-shadow: 0 3rem 7rem rgba(0,0,0,.42); }
  .phone-object__screen { width: 100%; height: 100%; border-radius: 1.7rem; display: grid; place-items: center; align-content: center; gap: .6rem; background: #e7dfd1; color: #1b1d20; text-align: center; }
  .phone-object__screen small { font-family: var(--mono); font-size: .6rem; letter-spacing: .1em; }
  .phone-object__screen span { font-size: .8rem; }
  .phone-object__screen s { color: #9c5740; font-size: 1.2rem; }
  .phone-object__screen b { font-size: 2.4rem; color: #536a7b; }
  .phone-object__screen i { padding: .55rem 1rem; border-radius: 999px; background: #1a1d20; color: #eee7dc; font-family: var(--mono); font-size: .54rem; font-style: normal; text-transform: uppercase; }
  .composition--phone .orbit-label { top: 18%; right: 11%; }
  .mass { position: absolute; border-radius: 50%; filter: blur(1px); }
  .mass--blue { width: 20rem; height: 20rem; right: -7rem; top: 8%; background: #536a7b; opacity: .16; }
  .mass--bone { width: 13rem; height: 13rem; left: -3rem; bottom: 8%; background: #d7d0c5; opacity: .08; }

  .composition--audit { background: #101214; }
  .audit-score { position: absolute; left: 10%; top: 14%; width: 13rem; aspect-ratio: 1; border: 1px solid var(--line); display: grid; place-content: center; text-align: center; }
  .audit-score span,.audit-score small { font-family: var(--mono); font-size: .52rem; letter-spacing: .1em; color: var(--muted); text-transform: uppercase; }
  .audit-score b { font-family: var(--serif); font-size: 6rem; font-weight: 400; line-height: .9; }
  .audit-sheet { position: absolute; right: 9%; top: 26%; width: min(44vw, 32rem); padding: 1.5rem; border: 1px solid var(--line); background: rgba(235,229,219,.03); font-family: var(--mono); }
  .audit-sheet code { color: #d1a456; }
  .audit-sheet p { margin: .7rem 0 0; color: #c8c2b8; font-size: .75rem; }
  .audit-line { position: absolute; left: 6%; right: 6%; bottom: 8%; width: 88%; height: 28%; }
  .audit-line path { fill: none; stroke: #536a7b; stroke-width: 4; stroke-linecap: round; }

  .composition--wheel { background: linear-gradient(135deg,#19181a,#121315 60%); }
  .wheel-object { position: absolute; left: 50%; top: 50%; width: min(48vw, 31rem); aspect-ratio: 1; transform: translate(-50%,-50%); border-radius: 50%; background: conic-gradient(#9c5740 0 25%, #d7d0c5 25% 50%, #536a7b 50% 75%, #24272b 75% 100%); box-shadow: 0 4rem 7rem rgba(0,0,0,.3); transition: transform 700ms cubic-bezier(.16,1,.3,1); }
  .work__visual:hover .wheel-object { transform: translate(-50%,-50%) rotate(18deg); }
  .wheel-object::after { content:""; position:absolute; inset:31%; border-radius:50%; background:#151719; border:1px solid var(--line); }
  .wheel-object b { position:absolute; z-index:2; inset:50% auto auto 50%; transform:translate(-50%,-50%); font-family:var(--mono); font-size:.7rem; text-transform:uppercase; letter-spacing:.08em; }
  .wheel-object span { position:absolute; font-size:1.6rem; font-family:var(--serif); }
  .wheel-object span:nth-child(1){top:8%;left:48%}.wheel-object span:nth-child(2){right:10%;top:48%}.wheel-object span:nth-child(3){bottom:8%;left:48%}.wheel-object span:nth-child(4){left:10%;top:48%}
  .wheel-shadow { position:absolute; left:50%; top:80%; width:32rem; height:4rem; transform:translateX(-50%); border-radius:50%; background:#000; filter:blur(20px); opacity:.25; }
  .composition--wheel .orbit-label { left: 9%; top: 11%; }

  .composition--calm { background: #d7d0c5; color:#17191d; }
  .paper-object { position:absolute; left:50%; top:48%; width:min(55vw,38rem); min-height:62%; transform:translate(-50%,-50%) rotate(-2deg); padding:clamp(2rem,5vw,4.5rem); background:#f0ebe3; box-shadow:0 2rem 4rem rgba(0,0,0,.15); }
