---
import Layout from '../layouts/Layout.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { projects } from '../data/projects';
---
<Layout title="Projects" description="Software, websites, and open-source tools built by Naman Patel.">
  <div class="inner-page"><header class="page-hero"><h1>Projects</h1><p>Software and websites I’m building and maintaining.</p></header><div class="project-list">{projects.map(project => <ProjectItem project={project} />)}</div></div>
</Layout>
