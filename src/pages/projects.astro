---
import Layout from '../layouts/Layout.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { projects } from '../data/projects';
---

<Layout title="Projects" description="The websites, tools, and WordPress experiments Naman keeps building and improving.">
  <div class="shell shell--content page-intro">
    <h1>The things I keep tinkering with.</h1>
    <p>
      Some are live, Calm WP is in beta, and I keep finding reasons to improve all of them.
    </p>
  </div>

  <section class="shell shell--wide projects-page" aria-labelledby="projects-list-title">
    <h2 id="projects-list-title" class="visually-hidden">Current projects</h2>
    <div class="project-list">
      {projects.map((project) => <ProjectItem project={project} />)}
    </div>
  </section>
</Layout>
