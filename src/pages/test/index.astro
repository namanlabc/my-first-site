  .ticker span { padding: 10px 0; font-family: var(--mono); font-size: 11px; font-weight: 900; white-space: nowrap; }
  @keyframes ticker { to { transform: translateX(-33.333%); } }

  .scene-heading { max-width: 1420px; display: grid; grid-template-columns: 1.4fr .6fr; gap: clamp(30px, 8vw, 110px); align-items: end; margin: 0 auto clamp(56px, 8vw, 110px); }
  .eyebrow { display: inline-block; margin-bottom: 13px; font-family: var(--mono); font-size: 10px; font-weight: 800; letter-spacing: .1em; }
  .scene-heading h2 { margin: 0; font-size: clamp(52px, 8.5vw, 136px); line-height: .79; letter-spacing: -.075em; }
  .scene-heading h2 em { font-family: var(--serif); font-weight: 400; }
  .scene-heading > p { max-width: 36ch; margin: 0; font-family: var(--serif); font-size: clamp(16px, 1.8vw, 23px); line-height: 1.35; }

  .work { background: var(--cream); }
  .work-wall { position: relative; max-width: 1380px; min-height: 1850px; margin: 0 auto; }
  .work-piece { position: absolute; width: min(48%, 620px); }
  .work-piece > a { display: block; text-decoration: none; }
  .work-piece--1 { left: 0; top: 0; }
