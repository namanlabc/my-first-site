---
import { getCollection } from 'astro:content';
import { projects } from '../../data/projects';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const projectHref = (project: (typeof projects)[number]) => {
  if (!project.href) return `${base}projects/`;
  if (project.href.startsWith('/')) return `${base}${project.href.replace(/^\//, '')}`;
  return project.href;
};

const projectWords = ['MAKE', 'SHIP', 'BREAK', 'FIX', 'REPEAT'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#d8ff4f" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>Creative Lab Test · Naman Patel</title>
    <meta
      name="description"
      content="An experimental alternate redesign for Naman Patel's personal site — a playful digital lab for projects, SEO, code and writing."
    />
  </head>

  <body>
    <div class="cursor-dot" data-cursor aria-hidden="true"></div>

    <header class="lab-nav">
      <a class="lab-brand" href={`${base}test/`} aria-label="Creative test home">
        <span class="lab-brand__mark">N</span>
        <span class="lab-brand__copy"><b>NAMAN</b><small>digital laboratory</small></span>
      </a>

      <nav aria-label="Test page navigation">
        <a href="#work"><span>01</span> work</a>
        <a href="#skills"><span>02</span> skills</a>
        <a href="#notes"><span>03</span> notes</a>
        <a href="#profile"><span>04</span> profile</a>
      </nav>

      <a class="exit-test" href={`${base}`}>real site ↗</a>
    </header>

    <main>
      <section class="hero scene" id="top" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>

        <div class="hero-kicker reveal">
          <span>PERSONAL SITE / EXPERIMENT 001</span>
          <span>SEO · WEB · ANDROID · AI</span>
        </div>

        <div class="hero-title-wrap">
          <h1 id="hero-title" class="reveal">
            <span>NA<span class="hero-title__cut">M</span>AN</span>
            <span>MAKES</span>
            <span>THI<span class="hero-title__ring">N</span>GS.</span>
          </h1>

          <p class="hero-intro reveal">
            I build useful internet things, obsess over search, ship tiny products, and keep notes while I figure the rest out.
          </p>
        </div>

        <div class="hero-playground" data-playground>
          <div class="orbit orbit--one" data-float="1.4" aria-hidden="true"></div>
          <div class="orbit orbit--two" data-float="0.8" aria-hidden="true"></div>

          <article class="artifact artifact--terminal" data-float="1.1">
            <div class="artifact-bar"><i></i><i></i><i></i><span>naman@lab:~</span></div>
            <code><b>$</b> npx astro-seo-audit</code>
            <p><span>✓</span> crawling final HTML</p>
            <p><span>✓</span> schema found</p>
            <strong>92 / 100</strong>
          </article>

          <article class="artifact artifact--phone" data-float="1.55">
            <div class="mini-phone">
              <span class="mini-phone__brand">smallmb</span>
              <div class="mini-phone__file"><s>12.4 MB</s><b>842 KB</b></div>
              <div class="mini-phone__buttons"><i></i><i></i><i></i></div>
            </div>
            <span class="artifact-label">ANDROID / OFFLINE</span>
          </article>

          <article class="artifact artifact--search" data-float="0.75">
            <span class="artifact-label">SEARCH CONSOLE</span>
            <div class="search-chart">
              <i style="--h:32%"></i><i style="--h:45%"></i><i style="--h:37%"></i><i style="--h:63%"></i><i style="--h:72%"></i><i style="--h:91%"></i>
            </div>
            <strong>impressions ↑</strong>
          </article>

          <article class="artifact artifact--wheel" data-float="1.25">
            <div class="tiny-wheel"><b>spin</b><span>A</span><span>G</span><span>M</span><span>R</span></div>
            <span class="artifact-label">GET RANDOM LETTER</span>
          </article>

          <div class="hero-sticker hero-sticker--ship" data-float="1.9">SHIP<br />IT.</div>
          <div class="hero-sticker hero-sticker--why" data-float="1.2">could I<br />make this<br /><b>better?</b></div>

          <button class="chaos-button" type="button" data-chaos>
            <span>poke the lab</span>
            <b>✦</b>
          </button>
        </div>

        <div class="hero-foot reveal">
          <p>Currently somewhere between <b>“this is a terrible idea”</b> and <b>“wait, this actually works.”</b></p>
          <a href="#work">scroll to the evidence ↓</a>
        </div>
      </section>

      <div class="ticker" aria-hidden="true">
        <div>
          {Array.from({ length: 3 }).map(() => (
            <span>SEO ✦ ASTRO ✦ ANDROID ✦ PRODUCT ✦ AGENTS ✦ WRITING ✦ BUILD SMALL / SHIP OFTEN ✦ </span>
          ))}
        </div>
      </div>

      <section class="work scene" id="work" aria-labelledby="work-title">
        <header class="scene-heading reveal">
          <div>
            <span class="eyebrow">01 / SELECTED WORK</span>
            <h2 id="work-title">Things that escaped<br />the <em>ideas folder.</em></h2>
          </div>
          <p>Not a neat portfolio grid. More like a shelf of experiments that became real products.</p>
        </header>

        <div class="work-wall">
          {projects.map((project, index) => (
            <article class:list={['work-piece', `work-piece--${index + 1}`, `work-piece--${project.visual ?? 'notes'}`, 'reveal']}>
              <span class="work-piece__number">0{index + 1}</span>
              <a
                href={projectHref(project)}
                target={project.external ? '_blank' : undefined}
                rel={project.external ? 'noopener noreferrer' : undefined}
                aria-label={`${project.name}${project.external ? ' (opens in new tab)' : ''}`}
              >
                <div class="work-piece__art" aria-hidden="true">
                  {project.visual === 'smallmb' && (
                    <div class="art-smallmb">
                      <div class="art-smallmb__phone">
                        <small>smallmb</small>
                        <div><span>PHOTO.JPG</span><s>12.4 MB</s><b>842 KB</b></div>
                        <footer><i>COMPRESS</i><i>RESIZE</i><i>PDF</i></footer>
                      </div>
                      <span class="art-badge">OFFLINE<br />FIRST</span>
                    </div>
                  )}

                  {project.visual === 'audit' && (
                    <div class="art-audit">
                      <div class="art-audit__score"><small>SITE HEALTH</small><b>92</b><span>/100</span></div>
                      <div class="art-audit__terminal"><code>$ astro-seo-audit</code><p>✓ title + description</p><p>✓ canonical</p><p>✓ schema</p></div>
                      <span class="art-badge">OPEN<br />SOURCE</span>
                    </div>
                  )}

                  {project.visual === 'wheel' && (
                    <div class="art-wheel">
                      <div class="art-wheel__disc"><span>A</span><span>G</span><span>M</span><span>R</span><b>SPIN</b></div>
                      <p>A TINY TOOL<br />GOT OUT OF HAND.</p>
                      <span class="art-badge">LIVE<br />NOW</span>
                    </div>
                  )}

                  {project.visual === 'calm' && (
                    <div class="art-calm">
                      <div class="art-calm__paper"><small>CALM / 001</small><h3>Less noise.<br />More reading.</h3><p></p><p></p><p></p></div>
                      <span class="art-calm__spark">✦</span>
                      <span class="art-badge">BETA<br />THEME</span>
                    </div>
                  )}

                  {project.visual === 'notes' && (
                    <div class="art-notes">
                      <div class="note note--a"><small>NOTE 08</small><b>I like One Piece.<br />That’s the post.</b></div>
                      <div class="note note--b"><small>NOTE 07</small><b>I wanted Yoast for Astro,<br />so I built it.</b></div>
                      <span class="art-badge">ALWAYS<br />EDITING</span>
                    </div>
                  )}
                </div>

                <div class="work-piece__caption">
                  <div><span>{project.kind}</span><span>{project.status}</span></div>
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                  <b class="work-piece__arrow">↗</b>
                </div>
              </a>
              <span class="work-piece__word">{projectWords[index] ?? 'MAKE'}</span>
            </article>
          ))}
        </div>

        <div class="work-end reveal">
          <span>There are always more tabs open than projects shown here.</span>
          <a href={`${base}projects/`}>open the full project drawer →</a>
        </div>
      </section>

      <section class="skills scene" id="skills" aria-labelledby="skills-title">
        <header class="scene-heading scene-heading--inverse reveal">
          <div>
            <span class="eyebrow">02 / WHAT I ACTUALLY DO</span>
            <h2 id="skills-title">One person.<br /><em>Too many toolbars.</em></h2>
          </div>
          <p>I like the messy middle where research, design, code, distribution and QA all touch the same thing.</p>
        </header>

        <div class="skill-deck">
          <article class="skill-card skill-card--seo reveal">
            <span>01</span>
            <h3>SEARCH<br />& CONTENT</h3>
            <p>Intent, technical SEO, schema, publishing systems and figuring out why a graph suddenly went sideways.</p>
            <div class="skill-card__tools"><b>GSC</b><b>AHREFS</b><b>WORDPRESS</b><b>SCHEMA</b></div>
            <div class="skill-card__visual" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
          </article>

          <article class="skill-card skill-card--build reveal">
            <span>02</span>
            <h3>PRODUCT<br />& WEB</h3>
            <p>From rough idea to structure, interface, code, QA, deploy and the weird final 10% that makes something feel finished.</p>
            <div class="skill-card__tools"><b>ASTRO</b><b>TAILWIND</b><b>GITHUB</b><b>ANDROID</b></div>
            <div class="skill-card__window" aria-hidden="true"><div></div><code>const idea = 'useful';<br />ship(idea);</code></div>
          </article>

          <article class="skill-card skill-card--agents reveal">
            <span>03</span>
            <h3>AI AGENTS<br />& WORKFLOW</h3>
            <p>Model routing, coding agents, CI and supervised automation — useful when it saves work, boring when it becomes theatre.</p>
            <div class="skill-card__tools"><b>CLAUDE</b><b>CODEX</b><b>OPENCODE</b><b>OPENROUTER</b></div>
            <div class="agent-diagram" aria-hidden="true"><b>YOU</b><i></i><b>ATLAS</b><i></i><b>SHIP</b></div>
          </article>
        </div>

        <div class="skill-marquee" aria-hidden="true">
          <span>RESEARCH → DESIGN → BUILD → TEST → SHIP → WATCH THE DATA → FIX WHAT BROKE → </span>
          <span>RESEARCH → DESIGN → BUILD → TEST → SHIP → WATCH THE DATA → FIX WHAT BROKE → </span>
        </div>
      </section>

      <section class="now scene" aria-labelledby="now-title">
        <div class="now-poster reveal">
          <span class="eyebrow">STATUS BOARD / LIVE-ish</span>
          <h2 id="now-title">RIGHT<br />NOW<span>.</span></h2>
          <div class="now-poster__stamp">AUG<br />2026</div>
        </div>

        <div class="now-board">
          <article class="now-row reveal">
            <span>01</span><div><b>SmallMB</b><small>Android utility</small></div><p>Polishing the product and making the boring file stuff feel simple.</p><em>LAUNCHING</em>
          </article>
          <article class="now-row reveal">
            <span>02</span><div><b>Get Random Letter</b><small>Web tools</small></div><p>Turning one silly wheel into an entire tiny-tool playground.</p><em>LIVE</em>
          </article>
          <article class="now-row reveal">
            <span>03</span><div><b>Astro SEO Audit</b><small>Open source</small></div><p>Teaching it to catch the SEO mistakes I’d rather find before Google does.</p><em>BUILDING</em>
          </article>
          <article class="now-row now-row--personal reveal">
            <span>04</span><div><b>Off screen</b><small>Important research</small></div><p>Chai, One Piece, and saying “one more chapter” with absolutely no credibility.</p><em>ONGOING</em>
          </article>
        </div>
      </section>

      <section class="notes scene" id="notes" aria-labelledby="notes-title">
        <header class="scene-heading reveal">
          <div>
            <span class="eyebrow">03 / FIELD NOTES</span>
            <h2 id="notes-title">Things I wrote<br />before I <em>forgot them.</em></h2>
          </div>
          <p>Build logs, opinions, experiments, useful mistakes and whatever refused to leave my head.</p>
        </header>

        <div class="notes-desk">
          {posts.map((post, index) => (
            <a class:list={['desk-note', `desk-note--${index + 1}`, 'reveal']} href={`${base}blog/${post.id}/`}>
              <span class="desk-note__pin" aria-hidden="true"></span>
              <small>FIELD NOTE / {String(index + 1).padStart(2, '0')}</small>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <footer>
                <span>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                <b>READ ↗</b>
              </footer>
            </a>
          ))}
          <div class="desk-scribble" aria-hidden="true">publish<br />before<br />perfect.</div>
        </div>

        <a class="big-link reveal" href={`${base}archive/`}><span>OPEN THE NOTE ARCHIVE</span><b>→</b></a>
      </section>

      <section class="profile scene" id="profile" aria-labelledby="profile-title">
        <div class="profile-type" aria-hidden="true">N</div>
        <div class="profile-photo reveal">
          <div class="profile-photo__frame"><img src={`${base}images/avatar.webp`} alt="" /></div>
          <span>YES, I REDESIGN MY OWN SITE TOO OFTEN.</span>
        </div>

        <div class="profile-copy reveal">
          <span class="eyebrow">04 / HUMAN BEHIND THE TABS</span>
          <h2 id="profile-title">Hi. I’m<br />Naman Patel.</h2>
          <p class="profile-copy__lead">I work on SEO, build websites and useful tools, and write about what I learn while making them.</p>
          <p>I’m happiest when something goes from “what if?” to an actual thing someone can open, use, install or complain about.</p>
          <div class="profile-links">
            <a href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            <a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer">X ↗</a>
            <a href={`${base}about/`}>Actual about page →</a>
          </div>
        </div>

        <div class="profile-labels reveal" aria-label="Things Naman likes">
          <span>ASTRO</span><span>SEARCH</span><span>ANDROID</span><span>CHAi</span><span>ONE PIECE</span><span>TINY TOOLS</span><span>WEIRD IDEAS</span>
        </div>
      </section>
    </main>

    <footer class="lab-footer">
      <div><b>NAMAN.BLOG</b><span>creative test / do not index</span></div>
      <p>If this version wins, the normal site is in trouble.</p>
      <a href="#top">back to chaos ↑</a>
    </footer>

    <script>
      const revealItems = document.querySelectorAll('.reveal');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      revealItems.forEach((item) => observer.observe(item));

      const cursor = document.querySelector('[data-cursor]');
      if (cursor && window.matchMedia('(pointer: fine)').matches) {
        window.addEventListener('pointermove', (event) => {
          cursor.style.transform = `translate(${event.clientX}px, ${event.clientY}px)`;
        });
        document.querySelectorAll('a, button').forEach((item) => {
          item.addEventListener('pointerenter', () => cursor.classList.add('is-hot'));
          item.addEventListener('pointerleave', () => cursor.classList.remove('is-hot'));
        });
      }

      const playground = document.querySelector('[data-playground]');
      const floaters = playground ? Array.from(playground.querySelectorAll('[data-float]')) : [];
      if (playground && window.matchMedia('(pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        playground.addEventListener('pointermove', (event) => {
          const box = playground.getBoundingClientRect();
          const x = (event.clientX - box.left) / box.width - 0.5;
          const y = (event.clientY - box.top) / box.height - 0.5;
          floaters.forEach((item) => {
            const amount = Number(item.getAttribute('data-float') || 1);
            item.style.setProperty('--px', `${x * amount * 18}px`);
            item.style.setProperty('--py', `${y * amount * 14}px`);
          });
        });
        playground.addEventListener('pointerleave', () => {
          floaters.forEach((item) => {
            item.style.setProperty('--px', '0px');
            item.style.setProperty('--py', '0px');
          });
        });
      }

      const chaosButton = document.querySelector('[data-chaos]');
      chaosButton?.addEventListener('click', () => {
        playground?.classList.toggle('is-chaos');
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --acid: #d8ff4f;
    --pink: #ff5f87;
    --blue: #75d8ff;
    --orange: #ff764d;
    --cream: #f5f0df;
    --paper: #fffaf0;
    --ink: #121212;
    --muted: #5d5a50;
    --deep: #14182b;
    --line: rgba(18, 18, 18, 0.22);
    --sans: Inter, Geist, "Arial Narrow", Arial, sans-serif;
    --serif: Georgia, Cambria, "Times New Roman", serif;
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--cream); }
  body { min-width: 320px; margin: 0; color: var(--ink); background: var(--cream); font-family: var(--sans); overflow-x: hidden; }
  ::selection { background: var(--pink); color: var(--ink); }
  a { color: inherit; }
  img { max-width: 100%; }
  button { font: inherit; }

  .cursor-dot {
    position: fixed;
    z-index: 9999;
    top: -9px;
    left: -9px;
    width: 18px;
    height: 18px;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--acid);
    pointer-events: none;
    transition: width 160ms ease, height 160ms ease, margin 160ms ease, background 160ms ease;
    will-change: transform;
  }
  .cursor-dot.is-hot { width: 38px; height: 38px; margin: -10px 0 0 -10px; background: var(--pink); mix-blend-mode: multiply; }

  .lab-nav {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    width: 100%;
    min-height: 72px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    padding: 10px clamp(16px, 3vw, 46px);
    border-bottom: 1px solid var(--ink);
    background: color-mix(in srgb, var(--cream) 86%, transparent);
    backdrop-filter: blur(12px);
  }
  .lab-brand { display: inline-flex; align-items: center; gap: 10px; justify-self: start; text-decoration: none; }
  .lab-brand__mark { width: 42px; height: 42px; display: grid; place-items: center; border: 1px solid var(--ink); border-radius: 50%; background: var(--acid); font-size: 23px; font-weight: 900; transform: rotate(-8deg); }
  .lab-brand__copy { display: flex; flex-direction: column; line-height: 1; }
  .lab-brand__copy b { font-size: 14px; letter-spacing: -0.04em; }
  .lab-brand__copy small { margin-top: 4px; font-family: var(--mono); font-size: 8px; text-transform: uppercase; letter-spacing: 0.08em; }
  .lab-nav nav { display: flex; align-items: center; gap: clamp(12px, 2.5vw, 34px); }
  .lab-nav nav a, .exit-test { font-family: var(--mono); font-size: 10px; font-weight: 700; text-decoration: none; text-transform: uppercase; }
  .lab-nav nav a { display: inline-flex; gap: 5px; }
  .lab-nav nav a span { color: var(--orange); }
  .lab-nav nav a:hover, .exit-test:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .exit-test { justify-self: end; padding: 8px 12px; border: 1px solid var(--ink); background: var(--paper); box-shadow: 3px 3px 0 var(--ink); }

  main { padding-top: 72px; }
  .scene { position: relative; padding: clamp(72px, 10vw, 150px) clamp(18px, 4vw, 64px); }

  .hero { min-height: calc(100svh - 72px); padding-top: clamp(32px, 5vw, 64px); padding-bottom: 40px; background: var(--acid); overflow: hidden; isolation: isolate; }
  .hero-grid { position: absolute; inset: 0; z-index: -2; opacity: 0.18; background-image: linear-gradient(var(--ink) 1px, transparent 1px), linear-gradient(90deg, var(--ink) 1px, transparent 1px); background-size: 54px 54px; mask-image: linear-gradient(to bottom, #000 65%, transparent); }
  .hero::before { content: ''; position: absolute; z-index: -1; width: min(56vw, 720px); aspect-ratio: 1; right: -16vw; top: -25vw; border: 1px solid var(--ink); border-radius: 50%; background: var(--blue); }
  .hero-kicker { display: flex; justify-content: space-between; gap: 2rem; font-family: var(--mono); font-size: clamp(8px, 1vw, 11px); font-weight: 700; letter-spacing: 0.08em; }
  .hero-title-wrap { position: relative; z-index: 3; display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 0.35fr); gap: 2rem; align-items: end; margin-top: clamp(24px, 4vw, 54px); }
  .hero h1 { margin: 0; font-size: clamp(78px, 15vw, 236px); font-weight: 950; line-height: 0.7; letter-spacing: -0.095em; text-transform: uppercase; }
  .hero h1 > span { display: block; white-space: nowrap; }
  .hero h1 > span:nth-child(2) { margin-left: 0.11em; font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.11em; }
  .hero h1 > span:nth-child(3) { margin-left: 0.28em; }
  .hero-title__cut { display: inline-block; color: var(--pink); -webkit-text-stroke: 2px var(--ink); transform: rotate(8deg) translateY(-0.02em); }
  .hero-title__ring { display: inline-grid; place-items: center; width: 0.78em; height: 0.78em; border: 0.045em solid var(--ink); border-radius: 50%; color: var(--cream); background: var(--deep); font-family: var(--sans); font-style: normal; font-size: 0.82em; transform: rotate(-8deg); }
  .hero-intro { max-width: 28ch; margin: 0 0 0.6rem; font-family: var(--serif); font-size: clamp(17px, 2vw, 25px); line-height: 1.25; }

  .hero-playground { position: relative; z-index: 5; height: clamp(360px, 36vw, 530px); max-width: 1440px; margin: clamp(-28px, -2vw, -8px) auto 0; }
  [data-float] { --px: 0px; --py: 0px; transition: transform 360ms cubic-bezier(.2,.8,.2,1); }
  .orbit { position: absolute; border: 1px solid var(--ink); border-radius: 50%; pointer-events: none; }
  .orbit--one { width: 47%; aspect-ratio: 1; top: 0; left: 24%; transform: translate(var(--px), var(--py)) rotate(-12deg); }
  .orbit--two { width: 34%; aspect-ratio: 1; top: 12%; left: 31%; border-style: dashed; transform: translate(var(--px), var(--py)) rotate(18deg); }

  .artifact { position: absolute; border: 1px solid var(--ink); color: var(--ink); box-shadow: 7px 7px 0 var(--ink); }
  .artifact-label { font-family: var(--mono); font-size: 8px; font-weight: 800; letter-spacing: 0.08em; }
  .artifact--terminal { left: 4%; top: 15%; width: clamp(210px, 24vw, 340px); padding: 12px 14px 16px; background: var(--deep); color: #e9ffd0; transform: translate(var(--px), var(--py)) rotate(-5deg); }
  .artifact-bar { display: flex; align-items: center; gap: 4px; padding-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,.28); }
  .artifact-bar i { width: 7px; height: 7px; border-radius: 50%; background: var(--pink); }
  .artifact-bar i:nth-child(2) { background: var(--orange); }
  .artifact-bar i:nth-child(3) { background: var(--acid); }
  .artifact-bar span { margin-left: auto; font-family: var(--mono); font-size: 8px; }
  .artifact--terminal code { display: block; margin-top: 12px; font-family: var(--mono); font-size: 11px; }
  .artifact--terminal code b { color: var(--acid); }
  .artifact--terminal p { margin: 7px 0 0; font-family: var(--mono); font-size: 9px; }
  .artifact--terminal p span { color: var(--acid); }
  .artifact--terminal strong { display: block; margin-top: 12px; color: var(--acid); font-size: clamp(28px, 4vw, 50px); line-height: 0.8; }

  .artifact--phone { left: 35%; top: 1%; width: clamp(180px, 20vw, 285px); padding: 13px; background: var(--pink); transform: translate(var(--px), var(--py)) rotate(6deg); }
  .mini-phone { padding: 13px; border: 2px solid var(--ink); border-radius: 24px; background: var(--paper); }
  .mini-phone__brand { font-size: 12px; font-weight: 900; }
  .mini-phone__file { margin-top: 20px; padding: 13px; border: 1px solid var(--ink); background: #f7de55; }
  .mini-phone__file s, .mini-phone__file b { display: block; font-size: clamp(20px, 2.6vw, 34px); line-height: 1; }
  .mini-phone__file b { margin-top: 6px; color: #147c70; }
  .mini-phone__buttons { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; margin-top: 9px; }
  .mini-phone__buttons i { height: 13px; border: 1px solid var(--ink); }
  .artifact--phone .artifact-label { display: block; margin-top: 8px; }

  .artifact--search { right: 5%; top: 15%; width: clamp(190px, 22vw, 310px); padding: 15px; background: var(--paper); transform: translate(var(--px), var(--py)) rotate(4deg); }
  .search-chart { height: 100px; display: flex; align-items: end; gap: 7px; margin: 15px 0 8px; padding: 10px; border: 1px solid var(--ink); background: #dff5ff; }
  .search-chart i { flex: 1; height: var(--h); border: 1px solid var(--ink); background: var(--blue); }
  .artifact--search strong { font-family: var(--serif); font-size: 20px; }

  .artifact--wheel { left: 15%; bottom: 2%; width: clamp(165px, 18vw, 245px); padding: 12px; background: var(--orange); transform: translate(var(--px), var(--py)) rotate(7deg); }
  .tiny-wheel { position: relative; aspect-ratio: 1; border: 3px solid var(--ink); border-radius: 50%; background: conic-gradient(var(--acid) 0 25%, var(--pink) 25% 50%, var(--blue) 50% 75%, var(--paper) 75%); }
  .tiny-wheel b { position: absolute; inset: 35%; display: grid; place-items: center; border: 2px solid var(--ink); border-radius: 50%; background: var(--deep); color: white; font-size: 9px; }
  .tiny-wheel span { position: absolute; font-family: var(--serif); font-size: 19px; font-weight: 800; }
  .tiny-wheel span:nth-of-type(1) { top: 8%; left: 48%; }
  .tiny-wheel span:nth-of-type(2) { right: 10%; top: 45%; }
  .tiny-wheel span:nth-of-type(3) { bottom: 8%; left: 48%; }
  .tiny-wheel span:nth-of-type(4) { left: 10%; top: 45%; }
  .artifact--wheel .artifact-label { display: block; margin-top: 7px; }

  .hero-sticker { position: absolute; z-index: 4; display: grid; place-items: center; border: 1px solid var(--ink); box-shadow: 4px 4px 0 var(--ink); text-align: center; }
  .hero-sticker--ship { right: 28%; bottom: 9%; width: 94px; height: 94px; border-radius: 50%; background: var(--blue); font-size: 23px; font-weight: 950; line-height: 0.86; transform: translate(var(--px), var(--py)) rotate(-12deg); }
  .hero-sticker--why { right: 9%; bottom: 5%; padding: 14px 17px; background: var(--acid); font-family: var(--serif); font-size: 15px; line-height: 1.05; transform: translate(var(--px), var(--py)) rotate(-7deg); }
  .hero-sticker--why b { font-style: italic; }
  .chaos-button { position: absolute; left: 50%; bottom: 2%; display: inline-flex; align-items: center; gap: 9px; padding: 10px 14px; border: 1px solid var(--ink); border-radius: 999px; background: var(--paper); box-shadow: 3px 3px 0 var(--ink); font-family: var(--mono); font-size: 9px; font-weight: 800; text-transform: uppercase; cursor: pointer; transform: translateX(-50%); }
  .chaos-button b { font-size: 16px; }
  .hero-playground.is-chaos .artifact--terminal { transform: translate(var(--px), var(--py)) rotate(7deg) translate(-12px, 6px); }
  .hero-playground.is-chaos .artifact--phone { transform: translate(var(--px), var(--py)) rotate(-8deg) translate(12px, 4px); }
  .hero-playground.is-chaos .artifact--search { transform: translate(var(--px), var(--py)) rotate(-6deg) translate(-8px, -5px); }
  .hero-playground.is-chaos .artifact--wheel { transform: translate(var(--px), var(--py)) rotate(-9deg) translate(10px, -4px); }
  .hero-playground.is-chaos .hero-sticker--ship { transform: translate(var(--px), var(--py)) rotate(17deg) scale(1.12); }
  .hero-playground.is-chaos .hero-sticker--why { transform: translate(var(--px), var(--py)) rotate(8deg); }

  .hero-foot { display: flex; justify-content: space-between; gap: 2rem; align-items: end; padding-top: 18px; border-top: 1px solid var(--ink); font-family: var(--mono); font-size: 10px; }
  .hero-foot p { max-width: 62ch; margin: 0; }
  .hero-foot a { font-weight: 800; text-decoration: none; white-space: nowrap; }
