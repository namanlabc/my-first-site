  .art-smallmb__phone b { margin-top: 5px; color: #147c70; }
  .art-smallmb__phone footer { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; margin-top: 8px; }
  .art-smallmb__phone footer i { padding: 6px 2px; border: 1px solid var(--ink); font-family: var(--mono); font-size: 6px; font-style: normal; text-align: center; }

  .art-badge { position: absolute; z-index: 5; right: 5%; top: 6%; width: clamp(64px, 8vw, 92px); aspect-ratio: 1; display: grid; place-items: center; border: 1px solid var(--ink); border-radius: 50%; background: var(--pink); font-family: var(--mono); font-size: 9px; font-weight: 900; line-height: 1.05; text-align: center; transform: rotate(9deg); }
  .work-piece--audit .work-piece__art { background: #143f36; color: #eaffd0; }
