---
import { getCollection } from 'astro:content';
import { projects } from '../../data/projects';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const projectHref = (project: (typeof projects)[number]) => {
  if (!project.href) return `${base}projects/`;
  if (project.href.startsWith('/')) return `${base}${project.href.replace(/^\//, '')}`;
  return project.href;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b10" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>Naman Unit 001 · Creative Test</title>
    <meta name="description" content="An alternate experimental redesign for Naman Patel's personal site." />
  </head>

  <body>
    <header class="hud">
      <a class="hud-mark" href="#top" aria-label="Naman test home">
        <span>NP</span><small>UNIT 001</small>
      </a>

      <nav aria-label="Test navigation">
        <a class="is-active" href="#top">HOME</a>
        <a href="#works">WORKS</a>
        <a href="#profile">PROFILE</a>
        <a href="#notes">NOTES</a>
      </nav>

      <a class="hud-exit" href={`${base}`}>REAL SITE ↗</a>
    </header>

    <main id="top">
      <section class="hero-shell" aria-labelledby="hero-title">
        <div class="hero-frame">
          <div class="hero-status" aria-hidden="true">
            <span>●</span><span>○</span><span>1</span><span>0</span><span>9</span>
          </div>

          <div class="hero-scene">
            <div class="wire-grid" aria-hidden="true"></div>

            <svg class="hero-cables" viewBox="0 0 1000 1320" preserveAspectRatio="none" aria-hidden="true">
              <path class="cable cable-a" d="M430 340 C235 220, 112 315, 28 500 C-45 662, 120 770, 250 702" />
              <path class="cable cable-b" d="M565 300 C760 170, 915 265, 985 425 C1040 555, 942 718, 780 700" />
              <path class="cable cable-c" d="M515 680 C690 735, 880 815, 952 1015" />
              <path class="cable cable-d" d="M450 705 C292 804, 150 902, 138 1110" />
            </svg>

            <div class="machine" data-float>
              <div class="machine-head">
                <div class="machine-head__top"><i></i><i></i><i></i><span>naman@unit:~</span></div>
                <div class="machine-eye">
                  <span></span>
                  <b>92</b>
                  <small>SEO HEALTH</small>
                </div>
                <code>$ build something useful_<br />$ ship before overthinking it</code>
              </div>

              <div class="machine-neck"><span></span><span></span><span></span></div>

              <div class="machine-body">
                <div class="body-label">N.P. / SHIPPING MACHINE</div>
                <div class="body-screen">
                  <div class="screen-line"><span>PROJECT</span><b>STATUS</b></div>
                  <div class="screen-row"><span>SmallMB</span><b>LAUNCHING</b></div>
                  <div class="screen-row"><span>Astro SEO Audit</span><b>OPEN SRC</b></div>
                  <div class="screen-row"><span>Get Random Letter</span><b>LIVE</b></div>
                  <div class="screen-row"><span>Calm WP</span><b>BETA</b></div>
                </div>
                <div class="body-switches"><i></i><i></i><i></i><i></i><i></i></div>
              </div>

              <div class="machine-hips">
                <span>SEO</span><span>WEB</span><span>APP</span><span>AI</span>
              </div>

              <div class="machine-legs">
                <div class="machine-leg machine-leg--left">
                  <div class="leg-panel"><small>INPUT</small><b>IDEA</b><i></i><small>OUTPUT</small><b>SHIP</b></div>
                </div>
                <div class="machine-leg machine-leg--right">
                  <div class="leg-panel leg-panel--chart"><small>TRAFFIC</small><div><i></i><i></i><i></i><i></i><i></i></div><b>↑</b></div>
                </div>
              </div>

              <div class="machine-feet"><span>01</span><span>02</span></div>
            </div>

            <aside class="micro-window micro-window--left" data-float aria-label="SmallMB detail">
              <header><span>smallmb.apk</span><b>×</b></header>
              <div class="mini-phone">
                <small>PHOTO.JPG</small>
                <s>12.4 MB</s>
                <strong>842 KB</strong>
                <footer><i>COMPRESS</i><i>RESIZE</i><i>PDF</i></footer>
              </div>
            </aside>

            <aside class="micro-window micro-window--right" data-float aria-label="Search detail">
              <header><span>search.graph</span><b>×</b></header>
              <div class="mini-chart"><i></i><i></i><i></i><i></i><i></i><i></i></div>
              <p>impressions / climbing</p>
            </aside>

            <div class="tag tag--one">BUILD SMALL<br />SHIP OFTEN</div>
            <div class="tag tag--two">NO MAGIC.<br />JUST ITERATION.</div>
          </div>

          <div class="hero-meta">
            <div>
              <span>1:09 / personal internet workshop</span>
              <span>seo · products · code · notes</span>
            </div>
            <h1 id="hero-title">Naman Patel.</h1>
            <p>I build useful things for the internet and write down what I learn before I forget it.</p>
            <a href="#works">enter the workshop ↓</a>
          </div>
        </div>
      </section>

      <section class="works" id="works" aria-labelledby="works-title">
        <div class="section-cap"><span>01</span><span>SELECTED WORK</span><i></i><span>2026</span></div>
        <div class="works-heading">
          <h2 id="works-title">Stuff that made it<br /><em>out of the folder.</em></h2>
          <p>Each one started as “this might be useful.” Some of them survived contact with reality.</p>
        </div>

        <div class="works-list">
          {projects.map((project, index) => (
            <article class="project-row">
              <a
                href={projectHref(project)}
                target={project.external ? '_blank' : undefined}
                rel={project.external ? 'noopener noreferrer' : undefined}
              >
                <span class="project-row__no">0{index + 1}</span>
                <div class:list={['project-row__visual', `visual--${project.visual ?? 'notes'}`]} aria-hidden="true">
                  {project.visual === 'smallmb' && <div class="visual-phone"><small>smallmb</small><s>12.4 MB</s><b>842 KB</b><i>OFFLINE</i></div>}
                  {project.visual === 'audit' && <div class="visual-terminal"><code>$ astro-seo-audit</code><b>92 / 100</b><span>✓ schema &nbsp; ✓ canonical</span></div>}
                  {project.visual === 'wheel' && <div class="visual-wheel"><span>A</span><span>G</span><span>M</span><span>R</span><b>spin</b></div>}
                  {project.visual === 'calm' && <div class="visual-page"><small>CALM</small><h3>Less noise.<br />More reading.</h3><p></p><p></p><p></p></div>}
                  {project.visual === 'notes' && <div class="visual-notes"><small>NOTE 07</small><b>I wanted Yoast for Astro,<br />so I built it.</b></div>}
                </div>
                <div class="project-row__copy">
                  <span>{project.kind} · {project.status}</span>
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                </div>
                <b class="project-row__arrow">↗</b>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="profile" id="profile" aria-labelledby="profile-title">
        <div class="section-cap section-cap--dark"><span>02</span><span>PROFILE</span><i></i><span>ABOUT THE OPERATOR</span></div>
        <div class="profile-grid">
          <div class="profile-copy">
            <span class="profile-kicker">Naman Patel / builder + SEO person</span>
            <h2 id="profile-title">Somewhere between<br /><em>search nerd</em> and<br />product tinkerer.</h2>
            <p>I like the awkward middle where an idea turns into an interface, the interface turns into code, and then the data tells you whether anyone cared.</p>
            <div class="profile-links"><a href={`${base}about/`}>ABOUT →</a><a href={`${base}experience/`}>EXPERIENCE →</a><a href="https://github.com/namanlabc/">GITHUB ↗</a></div>
          </div>

          <div class="instrument-panel" aria-label="Skills instrument panel">
            <div class="instrument-head"><span>TOOLING / ACTIVE</span><span>● ONLINE</span></div>
            <div class="instrument-row"><b>SEARCH</b><div><i style="--w:92%"></i></div><span>92</span></div>
            <div class="instrument-row"><b>WEB</b><div><i style="--w:87%"></i></div><span>87</span></div>
            <div class="instrument-row"><b>PRODUCT</b><div><i style="--w:84%"></i></div><span>84</span></div>
            <div class="instrument-row"><b>ANDROID</b><div><i style="--w:71%"></i></div><span>71</span></div>
            <div class="instrument-row"><b>AGENTS</b><div><i style="--w:89%"></i></div><span>89</span></div>
            <div class="instrument-tools"><span>ASTRO</span><span>TAILWIND</span><span>GITHUB</span><span>CLAUDE</span><span>CODEX</span><span>OPENCODE</span><span>GSC</span><span>WORDPRESS</span></div>
          </div>
        </div>
      </section>

      <section class="notes" id="notes" aria-labelledby="notes-title">
        <div class="section-cap"><span>03</span><span>FIELD NOTES</span><i></i><span>LATEST WRITING</span></div>
        <div class="notes-heading"><h2 id="notes-title">Things worth<br /><em>remembering.</em></h2><a href={`${base}archive/`}>FULL ARCHIVE →</a></div>
        <div class="notes-list">
          {posts.map((post, index) => (
            <a class="note-row" href={`${base}blog/${post.id}/`}>
              <span>0{index + 1}</span>
              <div><small>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })}</small><h3>{post.data.title}</h3></div>
              <p>{post.data.description}</p>
              <b>↗</b>
            </a>
          ))}
        </div>
      </section>

      <footer class="test-footer">
        <div><span>NP / UNIT 001</span><small>experimental build</small></div>
        <p>Made while wondering if a personal site can feel more like a place than a page.</p>
        <a href="#top">BACK TO TOP ↑</a>
      </footer>
    </main>

    <script>
      const floaters = document.querySelectorAll<HTMLElement>('[data-float]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        window.addEventListener('pointermove', (event) => {
          const x = (event.clientX / window.innerWidth - 0.5);
          const y = (event.clientY / window.innerHeight - 0.5);
          floaters.forEach((el, index) => {
            const strength = 4 + (index % 3) * 3;
            el.style.setProperty('--mx', `${x * strength}px`);
            el.style.setProperty('--my', `${y * strength}px`);
          });
        });
      }
    </script>
  </body>
</html>

<style>
  :root { --bg:#0b0b10; --panel:#111118; --ink:#f0efe9; --muted:#8d8d98; --line:#30303a; --blue:#4ea7ff; --violet:#8f86ff; --acid:#c4ff57; --paper:#e7e6df; --black:#0a0a0f; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; background:var(--bg); color:var(--ink); font-family:Inter, Geist, "Segoe UI", sans-serif; }
  body { margin:0; min-width:320px; background:var(--bg); color:var(--ink); }
  a { color:inherit; text-decoration:none; }
  ::selection { background:var(--blue); color:#07101d; }

  .hud { position:fixed; z-index:50; top:0; left:0; right:0; height:64px; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; padding:0 22px; border-bottom:1px solid var(--line); background:color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter:blur(14px); font-family:"SFMono-Regular", Consolas, monospace; }
  .hud-mark { display:flex; align-items:center; gap:10px; width:max-content; }
  .hud-mark > span { width:32px; height:32px; display:grid; place-items:center; border:1px solid #575765; font-size:10px; font-weight:800; }
  .hud-mark small { color:var(--muted); font-size:9px; letter-spacing:.12em; }
  .hud nav { display:flex; align-items:center; gap:4px; padding:4px; border:1px solid #454550; border-radius:4px; }
  .hud nav a { padding:7px 13px; border-radius:2px; color:#a5a5af; font-size:9px; letter-spacing:.08em; }
  .hud nav a.is-active, .hud nav a:hover { color:#0b0b10; background:var(--paper); }
  .hud-exit { justify-self:end; padding:8px 11px; border:1px solid #585865; border-radius:999px; font-size:9px; letter-spacing:.08em; }

  .hero-shell { padding:80px 14px 14px; background:var(--bg); }
  .hero-frame { position:relative; max-width:1500px; margin:0 auto; min-height:calc(100svh - 94px); border:1px solid #343440; border-radius:6px; overflow:hidden; background:#0d0d13; }
  .hero-status { position:absolute; top:10px; right:14px; z-index:8; display:flex; gap:8px; color:#a9a9b2; font:9px "SFMono-Regular", monospace; }
  .hero-status span:first-child { color:var(--ink); }

  .hero-scene { position:relative; min-height:1120px; overflow:hidden; }
  .wire-grid { position:absolute; left:50%; top:150px; width:min(72vw,760px); height:820px; transform:translateX(-50%) perspective(700px) rotateX(2deg); opacity:.5; background-image:linear-gradient(#33343d 1px,transparent 1px),linear-gradient(90deg,#33343d 1px,transparent 1px); background-size:42px 42px; mask-image:linear-gradient(to bottom,transparent 0,#000 10%,#000 88%,transparent 100%); }
  .hero-cables { position:absolute; inset:40px 0 auto 0; width:100%; height:1040px; overflow:visible; pointer-events:none; }
  .cable { fill:none; stroke-width:18; stroke-linecap:round; filter:drop-shadow(0 8px 0 rgba(0,0,0,.3)); }
  .cable-a { stroke:var(--blue); }
  .cable-b { stroke:var(--violet); }
  .cable-c { stroke:#5e65ff; stroke-width:12; }
  .cable-d { stroke:#72c9ff; stroke-width:12; }

  [data-float] { transform:translate(var(--mx,0),var(--my,0)); transition:transform 180ms ease-out; }
  .machine { position:absolute; z-index:5; top:100px; left:50%; width:min(52vw,520px); transform:translateX(-50%) translate(var(--mx,0),var(--my,0)); filter:drop-shadow(0 30px 30px rgba(0,0,0,.38)); }
  .machine-head { width:76%; margin:0 auto; border:2px solid #0a0a0e; border-radius:30px 30px 18px 18px; overflow:hidden; background:#b9b4ff; box-shadow:inset 0 0 0 1px rgba(255,255,255,.35), 14px 14px 0 #273f95; }
  .machine-head__top { height:32px; display:flex; align-items:center; gap:7px; padding:0 13px; border-bottom:1px solid #232335; background:#efeee8; color:#1b1b23; font:9px "SFMono-Regular", monospace; }
  .machine-head__top i { width:6px; height:6px; border-radius:50%; background:#1b1b23; }
  .machine-head__top span { margin-left:auto; }
  .machine-eye { position:relative; width:160px; height:120px; margin:34px auto 20px; border:2px solid #0b0b10; border-radius:50%; background:#151525; box-shadow:0 0 0 12px rgba(78,167,255,.18); overflow:hidden; color:#fff; }
  .machine-eye > span { position:absolute; width:54px; height:54px; left:50%; top:50%; border-radius:50%; background:var(--blue); transform:translate(-50%,-50%); box-shadow:0 0 0 14px #26264a,0 0 32px rgba(78,167,255,.9); }
  .machine-eye b { position:absolute; left:14px; top:10px; font:700 28px/1 "SFMono-Regular", monospace; }
  .machine-eye small { position:absolute; right:11px; bottom:10px; width:70px; text-align:right; font:8px/1.2 "SFMono-Regular", monospace; letter-spacing:.06em; }
  .machine-head code { display:block; padding:0 24px 28px; color:#161620; font:10px/1.6 "SFMono-Regular", Consolas, monospace; }
  .machine-neck { width:22%; height:70px; margin:0 auto; display:flex; justify-content:center; gap:9px; padding-top:10px; background:#dcd9ff; border-inline:2px solid #0b0b10; }
  .machine-neck span { width:8px; height:46px; border-radius:99px; background:#2b2b42; }
  .machine-body { position:relative; width:88%; margin:0 auto; padding:20px 22px 24px; border:2px solid #08080c; border-radius:32px 32px 24px 24px; background:#e9e7df; color:#101017; box-shadow:12px 12px 0 #4ea7ff; }
  .body-label { margin-bottom:14px; font:8px "SFMono-Regular", monospace; letter-spacing:.12em; }
  .body-screen { padding:12px 14px; border:2px solid #111119; background:#101019; color:#e7e7ee; font:9px "SFMono-Regular", monospace; }
  .screen-line,.screen-row { display:grid; grid-template-columns:1fr auto; gap:20px; padding:8px 0; border-bottom:1px solid #323241; }
  .screen-line { color:#737386; }
  .screen-row:last-child { border-bottom:0; }
  .screen-row b { color:var(--acid); font-weight:500; }
  .body-switches { display:flex; gap:9px; margin-top:18px; }
  .body-switches i { width:34px; height:13px; border:2px solid #111119; border-radius:99px; background:#fff; }
  .body-switches i:nth-child(2), .body-switches i:nth-child(5) { background:#ff7bb7; }
  .machine-hips { width:68%; margin:0 auto; display:grid; grid-template-columns:repeat(4,1fr); border:2px solid #09090e; border-top:0; background:#8e86ff; color:#0b0b10; }
  .machine-hips span { padding:10px 4px; border-right:1px solid #17171d; text-align:center; font:8px "SFMono-Regular", monospace; }
  .machine-hips span:last-child { border-right:0; }
  .machine-legs { width:63%; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:24px; }
  .machine-leg { min-height:390px; padding:24px 13px 14px; border-inline:2px solid #09090e; border-bottom:2px solid #09090e; border-radius:0 0 38px 38px; background:#a49dfc; }
  .machine-leg--right { background:#77bdf5; }
  .leg-panel { min-height:280px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:9px; border:1px solid rgba(10,10,16,.65); border-radius:24px; color:#111118; font-family:"SFMono-Regular", monospace; }
  .leg-panel small { font-size:7px; letter-spacing:.1em; }
  .leg-panel b { font-size:20px; }
  .leg-panel > i { width:2px; height:82px; background:#121219; }
  .leg-panel--chart div { height:110px; display:flex; align-items:end; gap:5px; }
  .leg-panel--chart div i { width:10px; background:#101017; }
  .leg-panel--chart div i:nth-child(1){height:28%}.leg-panel--chart div i:nth-child(2){height:42%}.leg-panel--chart div i:nth-child(3){height:35%}.leg-panel--chart div i:nth-child(4){height:67%}.leg-panel--chart div i:nth-child(5){height:90%}
  .leg-panel--chart > b { color:#0a3f74; font-size:34px; }
  .machine-feet { width:79%; margin:-2px auto 0; display:flex; justify-content:space-between; }
  .machine-feet span { width:44%; padding:18px; border:2px solid #08080c; border-radius:34px 34px 16px 16px; background:#dad8ff; color:#111118; font:8px "SFMono-Regular",monospace; }
  .machine-feet span:last-child { background:#d8efff; }

  .micro-window { position:absolute; z-index:7; width:210px; border:1px solid #555563; background:#111118; box-shadow:0 18px 40px rgba(0,0,0,.3); }
  .micro-window header { height:27px; display:flex; align-items:center; justify-content:space-between; padding:0 9px; border-bottom:1px solid #4b4b57; color:#c3c3ca; font:8px "SFMono-Regular", monospace; }
  .micro-window--left { top:530px; left:7%; transform:rotate(-2deg) translate(var(--mx,0),var(--my,0)); }
  .micro-window--right { top:425px; right:7%; transform:rotate(2deg) translate(var(--mx,0),var(--my,0)); }
  .mini-phone { margin:16px; padding:13px; border:1px solid #646470; background:#e8e7df; color:#15151d; }
  .mini-phone small,.mini-phone s,.mini-phone strong { display:block; }
  .mini-phone small { font:7px "SFMono-Regular",monospace; }
  .mini-phone s { margin-top:12px; font-size:18px; }
  .mini-phone strong { color:#126b96; font-size:25px; }
  .mini-phone footer { display:grid; grid-template-columns:repeat(3,1fr); gap:4px; margin-top:12px; }
  .mini-phone footer i { padding:5px 2px; border:1px solid #17171d; text-align:center; font:5px "SFMono-Regular",monospace; font-style:normal; }
  .mini-chart { height:120px; display:flex; align-items:end; gap:8px; padding:20px; }
  .mini-chart i { flex:1; background:#62baff; border:1px solid #a6d9ff; }
  .mini-chart i:nth-child(1){height:28%}.mini-chart i:nth-child(2){height:45%}.mini-chart i:nth-child(3){height:38%}.mini-chart i:nth-child(4){height:63%}.mini-chart i:nth-child(5){height:78%}.mini-chart i:nth-child(6){height:93%}
  .micro-window--right p { margin:0 20px 18px; color:#aaaab4; font:8px "SFMono-Regular",monospace; }
  .tag { position:absolute; z-index:8; padding:10px 12px; border:1px solid #52525e; background:#0f0f16; color:#dad9e0; font:8px/1.4 "SFMono-Regular",monospace; }
  .tag--one { top:280px; left:13%; transform:rotate(-6deg); }
  .tag--two { top:780px; right:11%; transform:rotate(5deg); }

  .hero-meta { position:absolute; z-index:10; left:18px; right:18px; bottom:18px; display:grid; grid-template-columns:1fr auto 1.2fr auto; gap:24px; align-items:end; padding-top:15px; border-top:1px solid #44444f; }
  .hero-meta > div { display:grid; gap:4px; color:#9a9aa5; font:8px "SFMono-Regular",monospace; }
  .hero-meta h1 { margin:0; font-family:Georgia,serif; font-size:clamp(25px,3vw,46px); font-weight:400; }
  .hero-meta p { max-width:40ch; margin:0; color:#aaaab3; font-size:12px; line-height:1.5; }
  .hero-meta > a { color:#c8c8cf; font:8px "SFMono-Regular",monospace; white-space:nowrap; }

  .works,.notes { padding:120px max(22px,6vw); background:#eceae3; color:#111118; }
  .section-cap { display:grid; grid-template-columns:auto auto 1fr auto; gap:12px; align-items:center; color:#65656c; font:8px "SFMono-Regular",monospace; letter-spacing:.08em; }
  .section-cap i { height:1px; background:#b8b6ae; }
  .works-heading,.notes-heading { display:grid; grid-template-columns:1.4fr .6fr; gap:40px; align-items:end; margin:60px 0 70px; }
