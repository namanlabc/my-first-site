  .skill-card__tools { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 26px; }
  .skill-card__tools b { padding: 5px 7px; border: 1px solid var(--ink); background: rgba(255,255,255,.35); font-family: var(--mono); font-size: 8px; }
  .skill-card--seo { background: var(--acid); }
  .skill-card--build { background: var(--blue); }
  .skill-card--agents { background: var(--pink); }
  .skill-card__visual { position: absolute; right: 7%; bottom: 5%; width: 60%; height: 150px; display: flex; align-items: end; gap: 7px; padding: 15px; border: 2px solid var(--ink); background: var(--paper); transform: rotate(-5deg); }
  .skill-card__visual i { flex: 1; border: 1px solid var(--ink); background: #27796e; }
  .skill-card__visual i:nth-child(1) { height: 34%; }.skill-card__visual i:nth-child(2) { height: 47%; }.skill-card__visual i:nth-child(3) { height: 54%; }.skill-card__visual i:nth-child(4) { height: 79%; }.skill-card__visual i:nth-child(5) { height: 92%; }
  .skill-card__window { position: absolute; right: 5%; bottom: 7%; width: 67%; border: 2px solid var(--ink); background: var(--deep); color: #eaffd0; box-shadow: 10px 10px 0 var(--ink); transform: rotate(4deg); }
  .skill-card__window div { height: 23px; border-bottom: 1px solid #eaffd0; background: linear-gradient(90deg, var(--pink) 0 8px, transparent 8px 16px, var(--acid) 16px 24px, transparent 24px); }
  .skill-card__window code { display: block; padding: 20px; font-family: var(--mono); font-size: 11px; line-height: 1.8; }
  .agent-diagram { position: absolute; right: 6%; bottom: 9%; display: flex; align-items: center; gap: 8px; transform: rotate(-5deg); }
  .agent-diagram b { min-width: 76px; padding: 17px 10px; border: 2px solid var(--ink); border-radius: 50%; background: var(--paper); font-family: var(--mono); font-size: 9px; text-align: center; }
  .agent-diagram i { width: 34px; height: 2px; background: var(--ink); }
  .skill-marquee { overflow: hidden; border-top: 1px solid var(--cream); }
  .skill-marquee { display: flex; width: max-content; animation: skillTicker 24s linear infinite; }
  .skill-marquee span { padding: 12px 0; color: var(--acid); font-family: var(--mono); font-size: 12px; font-weight: 900; white-space: nowrap; }
  @keyframes skillTicker { to { transform: translateX(-50%); } }

  .now { display: grid; grid-template-columns: minmax(280px,.55fr) minmax(0,1fr); gap: clamp(40px, 8vw, 120px); background: var(--orange); }
  .now-poster { position: sticky; top: 120px; align-self: start; }
  .now-poster h2 { margin: 10px 0 0; font-size: clamp(90px, 15vw, 220px); line-height: .65; letter-spacing: -.1em; }
  .now-poster h2 span { color: var(--acid); -webkit-text-stroke: 2px var(--ink); }
  .now-poster__stamp { width: 100px; height: 100px; display: grid; place-items: center; margin: 45px 0 0 auto; border: 2px solid var(--ink); border-radius: 50%; background: var(--paper); font-family: var(--mono); font-size: 13px; font-weight: 900; line-height: 1.1; text-align: center; transform: rotate(12deg); }
  .now-board { border-top: 2px solid var(--ink); }
  .now-row { display: grid; grid-template-columns: 38px minmax(150px,.8fr) minmax(230px,1.2fr) auto; gap: 20px; align-items: start; padding: 28px 0; border-bottom: 2px solid var(--ink); }
  .now-row > span { font-family: var(--mono); font-size: 10px; font-weight: 900; }
  .now-row div { display: flex; flex-direction: column; }
  .now-row div b { font-size: clamp(22px, 3vw, 38px); line-height: 1; letter-spacing: -.045em; }
  .now-row div small { margin-top: 6px; font-family: var(--mono); font-size: 8px; text-transform: uppercase; }
  .now-row p { max-width: 42ch; margin: 0; font-family: var(--serif); font-size: 15px; line-height: 1.4; }
  .now-row em { padding: 5px 8px; border: 1px solid var(--ink); background: var(--acid); font-family: var(--mono); font-size: 8px; font-style: normal; font-weight: 900; }
  .now-row--personal em { background: var(--pink); }

  .notes { background: #b5d4fb; }
