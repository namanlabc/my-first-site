  .work-piece__caption p { grid-column: 1; max-width: 50ch; margin: 5px 0 0; color: var(--muted); font-size: 12px; line-height: 1.5; }
  .work-piece__arrow { grid-column: 2; grid-row: 2 / 4; align-self: start; font-size: 30px; }
  .work-piece__word { position: absolute; z-index: -1; color: transparent; -webkit-text-stroke: 1px rgba(18,18,18,.24); font-size: clamp(80px, 13vw, 190px); font-weight: 950; letter-spacing: -.08em; line-height: .7; pointer-events: none; }
  .work-piece--1 .work-piece__word { left: 80%; top: 20%; transform: rotate(90deg); }
  .work-piece--2 .work-piece__word { right: 80%; top: 40%; }
  .work-piece--3 .work-piece__word { left: 84%; top: 30%; transform: rotate(-12deg); }
  .work-piece--4 .work-piece__word { right: 83%; top: 45%; }
  .work-piece--5 .work-piece__word { left: 90%; top: 26%; transform: rotate(12deg); }

  .work-piece--smallmb .work-piece__art { background: #9edfd9; }
  .art-smallmb { position: absolute; inset: 0; }
  .art-smallmb__phone { position: absolute; width: 58%; right: 10%; top: 9%; padding: 17px; border: 5px solid var(--ink); border-radius: 30px; background: var(--paper); transform: rotate(6deg); box-shadow: -18px 18px 0 var(--orange); }
  .art-smallmb__phone small { font-weight: 900; }
