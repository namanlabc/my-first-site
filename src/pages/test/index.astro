  .desk-note { position: absolute; width: min(38%, 500px); min-height: 310px; display: flex; flex-direction: column; padding: clamp(22px, 3vw, 40px); border: 1px solid var(--ink); background: var(--paper); box-shadow: 10px 10px 0 var(--ink); text-decoration: none; transition: transform 220ms ease; }
  .desk-note:hover { z-index: 10; transform: rotate(0deg) translateY(-8px) !important; }
  .desk-note--1 { left: 3%; top: 0; transform: rotate(-5deg); }
  .desk-note--2 { right: 7%; top: 60px; background: #ffd7e2; transform: rotate(4deg); }
  .desk-note--3 { left: 31%; top: 365px; background: #efff9e; transform: rotate(-2deg); }
  .desk-note--4 { left: 2%; top: 630px; background: #fff4c9; transform: rotate(5deg); }
  .desk-note--5 { right: 5%; top: 610px; background: #c5f3e9; transform: rotate(-5deg); }
  .desk-note__pin { position: absolute; top: 13px; left: 50%; width: 14px; height: 14px; border: 1px solid var(--ink); border-radius: 50%; background: var(--orange); box-shadow: 2px 2px 0 var(--ink); }
  .desk-note small { font-family: var(--mono); font-size: 9px; font-weight: 900; }
