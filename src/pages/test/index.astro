---
import { getCollection } from 'astro:content';
import { projects } from '../../data/projects';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const projectHref = (project: (typeof projects)[number]) => {
  if (!project.href) return `${base}projects/`;
  if (project.href.startsWith('/')) return `${base}${project.href.replace(/^\//, '')}`;
  return project.href;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#151515" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>The Fold · Naman Patel</title>
    <meta name="description" content="An experimental alternate redesign for Naman Patel's personal site." />
  </head>

  <body>
    <header class="topbar">
      <a href="#ship" class="identity" aria-label="Naman Patel creative test">
        <b>NP</b>
        <span>Naman Patel</span>
      </a>
      <p>THE FOLD / EXPERIMENT 003</p>
      <a href={`${base}`} class="exit">real site ↗</a>
    </header>

    <main class="fold" data-fold>
      <section class="panel panel--build" data-panel="build" id="build">
        <button class="panel-handle" type="button" data-panel-trigger aria-expanded="false">
          <span class="panel-no">01</span>
          <strong>BUILD</strong>
          <small>turning an idea into something you can touch</small>
          <b class="panel-plus" aria-hidden="true">+</b>
        </button>

        <div class="panel-body" data-panel-body>
          <div class="panel-intro">
            <span>01 / BUILD</span>
            <h1>I like the part where<br />the blank page <em>stops being blank.</em></h1>
            <p>Structure first. Then interface, code, QA, deploy, and the awkward final ten percent that decides whether a thing feels finished.</p>
          </div>

          <div class="build-flow" aria-label="How I build">
            <article><span>01</span><b>ROUGH IDEA</b><p>A sentence, screenshot, annoying problem or “what if?”</p></article>
            <i aria-hidden="true">→</i>
            <article><span>02</span><b>SHAPE IT</b><p>Scope, user flow, interface, content and edge cases.</p></article>
            <i aria-hidden="true">→</i>
            <article><span>03</span><b>MAKE IT REAL</b><p>Astro, Android, Tailwind, GitHub, whatever actually fits.</p></article>
            <i aria-hidden="true">→</i>
            <article><span>04</span><b>BREAK IT</b><p>QA, weird phones, bad inputs, boring checks, then ship.</p></article>
          </div>

          <div class="tool-ribbon" aria-label="Tools I use">
            <span>ASTRO</span><span>TAILWIND</span><span>ANDROID</span><span>GITHUB</span><span>VS CODE</span><span>CLAUDE</span><span>CODEX</span><span>OPENCODE</span>
          </div>
        </div>
      </section>

      <section class="panel panel--rank" data-panel="rank" id="rank">
        <button class="panel-handle" type="button" data-panel-trigger aria-expanded="false">
          <span class="panel-no">02</span>
          <strong>RANK</strong>
          <small>making useful pages findable</small>
          <b class="panel-plus" aria-hidden="true">+</b>
        </button>

        <div class="panel-body" data-panel-body>
          <div class="panel-intro panel-intro--rank">
            <span>02 / RANK</span>
            <h1>Search is less magic,<br />more <em>evidence.</em></h1>
            <p>Intent, technical SEO, content systems, schema, publishing, and watching what people actually click after the page goes live.</p>
          </div>

          <div class="rank-stage">
            <div class="rank-query">
              <small>SEARCH QUERY</small>
              <div><span>how do I</span><b>______</b><i>↵</i></div>
              <p>Start with the problem. Not the keyword spreadsheet.</p>
            </div>

            <div class="rank-graph" aria-label="Illustrative search growth graph">
              <div class="rank-graph__head"><span>SEARCH / 90 DAYS</span><b>↑ useful traffic</b></div>
              <div class="bars" aria-hidden="true">
                <i style="--h:22%"></i><i style="--h:31%"></i><i style="--h:28%"></i><i style="--h:42%"></i><i style="--h:52%"></i><i style="--h:48%"></i><i style="--h:67%"></i><i style="--h:78%"></i><i style="--h:92%"></i>
              </div>
              <footer><span>INTENT</span><span>TECHNICAL</span><span>CONTENT</span><span>MEASURE</span></footer>
            </div>

            <div class="rank-note">
              <b>THE RULE</b>
              <p>Make the page genuinely useful first. Then make it impossible for crawlers to misunderstand.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="panel panel--ship is-active" data-panel="ship" id="ship">
        <button class="panel-handle" type="button" data-panel-trigger aria-expanded="true">
          <span class="panel-no">03</span>
          <strong>SHIP</strong>
          <small>projects that escaped the ideas folder</small>
          <b class="panel-plus" aria-hidden="true">−</b>
        </button>

        <div class="panel-body" data-panel-body>
          <div class="panel-intro panel-intro--ship">
            <span>03 / SHIP</span>
            <h1>Things I made<br />instead of <em>just talking about them.</em></h1>
            <p>Some are useful. Some are weird. A few started as jokes and somehow became products.</p>
          </div>

          <div class="project-stack">
            {projects.map((project, index) => (
              <a
                class="project-line"
                href={projectHref(project)}
                target={project.external ? '_blank' : undefined}
                rel={project.external ? 'noopener noreferrer' : undefined}
              >
                <span class="project-line__index">{String(index + 1).padStart(2, '0')}</span>
                <div class="project-line__name"><b>{project.name}</b><small>{project.kind}</small></div>
                <p>{project.description}</p>
                <span class="project-line__status">{project.status}</span>
                <i aria-hidden="true">↗</i>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="panel panel--write" data-panel="write" id="write">
        <button class="panel-handle" type="button" data-panel-trigger aria-expanded="false">
          <span class="panel-no">04</span>
          <strong>WRITE</strong>
          <small>notes from the middle of figuring things out</small>
          <b class="panel-plus" aria-hidden="true">+</b>
        </button>

        <div class="panel-body" data-panel-body>
          <div class="panel-intro panel-intro--write">
            <span>04 / WRITE</span>
            <h1>I write things down<br />before my brain <em>deletes them.</em></h1>
            <p>Build logs, opinions, experiments, useful mistakes and whatever refused to leave me alone.</p>
          </div>

          <div class="writing-stack">
            {posts.map((post, index) => (
              <a href={`${base}blog/${post.id}/`} class="writing-line">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div><small>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</small><b>{post.data.title}</b></div>
                <p>{post.data.description}</p>
                <i>→</i>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="panel panel--me" data-panel="me" id="me">
        <button class="panel-handle" type="button" data-panel-trigger aria-expanded="false">
          <span class="panel-no">05</span>
          <strong>ME</strong>
          <small>the person causing all of this</small>
          <b class="panel-plus" aria-hidden="true">+</b>
        </button>

        <div class="panel-body" data-panel-body>
          <div class="me-layout">
            <div class="me-title">
              <span>05 / ME</span>
              <h1>Naman<br />Patel<span>.</span></h1>
            </div>

            <div class="me-copy">
              <p class="me-copy__lead">I work on SEO, build websites and useful tools, and write about what I learn while making them.</p>
              <p>Most of it starts with me wondering, “could I make this better?” Then I disappear into it for a while.</p>
              <div class="me-links">
                <a href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
                <a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer">X ↗</a>
                <a href={`${base}about/`}>About me →</a>
              </div>
            </div>

            <div class="me-aside">
              <small>OFF SCREEN</small>
              <p>Chai.<br />One Piece.<br />One more chapter.</p>
              <span>repeat forever ↻</span>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="bottom-note">
      <span>Five folds. One person. Too many tabs.</span>
      <span>naman.blog / test</span>
    </footer>

    <script>
      const fold = document.querySelector('[data-fold]');
      const panels = Array.from(document.querySelectorAll('[data-panel]'));

      function activate(panel, shouldScroll = false) {
        panels.forEach((item) => {
          const active = item === panel;
          item.classList.toggle('is-active', active);
          item.querySelector('[data-panel-trigger]')?.setAttribute('aria-expanded', String(active));
          const plus = item.querySelector('.panel-plus');
          if (plus) plus.textContent = active ? '−' : '+';
        });

        const name = panel?.getAttribute('data-panel');
        if (name) history.replaceState(null, '', `#${name}`);
        if (shouldScroll && window.innerWidth <= 760) panel?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      panels.forEach((panel) => {
        panel.querySelector('[data-panel-trigger]')?.addEventListener('click', () => activate(panel, true));
      });

      const initial = panels.find((panel) => `#${panel.getAttribute('data-panel')}` === location.hash);
      if (initial) activate(initial);

      fold?.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight' && event.key !== 'ArrowUp' && event.key !== 'ArrowDown') return;
        const current = panels.findIndex((panel) => panel.classList.contains('is-active'));
        const delta = event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 1;
        const next = panels[(current + delta + panels.length) % panels.length];
        event.preventDefault();
        activate(next, true);
        next.querySelector('[data-panel-trigger]')?.focus();
      });
    </script>

    <style>
      :root {
        --ink: #151515;
        --paper: #f0ebdf;
        --build: #7fa8e8;
        --rank: #c8d46d;
        --ship: #e96a55;
        --write: #afa2d6;
        --me: #e7dfcf;
        --rule: rgba(21, 21, 21, 0.45);
        font-family: Inter, Arial, Helvetica, sans-serif;
        color: var(--ink);
        background: var(--ink);
      }

      * { box-sizing: border-box; }
      html { background: var(--ink); scroll-behavior: smooth; }
      body { margin: 0; min-width: 320px; min-height: 100vh; background: var(--ink); overflow-x: hidden; }
      a { color: inherit; }
      button { font: inherit; }
      ::selection { background: var(--ink); color: var(--paper); }

      .topbar {
        height: 56px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
        padding: 0 18px;
        color: #f4f1e9;
        border-bottom: 1px solid rgba(255,255,255,.18);
        background: #151515;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 10px;
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      .identity { display: flex; align-items: center; gap: 10px; text-decoration: none; }
      .identity b { width: 25px; height: 25px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.5); font-size: 9px; }
      .identity span { opacity: .72; }
      .topbar p { margin: 0; opacity: .52; }
      .exit { justify-self: end; text-decoration: none; opacity: .72; }

      .fold {
        height: calc(100svh - 92px);
        min-height: 620px;
        display: flex;
        width: 100%;
        overflow: hidden;
        background: var(--paper);
      }

      .panel {
        position: relative;
        flex: .72 1 0;
        min-width: 74px;
        overflow: hidden;
        border-right: 1px solid var(--rule);
        transition: flex 720ms cubic-bezier(.16,1,.3,1), filter 260ms ease;
        isolation: isolate;
      }

      .panel:last-child { border-right: 0; }
      .panel.is-active { flex: 5.4 1 0; }
      .panel:not(.is-active) { filter: saturate(.78); }
      .panel--build { background: var(--build); }
      .panel--rank { background: var(--rank); }
      .panel--ship { background: var(--ship); }
      .panel--write { background: var(--write); }
      .panel--me { background: var(--me); }

      .panel-handle {
        position: absolute;
        inset: 0 auto 0 0;
        z-index: 3;
        width: 74px;
        padding: 18px 12px;
        border: 0;
        border-right: 1px solid var(--rule);
        color: var(--ink);
        background: transparent;
        cursor: pointer;
        text-align: left;
      }

      .panel-handle .panel-no { position: absolute; top: 18px; left: 12px; font: 9px ui-monospace, monospace; }
      .panel-handle strong {
        position: absolute;
        top: 54px;
        left: 14px;
        font-size: clamp(1.5rem, 2vw, 2.2rem);
        line-height: 1;
        letter-spacing: -.06em;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
      }
      .panel-handle small {
        position: absolute;
        bottom: 56px;
        left: 14px;
        width: 140px;
        color: rgba(21,21,21,.62);
        font: 9px/1.35 ui-monospace, monospace;
        transform: rotate(-90deg);
        transform-origin: left bottom;
        white-space: nowrap;
      }
      .panel-plus { position: absolute; right: 12px; bottom: 12px; font-size: 18px; font-weight: 400; }

      .panel-body {
        height: 100%;
        margin-left: 74px;
        padding: clamp(28px, 4vw, 58px);
        opacity: 0;
        transform: translateX(24px);
        pointer-events: none;
        overflow: auto;
        transition: opacity 200ms ease, transform 360ms ease;
      }

      .panel.is-active .panel-body {
        opacity: 1;
        transform: none;
        pointer-events: auto;
        transition-delay: 180ms;
      }

      .panel-intro { display: grid; grid-template-columns: minmax(0,1.3fr) minmax(220px,.7fr); gap: 2rem; align-items: end; }
      .panel-intro > span,
      .me-title > span { grid-column: 1 / -1; font: 10px ui-monospace, monospace; letter-spacing: .08em; }
      .panel-intro h1,
      .me-title h1 { margin: 0; max-width: 860px; font-size: clamp(2.6rem, 5.8vw, 6.6rem); line-height: .9; letter-spacing: -.075em; font-weight: 750; }
      .panel-intro h1 em { font-family: Georgia, serif; font-weight: 400; }
      .panel-intro > p { margin: 0 0 .4rem; max-width: 34ch; font-size: clamp(.85rem, 1.3vw, 1.05rem); line-height: 1.5; }

      .build-flow { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr; gap: 14px; align-items: stretch; margin-top: clamp(38px, 7vh, 80px); }
      .build-flow article { min-height: 180px; display: flex; flex-direction: column; padding: 16px; border: 1px solid var(--rule); background: rgba(255,255,255,.17); }
      .build-flow article span { font: 9px ui-monospace, monospace; }
      .build-flow article b { margin-top: auto; font-size: clamp(1.1rem, 1.8vw, 1.5rem); letter-spacing: -.045em; }
      .build-flow article p { margin: 8px 0 0; font-size: 12px; line-height: 1.45; }
      .build-flow > i { align-self: center; font-style: normal; }
      .tool-ribbon { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 20px; }
      .tool-ribbon span { padding: 6px 8px; border: 1px solid var(--rule); font: 9px ui-monospace, monospace; }

      .rank-stage { position: relative; display: grid; grid-template-columns: .8fr 1.35fr .75fr; gap: 18px; margin-top: clamp(38px, 7vh, 76px); align-items: stretch; }
      .rank-query, .rank-graph, .rank-note { border: 1px solid var(--rule); background: rgba(255,255,255,.18); padding: 18px; }
      .rank-query small, .rank-note b, .rank-graph__head { font: 9px ui-monospace, monospace; letter-spacing: .06em; }
      .rank-query > div { display: flex; align-items: center; gap: 7px; margin-top: 48px; border-bottom: 2px solid var(--ink); padding-bottom: 8px; font-family: Georgia, serif; font-size: clamp(1.2rem,2vw,2rem); }
      .rank-query > div b { flex: 1; overflow: hidden; }
      .rank-query > div i { font-style: normal; }
      .rank-query p, .rank-note p { margin: 20px 0 0; font-size: 12px; line-height: 1.5; }
      .rank-graph { min-height: 240px; display: flex; flex-direction: column; }
      .rank-graph__head { display: flex; justify-content: space-between; gap: 1rem; }
      .rank-graph__head b { color: #354100; }
      .bars { flex: 1; display: flex; align-items: end; gap: 7px; padding: 25px 0 14px; border-bottom: 1px solid var(--rule); }
      .bars i { flex: 1; height: var(--h); min-height: 6px; background: var(--ink); }
      .rank-graph footer { display: flex; justify-content: space-between; gap: 8px; padding-top: 8px; font: 8px ui-monospace, monospace; }
      .rank-note { display: flex; flex-direction: column; justify-content: flex-end; }
      .rank-note b { margin-bottom: auto; }
      .rank-note p { font-family: Georgia, serif; font-size: clamp(1rem,1.5vw,1.3rem); }

      .project-stack, .writing-stack { margin-top: clamp(36px, 6vh, 68px); border-top: 1px solid var(--rule); }
      .project-line { display: grid; grid-template-columns: 36px minmax(150px,.7fr) minmax(260px,1.4fr) auto 24px; gap: 18px; align-items: center; min-height: 82px; padding: 12px 4px; border-bottom: 1px solid var(--rule); text-decoration: none; transition: padding 220ms ease, background 220ms ease; }
      .project-line:hover { padding-inline: 12px; background: rgba(255,255,255,.16); }
      .project-line__index { font: 9px ui-monospace, monospace; }
      .project-line__name b { display: block; font-size: clamp(1.15rem,2vw,1.7rem); letter-spacing: -.045em; }
      .project-line__name small { font: 9px ui-monospace, monospace; text-transform: uppercase; }
      .project-line p { margin: 0; max-width: 50ch; font-size: 12px; line-height: 1.45; }
      .project-line__status { padding: 5px 7px; border: 1px solid var(--rule); font: 9px ui-monospace, monospace; text-transform: uppercase; }
      .project-line i { font-style: normal; }

      .writing-line { display: grid; grid-template-columns: 34px minmax(160px,.8fr) minmax(220px,1.3fr) 24px; gap: 18px; align-items: center; min-height: 88px; padding: 10px 4px; border-bottom: 1px solid var(--rule); text-decoration: none; }
      .writing-line > span, .writing-line small { font: 9px ui-monospace, monospace; }
      .writing-line b { display: block; margin-top: 4px; font-size: clamp(1rem,1.6vw,1.35rem); letter-spacing: -.035em; }
      .writing-line p { margin: 0; font-size: 12px; line-height: 1.45; }
      .writing-line i { font-style: normal; }

      .me-layout { height: 100%; display: grid; grid-template-columns: 1.1fr .85fr .55fr; gap: clamp(30px,5vw,80px); align-items: center; }
      .me-title h1 span { color: #c34634; }
      .me-copy__lead { font-family: Georgia, serif; font-size: clamp(1.3rem,2.2vw,2rem); line-height: 1.35; }
      .me-copy p:not(.me-copy__lead) { max-width: 38ch; font-size: 13px; line-height: 1.6; }
      .me-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
      .me-links a { padding: 8px 10px; border: 1px solid var(--rule); font: 9px ui-monospace, monospace; text-decoration: none; }
      .me-aside { align-self: end; padding: 16px; border: 1px solid var(--rule); }
      .me-aside small, .me-aside span { font: 9px ui-monospace, monospace; }
      .me-aside p { margin: 24px 0; font-family: Georgia, serif; font-size: clamp(1.2rem,2vw,1.8rem); line-height: 1.25; }

      .bottom-note {
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 18px;
        color: rgba(255,255,255,.55);
        background: var(--ink);
        font: 8px ui-monospace, monospace;
        letter-spacing: .07em;
        text-transform: uppercase;
      }

      @media (max-width: 900px) {
        .topbar { grid-template-columns: 1fr auto; }
        .topbar p { display: none; }
        .fold { height: calc(100svh - 92px); min-height: 560px; }
        .panel-handle { width: 62px; }
        .panel { min-width: 62px; }
        .panel-body { margin-left: 62px; padding: 30px 24px; }
        .panel-intro { grid-template-columns: 1fr; gap: 14px; }
        .panel-intro > p { max-width: 48ch; }
        .build-flow { grid-template-columns: repeat(2,1fr); }
        .build-flow > i { display: none; }
        .rank-stage { grid-template-columns: 1fr 1fr; }
        .rank-note { grid-column: 1 / -1; min-height: 120px; }
        .project-line { grid-template-columns: 30px minmax(130px,.7fr) 1fr auto; }
        .project-line p { display: none; }
        .project-line i { display: none; }
        .me-layout { grid-template-columns: 1fr 1fr; }
        .me-aside { grid-column: 1 / -1; }
      }

      @media (max-width: 760px) {
        body { overflow: auto; }
        .topbar { position: sticky; top: 0; z-index: 20; height: 50px; padding-inline: 12px; }
        .identity span { display: none; }
        .fold { height: auto; min-height: calc(100svh - 86px); flex-direction: column; overflow: visible; }
        .panel { flex: none; min-width: 0; min-height: 72px; border-right: 0; border-bottom: 1px solid var(--rule); transition: min-height 640ms cubic-bezier(.16,1,.3,1); }
        .panel.is-active { flex: none; min-height: calc(100svh - 86px); }
        .panel-handle { position: relative; width: 100%; height: 72px; display: grid; grid-template-columns: 34px auto 1fr 20px; gap: 10px; align-items: center; padding: 0 14px; border-right: 0; border-bottom: 1px solid var(--rule); }
        .panel-handle .panel-no, .panel-handle strong, .panel-handle small, .panel-plus { position: static; }
        .panel-handle strong { writing-mode: horizontal-tb; transform: none; font-size: 1.6rem; }
        .panel-handle small { width: auto; transform: none; transform-origin: initial; white-space: normal; text-align: right; font-size: 8px; }
        .panel-plus { justify-self: end; }
        .panel-body { height: auto; min-height: calc(100svh - 158px); margin-left: 0; padding: 22px 16px 34px; display: none; opacity: 1; transform: none; overflow: visible; }
        .panel.is-active .panel-body { display: block; }
        .panel-intro { display: block; }
        .panel-intro > span { display: block; margin-bottom: 20px; }
        .panel-intro h1 { font-size: clamp(2.6rem, 13vw, 4.5rem); }
        .panel-intro > p { margin-top: 18px; font-size: .86rem; }
        .build-flow { grid-template-columns: 1fr; margin-top: 30px; }
        .build-flow article { min-height: 125px; }
        .rank-stage { grid-template-columns: 1fr; margin-top: 30px; }
