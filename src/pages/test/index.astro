  .work-piece--3 { left: 10%; top: 690px; width: min(39%, 515px); }
  .work-piece--4 { right: 5%; top: 870px; width: min(45%, 600px); }
  .work-piece--5 { left: 2%; top: 1320px; width: min(43%, 560px); }
  .work-piece__number { position: absolute; z-index: 5; top: -25px; left: -18px; display: grid; place-items: center; width: 55px; height: 55px; border: 1px solid var(--ink); border-radius: 50%; background: var(--acid); font-family: var(--mono); font-size: 12px; font-weight: 900; transform: rotate(-9deg); }
  .work-piece__art { position: relative; min-height: clamp(270px, 33vw, 470px); border: 1px solid var(--ink); overflow: hidden; box-shadow: 9px 9px 0 var(--ink); transition: transform 260ms ease, box-shadow 260ms ease; }
  .work-piece > a:hover .work-piece__art { transform: translate(-5px, -5px) rotate(-1deg); box-shadow: 15px 15px 0 var(--ink); }
  .work-piece__caption { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 7px 20px; padding-top: 16px; }
  .work-piece__caption > div { display: flex; gap: 8px; grid-column: 1 / -1; }
  .work-piece__caption > div span { padding: 4px 7px; border: 1px solid var(--ink); font-family: var(--mono); font-size: 8px; font-weight: 800; text-transform: uppercase; }
