  .art-audit__score b { margin-top: 8px; color: var(--acid); font-size: clamp(55px, 8vw, 100px); line-height: .8; }
  .art-audit__score span { font-family: var(--mono); }
  .art-audit__terminal { position: absolute; right: 7%; bottom: 9%; width: 54%; padding: 16px; border: 1px solid #eaffd0; background: #102720; transform: rotate(-4deg); }
  .art-audit__terminal code, .art-audit__terminal p { font-family: var(--mono); font-size: 9px; }
  .art-audit__terminal p { margin: 8px 0 0; }
  .work-piece--audit .art-badge { background: var(--blue); color: var(--ink); }

  .work-piece--wheel .work-piece__art { background: #f3db4e; }
  .art-wheel__disc { position: absolute; right: -8%; top: 3%; width: 72%; aspect-ratio: 1; border: 6px solid var(--ink); border-radius: 50%; background: conic-gradient(var(--orange) 0 25%, var(--paper) 25% 50%, #27796e 50% 75%, var(--pink) 75%); }
  .art-wheel__disc b { position: absolute; inset: 35%; display: grid; place-items: center; border: 3px solid var(--ink); border-radius: 50%; background: var(--ink); color: white; font-family: var(--mono); font-size: 9px; }
  .art-wheel__disc span { position: absolute; font-family: var(--serif); font-size: clamp(24px, 4vw, 52px); font-weight: 900; }
  .art-wheel__disc span:nth-child(1) { top: 5%; left: 46%; }
  .art-wheel__disc span:nth-child(2) { right: 7%; top: 45%; }
  .art-wheel__disc span:nth-child(3) { bottom: 4%; left: 47%; }
  .art-wheel__disc span:nth-child(4) { left: 7%; top: 45%; }
  .art-wheel p { position: absolute; left: 6%; top: 9%; font-family: var(--mono); font-size: clamp(10px, 1.2vw, 14px); font-weight: 900; line-height: 1.1; }
  .work-piece--wheel .art-badge { top: auto; bottom: 8%; right: auto; left: 5%; background: var(--blue); }

  .work-piece--calm .work-piece__art { background: #d9d5c6; }
  .art-calm__paper { position: absolute; left: 13%; top: 8%; width: 69%; height: 84%; padding: clamp(20px, 3vw, 42px); border: 1px solid var(--ink); background: var(--paper); box-shadow: 15px 15px 0 #6f9c83; transform: rotate(-3deg); }
  .art-calm__paper small { font-family: var(--mono); font-size: 8px; }
  .art-calm__paper h3 { margin: clamp(28px, 5vw, 58px) 0 0; font-family: var(--serif); font-size: clamp(32px, 5vw, 67px); font-weight: 400; line-height: .9; letter-spacing: -.05em; }
  .art-calm__paper p { width: 80%; height: 1px; margin: 14px 0 0; background: var(--line); }
  .art-calm__paper p:nth-of-type(2) { width: 68%; }
  .art-calm__paper p:nth-of-type(3) { width: 74%; }
  .art-calm__spark { position: absolute; right: 7%; top: 18%; color: var(--orange); font-size: clamp(44px, 8vw, 100px); transform: rotate(14deg); }
  .work-piece--calm .art-badge { top: auto; bottom: 7%; background: var(--acid); }

  .work-piece--notes .work-piece__art { background: #a8c6ef; }
  .note { position: absolute; width: 65%; padding: clamp(20px, 3vw, 36px); border: 1px solid var(--ink); background: var(--paper); box-shadow: 9px 9px 0 var(--ink); }
  .note small { font-family: var(--mono); font-size: 8px; }
  .note b { display: block; margin-top: 18px; font-family: var(--serif); font-size: clamp(22px, 3.5vw, 44px); font-weight: 400; line-height: 1.04; }
  .note--a { left: 8%; top: 16%; transform: rotate(-7deg); }
  .note--b { right: 6%; bottom: 8%; background: #ffd4df; transform: rotate(5deg); }
  .work-piece--notes .art-badge { background: var(--orange); }

  .work-end { max-width: 1380px; display: flex; justify-content: space-between; gap: 2rem; margin: 20px auto 0; padding-top: 18px; border-top: 1px solid var(--ink); font-family: var(--mono); font-size: 10px; }
  .work-end a { font-weight: 900; text-decoration: none; }

  .skills { padding-inline: 0; color: var(--cream); background: var(--deep); }
  .skills .scene-heading { padding-inline: clamp(18px, 4vw, 64px); }
  .scene-heading--inverse .eyebrow { color: var(--acid); }
  .scene-heading--inverse h2 em { color: var(--pink); }
  .skill-deck { max-width: 1500px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin: 0 auto; border-block: 1px solid var(--cream); background: var(--cream); }
  .skill-card { position: relative; min-height: 580px; padding: clamp(24px, 3.5vw, 52px); color: var(--ink); overflow: hidden; }
  .skill-card > span { font-family: var(--mono); font-size: 11px; font-weight: 900; }
