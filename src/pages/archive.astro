---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import WritingItem from '../components/WritingItem.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const postsByYear: Record<number, typeof posts> = {};

for (const post of sortedPosts) {
  const year = post.data.pubDate.getFullYear();
  postsByYear[year] ??= [];
  postsByYear[year].push(post);
}

const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Writing archive" description="A chronological archive of everything Naman has published on Naman.blog.">
  <div class="shell shell--content page-intro page-intro--archive">
    <h1>Everything I’ve written here.</h1>
    <p>{sortedPosts.length} notes so far, newest first. No feed deciding which one deserves your attention.</p>
  </div>

  <div class="shell shell--content archive">
    {years.length === 0 ? (
      <p class="empty-state">Nothing published yet. The first note is still finding its way here.</p>
    ) : years.map((year) => (
      <section class="archive-year" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`}>{year}</h2>
        <div class="writing-list writing-list--archive">
          {postsByYear[year].map((post) => (
            <WritingItem
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              href={`${base}blog/${post.id}/`}
              tags={post.data.tags}
              compact
            />
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>
