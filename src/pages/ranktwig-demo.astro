    <script>
      const storageKey = 'ranktwig-theme';
      const allowedThemes = new Set(['dark', 'light', 'system']);
      const themeMedia = window.matchMedia('(prefers-color-scheme: light)');
      const resolveTheme = (preference) => preference === 'system' ? (themeMedia.matches ? 'light' : 'dark') : preference;
      const updateThemeControls = (preference) => {
        document.querySelectorAll('[data-theme-option]').forEach((button) => {
          const selected = button.dataset.themeOption === preference;
          button.setAttribute('aria-pressed', String(selected));
          button.toggleAttribute('data-selected', selected);
        });
      };
      const applyThemePreference = (requested, persist = true) => {
        const preference = allowedThemes.has(requested) ? requested : 'light';
        const resolved = resolveTheme(preference);
        const root = document.documentElement;
        root.dataset.themePreference = preference;
        root.dataset.theme = resolved;
        root.style.colorScheme = resolved;
        root.classList.toggle('dark', resolved === 'dark');
        root.classList.toggle('light', resolved === 'light');
        const themeColor = document.querySelector('meta[data-ranktwig-theme-color]');
        if (themeColor) themeColor.content = resolved === 'light' ? '#f7f7f8' : '#09090b';
        if (persist) {
          try { window.localStorage.setItem(storageKey, preference); } catch {}
        }
        updateThemeControls(preference);
        window.dispatchEvent(new CustomEvent('ranktwig:themechange', { detail: { preference, resolved } }));
      };
      updateThemeControls(document.documentElement.dataset.themePreference || 'light');
      document.querySelectorAll('[data-theme-option]').forEach((button) => {
        button.addEventListener('click', () => applyThemePreference(button.dataset.themeOption || 'light'));
      });
      themeMedia.addEventListener('change', () => {
        if (document.documentElement.dataset.themePreference === 'system') applyThemePreference('system', false);
      });
      window.addEventListener('storage', (event) => {
        if (event.key !== storageKey || !event.newValue || !allowedThemes.has(event.newValue)) return;
        applyThemePreference(event.newValue, false);
      });

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const root = document.documentElement;
      root.classList.add('motion-ready');

      const revealNow = (element) => element.classList.add('is-visible');
      const revealTargets = [...document.querySelectorAll('.reveal-target')];

      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealTargets.forEach(revealNow);
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            revealNow(entry.target);
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.16, rootMargin: '0px 0px -6% 0px' });
        revealTargets.forEach((target) => observer.observe(target));
      }

      const route = document.querySelector('.route');
      const routeGlow = document.querySelector('.route-glow');
      const nodes = [...document.querySelectorAll('.route-node, .destination')];
      const terrainLabels = [...document.querySelectorAll('.terrain-label')];

      if (route instanceof SVGPathElement) {
        const length = route.getTotalLength();
        [route, routeGlow].forEach((path) => {
          if (!(path instanceof SVGPathElement)) return;
          path.style.strokeDasharray = `${length}`;
          path.style.strokeDashoffset = reduceMotion ? '0' : `${length}`;
        });
        if (!reduceMotion) {
          requestAnimationFrame(() => {
            route.style.transition = 'stroke-dashoffset 1800ms cubic-bezier(.22,1,.36,1) 420ms';
            route.style.strokeDashoffset = '0';
            if (routeGlow instanceof SVGPathElement) {
              routeGlow.style.transition = 'stroke-dashoffset 1900ms cubic-bezier(.22,1,.36,1) 440ms';
              routeGlow.style.strokeDashoffset = '0';
            }
          });
          nodes.forEach((node, index) => setTimeout(() => node.classList.add('is-active'), 700 + index * 360));
          terrainLabels.forEach((card, index) => setTimeout(() => card.classList.add('is-active'), 900 + index * 430));
        } else {
          nodes.forEach((node) => node.classList.add('is-active'));
          terrainLabels.forEach((card) => card.classList.add('is-active'));
        }
      }

      const hero = document.querySelector('.hero');
      const terrain = document.querySelector('.terrain-wrap');
      if (!reduceMotion && hero instanceof HTMLElement && terrain instanceof HTMLElement && window.matchMedia('(pointer:fine)').matches) {
        let frame = 0;
        hero.addEventListener('pointermove', (event) => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            const rect = hero.getBoundingClientRect();
            const x = ((event.clientX - rect.left) / rect.width - .5) * 2;
            const y = ((event.clientY - rect.top) / rect.height - .5) * 2;
            terrain.style.setProperty('--parallax-x', `${x * 5}px`);
            terrain.style.setProperty('--parallax-y', `${y * 3}px`);
            hero.style.setProperty('--orb-x', `${x * 8}px`);
          });
        });
        hero.addEventListener('pointerleave', () => {
          terrain.style.setProperty('--parallax-x', '0px');
          terrain.style.setProperty('--parallax-y', '0px');
          hero.style.setProperty('--orb-x', '0px');
        });
      }

      const counters = [...document.querySelectorAll('[data-counter]')];
      const runCounter = (element) => {
        if (!(element instanceof HTMLElement) || element.dataset.counted === 'true') return;
        element.dataset.counted = 'true';
        const target = Number(element.dataset.counter || '0');
        const decimal = element.dataset.format === 'decimal';
        const duration = 760;
        const start = performance.now();
        const formatter = new Intl.NumberFormat('en-US', { maximumFractionDigits: decimal ? 1 : 0, minimumFractionDigits: decimal ? 1 : 0 });
        if (reduceMotion) { element.textContent = formatter.format(target); return; }
        const tick = (now) => {
          const progress = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - progress, 3);
          element.textContent = formatter.format(target * eased);
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      if (reduceMotion || !('IntersectionObserver' in window)) {
        counters.forEach(runCounter);
      } else {
        const counterObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.querySelectorAll?.('[data-counter]').forEach(runCounter);
            if (entry.target.matches?.('[data-counter]')) runCounter(entry.target);
            counterObserver.unobserve(entry.target);
          });
        }, { threshold: .35 });
        document.querySelectorAll('.metric-grid').forEach((grid) => counterObserver.observe(grid));
      }
    </script>
  </body>
