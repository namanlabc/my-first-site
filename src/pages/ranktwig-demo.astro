---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const rankTwigUrl = 'https://ranktwig.com';
---

<!doctype html>
<html lang="en" class="light" data-theme="light" data-theme-preference="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f8" data-ranktwig-theme-color />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="description" content="A private RankTwig homepage design experiment." />
    <link rel="icon" type="image/svg+xml" href={`${base}ranktwig-demo/ranktwig-mark.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <title>RankTwig homepage experiment</title>
    <script is:inline>
      (() => {
        const key = 'ranktwig-theme';
        const allowed = ['dark', 'light', 'system'];
        let preference = 'light';
        try {
          const saved = localStorage.getItem(key);
          if (saved && allowed.includes(saved)) preference = saved;
        } catch {}
        const resolved = preference === 'system'
          ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
          : preference;
        const root = document.documentElement;
        root.dataset.themePreference = preference;
        root.dataset.theme = resolved;
        root.classList.toggle('dark', resolved === 'dark');
        root.classList.toggle('light', resolved === 'light');
        root.style.colorScheme = resolved;
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="#top" aria-label="RankTwig home">
          <svg viewBox="0 0 40 40" aria-hidden="true">
            <rect width="40" height="40" rx="10" fill="currentColor"></rect>
            <path d="M8.5 30.2c4.1-3 7.7-6.4 10-10.2 1.7-2.8 2.7-5.8 3.1-9.3.1-1.1 1.8-1.1 1.9 0 .1 2.8-.6 5.6-1.4 7.7 2.7-2.1 5.5-4 8.4-5.7.9-.5 1.7.7 1.1 1.5-4.4 6.3-10.5 10.7-17.6 13 4.2.1 8 .8 11.4 2.1 1 .4.8 1.9-.3 2-5.6-.4-11.2-.8-18 1.6-1 .3-1.7-1.1-.8-1.7 1.6-1.2 2.1-1.8 2.6-2.7Z" fill="white"></path>
          </svg>
          <span>RankTwig</span>
        </a>

        <nav aria-label="Primary navigation">
          <a href="#product">Product</a>
          <a href="#proof">Evidence</a>
          <a href="#pricing">Pricing</a>
          <a href={`${rankTwigUrl}/mcp-guide`}>MCP</a>
        </nav>

        <div class="header-actions">
          <div class="theme-control" role="group" aria-label="Color theme">
            <button type="button" data-theme-option="system" aria-label="Use system theme" title="System theme">
              <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="4" width="14" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M7 17h6M10 14v3" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path></svg>
            </button>
            <button type="button" data-theme-option="light" aria-label="Use light theme" title="Light theme">
              <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M15.3 4.7l-1.4 1.4M6.1 13.9l-1.4 1.4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path></svg>
            </button>
            <button type="button" data-theme-option="dark" aria-label="Use dark theme" title="Dark theme">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15.7 12.6A6.2 6.2 0 0 1 7.4 4.3 6.3 6.3 0 1 0 15.7 12.6Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"></path></svg>
            </button>
          </div>
          <a class="login" href={`${rankTwigUrl}/login`}>Log in</a>
          <a class="button button-primary button-small" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Start Free <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </header>

    <main id="main-content">
      <section id="top" class="hero">
        <div class="shell hero-copy reveal">
          <a class="announcement" href="#product"><span></span> Evidence-first SEO intelligence <b aria-hidden="true">→</b></a>
          <h1>Your next SEO move is already in your data.</h1>
          <p>Connect Google Search Console. RankTwig finds the pages and queries worth acting on, shows you why they surfaced, and lets your AI work from the same evidence.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={`${rankTwigUrl}/login?intent=connect-gsc`}>See My Next Move <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href={`${rankTwigUrl}/demo`}>Explore the demo</a>
          </div>
          <div class="hero-meta"><span>Read-only GSC</span><span>Bring your own AI</span><span>ChatGPT + MCP</span></div>
        </div>

        <div class="hero-stage reveal" aria-hidden="true">
          <svg class="terrain" viewBox="0 0 1500 520" preserveAspectRatio="xMidYMax meet">
            <defs>
              <linearGradient id="terrainFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--terrain-top)"/><stop offset="1" stop-color="var(--terrain-bottom)"/></linearGradient>
              <linearGradient id="routeGradient" x1="110" y1="0" x2="1360" y2="0" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#fb923c" stop-opacity=".42"/><stop offset=".35" stop-color="#f97316"/><stop offset="1" stop-color="#ea580c"/></linearGradient>
              <filter id="routeGlow"><feGaussianBlur stdDeviation="5"/></filter>
            </defs>
            <path class="terrain-back" d="M0 430L150 350L270 380L418 286L560 348L704 240L844 332L1000 236L1130 320L1280 224L1400 310L1500 270V520H0Z"/>
            <path class="terrain-front" fill="url(#terrainFill)" d="M0 482L180 402L330 445L485 344L620 407L760 310L900 401L1045 309L1190 394L1330 309L1438 365L1500 344V520H0Z"/>
            <g class="terrain-lines" fill="none" stroke-linecap="round"><path d="M-30 476C154 425 274 472 432 406C570 348 674 392 811 353C951 312 1040 363 1184 330C1305 302 1394 314 1530 335"/><path d="M-20 501C160 459 292 493 442 439C575 391 691 424 825 391C959 358 1052 402 1198 374C1319 351 1412 361 1532 378"/><path d="M80 459C191 409 286 423 388 376M1006 349C1115 308 1210 324 1319 283"/></g>
            <path class="route-glow" d="M110 459C249 413 318 467 439 428C555 391 621 350 732 377C849 406 922 363 1032 382C1150 402 1224 333 1362 318"/>
            <path class="route" d="M110 459C249 413 318 467 439 428C555 391 621 350 732 377C849 406 922 363 1032 382C1150 402 1224 333 1362 318"/>
            <g class="route-node" transform="translate(110 459)"><circle r="7"/><circle r="2.5" class="node-core"/></g>
            <g class="route-node" transform="translate(732 377)"><circle r="7"/><circle r="2.5" class="node-core"/></g>
            <g class="route-node" transform="translate(1362 318)"><circle r="12"/><circle r="4" class="node-core"/></g>
          </svg>

          <div class="opportunity-card">
            <div class="opportunity-top"><span class="signal-dot"></span><small>OPPORTUNITY FOUND</small><b>High confidence</b></div>
            <strong>/best-service-guide/</strong>
            <p>Demand is there. Clicks are not.</p>
            <div class="opportunity-metrics"><span><b>1,240</b><small>impressions</small></span><span><b>9</b><small>clicks</small></span><span><b>21.6</b><small>avg. position</small></span></div>
            <div class="opportunity-action"><small>NEXT MOVE</small><b>Fix the snippet before rewriting the page.</b><span>→</span></div>
          </div>
        </div>
      </section>

      <section id="product" class="product-section">
        <div class="shell">
          <div class="section-intro reveal">
            <p class="eyebrow">THE PRODUCT</p>
            <h2>Less dashboard. More direction.</h2>
            <p>RankTwig doesn’t dump another wall of SEO metrics on you. It turns the evidence into the next investigation, comparison, or update worth making.</p>
          </div>

          <article class="card investigator-card reveal">
            <div class="card-copy">
              <span class="card-kicker blue">PAGE INVESTIGATOR</span>
              <h3>Know what’s worth fixing before you rewrite anything.</h3>
              <p>See search demand, ranking queries, movement, and current page evidence together—then focus on the part most worth testing.</p>
            </div>
            <div class="investigator-ui">
              <div class="ui-bar"><span>/best-service-guide/</span><span>28 days vs previous 28</span></div>
              <div class="metric-grid">
                <div><small>IMPRESSIONS</small><strong data-counter="1240">1,240</strong><em>+18%</em></div>
                <div><small>CLICKS</small><strong data-counter="9">9</strong><em class="down">−12%</em></div>
                <div><small>POSITION</small><strong data-counter="21.6" data-decimal="true">21.6</strong><em>+2.1</em></div>
              </div>
              <div class="query-list"><div><span>trail running shoes</span><small>620 imp.</small><b>18.7</b></div><div><span>best trail shoes</span><small>381 imp.</small><b>22.4</b></div><div><span>trail shoes guide</span><small>239 imp.</small><b>28.9</b></div></div>
              <div class="why-row"><small>WHY THIS SURFACED</small><div><span>Striking distance</span><span>CTR gap</span><span>Demand rising</span></div><b>Investigate →</b></div>
            </div>
          </article>

          <div class="secondary-grid">
            <article class="card battle-card reveal">
              <div class="card-copy">
                <span class="card-kicker orange">PAGE BATTLE</span>
                <h3>See what the competing page does differently.</h3>
                <p>Compare observable differences in intent, coverage, links, schema, and trust cues—then decide what’s actually worth changing.</p>
              </div>
              <div class="battle-ui">
                <div><small>YOUR PAGE</small><strong>Useful guide</strong><span>Weak decision section</span></div><i>VS</i><div><small>COMPETITOR</small><strong>Commercial guide</strong><span>Clear comparison + trust cues</span></div>
              </div>
              <div class="decision-strip"><small>NEXT MOVE</small><strong>Strengthen the decision section first.</strong></div>
            </article>

            <article class="card mcp-card reveal">
              <div class="card-copy">
                <span class="card-kicker indigo">CHATGPT + MCP</span>
                <h3>Ask ChatGPT about your site. Bring the evidence with you.</h3>
                <p>RankTwig gives compatible AI clients the relevant page, query, and opportunity context so the answer starts from your data—not generic SEO advice.</p>
              </div>
              <div class="chat-ui"><p class="user-bubble">What should I work on today?</p><div class="ai-bubble"><strong>Start with /best-service-guide/.</strong><p>1,240 impressions · 9 clicks · positions 18–29.</p><div><span>GSC</span><span>3 queries</span><span>Fresh crawl</span></div></div></div>
            </article>
          </div>
        </div>
      </section>

      <section id="proof" class="proof-section">
        <div class="shell proof-grid">
          <div class="proof-copy reveal"><p class="eyebrow">SHOW THE RECEIPTS</p><h2>Every recommendation should tell you where it came from.</h2><p>RankTwig separates what it observed, what it calculated, and what your AI inferred—so you can judge the move before you make it.</p></div>
          <article class="proof-card reveal">
            <div class="proof-row observed"><span><i></i>OBSERVED</span><strong>Clicks fell 12% while rankings held.</strong><small>Google Search Console · last 28 days</small></div>
            <div class="proof-row calculated"><span><i></i>CALCULATED</span><strong>The CTR gap deserves investigation.</strong><small>Deterministic RankTwig signal</small></div>
            <div class="proof-row inferred"><span><i></i>AI INFERENCE</span><strong>The snippet is the lowest-risk first test.</strong><small>Reasoning over bounded evidence</small></div>
            <div class="proof-row action"><span><i></i>ACTION</span><strong>Rewrite title + description, then measure.</strong><small>Source stays attached</small></div>
          </article>
        </div>
      </section>

      <section id="pricing" class="pricing-section">
        <div class="shell pricing-grid">
          <div class="pricing-copy reveal"><p class="eyebrow">TRY THE REAL WORKFLOW</p><h2>Start free. Upgrade for capacity.</h2><p>Connect one website, investigate real pages, and see whether RankTwig belongs in your workflow before paying for more.</p></div>
          <div class="plans reveal">
            <article><span>FREE</span><div><strong>$0</strong><small>forever</small></div><p>Enough to connect a site and use the core workflow.</p><ul><li>1 connected website</li><li>25 Page Investigations / month</li><li>10 Page Battles / month</li><li>5 Content Briefs / month</li></ul><a class="button button-secondary" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Start Free</a></article>
            <article class="pro"><span>PRO</span><div><strong>$29</strong><small>per month</small></div><p>More sites, more capacity, MCP, groups, and exports.</p><ul><li>Up to 5 websites</li><li>500 Investigations · 200 Battles</li><li>100 Content Briefs / month</li><li>ChatGPT + MCP</li></ul><a class="button button-primary" href={`${rankTwigUrl}/pricing`}>See Pro <span>→</span></a></article>
          </div>
        </div>
      </section>

      <section class="closing reveal"><div class="shell"><p class="eyebrow">THE DATA IS ALREADY THERE</p><h2>See the next move.</h2><p>Connect Search Console and let RankTwig turn scattered signals into something you can actually act on.</p><a class="button button-primary" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Connect Search Console <span>→</span></a></div></section>
    </main>

    <footer><div class="shell footer-inner"><a class="brand" href="#top"><svg viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="10" fill="currentColor"></rect><path d="M8.5 30.2c4.1-3 7.7-6.4 10-10.2 1.7-2.8 2.7-5.8 3.1-9.3.1-1.1 1.8-1.1 1.9 0 .1 2.8-.6 5.6-1.4 7.7 2.7-2.1 5.5-4 8.4-5.7.9-.5 1.7.7 1.1 1.5-4.4 6.3-10.5 10.7-17.6 13 4.2.1 8 .8 11.4 2.1 1 .4.8 1.9-.3 2-5.6-.4-11.2-.8-18 1.6-1 .3-1.7-1.1-.8-1.7 1.6-1.2 2.1-1.8 2.6-2.7Z" fill="white"></path></svg><span>RankTwig</span></a><p>Evidence-first SEO intelligence.</p><nav><a href={`${rankTwigUrl}/privacy`}>Privacy</a><a href={`${rankTwigUrl}/terms`}>Terms</a><a href="mailto:team@ranktwig.com">Contact</a></nav></div></footer>

    <script>
      const themeKey = 'ranktwig-theme';
      const allowedThemes = new Set(['dark', 'light', 'system']);
      const media = matchMedia('(prefers-color-scheme: light)');
      const resolveTheme = (preference) => preference === 'system' ? (media.matches ? 'light' : 'dark') : preference;
      const updateButtons = (preference) => document.querySelectorAll('[data-theme-option]').forEach((button) => button.toggleAttribute('data-selected', button.dataset.themeOption === preference));
      const applyTheme = (preference, persist = true) => {
        if (!allowedThemes.has(preference)) preference = 'light';
        const resolved = resolveTheme(preference);
        const root = document.documentElement;
        root.dataset.themePreference = preference;
        root.dataset.theme = resolved;
        root.classList.toggle('dark', resolved === 'dark');
        root.classList.toggle('light', resolved === 'light');
        root.style.colorScheme = resolved;
        const meta = document.querySelector('[data-ranktwig-theme-color]');
        if (meta) meta.content = resolved === 'light' ? '#f7f7f8' : '#09090b';
        if (persist) try { localStorage.setItem(themeKey, preference); } catch {}
        updateButtons(preference);
      };
      updateButtons(document.documentElement.dataset.themePreference || 'light');
      document.querySelectorAll('[data-theme-option]').forEach((button) => button.addEventListener('click', () => applyTheme(button.dataset.themeOption || 'light')));
      media.addEventListener('change', () => { if (document.documentElement.dataset.themePreference === 'system') applyTheme('system', false); });

      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.documentElement.classList.add('motion-ready');
      const reveals = [...document.querySelectorAll('.reveal')];
      if (reduceMotion || !('IntersectionObserver' in window)) reveals.forEach((el) => el.classList.add('is-visible'));
      else {
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: .14, rootMargin: '0px 0px -5% 0px' });
        reveals.forEach((el) => observer.observe(el));
      }

      const route = document.querySelector('.route');
      const glow = document.querySelector('.route-glow');
      if (route instanceof SVGPathElement) {
        const length = route.getTotalLength();
        [route, glow].forEach((p) => { if (p instanceof SVGPathElement) { p.style.strokeDasharray = String(length); p.style.strokeDashoffset = reduceMotion ? '0' : String(length); } });
        if (!reduceMotion) requestAnimationFrame(() => {
          route.style.transition = 'stroke-dashoffset 1600ms cubic-bezier(.22,1,.36,1) 250ms';
          route.style.strokeDashoffset = '0';
          if (glow instanceof SVGPathElement) { glow.style.transition = 'stroke-dashoffset 1700ms cubic-bezier(.22,1,.36,1) 280ms'; glow.style.strokeDashoffset = '0'; }
        });
      }

      const counters = [...document.querySelectorAll('[data-counter]')];
      const runCounter = (el) => {
        if (!(el instanceof HTMLElement) || el.dataset.counted) return;
        el.dataset.counted = 'true';
        const target = Number(el.dataset.counter || 0);
        const decimal = el.dataset.decimal === 'true';
        if (reduceMotion) { el.textContent = target.toLocaleString('en-US', { maximumFractionDigits: decimal ? 1 : 0 }); return; }
        const started = performance.now();
        const tick = (now) => { const p = Math.min(1, (now - started) / 700); const eased = 1 - Math.pow(1 - p, 3); el.textContent = (target * eased).toLocaleString('en-US', { minimumFractionDigits: decimal ? 1 : 0, maximumFractionDigits: decimal ? 1 : 0 }); if (p < 1) requestAnimationFrame(tick); };
        requestAnimationFrame(tick);
      };
      if ('IntersectionObserver' in window && !reduceMotion) {
        const counterObserver = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.querySelectorAll('[data-counter]').forEach(runCounter); counterObserver.unobserve(entry.target); } }), { threshold: .35 });
        document.querySelectorAll('.metric-grid').forEach((el) => counterObserver.observe(el));
      } else counters.forEach(runCounter);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --canvas:#09090b;--surface:#121215;--raised:#18181b;--ink:#fafafa;--muted:#a1a1aa;--faint:#71717a;--line:#27272a;--soft-line:#1e1e22;
    --orange:#f97316;--orange-deep:#c84c0c;--orange-soft:rgb(249 115 22 / 9%);--blue:#2563eb;--blue-soft:rgb(37 99 235 / 9%);--green:#16a34a;--green-soft:rgb(22 163 74 / 9%);--indigo:#6366f1;--indigo-soft:rgb(99 102 241 / 9%);--red:#ef4444;
    --terrain-top:#202846;--terrain-bottom:#0c1020;--ease:cubic-bezier(.22,1,.36,1);--sans:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;--mono:"JetBrains Mono",ui-monospace,monospace;
  }
  :root[data-theme='light']{--canvas:#f7f7f8;--surface:#fff;--raised:#f4f4f5;--ink:#18181b;--muted:#52525b;--faint:#71717a;--line:#d4d4d8;--soft-line:#e4e4e7;--terrain-top:#dfe4f5;--terrain-bottom:#eef0f6;--blue-soft:#eef5ff;--green-soft:#eefaf2;--indigo-soft:#f0efff;--orange-soft:#fff3e9;color-scheme:light}
  :root[data-theme='dark']{color-scheme:dark}
  *,*::before,*::after{box-sizing:border-box} html{scroll-behavior:smooth;background:var(--canvas);font-family:var(--sans);color:var(--ink)} body{margin:0;overflow-x:hidden;background:var(--canvas);color:var(--ink);font-family:var(--sans);line-height:1.6;-webkit-font-smoothing:antialiased} a{color:inherit} svg{display:block;max-width:100%}.shell{width:min(100% - 2rem,76rem);margin-inline:auto}.skip-link{position:fixed;z-index:100;top:.75rem;left:.75rem;transform:translateY(-150%);background:var(--orange-deep);color:#fff;padding:.6rem .9rem;border-radius:.55rem}.skip-link:focus{transform:none}

  .site-header{position:absolute;z-index:40;inset:0 0 auto}.header-inner{min-height:4.7rem;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem}.brand{display:inline-flex;align-items:center;gap:.58rem;width:max-content;color:var(--orange);text-decoration:none}.brand svg{width:2rem;height:2rem}.brand span{color:var(--ink);font-size:1rem;font-weight:600;letter-spacing:-.025em}.site-header nav{display:flex;gap:.15rem}.site-header nav a,.login{padding:.6rem .7rem;border-radius:.5rem;color:var(--muted);font-size:.78rem;font-weight:500;text-decoration:none}.site-header nav a:hover,.login:hover{color:var(--ink);background:color-mix(in srgb,var(--ink) 5%,transparent)}.header-actions{justify-self:end;display:flex;align-items:center;gap:.35rem}
