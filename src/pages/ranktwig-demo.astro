---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const rankTwigUrl = 'https://ranktwig.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090b" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="description" content="A private RankTwig homepage design experiment." />
    <link rel="icon" type="image/svg+xml" href={`${base}ranktwig-demo/ranktwig-mark.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <title>RankTwig homepage experiment</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="#top" aria-label="RankTwig home">
          <svg viewBox="0 0 40 40" aria-hidden="true">
            <rect width="40" height="40" rx="10" fill="currentColor"></rect>
            <path d="M8.5 30.2c4.1-3 7.7-6.4 10-10.2 1.7-2.8 2.7-5.8 3.1-9.3.1-1.1 1.8-1.1 1.9 0 .1 2.8-.6 5.6-1.4 7.7 2.7-2.1 5.5-4 8.4-5.7.9-.5 1.7.7 1.1 1.5-4.4 6.3-10.5 10.7-17.6 13 4.2.1 8 .8 11.4 2.1 1 .4.8 1.9-.3 2-5.6-.4-11.2-.8-18 1.6-1 .3-1.7-1.1-.8-1.7 1.6-1.2 2.1-1.8 2.6-2.7Z" fill="white"></path>
          </svg>
          <span>RankTwig</span>
        </a>

        <nav aria-label="Primary navigation">
          <a href="#product">Product</a>
          <a href={`${rankTwigUrl}/use-cases`}>Use cases</a>
          <a href="#pricing">Pricing</a>
          <a href={`${rankTwigUrl}/mcp-guide`}>MCP</a>
          <a href="#proof">Evidence</a>
        </nav>

        <div class="header-actions">
          <a class="login" href={`${rankTwigUrl}/login`}>Log in</a>
          <a class="button button-primary button-small" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Start Free <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </header>

    <main id="main-content">
      <section id="top" class="hero" aria-labelledby="hero-title">
        <div class="hero-noise" aria-hidden="true"></div>
        <div class="hero-orb hero-orb-left" aria-hidden="true"></div>
        <div class="hero-orb hero-orb-right" aria-hidden="true"></div>

        <div class="shell hero-copy">
          <a class="announcement" href="#product">
            <span class="announcement-dot"></span>
            <span>Evidence-first SEO intelligence</span>
            <span aria-hidden="true">→</span>
          </a>

          <h1 id="hero-title">Your search data knows the next move.</h1>
          <p class="hero-lede">Connect Search Console to the AI you choose. RankTwig surfaces what deserves attention and keeps the evidence attached all the way to action.</p>

          <div class="hero-actions-main">
            <a class="button button-primary" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Find My Next SEO Move <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href={`${rankTwigUrl}/demo`}>Explore the demo</a>
          </div>

          <div class="hero-meta" aria-label="Product highlights">
            <span>Read-only GSC</span>
            <span>ChatGPT OAuth + MCP</span>
            <span>Bring your own AI</span>
          </div>
        </div>

        <div class="terrain-wrap" aria-hidden="true">
          <svg class="terrain" viewBox="0 0 1600 640" preserveAspectRatio="xMidYMax meet" role="presentation">
            <defs>
              <linearGradient id="terrainFade" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#111827" stop-opacity="0" />
                <stop offset=".34" stop-color="#111827" stop-opacity=".44" />
                <stop offset="1" stop-color="#08080b" stop-opacity="1" />
              </linearGradient>
              <linearGradient id="mountainFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#172038" />
                <stop offset=".58" stop-color="#0d1220" />
                <stop offset="1" stop-color="#08080b" />
              </linearGradient>
              <linearGradient id="orangeRoute" x1="170" y1="0" x2="1375" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#f97316" stop-opacity=".28" />
                <stop offset=".18" stop-color="#f97316" />
                <stop offset=".75" stop-color="#fb923c" />
                <stop offset="1" stop-color="#f97316" />
              </linearGradient>
              <radialGradient id="nodeGlow">
                <stop offset="0" stop-color="#fff7ed" />
                <stop offset=".25" stop-color="#fb923c" />
                <stop offset="1" stop-color="#f97316" stop-opacity="0" />
              </radialGradient>
              <filter id="softGlow" x="-200%" y="-200%" width="400%" height="400%">
                <feGaussianBlur stdDeviation="12" />
              </filter>
              <filter id="routeGlow" x="-20%" y="-100%" width="140%" height="300%">
                <feGaussianBlur stdDeviation="5" result="blur" />
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <pattern id="microGrid" width="28" height="28" patternUnits="userSpaceOnUse">
                <circle cx="1.4" cy="1.4" r="1" fill="#c7d2fe" opacity=".16" />
              </pattern>
            </defs>

            <rect x="0" y="220" width="1600" height="420" fill="url(#terrainFade)" />
            <rect x="0" y="180" width="1600" height="460" fill="url(#microGrid)" opacity=".6" />

            <path class="terrain-mass terrain-mass-back" d="M0 505L120 447L217 463L344 372L448 430L550 323L672 408L790 288L895 388L1020 318L1134 401L1256 292L1382 389L1498 346L1600 412V640H0Z" />
            <path class="terrain-mass" d="M0 548L144 486L267 515L405 417L518 477L632 382L740 461L850 351L973 449L1090 385L1200 474L1320 366L1435 452L1534 413L1600 456V640H0Z" />

            <g class="contours" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M-20 580C128 535 248 564 380 501C505 442 604 486 721 433C861 369 934 448 1052 408C1188 362 1291 424 1424 390C1500 371 1558 379 1620 404" />
              <path d="M-30 607C128 564 244 593 386 533C508 481 611 519 728 474C856 425 945 490 1065 454C1197 414 1307 468 1439 438C1511 421 1563 426 1630 447" />
              <path d="M-40 628C130 594 249 620 393 567C516 522 622 557 740 518C862 478 957 533 1080 503C1203 473 1315 516 1450 491C1520 478 1573 481 1640 501" />
              <path d="M160 520C249 475 313 482 385 434C451 390 496 409 551 371" />
              <path d="M995 431C1058 400 1115 404 1183 368C1248 334 1302 341 1379 310" />
            </g>

            <g class="mesh" fill="none" stroke="#818cf8" stroke-opacity=".13" stroke-width="1">
              <path d="M90 554L274 510L407 422L630 382L850 351L1090 385L1320 366L1520 416" />
              <path d="M190 610L302 520L504 477L740 461L973 449L1200 474L1435 452" />
              <path d="M274 510L302 520M407 422L504 477M630 382L740 461M850 351L973 449M1090 385L1200 474M1320 366L1435 452" />
            </g>

            <g class="signal-stars" fill="#c7d2fe">
              <circle cx="214" cy="510" r="2"/><circle cx="338" cy="484" r="1.8"/><circle cx="470" cy="461" r="2"/><circle cx="585" cy="423" r="1.5"/><circle cx="688" cy="449" r="2"/><circle cx="819" cy="402" r="1.6"/><circle cx="952" cy="428" r="2"/><circle cx="1060" cy="412" r="1.7"/><circle cx="1160" cy="446" r="2"/><circle cx="1284" cy="402" r="1.8"/><circle cx="1408" cy="424" r="2"/>
            </g>

            <path class="route-glow" d="M170 548C262 516 322 562 405 526C484 492 521 465 604 478C706 495 747 426 832 441C919 456 961 512 1062 493C1154 476 1199 419 1284 428C1343 434 1370 401 1404 360" />
            <path class="route" d="M170 548C262 516 322 562 405 526C484 492 521 465 604 478C706 495 747 426 832 441C919 456 961 512 1062 493C1154 476 1199 419 1284 428C1343 434 1370 401 1404 360" />

            <g class="route-node" transform="translate(170 548)"><circle r="28" fill="url(#nodeGlow)" opacity=".55"/><circle r="8" fill="#f97316"/><circle r="3.5" fill="#fff7ed"/></g>
            <g class="route-node" transform="translate(604 478)"><circle r="30" fill="url(#nodeGlow)" opacity=".5"/><circle r="7.5" fill="#f97316"/><circle r="3" fill="#fff7ed"/></g>
            <g class="route-node" transform="translate(1062 493)"><circle r="30" fill="url(#nodeGlow)" opacity=".5"/><circle r="7.5" fill="#f97316"/><circle r="3" fill="#fff7ed"/></g>
            <g class="destination" transform="translate(1404 360)">
              <circle r="44" fill="url(#nodeGlow)" opacity=".45"/>
              <circle r="14" fill="none" stroke="#f97316" stroke-width="2"/>
              <circle r="5" fill="#fff7ed"/>
              <path d="M0-52V-15M0-52L34-42L0-30" fill="#f97316" stroke="#f97316" stroke-linejoin="round"/>
            </g>
          </svg>

          <div class="terrain-label label-left">
            <span class="label-kicker">SEARCH SIGNAL</span>
            <strong>1,240 impressions</strong>
            <small>relevant queries · position 18–29</small>
          </div>
          <div class="terrain-label label-mid">
            <span class="label-kicker">PAGE EVIDENCE</span>
            <strong>CTR gap confirmed</strong>
            <small>rankings held while clicks fell</small>
          </div>
          <div class="terrain-label label-right">
            <span class="label-kicker">NEXT MOVE</span>
            <strong>Fix the snippet first</strong>
            <small>evidence attached</small>
          </div>
        </div>
      </section>

      <section class="workflow shell" aria-labelledby="workflow-title">
        <div class="workflow-heading">
          <p class="eyebrow">HOW IT COMES TOGETHER</p>
          <h2 id="workflow-title">From signal to action without losing the source.</h2>
        </div>
        <ol class="workflow-steps">
          <li><span>01</span><div><strong>Find</strong><p>Surface the pages and queries already showing potential.</p></div></li>
          <li><span>02</span><div><strong>Investigate</strong><p>Bring performance, intent and fresh page evidence together.</p></div></li>
          <li><span>03</span><div><strong>Compare</strong><p>See what is observably different before copying anything.</p></div></li>
          <li><span>04</span><div><strong>Act</strong><p>Use your AI to turn the evidence into one defensible next move.</p></div></li>
        </ol>
      </section>

      <section id="product" class="product-section">
        <div class="shell">
          <div class="section-intro">
            <div>
              <p class="eyebrow">THE PRODUCT</p>
              <h2>Built around SEO decisions, not dashboard decoration.</h2>
            </div>
            <p>RankTwig keeps the search signal, current page facts and AI reasoning visually distinct so you always know what came from where.</p>
          </div>

          <article class="feature feature-investigator">
            <div class="feature-copy">
              <span class="feature-index">01 / PAGE INVESTIGATOR</span>
              <h3>Understand a page before changing it.</h3>
              <p>See search performance, ranking queries and fresh page evidence together. Add your AI only when another layer of reasoning is actually useful.</p>
              <a href={`${rankTwigUrl}/demo/pages/detail`}>Explore Page Investigator <span aria-hidden="true">→</span></a>
            </div>
            <div class="product-window">
              <div class="window-bar"><span>Page Investigator</span><span>28 days vs previous 28</span></div>
              <div class="metric-grid">
                <div><small>IMPRESSIONS</small><strong>1,240</strong><em>+18.4%</em></div>
                <div><small>CLICKS</small><strong>9</strong><em class="down">−12.0%</em></div>
                <div><small>POSITION</small><strong>21.6</strong><em>+2.1</em></div>
              </div>
              <div class="evidence-row"><span>Striking distance</span><span>CTR gap</span><span>Fresh crawl</span><strong>Investigate →</strong></div>
              <div class="query-list">
                <div><span>trail running shoes</span><small>620 imp.</small><strong>18.7</strong></div>
                <div><span>best shoes for trail running</span><small>381 imp.</small><strong>22.4</strong></div>
                <div><span>trail shoes guide</span><small>239 imp.</small><strong>28.9</strong></div>
              </div>
            </div>
          </article>

          <article class="feature feature-battle">
            <div class="feature-copy">
              <span class="feature-index">02 / PAGE BATTLE</span>
              <h3>See where the competing page actually has an edge.</h3>
              <p>Compare titles, intent, internal links, schema and observed page facts side by side—without turning one competitor URL into fake certainty.</p>
              <a href={`${rankTwigUrl}/use-cases`}>See Page Battle use cases <span aria-hidden="true">→</span></a>
            </div>
            <div class="battle-window">
              <div class="battle-column"><span>YOUR PAGE</span><strong>Useful guide</strong><small>28 internal links</small><small>Weak decision section</small><small>Article schema valid</small></div>
              <div class="battle-vs">VS</div>
              <div class="battle-column"><span>COMPETITOR</span><strong>Commercial guide</strong><small>34 internal links</small><small>Clear comparison section</small><small>Trust cues observed</small></div>
              <div class="battle-verdict"><span>MOVE</span><strong>Fix the decision section first.</strong><small>Observed difference · higher-confidence action</small></div>
            </div>
          </article>

          <article class="feature feature-mcp">
            <div class="feature-copy">
              <span class="feature-index">03 / CHATGPT + MCP</span>
              <h3>Your SEO evidence, inside the conversation.</h3>
              <p>Connect RankTwig once, then ask naturally. A compatible AI client can request the relevant site, page, query and opportunity evidence when it needs it.</p>
              <a href={`${rankTwigUrl}/mcp-guide`}>See how MCP works <span aria-hidden="true">→</span></a>
            </div>
            <div class="chat-window">
              <p class="bubble bubble-user">Bro, what should I work on today?</p>
              <div class="bubble bubble-ai"><strong>Start with /best-service-guide/.</strong><p>It has 1,240 impressions but only 9 clicks, with several relevant queries around positions 18–29.</p><div class="chat-evidence"><span>GSC · 28 days</span><span>3 matching queries</span><span>Fresh crawl ready</span></div></div>
              <p class="bubble bubble-user">What do I actually change?</p>
              <div class="bubble bubble-ai"><strong>Start with the snippet and decision section.</strong><p>Rankings are holding, so rewrite only the parts that are underperforming before touching the rest of the page.</p></div>
            </div>
          </article>
        </div>
      </section>

      <section id="proof" class="proof shell" aria-labelledby="proof-title">
        <div class="proof-copy">
          <p class="eyebrow">SHOW THE WORK</p>
          <h2 id="proof-title">Never wonder why the AI said that.</h2>
          <p>Observed data, calculated signals and AI inference stay distinguishable. Thin evidence should look thin.</p>
        </div>
        <div class="proof-flow">
          <div><span>01</span><strong>Observed</strong><small>Search Console + current page facts</small></div>
          <i>→</i>
          <div><span>02</span><strong>Calculated</strong><small>Deterministic signals and comparisons</small></div>
          <i>→</i>
          <div><span>03</span><strong>AI inference</strong><small>Your model reasons over the evidence</small></div>
          <i>→</i>
          <div class="proof-action"><span>04</span><strong>Action</strong><small>One next move with the source attached</small></div>
        </div>
      </section>

      <section id="pricing" class="pricing-section">
        <div class="shell pricing-grid">
          <div class="pricing-copy">
            <p class="eyebrow">SIMPLE PRICING</p>
            <h2>Use the real product for free.</h2>
            <p>Connect one website and decide from actual use whether RankTwig belongs in your workflow.</p>
          </div>
          <div class="plans">
            <article>
              <div class="plan-head"><span>FREE</span><strong>$0</strong><small>forever</small></div>
              <p>One connected website with the intelligence core and useful monthly limits.</p>
              <ul><li>1 connected website</li><li>25 Page Investigations / month</li><li>10 Page Battles / month</li><li>5 Content Briefs / month</li></ul>
              <a class="button button-secondary" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Start Free</a>
            </article>
            <article class="plan-pro">
              <div class="plan-head"><span>PRO</span><strong>$29</strong><small>per month</small></div>
              <p>More sites, generous capacity, MCP, URL Groups and exports.</p>
              <ul><li>Up to 5 websites</li><li>500 Investigations · 200 Battles</li><li>100 Content Briefs / month</li><li>ChatGPT + MCP, groups and exports</li></ul>
              <a class="button button-primary" href={`${rankTwigUrl}/pricing`}>See Pro <span aria-hidden="true">→</span></a>
            </article>
          </div>
        </div>
      </section>

      <section class="closing">
        <div class="closing-noise" aria-hidden="true"></div>
        <div class="shell closing-inner">
          <p class="eyebrow">THE NEXT MOVE IS PROBABLY ALREADY THERE</p>
          <h2>Follow the evidence.</h2>
          <p>Connect Search Console. Let RankTwig show you what deserves attention. Decide with the source still attached.</p>
          <div class="hero-actions-main">
            <a class="button button-primary" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Put my search data to work <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href={`${rankTwigUrl}/demo`}>Explore first</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell footer-inner">
        <a class="brand" href="#top" aria-label="Back to top">
          <svg viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="10" fill="currentColor"></rect><path d="M8.5 30.2c4.1-3 7.7-6.4 10-10.2 1.7-2.8 2.7-5.8 3.1-9.3.1-1.1 1.8-1.1 1.9 0 .1 2.8-.6 5.6-1.4 7.7 2.7-2.1 5.5-4 8.4-5.7.9-.5 1.7.7 1.1 1.5-4.4 6.3-10.5 10.7-17.6 13 4.2.1 8 .8 11.4 2.1 1 .4.8 1.9-.3 2-5.6-.4-11.2-.8-18 1.6-1 .3-1.7-1.1-.8-1.7 1.6-1.2 2.1-1.8 2.6-2.7Z" fill="white"></path></svg>
          <span>RankTwig</span>
        </a>
        <p>SEO intelligence that turns evidence into action.</p>
        <nav aria-label="Footer links"><a href={`${rankTwigUrl}/privacy`}>Privacy</a><a href={`${rankTwigUrl}/terms`}>Terms</a><a href="mailto:team@ranktwig.com">Contact</a></nav>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --canvas:#09090b;
    --surface:#121215;
    --surface-raised:#18181b;
    --surface-overlay:#1c1c20;
    --ink:#fafafa;
    --ink-muted:#a1a1aa;
    --ink-faint:#71717a;
    --line:#27272a;
    --line-subtle:#1e1e22;
    --action:#f97316;
    --action-hover:#ea580c;
    --action-muted:rgb(249 115 22 / 12%);
    --positive:#22c55e;
    --risk:#ef4444;
    --ai:#6366f1;
    --sans:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    --mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,Monaco,monospace;
  }

  *,*::before,*::after{box-sizing:border-box}
  html{min-width:320px;scroll-behavior:smooth;background:var(--canvas);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}
  body{min-width:320px;margin:0;overflow-x:hidden;background:var(--canvas);color:var(--ink);font-family:var(--sans);line-height:1.6;text-rendering:optimizeLegibility}
  a{color:inherit}
  svg{display:block;max-width:100%}
  ::selection{background:var(--action-muted);color:var(--ink)}
  :focus-visible{outline:2px solid var(--action);outline-offset:3px}
  .skip-link{position:fixed;z-index:100;top:.75rem;left:.75rem;transform:translateY(-150%);border-radius:.5rem;background:var(--action);padding:.65rem .9rem;color:#09090b;font-size:.875rem;font-weight:600}
  .skip-link:focus{transform:translateY(0)}
  .shell{width:min(100% - 2rem,76rem);margin-inline:auto}

  .site-header{position:absolute;z-index:50;inset:0 0 auto}
  .header-inner{min-height:4.75rem;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1.5rem}
  .brand{display:inline-flex;align-items:center;gap:.625rem;width:fit-content;color:var(--action);text-decoration:none}
  .brand svg{width:2rem;height:2rem;flex:0 0 auto;border-radius:.5rem}
  .brand span{color:var(--ink);font-size:1.0625rem;font-weight:600;letter-spacing:-.025em}
  .site-header nav{display:flex;align-items:center;gap:.1rem}
  .site-header nav a,.login{min-height:2.5rem;display:inline-flex;align-items:center;padding:.65rem .75rem;border-radius:.5rem;color:var(--ink-muted);font-size:.8125rem;font-weight:500;text-decoration:none;transition:150ms ease}
  .site-header nav a:hover,.login:hover{color:var(--ink);background:rgb(255 255 255 / 4%)}
  .header-actions{justify-self:end;display:flex;align-items:center;gap:.25rem}

  .button{min-height:3rem;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.72rem 1rem;border:1px solid transparent;border-radius:.5rem;font-size:.875rem;font-weight:600;text-decoration:none;transition:150ms ease}
  .button:hover{transform:translateY(-1px)}
  .button-small{min-height:2.5rem;padding:.62rem .9rem;font-size:.8125rem}
  .button-primary{background:var(--action);color:#09090b}
  .button-primary:hover{background:var(--action-hover);color:#fff}
  .button-secondary{border-color:var(--line);background:var(--surface-raised);color:var(--ink)}
  .button-secondary:hover{border-color:var(--ink-faint);background:var(--surface-overlay)}

  .hero{position:relative;min-height:clamp(58rem,100svh,68rem);overflow:hidden;isolation:isolate;background:var(--canvas)}
  .hero::before{content:"";position:absolute;z-index:-5;inset:0;background:linear-gradient(180deg,#09090b 0%,#09090b 46%,#0a0c13 72%,#09090b 100%)}
  .hero-noise,.closing-noise{position:absolute;z-index:-2;inset:0;opacity:.28;background-image:radial-gradient(rgb(255 255 255 / 8%) .65px,transparent .7px);background-size:5px 5px;mask-image:linear-gradient(to bottom,#000,transparent 76%)}
  .hero-orb{position:absolute;z-index:-4;bottom:-14rem;width:38rem;height:38rem;border-radius:50%;filter:blur(22px);pointer-events:none}
  .hero-orb-left{left:-18rem;background:radial-gradient(circle,rgb(79 70 229 / 25%),transparent 70%)}
  .hero-orb-right{right:-18rem;background:radial-gradient(circle,rgb(37 99 235 / 22%),transparent 70%)}
  .hero-copy{position:relative;z-index:8;padding-top:clamp(8.25rem,14vh,10.25rem);text-align:center}
