---
const rankTwigUrl = 'https://ranktwig.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbfaf6" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="description" content="A private RankTwig homepage design experiment." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" />
    <title>RankTwig homepage experiment</title>
  </head>

  <body>
    <header class="site-header">
      <div class="shell nav-wrap">
        <a class="brand" href="#top" aria-label="RankTwig home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 36 36"><path d="M10 27c6-4.2 10-9.8 12-17 .3-1.2 2.1-.9 2.1.3-.1 4-1.3 7.5-3.1 10.4 2.8-2.1 5.3-3.6 7.5-4.6 1-.4 1.8.9 1 1.7-4.7 4.6-9.9 7.5-16.4 9.2" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M21.5 11.5c-2.4-.2-4.4-1.3-6-3.4 2.7-.7 4.9-.3 6.8 1.1" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/></svg>
          </span>
          <span>RankTwig</span>
        </a>

        <nav aria-label="Primary">
          <a href="#how">How it works</a>
          <a href="#features">Product</a>
          <a href="#evidence">Evidence</a>
          <a href={`${rankTwigUrl}/mcp-guide`}>MCP</a>
        </nav>

        <div class="nav-actions">
          <a class="login" href={`${rankTwigUrl}/login`}>Log in</a>
          <a class="button button-small" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Start free</a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero shell" id="top">
        <div class="hero-copy reveal">
          <span class="eyebrow"><i></i> Evidence-first SEO intelligence</span>
          <h1>Find the SEO move<br />worth making.</h1>
          <p class="hero-lede">Your search data already knows where the opportunity is. RankTwig turns it into a clear, evidence-backed next move.</p>
          <div class="hero-actions">
            <a class="button" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Find my next move <span>→</span></a>
            <a class="text-link" href={`${rankTwigUrl}/demo`}>Explore the demo</a>
          </div>
          <div class="trust-row"><span>Read-only GSC</span><span>Bring your own AI</span><span>ChatGPT + MCP</span></div>
        </div>

        <div class="hero-art reveal" aria-label="A tiny RankTwig crew investigating an SEO opportunity">
          <div class="status-pill"><span></span> Opportunity found <b>✓</b></div>

          <div class="crew-scene">
            <div class="mascot bot mascot-back" aria-hidden="true">
              <span class="antenna a1"></span><span class="antenna a2"></span>
              <div class="head"><i></i><i></i><b></b></div>
              <div class="body"></div>
            </div>

            <div class="mascot scout" aria-hidden="true">
              <div class="hood"><div class="face"><i></i><i></i></div></div>
              <div class="scout-body"></div>
              <div class="magnifier"><span></span></div>
            </div>

            <div class="mascot twig" aria-hidden="true">
              <div class="sprout"><i></i><i></i></div>
              <div class="twig-head"><i></i><i></i><b></b><em></em></div>
              <div class="twig-body"></div>
            </div>

            <div class="laptop" aria-hidden="true"><div class="screen"><span></span></div><div class="base"></div></div>

            <div class="mascot spark" aria-hidden="true">
              <div class="flame"><i></i></div>
              <div class="spark-head"><i></i><i></i><b></b></div>
              <div class="spark-body"></div>
              <span class="arm"></span>
            </div>

            <div class="evidence-ticket">
              <small>PAGE SIGNAL</small>
              <strong>/best-service-guide/</strong>
              <div><span>1,240 impressions</span><span>9 clicks</span></div>
            </div>
          </div>
        </div>
      </section>

      <section class="proof-strip">
        <div class="shell proof-items reveal">
          <span><b>Google Search Console</b><small>your actual search data</small></span>
          <span><b>Evidence before advice</b><small>see why a move surfaced</small></span>
          <span><b>AI-ready context</b><small>bring RankTwig into ChatGPT</small></span>
        </div>
      </section>

      <section class="section shell" id="how">
        <div class="section-heading reveal">
          <span class="eyebrow">THE IDEA</span>
          <h2>Your data is already talking.<br />RankTwig helps you hear it.</h2>
          <p>Instead of another dashboard full of numbers, RankTwig connects the signals and points to the page, query, or comparison worth investigating next.</p>
        </div>

        <div class="signal-scene reveal">
          <div class="signal-card blue-card"><small>SEARCH DEMAND</small><strong>1,240</strong><span>impressions</span></div>
          <div class="signal-card orange-card"><small>CTR GAP</small><strong>0.7%</strong><span>9 clicks</span></div>
          <div class="signal-card green-card"><small>POSITION</small><strong>21.6</strong><span>striking distance</span></div>
          <svg class="path-line" viewBox="0 0 1000 260" aria-hidden="true"><path d="M50 190C210 190 230 58 390 80s190 130 340 82 150-100 220-87"/><circle cx="50" cy="190" r="5"/><circle cx="390" cy="80" r="5"/><circle cx="950" cy="75" r="7"/></svg>
          <div class="mini-twig" aria-hidden="true"><div class="mini-leaves"><i></i><i></i></div><div class="mini-head"><i></i><i></i><b></b></div></div>
          <div class="next-note"><small>NEXT MOVE</small><strong>Fix the snippet before rewriting the page.</strong><span>→</span></div>
        </div>
      </section>

      <section class="section soft" id="features">
        <div class="shell">
          <div class="section-heading compact reveal">
            <span class="eyebrow">ONE CLEAR WORKFLOW</span>
            <h2>Connect. Investigate. Compare. Act.</h2>
          </div>

          <div class="workflow reveal">
            <article>
              <div class="step-num">01</div>
              <div class="step-icon gsc"><span>G</span></div>
              <h3>Connect your search data.</h3>
              <p>Read-only Google Search Console gives RankTwig the evidence it needs without asking you to export spreadsheets.</p>
            </article>
            <div class="connector">→</div>
            <article>
              <div class="step-num">02</div>
              <div class="step-icon scout-icon">⌕</div>
              <h3>Investigate the right page.</h3>
              <p>See demand, rankings, movement, and queries together so you know what deserves attention first.</p>
            </article>
            <div class="connector">→</div>
            <article>
              <div class="step-num">03</div>
              <div class="step-icon battle-icon">VS</div>
              <h3>Compare what actually differs.</h3>
              <p>Use Page Battle to inspect intent, coverage, trust cues, structure, links, and observable competitive gaps.</p>
            </article>
            <div class="connector">→</div>
            <article>
              <div class="step-num">04</div>
              <div class="step-icon act-icon">✓</div>
              <h3>Make the next move.</h3>
              <p>Turn the evidence into an action, content brief, or AI-assisted decision without losing the source context.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section shell product-scenes">
        <article class="feature-scene reveal">
          <div class="feature-copy">
            <span class="eyebrow blue-text">PAGE INVESTIGATOR</span>
            <h2>Know what’s worth fixing before you rewrite anything.</h2>
            <p>RankTwig puts the useful evidence next to the decision: demand, ranking queries, movement, and why the page surfaced.</p>
            <a class="text-link strong" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Investigate my site →</a>
          </div>
          <div class="paper-stack investigator-paper">
            <div class="paper paper-back"></div>
            <div class="paper">
              <div class="paper-top"><span>/best-service-guide/</span><small>28 DAYS</small></div>
              <div class="paper-metrics"><span><small>IMPRESSIONS</small><b>1,240</b><em>+18%</em></span><span><small>CLICKS</small><b>9</b><em class="down">−12%</em></span><span><small>POSITION</small><b>21.6</b><em>+2.1</em></span></div>
              <div class="query"><span>trail running shoes</span><small>620 imp.</small><b>18.7</b></div>
              <div class="query"><span>best trail shoes</span><small>381 imp.</small><b>22.4</b></div>
              <div class="paper-tags"><span>Striking distance</span><span>CTR gap</span><span>Demand rising</span></div>
            </div>
            <div class="tiny-scout" aria-hidden="true"><div><i></i><i></i></div><span></span></div>
          </div>
        </article>

        <article class="feature-scene reverse reveal">
          <div class="feature-copy">
            <span class="eyebrow orange-text">PAGE BATTLE</span>
            <h2>See what the competing page does differently.</h2>
            <p>Compare the visible evidence before changing your page. RankTwig helps separate useful differences from random competitor imitation.</p>
            <a class="text-link strong" href={`${rankTwigUrl}/demo`}>See Page Battle →</a>
          </div>
          <div class="battle-paper">
            <div class="battle-col"><small>YOUR PAGE</small><strong>Useful guide</strong><span class="muted-chip">Weak decision section</span><ul><li>✓ Covers core topic</li><li>✓ Clear structure</li><li>— Few trust cues</li></ul></div>
            <div class="versus">VS</div>
            <div class="battle-col"><small>COMPETITOR</small><strong>Commercial guide</strong><span class="accent-chip">Clear comparison + trust</span><ul><li>✓ Decision section</li><li>✓ Expert signals</li><li>✓ Better internal links</li></ul></div>
            <div class="battle-note"><small>NEXT MOVE</small><b>Strengthen the decision section first.</b></div>
          </div>
        </article>
      </section>

      <section class="section ai-section" id="evidence">
        <div class="shell ai-grid">
          <div class="ai-copy reveal">
            <span class="eyebrow">CHATGPT + MCP</span>
            <h2>Your AI should know your site.</h2>
            <p>Give compatible AI clients the relevant page, query, and opportunity context from RankTwig so the conversation starts with evidence instead of generic SEO advice.</p>
            <a class="button ghost" href={`${rankTwigUrl}/mcp-guide`}>See the MCP guide <span>→</span></a>
          </div>
          <div class="ai-scene reveal">
            <div class="ai-bot" aria-hidden="true"><span class="ai-antenna"></span><div><i></i><i></i><b></b></div></div>
            <div class="packet"><small>RANKTWIG EVIDENCE</small><strong>/best-service-guide/</strong><span>3 ranking queries</span><span>28-day GSC trend</span><span>fresh page evidence</span></div>
            <div class="conversation"><p class="question">What should I work on today?</p><div class="answer"><strong>Start with /best-service-guide/.</strong><span>Demand is up, clicks are down, and the page is sitting in striking distance.</span><small>Based on RankTwig evidence</small></div></div>
          </div>
        </div>
      </section>

      <section class="section shell receipts">
        <div class="section-heading reveal">
          <span class="eyebrow">SHOW THE RECEIPTS</span>
          <h2>Know where every recommendation came from.</h2>
          <p>RankTwig separates what it observed, what it calculated, and what your AI inferred so you can judge the move before you make it.</p>
        </div>
        <div class="receipt-card reveal">
          <div><span class="dot observed"></span><small>OBSERVED</small><strong>Clicks fell 12% while rankings held.</strong><em>Google Search Console · last 28 days</em></div>
          <div><span class="dot calculated"></span><small>CALCULATED</small><strong>CTR is underperforming for the current position.</strong><em>RankTwig signal · comparison window</em></div>
          <div><span class="dot inferred"></span><small>AI INFERENCE</small><strong>The snippet is the first thing worth testing.</strong><em>Recommendation based on the evidence above</em></div>
        </div>
      </section>

      <section class="final-cta">
        <div class="shell final-grid reveal">
          <div>
            <span class="eyebrow"><i></i> READY WHEN YOU ARE</span>
            <h2>Stop staring at the dashboard.<br />Find the move.</h2>
            <p>Connect your site and let RankTwig surface the opportunities already hiding in your search data.</p>
            <a class="button" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Start with my site <span>→</span></a>
          </div>
          <div class="done-scene" aria-hidden="true">
            <div class="done-pill">Status: ready <b>✓</b></div>
            <div class="done-twig"><div class="done-leaves"><i></i><i></i></div><div class="done-head"><i></i><i></i><b></b></div><div class="done-body"></div><span class="wave"></span></div>
            <div class="done-laptop"><div><span></span></div><i></i></div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell footer-inner"><span>RankTwig</span><small>Evidence-first SEO intelligence.</small><a href={`${rankTwigUrl}`}>ranktwig.com ↗</a></div>
    </footer>

    <script is:inline>
      const reveal = () => {
        const items = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { items.forEach(el => el.classList.add('visible')); return; }
        const io = new IntersectionObserver((entries) => {
          entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('visible'); io.unobserve(entry.target); } });
        }, { threshold: .12 });
        items.forEach(el => io.observe(el));
      };
      reveal();
    </script>
  </body>
</html>

<style>
  :root{--bg:#fbfaf6;--ink:#11120f;--muted:#70736b;--line:#e8e5dc;--orange:#f36b00;--green:#73a93e;--blue:#4f70e8;--yellow:#efc64c;--charcoal:#292b32;--paper:#fffefb;--soft:#f5f3ec}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}.shell{width:min(1180px,calc(100% - 48px));margin:0 auto}.site-header{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(18px);border-bottom:1px solid transparent}.nav-wrap{height:78px;display:flex;align-items:center;justify-content:space-between;gap:30px}.brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:20px}.brand-mark{width:30px;height:30px;color:var(--orange);display:grid;place-items:center}.brand-mark svg{width:100%;height:100%}nav{display:flex;gap:28px;color:#55584f;font-size:14px;font-weight:600}nav a:hover,.login:hover,.text-link:hover{color:var(--orange)}.nav-actions{display:flex;align-items:center;gap:18px}.login{font-size:14px;font-weight:600}.button{display:inline-flex;align-items:center;justify-content:center;gap:11px;background:var(--ink);color:white;border:1px solid var(--ink);padding:14px 20px;border-radius:11px;font-size:14px;font-weight:700;transition:.2s ease}.button:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(17,18,15,.12)}.button-small{padding:10px 15px;border-radius:9px}.button span{color:#a8d574}.ghost{background:transparent;color:var(--ink)}.ghost span{color:var(--orange)}.hero{min-height:720px;display:grid;grid-template-columns:1.02fr .98fr;align-items:center;gap:38px;padding-top:54px;padding-bottom:76px}.eyebrow{display:inline-flex;align-items:center;gap:9px;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;letter-spacing:.08em;color:#64675f}.eyebrow i{width:7px;height:7px;background:var(--green);border-radius:50%}.hero h1,.section-heading h2,.feature-copy h2,.ai-copy h2,.final-cta h2{letter-spacing:-.055em;margin:0;font-weight:700;line-height:.98}.hero h1{font-size:clamp(56px,6vw,82px);max-width:720px}.hero-lede{font-size:20px;line-height:1.55;color:var(--muted);max-width:650px;margin:27px 0 0}.hero-actions{display:flex;align-items:center;gap:22px;margin-top:32px}.text-link{font-size:14px;font-weight:700}.trust-row{display:flex;gap:22px;margin-top:28px;color:#777a71;font-size:12px}.trust-row span:before{content:'✓';color:var(--green);margin-right:7px}.hero-art{position:relative;min-height:500px;display:flex;align-items:center;justify-content:center}.status-pill{position:absolute;right:10px;top:42px;padding:11px 14px;border-radius:999px;background:#18c76a;color:white;font-size:13px;font-weight:700;box-shadow:0 10px 20px rgba(24,199,106,.16);z-index:10}.status-pill span{display:inline-block;width:7px;height:7px;background:white;border-radius:50%;margin-right:7px}.status-pill b{margin-left:7px}.crew-scene{position:relative;width:520px;height:390px}.mascot{position:absolute;filter:drop-shadow(0 12px 14px rgba(20,20,16,.12))}.mascot-back{width:126px;height:166px;left:110px;top:70px}.bot .head{position:absolute;left:10px;top:20px;width:105px;height:92px;border:5px solid #191a1e;background:#30323a;border-radius:28px 28px 22px 22px;box-shadow:inset 0 -12px 0 rgba(0,0,0,.1)}.bot .head i{position:absolute;width:9px;height:12px;background:#7a89ff;border-radius:3px;top:40px}.bot .head i:first-child{left:27px}.bot .head i:nth-child(2){right:27px}.bot .head b{position:absolute;width:18px;height:7px;border-bottom:4px solid #9ca5ff;border-radius:50%;left:39px;top:57px}.bot .body{position:absolute;width:92px;height:66px;left:16px;bottom:0;background:#292b32;border:5px solid #191a1e;border-radius:20px}.antenna{position:absolute;width:5px;height:31px;background:#191a1e;top:0}.antenna:after{content:'';position:absolute;width:15px;height:15px;background:#4a4d58;border:5px solid #191a1e;border-radius:4px;top:-8px;left:-5px}.a1{left:38px;transform:rotate(-22deg)}.a2{right:38px;transform:rotate(22deg)}.scout{left:45px;top:170px;width:122px;height:128px}.hood{position:absolute;width:92px;height