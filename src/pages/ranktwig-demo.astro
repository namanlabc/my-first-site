---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const rankTwigUrl = 'https://ranktwig.com';
---

<!doctype html>
<html lang="en" class="light" data-theme="light" data-theme-preference="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f8" data-ranktwig-theme-color />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="description" content="A private RankTwig homepage design experiment." />
    <link rel="icon" type="image/svg+xml" href={`${base}ranktwig-demo/ranktwig-mark.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <title>RankTwig homepage experiment</title>
    <script is:inline>
      (() => {
        const key = 'ranktwig-theme';
        const allowed = ['dark', 'light', 'system'];
        let preference = 'light';
        try {
          const saved = localStorage.getItem(key);
          if (saved && allowed.includes(saved)) preference = saved;
        } catch {}
        const systemLight = matchMedia('(prefers-color-scheme: light)').matches;
        const resolved = preference === 'system' ? (systemLight ? 'light' : 'dark') : preference;
        const root = document.documentElement;
        root.dataset.themePreference = preference;
        root.dataset.theme = resolved;
        root.classList.toggle('dark', resolved === 'dark');
        root.classList.toggle('light', resolved === 'light');
        root.style.colorScheme = resolved;
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="#top" aria-label="RankTwig home">
          <svg viewBox="0 0 40 40" aria-hidden="true">
            <rect width="40" height="40" rx="10" fill="currentColor"></rect>
            <path d="M8.5 30.2c4.1-3 7.7-6.4 10-10.2 1.7-2.8 2.7-5.8 3.1-9.3.1-1.1 1.8-1.1 1.9 0 .1 2.8-.6 5.6-1.4 7.7 2.7-2.1 5.5-4 8.4-5.7.9-.5 1.7.7 1.1 1.5-4.4 6.3-10.5 10.7-17.6 13 4.2.1 8 .8 11.4 2.1 1 .4.8 1.9-.3 2-5.6-.4-11.2-.8-18 1.6-1 .3-1.7-1.1-.8-1.7 1.6-1.2 2.1-1.8 2.6-2.7Z" fill="white"></path>
          </svg>
          <span>RankTwig</span>
        </a>

        <nav aria-label="Primary navigation">
          <a href="#product">Product</a>
          <a href="#proof">Evidence</a>
          <a href="#pricing">Pricing</a>
          <a href={`${rankTwigUrl}/mcp-guide`}>MCP</a>
        </nav>

        <div class="header-actions">
          <div class="theme-control" role="group" aria-label="Color theme">
            <button type="button" data-theme-option="system" aria-label="Use system theme" title="System theme">
              <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="4" width="14" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M7 17h6M10 14v3" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path></svg>
            </button>
            <button type="button" data-theme-option="light" aria-label="Use light theme" title="Light theme">
              <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M15.3 4.7l-1.4 1.4M6.1 13.9l-1.4 1.4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path></svg>
            </button>
            <button type="button" data-theme-option="dark" aria-label="Use dark theme" title="Dark theme">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15.7 12.6A6.2 6.2 0 0 1 7.4 4.3 6.3 6.3 0 1 0 15.7 12.6Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"></path></svg>
            </button>
          </div>
          <a class="login" href={`${rankTwigUrl}/login`}>Log in</a>
          <a class="button button-primary button-small" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Start Free <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </header>

    <main id="main-content">
      <section id="top" class="hero" aria-labelledby="hero-title">
        <div class="shell hero-copy reveal">
          <a class="announcement" href="#product"><span></span> Evidence-first SEO intelligence <b aria-hidden="true">→</b></a>
          <h1 id="hero-title">Your search data knows the next move.</h1>
          <p>RankTwig turns Search Console signals into focused SEO actions—while keeping the evidence visible from discovery to decision.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Find My Next SEO Move <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href={`${rankTwigUrl}/demo`}>Explore the demo</a>
          </div>
          <div class="hero-meta"><span>Read-only GSC</span><span>Bring your own AI</span><span>ChatGPT + MCP</span></div>
        </div>

        <div class="hero-stage reveal" aria-hidden="true">
          <svg class="terrain" viewBox="0 0 1500 520" preserveAspectRatio="xMidYMax meet">
            <defs>
              <linearGradient id="terrainFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="var(--terrain-top)" />
                <stop offset="1" stop-color="var(--terrain-bottom)" />
              </linearGradient>
              <linearGradient id="routeGradient" x1="120" y1="0" x2="1350" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#fb923c" stop-opacity=".45" />
                <stop offset=".35" stop-color="#f97316" />
                <stop offset="1" stop-color="#ea580c" />
              </linearGradient>
              <filter id="routeGlow"><feGaussianBlur stdDeviation="5" /></filter>
            </defs>
            <path class="terrain-back" d="M0 420L150 360L270 390L420 285L560 350L700 235L845 338L1010 258L1145 355L1298 290L1500 370V520H0Z" />
            <path class="terrain-front" d="M0 458L155 410L305 436L455 344L600 405L748 320L890 397L1038 331L1180 412L1330 356L1500 408V520H0Z" fill="url(#terrainFill)" />
            <g class="contours" fill="none" stroke-linecap="round">
              <path d="M-20 468C160 429 280 458 438 400C576 350 688 393 817 357C960 316 1075 372 1220 337C1330 310 1417 327 1520 356" />
              <path d="M-20 494C170 459 294 484 450 435C590 391 700 427 832 398C963 367 1083 411 1230 384C1340 364 1424 376 1520 398" />
            </g>
            <path class="route-glow" d="M120 445C260 398 366 470 480 421C586 375 660 391 756 370C865 346 955 409 1062 379C1180 346 1258 300 1370 327" />
            <path class="route" d="M120 445C260 398 366 470 480 421C586 375 660 391 756 370C865 346 955 409 1062 379C1180 346 1258 300 1370 327" />
            <g class="route-node" transform="translate(120 445)"><circle r="7" fill="#f97316"/><circle r="3" fill="#fff7ed"/></g>
            <g class="route-node" transform="translate(756 370)"><circle r="7" fill="#f97316"/><circle r="3" fill="#fff7ed"/></g>
            <g class="route-node" transform="translate(1062 379)"><circle r="7" fill="#f97316"/><circle r="3" fill="#fff7ed"/></g>
            <g class="route-node destination" transform="translate(1370 327)"><circle r="12" fill="none" stroke="#f97316" stroke-width="2"/><circle r="4" fill="#f97316"/></g>
          </svg>

          <div class="opportunity-card">
            <div class="opportunity-top"><span class="status-dot"></span><span>Opportunity found</span><small>HIGH CONFIDENCE</small></div>
            <h2>/best-service-guide/</h2>
            <p>Strong demand. Weak click capture. Rankings are holding.</p>
            <div class="opportunity-metrics">
              <div><small>IMPRESSIONS</small><strong data-counter="1240">1,240</strong></div>
              <div><small>CLICKS</small><strong data-counter="9">9</strong></div>
              <div><small>POSITION</small><strong data-counter="21.6" data-decimal="true">21.6</strong></div>
            </div>
            <div class="opportunity-action"><span>Next move</span><strong>Fix the snippet first.</strong><b>Evidence attached →</b></div>
          </div>
        </div>
      </section>

      <section class="signal-strip shell reveal" aria-label="RankTwig workflow">
        <span><i class="dot dot-blue"></i>Search signal</span>
        <b>→</b>
        <span><i class="dot dot-green"></i>Page evidence</span>
        <b>→</b>
        <span><i class="dot dot-indigo"></i>AI reasoning</span>
        <b>→</b>
        <span><i class="dot dot-orange"></i>Action</span>
      </section>

      <section id="product" class="product-section">
        <div class="shell">
          <div class="section-head reveal">
            <div><p class="eyebrow">THE PRODUCT</p><h2>Less dashboard. More decision.</h2></div>
            <p>Every surface earns its place: one question, one evidence set, one next action.</p>
          </div>

          <div class="bento">
            <article class="card card-investigator reveal">
              <div class="card-copy">
                <span class="card-label label-blue">PAGE INVESTIGATOR</span>
                <h3>Understand the page before you touch it.</h3>
                <p>Performance, ranking queries and current page evidence in one focused view.</p>
              </div>
              <div class="mini-window">
                <div class="mini-bar"><span>/best-service-guide/</span><small>28 days vs prior</small></div>
                <div class="mini-metrics">
                  <div><small>IMP.</small><strong>1,240</strong><em>+18%</em></div>
                  <div><small>CLICKS</small><strong>9</strong><em class="down">−12%</em></div>
                  <div><small>POS.</small><strong>21.6</strong><em>+2.1</em></div>
                </div>
                <div class="query-row"><span>trail running shoes</span><small>620 imp.</small><b>18.7</b></div>
                <div class="query-row"><span>best trail shoes</span><small>381 imp.</small><b>22.4</b></div>
                <div class="query-row"><span>trail shoes guide</span><small>239 imp.</small><b>28.9</b></div>
              </div>
            </article>

            <article class="card card-battle reveal">
              <div class="card-copy">
                <span class="card-label label-orange">PAGE BATTLE</span>
                <h3>Compare only what matters.</h3>
                <p>Observed differences, not a wall of vanity metrics.</p>
              </div>
              <div class="battle-pair">
                <div><small>YOUR PAGE</small><strong>Useful guide</strong><span>Weak decision section</span></div>
                <b>VS</b>
                <div><small>COMPETITOR</small><strong>Commercial guide</strong><span>Clear comparison + trust cues</span></div>
              </div>
              <div class="battle-move"><small>MOVE</small><strong>Fix the decision section first.</strong></div>
            </article>

            <article class="card card-mcp reveal">
              <div class="card-copy">
                <span class="card-label label-indigo">CHATGPT + MCP</span>
                <h3>Ask naturally. Keep the evidence.</h3>
                <p>RankTwig brings the right site context into the conversation.</p>
              </div>
              <div class="chat">
                <p class="chat-user">Bro, what should I work on today?</p>
                <div class="chat-ai"><strong>Start with /best-service-guide/.</strong><span>1,240 impressions · 9 clicks · positions 18–29</span><div><i>GSC</i><i>3 queries</i><i>Fresh crawl</i></div></div>
              </div>
            </article>

            <article class="card card-evidence reveal" id="proof">
              <div class="card-copy">
                <span class="card-label label-green">EVIDENCE FIRST</span>
                <h3>Know what is fact, signal, or inference.</h3>
                <p>RankTwig separates the layers instead of hiding them behind one mysterious score.</p>
              </div>
              <div class="evidence-stack">
                <div><i class="dot dot-blue"></i><span>Observed</span><strong>Clicks fell while rankings held.</strong></div>
                <div><i class="dot dot-green"></i><span>Calculated</span><strong>CTR gap deserves investigation.</strong></div>
                <div><i class="dot dot-indigo"></i><span>AI inference</span><strong>Snippet is the lowest-risk first move.</strong></div>
                <div class="evidence-action"><i class="dot dot-orange"></i><span>Action</span><strong>Rewrite title + description first.</strong></div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="proof-statement shell reveal">
        <p class="eyebrow">THE DIFFERENCE</p>
        <h2>RankTwig does not ask you to trust a score. It shows you the trail.</h2>
        <p>Source → date range → observation → signal → recommendation. Clear enough to inspect. Compact enough to act on.</p>
      </section>

      <section id="pricing" class="pricing-section">
        <div class="shell pricing-wrap">
          <div class="pricing-copy reveal">
            <p class="eyebrow">START SMALL</p>
            <h2>Use the real product for free.</h2>
            <p>Connect one website. See whether the workflow earns a place in your day.</p>
          </div>
          <div class="pricing-cards">
            <article class="price-card reveal">
              <span>FREE</span><strong>$0</strong><small>forever</small>
              <p>One website with the intelligence core.</p>
              <ul><li>25 Investigations</li><li>10 Page Battles</li><li>5 Content Briefs</li></ul>
              <a class="button button-secondary" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Start Free</a>
            </article>
            <article class="price-card price-card-pro reveal">
              <span>PRO</span><strong>$29</strong><small>per month</small>
              <p>More sites, more capacity, MCP and exports.</p>
              <ul><li>Up to 5 websites</li><li>500 Investigations</li><li>ChatGPT + MCP</li></ul>
              <a class="button button-primary" href={`${rankTwigUrl}/pricing`}>See Pro <span aria-hidden="true">→</span></a>
            </article>
          </div>
        </div>
      </section>

      <section class="closing reveal">
        <div class="shell closing-inner">
          <p class="eyebrow">YOUR NEXT MOVE IS PROBABLY ALREADY THERE</p>
          <h2>Follow the evidence.</h2>
          <p>Connect Search Console. Let RankTwig show you what deserves attention.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Put my search data to work <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href={`${rankTwigUrl}/demo`}>Explore first</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell footer-inner">
        <a class="brand" href="#top" aria-label="Back to top">
          <svg viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="10" fill="currentColor"></rect><path d="M8.5 30.2c4.1-3 7.7-6.4 10-10.2 1.7-2.8 2.7-5.8 3.1-9.3.1-1.1 1.8-1.1 1.9 0 .1 2.8-.6 5.6-1.4 7.7 2.7-2.1 5.5-4 8.4-5.7.9-.5 1.7.7 1.1 1.5-4.4 6.3-10.5 10.7-17.6 13 4.2.1 8 .8 11.4 2.1 1 .4.8 1.9-.3 2-5.6-.4-11.2-.8-18 1.6-1 .3-1.7-1.1-.8-1.7 1.6-1.2 2.1-1.8 2.6-2.7Z" fill="white"></path></svg>
          <span>RankTwig</span>
        </a>
        <p>SEO intelligence that turns evidence into action.</p>
        <nav><a href={`${rankTwigUrl}/privacy`}>Privacy</a><a href={`${rankTwigUrl}/terms`}>Terms</a><a href="mailto:team@ranktwig.com">Contact</a></nav>
      </div>
    </footer>

    <script>
      const key = 'ranktwig-theme';
      const media = matchMedia('(prefers-color-scheme: light)');
      const allowed = new Set(['dark', 'light', 'system']);
      const resolve = (p) => p === 'system' ? (media.matches ? 'light' : 'dark') : p;
      const updateButtons = (p) => document.querySelectorAll('[data-theme-option]').forEach((button) => {
        const active = button.dataset.themeOption === p;
        button.toggleAttribute('data-selected', active);
        button.setAttribute('aria-pressed', String(active));
      });
      const applyTheme = (requested, persist = true) => {
        const preference = allowed.has(requested) ? requested : 'light';
        const resolved = resolve(preference);
        const root = document.documentElement;
        root.dataset.themePreference = preference;
        root.dataset.theme = resolved;
        root.classList.toggle('light', resolved === 'light');
        root.classList.toggle('dark', resolved === 'dark');
        root.style.colorScheme = resolved;
        document.querySelector('[data-ranktwig-theme-color]')?.setAttribute('content', resolved === 'light' ? '#f7f7f8' : '#09090b');
        if (persist) { try { localStorage.setItem(key, preference); } catch {} }
        updateButtons(preference);
      };
      updateButtons(document.documentElement.dataset.themePreference || 'light');
      document.querySelectorAll('[data-theme-option]').forEach((button) => button.addEventListener('click', () => applyTheme(button.dataset.themeOption || 'light')));
      media.addEventListener('change', () => { if (document.documentElement.dataset.themePreference === 'system') applyTheme('system', false); });

      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.documentElement.classList.add('motion-ready');

      const reveal = [...document.querySelectorAll('.reveal')];
      if (reduceMotion || !('IntersectionObserver' in window)) reveal.forEach((el) => el.classList.add('is-visible'));
      else {
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }), { threshold: .14, rootMargin: '0px 0px -5% 0px' });
        reveal.forEach((el) => observer.observe(el));
      }

      const route = document.querySelector('.route');
      const glow = document.querySelector('.route-glow');
      if (route instanceof SVGPathElement) {
        const length = route.getTotalLength();
        [route, glow].forEach((path) => {
          if (!(path instanceof SVGPathElement)) return;
          path.style.strokeDasharray = String(length);
          path.style.strokeDashoffset = reduceMotion ? '0' : String(length);
        });
        if (!reduceMotion) requestAnimationFrame(() => {
          route.style.transition = 'stroke-dashoffset 1600ms cubic-bezier(.22,1,.36,1) 420ms';
          route.style.strokeDashoffset = '0';
          if (glow instanceof SVGPathElement) {
            glow.style.transition = 'stroke-dashoffset 1700ms cubic-bezier(.22,1,.36,1) 450ms';
            glow.style.strokeDashoffset = '0';
          }
        });
      }

      const runCounter = (el) => {
        if (!(el instanceof HTMLElement) || el.dataset.counted) return;
        el.dataset.counted = 'true';
        const target = Number(el.dataset.counter || 0);
        const decimal = el.dataset.decimal === 'true';
        if (reduceMotion) return;
        const started = performance.now();
        const duration = 720;
        const fmt = new Intl.NumberFormat('en-US', { maximumFractionDigits: decimal ? 1 : 0, minimumFractionDigits: decimal ? 1 : 0 });
        const frame = (now) => {
          const p = Math.min(1, (now - started) / duration);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt.format(target * eased);
          if (p < 1) requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      };
      const opportunity = document.querySelector('.opportunity-card');
      if (opportunity && 'IntersectionObserver' in window && !reduceMotion) {
        const counterObserver = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.querySelectorAll('[data-counter]').forEach(runCounter);
          counterObserver.disconnect();
        }), { threshold: .35 });
        counterObserver.observe(opportunity);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --canvas:#09090b;
    --surface:#121215;
    --surface-raised:#18181b;
    --surface-soft:#1f1f23;
    --ink:#fafafa;
    --ink-muted:#a1a1aa;
    --ink-faint:#71717a;
    --line:#27272a;
    --line-soft:#1e1e22;
    --orange:#f97316;
    --orange-deep:#c84c0c;
    --orange-soft:rgb(249 115 22 / 10%);
    --blue:#3b82f6;
    --blue-soft:rgb(59 130 246 / 10%);
    --green:#22c55e;
    --green-soft:rgb(34 197 94 / 10%);
    --indigo:#6366f1;
    --indigo-soft:rgb(99 102 241 / 10%);
    --positive:#22c55e;
    --risk:#ef4444;
    --terrain-top:#172038;
    --terrain-bottom:#09090b;
    --ease:cubic-bezier(.22,1,.36,1);
    --sans:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    --mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,Monaco,monospace;
  }

  :root[data-theme='light'] {
    --canvas:#f7f7f8;
    --surface:#ffffff;
    --surface-raised:#f4f4f5;
    --surface-soft:#ececef;
    --ink:#18181b;
    --ink-muted:#52525b;
    --ink-faint:#71717a;
    --line:#d4d4d8;
    --line-soft:#e4e4e7;
    --orange:#f97316;
    --orange-deep:#c84c0c;
    --orange-soft:#fff3e8;
    --blue:#2563eb;
    --blue-soft:#eff6ff;
    --green:#15803d;
    --green-soft:#f0fdf4;
    --indigo:#4f46e5;
    --indigo-soft:#eef2ff;
    --positive:#15803d;
    --risk:#dc2626;
    --terrain-top:#dbe3f2;
    --terrain-bottom:#eef1f6;
  }

  *,*::before,*::after{box-sizing:border-box}
  html{min-width:320px;scroll-behavior:smooth;background:var(--canvas);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}
  body{min-width:320px;margin:0;overflow-x:hidden;background:var(--canvas);color:var(--ink);font-family:var(--sans);line-height:1.6;text-rendering:optimizeLegibility;transition:background-color 180ms ease,color 180ms ease}
  a{color:inherit} svg{display:block;max-width:100%}
  ::selection{background:var(--orange-soft);color:var(--ink)}
  :focus-visible{outline:2px solid var(--orange);outline-offset:3px}
  .shell{width:min(100% - 2rem,76rem);margin-inline:auto}
  .skip-link{position:fixed;z-index:100;top:.75rem;left:.75rem;transform:translateY(-150%);padding:.65rem .9rem;border-radius:.55rem;background:var(--orange-deep);color:white;font-size:.82rem}.skip-link:focus{transform:none}

  .site-header{position:absolute;z-index:30;inset:0 0 auto}
  .header-inner{min-height:4.75rem;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1.2rem}
