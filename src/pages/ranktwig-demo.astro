---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const heroImage = `${base}ranktwig-demo/search-beneath-surface.webp`;
const rankTwigUrl = 'https://ranktwig.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090b" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="description" content="A private RankTwig homepage design experiment." />
    <link rel="icon" type="image/svg+xml" href={`${base}ranktwig-demo/ranktwig-mark.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <title>RankTwig homepage experiment</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="header-shell">
        <a class="brand" href="#top" aria-label="RankTwig home">
          <svg viewBox="0 0 40 40" aria-hidden="true">
            <rect width="40" height="40" rx="10" fill="currentColor"></rect>
            <path d="M8.5 30.2c4.1-3 7.7-6.4 10-10.2 1.7-2.8 2.7-5.8 3.1-9.3.1-1.1 1.8-1.1 1.9 0 .1 2.8-.6 5.6-1.4 7.7 2.7-2.1 5.5-4 8.4-5.7.9-.5 1.7.7 1.1 1.5-4.4 6.3-10.5 10.7-17.6 13 4.2.1 8 .8 11.4 2.1 1 .4.8 1.9-.3 2-5.6-.4-11.2-.8-18 1.6-1 .3-1.7-1.1-.8-1.7 1.6-1.2 2.1-1.8 2.6-2.7Z" fill="white"></path>
          </svg>
          <span>RankTwig</span>
        </a>

        <nav aria-label="Primary navigation">
          <a href="#product">Product</a>
          <a href="#workflow">How it works</a>
          <a href="#pricing">Pricing</a>
          <a href={`${rankTwigUrl}/mcp-guide`}>MCP</a>
        </nav>

        <div class="header-actions">
          <a class="login-link" href={`${rankTwigUrl}/login`}>Log in</a>
          <a class="header-cta" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Start Free <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </header>

    <main id="main-content">
      <section id="top" class="hero" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-glow hero-glow--orange" aria-hidden="true"></div>
        <div class="hero-glow hero-glow--blue-left" aria-hidden="true"></div>
        <div class="hero-glow hero-glow--blue-right" aria-hidden="true"></div>

        <div class="hero-copy">
          <a class="announcement" href="#product">
            <span class="announcement-dot"></span>
            <span>Evidence-first SEO intelligence</span>
            <span aria-hidden="true">→</span>
          </a>

          <h1 id="hero-title">See what search data is trying to tell you.</h1>
          <p class="hero-lede">RankTwig connects Search Console to the AI you choose, finds what deserves attention, and turns it into evidence-backed SEO actions.</p>

          <div class="hero-actions-main">
            <a class="button button-primary" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Find My Next SEO Move <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href={`${rankTwigUrl}/demo`}>Explore the demo</a>
          </div>

          <div class="hero-reassurance" aria-label="Product highlights">
            <span>Set up in minutes</span>
            <span>ChatGPT OAuth + MCP</span>
            <span>BYOK AI</span>
          </div>
        </div>

        <div class="hero-art" aria-hidden="true">
          <div class="hero-art-haze"></div>
          <img src={heroImage} alt="" loading="eager" decoding="async" />
          <div class="floating-proof floating-proof--left">
            <span class="proof-kicker">GSC SIGNAL</span>
            <strong>1,240 impressions</strong>
            <small>Position 18–29 · worth investigating</small>
          </div>
          <div class="floating-proof floating-proof--right">
            <span class="proof-kicker">NEXT MOVE</span>
            <strong>Fix the snippet first</strong>
            <small>Evidence attached · not a blind score</small>
          </div>
        </div>
      </section>

      <section id="workflow" class="flow-section section-shell" aria-labelledby="flow-title">
        <div class="section-heading">
          <p class="eyebrow">HOW IT COMES TOGETHER</p>
          <h2 id="flow-title">One signal becomes a clear next move.</h2>
          <p>Start with what your site is already earning. Keep the page, queries, dates and current evidence together before asking AI to reason over it.</p>
        </div>

        <ol class="flow-steps">
          <li>
            <span class="step-number">01</span>
            <div><strong>Find</strong><p>Surface striking-distance keywords, CTR gaps, rising demand, declines and cannibalization.</p></div>
            <span class="step-proof">Connected GSC</span>
          </li>
          <li>
            <span class="step-number">02</span>
            <div><strong>Investigate</strong><p>Bring search performance, ranking queries and a fresh bounded crawl into one page view.</p></div>
            <span class="step-proof">Search + page evidence</span>
          </li>
          <li>
            <span class="step-number">03</span>
            <div><strong>Compare</strong><p>Use Page Battle to inspect observable differences instead of guessing what a competitor does better.</p></div>
            <span class="step-proof">Observed facts</span>
          </li>
          <li>
            <span class="step-number">04</span>
            <div><strong>Act</strong><p>Turn the evidence into a focused update, content brief or grounded AI conversation.</p></div>
            <span class="step-proof step-proof--action">Evidence-backed action</span>
          </li>
        </ol>
      </section>

      <section id="product" class="product-section">
        <div class="section-shell">
          <div class="product-heading">
            <div>
              <p class="eyebrow">INSIDE RANKTWIG</p>
              <h2>Built around real SEO decisions, not decorative dashboards.</h2>
            </div>
            <p>Every workflow keeps source, date range and limitations visible so you can see why something surfaced before you act on it.</p>
          </div>

          <div class="product-grid">
            <article class="product-card product-card--wide">
              <div class="card-topline"><span>PAGE INVESTIGATOR</span><span>01</span></div>
              <div class="card-copy">
                <h3>Understand a page before changing it.</h3>
                <p>Performance, ranking queries and current page evidence in one place. Add your AI only when another layer of reasoning is useful.</p>
              </div>
              <div class="investigator-ui">
                <div class="ui-bar"><span>/best-service-guide/</span><span>Last 28 days vs previous</span></div>
                <div class="metric-row">
                  <div><small>IMPRESSIONS</small><strong>1,240</strong><span>+18.4%</span></div>
                  <div><small>CLICKS</small><strong>9</strong><span class="negative">−12.0%</span></div>
                  <div><small>AVG. POSITION</small><strong>21.6</strong><span>+2.1</span></div>
                </div>
                <div class="signal-row"><span>Striking distance</span><span>CTR gap</span><span>Fresh crawl ready</span><strong>Investigate →</strong></div>
              </div>
            </article>

            <article class="product-card">
              <div class="card-topline"><span>PAGE BATTLE</span><span>02</span></div>
              <div class="card-copy">
                <h3>See where the competing page has an edge.</h3>
                <p>Compare titles, intent, internal links, schema and current page facts side by side.</p>
              </div>
              <div class="battle-ui">
                <div><span>Your page</span><strong>Useful guide</strong><small>Weak decision section</small></div>
                <i>VS</i>
                <div><span>Competitor</span><strong>Commercial guide</strong><small>Clearer trust cues</small></div>
              </div>
              <div class="action-strip"><span>Move</span><strong>Fix the decision section first</strong></div>
            </article>

            <article class="product-card">
              <div class="card-topline"><span>CHATGPT + MCP</span><span>03</span></div>
              <div class="card-copy">
                <h3>Your SEO data, inside the conversation.</h3>
                <p>Connect once. Then ask naturally while RankTwig brings the relevant site, page, query and opportunity evidence with it.</p>
              </div>
              <div class="chat-ui">
                <p class="chat-user">Bro, what should I work on today?</p>
                <p class="chat-ai"><strong>Start with /best-service-guide/.</strong> It already has demand, but several relevant queries sit around positions 18–29. Fix the snippet and decision section before rewriting the page.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="proof-section section-shell" aria-labelledby="proof-title">
        <div class="section-heading section-heading--compact">
          <p class="eyebrow">SHOW THE WORK</p>
          <h2 id="proof-title">Never wonder why the AI said that.</h2>
        </div>

        <div class="evidence-ledger">
          <div><span>OBSERVED</span><strong>Clicks fell while rankings held</strong><small>GSC · current 28 days vs prior 28 days</small></div>
          <div><span>OBSERVED</span><strong>High-impression queries still match the page</strong><small>Connected query evidence</small></div>
          <div><span>CALCULATED</span><strong>CTR gap deserves investigation</strong><small>Deterministic RankTwig signal</small></div>
          <div class="ledger-answer"><span>NEXT MOVE</span><strong>Start with the title and snippet</strong><small>AI reasoning checked against the evidence</small></div>
        </div>
      </section>

      <section id="pricing" class="pricing-section">
        <div class="section-shell pricing-inner">
          <div class="section-heading section-heading--compact">
            <p class="eyebrow">START SMALL</p>
            <h2>Use the real product for free.</h2>
            <p>Connect one website and see whether RankTwig earns a place in your workflow.</p>
          </div>

          <div class="plans">
            <article>
              <div class="plan-heading"><span>FREE</span><strong>$0</strong><small>forever</small></div>
              <p>One connected website with the intelligence core and useful workflow limits.</p>
              <ul><li>1 connected website</li><li>25 Page Investigations / month</li><li>10 Page Battles / month</li><li>5 Content Briefs / month</li></ul>
              <a class="button button-secondary" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Start Free</a>
            </article>
            <article class="plan-pro">
              <div class="plan-heading"><span>PRO</span><strong>$29</strong><small>per month</small></div>
              <p>More sites, generous workflow capacity, MCP, URL Groups and exports.</p>
              <ul><li>Up to 5 connected websites</li><li>500 Investigations · 200 Battles</li><li>100 Content Briefs / month</li><li>ChatGPT + MCP, groups and exports</li></ul>
              <a class="button button-primary" href={`${rankTwigUrl}/pricing`}>See Pro <span aria-hidden="true">→</span></a>
            </article>
          </div>
        </div>
      </section>

      <section class="closing-section">
        <div class="closing-glow" aria-hidden="true"></div>
        <div class="section-shell closing-inner">
          <p class="eyebrow">THE NEXT MOVE IS PROBABLY ALREADY THERE</p>
          <h2>Follow the evidence.</h2>
          <p>Connect Search Console. Let RankTwig show you what deserves attention. Decide with the source still attached.</p>
          <div class="hero-actions-main">
            <a class="button button-primary" href={`${rankTwigUrl}/login?intent=connect-gsc`}>Put my search data to work <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href={`${rankTwigUrl}/demo`}>Explore first</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <a class="brand" href="#top" aria-label="Back to the top">
        <svg viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="10" fill="currentColor"></rect><path d="M8.5 30.2c4.1-3 7.7-6.4 10-10.2 1.7-2.8 2.7-5.8 3.1-9.3.1-1.1 1.8-1.1 1.9 0 .1 2.8-.6 5.6-1.4 7.7 2.7-2.1 5.5-4 8.4-5.7.9-.5 1.7.7 1.1 1.5-4.4 6.3-10.5 10.7-17.6 13 4.2.1 8 .8 11.4 2.1 1 .4.8 1.9-.3 2-5.6-.4-11.2-.8-18 1.6-1 .3-1.7-1.1-.8-1.7 1.6-1.2 2.1-1.8 2.6-2.7Z" fill="white"></path></svg>
        <span>RankTwig</span>
      </a>
      <p>SEO intelligence that turns evidence into action.</p>
      <div><a href={`${rankTwigUrl}/privacy`}>Privacy</a><a href={`${rankTwigUrl}/terms`}>Terms</a><a href="mailto:team@ranktwig.com">Contact</a></div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --canvas: #09090b;
    --surface: #121215;
    --surface-raised: #18181b;
    --surface-overlay: #1c1c20;
    --ink: #fafafa;
    --ink-muted: #a1a1aa;
    --ink-faint: #71717a;
    --line: #27272a;
    --line-subtle: #1e1e22;
    --action: #f97316;
    --action-hover: #ea580c;
    --action-muted: rgb(249 115 22 / 12%);
    --positive: #22c55e;
    --risk: #ef4444;
    --ai: #6366f1;
    --sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { min-width: 320px; scroll-behavior: smooth; background: var(--canvas); color: var(--ink); font-family: var(--sans); }
  body { min-width: 320px; margin: 0; overflow-x: hidden; background: var(--canvas); color: var(--ink); font-family: var(--sans); line-height: 1.6; text-rendering: optimizeLegibility; -webkit-font-smoothing: antialiased; }
  a { color: inherit; }
  img, svg { display: block; max-width: 100%; }
  ::selection { background: var(--action-muted); color: var(--ink); }
  :focus-visible { outline: 2px solid var(--action); outline-offset: 3px; }

  .skip-link { position: fixed; z-index: 100; top: .75rem; left: .75rem; transform: translateY(-150%); border-radius: .5rem; background: var(--action); padding: .65rem .9rem; color: #09090b; font-size: .875rem; font-weight: 600; }
  .skip-link:focus { transform: translateY(0); }

  .section-shell, .header-shell { width: min(100% - 2rem, 76rem); margin-inline: auto; }

  .site-header { position: absolute; z-index: 50; inset: 0 0 auto; }
  .header-shell { min-height: 4.75rem; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1.5rem; }
  .brand { display: inline-flex; align-items: center; gap: .625rem; width: fit-content; color: var(--action); text-decoration: none; }
  .brand svg { width: 2rem; height: 2rem; flex: 0 0 auto; border-radius: .5rem; }
  .brand span { color: var(--ink); font-size: 1.0625rem; font-weight: 600; letter-spacing: -.025em; }
  .site-header nav { display: flex; align-items: center; gap: .1rem; }
  .site-header nav a, .login-link { min-height: 2.5rem; display: inline-flex; align-items: center; padding: .65rem .78rem; border-radius: .5rem; color: var(--ink-muted); font-size: .8125rem; font-weight: 500; text-decoration: none; transition: 150ms ease; }
  .site-header nav a:hover, .login-link:hover { color: var(--ink); background: rgb(255 255 255 / 4%); }
  .header-actions { justify-self: end; display: flex; align-items: center; gap: .25rem; }
  .header-cta { min-height: 2.5rem; display: inline-flex; align-items: center; gap: .45rem; padding: .65rem .9rem; border-radius: .5rem; background: var(--action); color: #09090b; font-size: .8125rem; font-weight: 600; text-decoration: none; transition: 150ms ease; }
  .header-cta:hover { background: var(--action-hover); color: #fff; transform: translateY(-1px); }

  .hero { position: relative; min-height: clamp(58rem, 100svh, 68rem); overflow: hidden; isolation: isolate; background: var(--canvas); }
  .hero::before { content: ""; position: absolute; z-index: -3; inset: 0; background: linear-gradient(180deg, #09090b 0%, #09090b 51%, #0b0c12 76%, #09090b 100%); }
  .hero-grid { position: absolute; z-index: -2; inset: 0; opacity: .6; background-image: radial-gradient(rgb(255 255 255 / 7%) .75px, transparent .75px); background-size: 24px 24px; -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 44%, transparent 82%); mask-image: linear-gradient(to bottom, #000 0%, #000 44%, transparent 82%); }
  .hero-glow { position: absolute; z-index: -1; border-radius: 999px; filter: blur(20px); pointer-events: none; }
  .hero-glow--orange { left: 50%; bottom: 4%; width: min(46rem, 76vw); height: 24rem; background: radial-gradient(circle, rgb(249 115 22 / 20%), transparent 68%); transform: translateX(-50%); }
  .hero-glow--blue-left { left: -16rem; bottom: -8rem; width: 34rem; height: 34rem; background: radial-gradient(circle, rgb(99 102 241 / 25%), transparent 70%); }
  .hero-glow--blue-right { right: -16rem; bottom: -8rem; width: 34rem; height: 34rem; background: radial-gradient(circle, rgb(59 130 246 / 22%), transparent 70%); }

  .hero-copy { position: relative; z-index: 5; width: min(100% - 2rem, 58rem); margin-inline: auto; padding-top: clamp(8rem, 14vh, 10rem); text-align: center; }
  .announcement { display: inline-flex; align-items: center; gap: .5rem; padding: .37rem .62rem; border: 1px solid rgb(255 255 255 / 12%); border-radius: 999px; background: rgb(255 255 255 / 3%); color: var(--ink-muted); font-family: var(--mono); font-size: .6875rem; font-weight: 500; text-decoration: none; box-shadow: inset 0 1px 0 rgb(255 255 255 / 4%); backdrop-filter: blur(12px); }
  .announcement:hover { border-color: rgb(249 115 22 / 45%); color: var(--ink); }
  .announcement-dot { width: .4rem; height: .4rem; border-radius: 50%; background: var(--action); box-shadow: 0 0 0 .23rem rgb(249 115 22 / 10%); }
  .hero h1 { max-width: 13ch; margin: 1.3rem auto 0; font-size: clamp(3.4rem, 6.1vw, 6.2rem); font-weight: 500; line-height: .94; letter-spacing: -.062em; text-wrap: balance; }
  .hero-lede { max-width: 45rem; margin: 1.45rem auto 0; color: var(--ink-muted); font-size: clamp(.95rem, 1.25vw, 1.08rem); line-height: 1.75; text-wrap: balance; }
  .hero-actions-main { margin-top: 1.65rem; display: flex; flex-wrap: wrap; justify-content: center; gap: .65rem; }
  .button { min-height: 3rem; display: inline-flex; align-items: center; justify-content: center; gap: .5rem; padding: .72rem 1rem; border: 1px solid transparent; border-radius: .5rem; font-size: .875rem; font-weight: 600; text-decoration: none; transition: 150ms ease; }
  .button:hover { transform: translateY(-1px); }
  .button-primary { background: var(--action); color: #09090b; }
  .button-primary:hover { background: var(--action-hover); color: #fff; }
  .button-secondary { border-color: var(--line); background: var(--surface-raised); color: var(--ink); }
  .button-secondary:hover { border-color: var(--ink-faint); background: var(--surface-overlay); }
  .hero-reassurance { margin-top: 1.15rem; display: flex; flex-wrap: wrap; justify-content: center; gap: .55rem 1.4rem; color: var(--ink-faint); font-family: var(--mono); font-size: .625rem; }
  .hero-reassurance span::before { content: "•"; margin-right: .45rem; color: var(--action); }

  .hero-art { position: absolute; z-index: 3; left: 50%; bottom: -1.5rem; width: min(82rem, 112vw); height: 49%; transform: translateX(-50%); pointer-events: none; }
  .hero-art::before { content: ""; position: absolute; z-index: -1; left: 10%; right: 10%; bottom: 2%; height: 48%; border-radius: 50%; background: radial-gradient(ellipse, rgb(249 115 22 / 14%), transparent 66%); filter: blur(24px); }
  .hero-art-haze { position: absolute; z-index: 2; inset: 0; background: linear-gradient(180deg, var(--canvas) 0%, rgb(9 9 11 / 92%) 5%, transparent 27%, transparent 90%, rgb(9 9 11 / 16%) 100%); }
  .hero-art img { position: absolute; z-index: 1; left: 50%; bottom: 0; width: 100%; height: 100%; object-fit: contain; object-position: center bottom; transform: translateX(-50%); image-rendering: auto; filter: saturate(1.06) contrast(1.02); }
  .floating-proof { position: absolute; z-index: 4; width: 13.5rem; padding: .85rem .9rem; border: 1px solid rgb(255 255 255 / 12%); border-radius: .72rem; background: rgb(18 18 21 / 82%); box-shadow: 0 18px 60px rgb(0 0 0 / 28%), inset 0 1px 0 rgb(255 255 255 / 5%); backdrop-filter: blur(16px); }
  .floating-proof--left { left: 8%; bottom: 19%; transform: rotate(-2deg); }
  .floating-proof--right { right: 8%; bottom: 26%; transform: rotate(2deg); }
  .proof-kicker { display: block; color: var(--action); font-family: var(--mono); font-size: .57rem; font-weight: 500; letter-spacing: .08em; }
  .floating-proof strong { display: block; margin-top: .36rem; font-size: .78rem; font-weight: 600; }
  .floating-proof small { display: block; margin-top: .24rem; color: var(--ink-faint); font-family: var(--mono); font-size: .54rem; line-height: 1.5; }

  .eyebrow { margin: 0; color: var(--action); font-family: var(--mono); font-size: .6875rem; font-weight: 500; letter-spacing: .08em; }
  .section-heading { max-width: 46rem; }
  .section-heading h2, .product-heading h2, .closing-inner h2 { margin: .85rem 0 0; font-size: clamp(2.5rem, 4.8vw, 4.7rem); font-weight: 500; line-height: .98; letter-spacing: -.052em; text-wrap: balance; }
  .section-heading > p:last-child, .product-heading > p, .closing-inner > p:nth-of-type(2) { margin: 1.25rem 0 0; color: var(--ink-muted); font-size: 1rem; line-height: 1.75; }
  .section-heading--compact { max-width: 38rem; }

  .flow-section { padding-block: clamp(6rem, 11vw, 10rem); }
  .flow-steps { margin: 4rem 0 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .flow-steps li { display: grid; grid-template-columns: 3.8rem minmax(0, 1fr) minmax(9rem, .35fr); gap: 2rem; align-items: center; padding: 1.6rem 0; border-bottom: 1px solid var(--line); }
  .step-number, .step-proof { color: var(--ink-faint); font-family: var(--mono); font-size: .625rem; }
  .flow-steps strong { display: block; font-size: 1.35rem; font-weight: 600; letter-spacing: -.025em; }
  .flow-steps p { max-width: 42rem; margin: .28rem 0 0; color: var(--ink-muted); font-size: .875rem; }
  .step-proof { text-align: right; }
  .step-proof--action { color: var(--action); }

  .product-section { padding-block: clamp(6rem, 11vw, 10rem); border-block: 1px solid var(--line-subtle); background: #0b0b0e; }
  .product-heading { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(18rem, .55fr); gap: clamp(3rem, 8vw, 7rem); align-items: end; }
  .product-heading h2 { max-width: 14ch; }
  .product-grid { margin-top: 4rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .product-card { overflow: hidden; min-height: 28rem; padding: clamp(1.4rem, 2.5vw, 2rem); border: 1px solid var(--line); border-radius: 1rem; background: linear-gradient(180deg, rgb(24 24 27 / 92%), rgb(18 18 21 / 98%)); box-shadow: inset 0 1px 0 rgb(255 255 255 / 3%); }
  .product-card--wide { grid-column: 1 / -1; min-height: 31rem; }
