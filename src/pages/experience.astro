---
import Layout from '../layouts/Layout.astro';
import TechnicalWorkbench from '../components/TechnicalWorkbench.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const logo = (path: string) => `https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${path}`;

const toolGroups = [
  {
    label: 'SEARCH / PUBLISH',
    tools: [
      { name: 'Search Console', icon: logo('google/google-original.svg') },
      { name: 'WordPress', icon: logo('wordpress/wordpress-plain.svg') },
      { name: 'HTML', icon: logo('html5/html5-original.svg') },
      { name: 'CSS', icon: logo('css3/css3-original.svg') },
    ],
  },
  {
    label: 'BUILD / SHIP',
    tools: [
      { name: 'Astro', icon: logo('astro/astro-original.svg') },
      { name: 'Tailwind', icon: logo('tailwindcss/tailwindcss-original.svg') },
      { name: 'VS Code', icon: logo('vscode/vscode-original.svg') },
      { name: 'GitHub', icon: logo('github/github-original.svg') },
    ],
  },
  {
    label: 'ANDROID / QA',
    tools: [
      { name: 'Android Studio', icon: logo('androidstudio/androidstudio-original.svg') },
      { name: 'Kotlin', icon: logo('kotlin/kotlin-original.svg') },
      { name: 'Gradle', icon: logo('gradle/gradle-original.svg') },
      { name: 'Android', icon: logo('android/android-original.svg') },
    ],
  },
];
---

<Layout
  title="Experience"
  description="Naman Patel’s hands-on experience across SEO, content, web products, Android, GitHub, automation, QA, and the workflows used to turn ideas into shipped work."
>
  <section class="experience-hero shell shell--wide" aria-labelledby="experience-title">
    <div class="experience-hero__copy">
      <span class="experience-kicker">Experience / working evidence</span>
      <h1 id="experience-title">I learned most of this by shipping things.</h1>
      <p class="experience-lede">
        Search was the entry point. Then the work kept pulling me into publishing, product, code, automation, Android, QA, and release engineering.
      </p>
      <p>
        I’m largely self-taught. I care less about collecting badges than being able to move from a messy problem to something useful, measurable, and actually live.
      </p>
      <div class="experience-hero__links">
        <a class="arrow-link" href={`${base}projects/`}>See what I’ve built <span aria-hidden="true">→</span></a>
        <a class="arrow-link" href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <aside class="experience-console" aria-label="A snapshot of Naman's working stack">
      <div class="experience-console__bar"><i></i><i></i><i></i><span>working-stack.txt</span></div>
      <div class="experience-console__body">
        <div class="console-line"><b>01</b><span>research search intent</span><em>SEO</em></div>
        <div class="console-line"><b>02</b><span>structure + build</span><em>WEB</em></div>
        <div class="console-line"><b>03</b><span>test on device</span><em>QA</em></div>
        <div class="console-line"><b>04</b><span>ship + measure</span><em>LIVE</em></div>
        <pre><code>$ git status
<span>✓ product thinking</span>
<span>✓ technical SEO</span>
<span>✓ Android builds</span>
<span>✓ automation / CI</span>

<strong>still learning → always</strong></code></pre>
      </div>
    </aside>
  </section>

  <section class="page-section shell shell--wide" aria-labelledby="trail-title">
    <div class="experience-heading">
      <span>01 / THE WORK TRAIL</span>
      <div>
        <h2 id="trail-title">The skills make more sense when you see how they connect.</h2>
        <p>Each layer came from needing to solve the next problem, not from trying to make a longer résumé.</p>
      </div>
    </div>

    <div class="work-trail">
      <article class="trail-item trail-item--seo">
        <div class="trail-index"><span>01</span><i></i></div>
        <div class="trail-visual"><TechnicalWorkbench variant="seo" /></div>
        <div class="trail-copy">
          <span class="trail-label">SEARCH → CONTENT → MEASUREMENT</span>
          <h3>SEO became the habit of looking for what people actually need.</h3>
          <p>
            I’ve spent years around keyword research, search intent, content structure, on-page work, WordPress publishing, technical cleanup, Search Console, analytics, and the less glamorous job of diagnosing why a page stopped working.
          </p>
          <div class="receipt-list" aria-label="SEO experience">
            <span><b>QUERY</b> research + intent</span>
            <span><b>PAGE</b> structure + on-page</span>
            <span><b>TECH</b> schema + crawl + index</span>
            <span><b>DATA</b> GSC + analytics</span>
          </div>
        </div>
      </article>

      <article class="trail-item trail-item--web">
        <div class="trail-index"><span>02</span><i></i></div>
        <div class="trail-visual"><TechnicalWorkbench variant="web" /></div>
        <div class="trail-copy">
          <span class="trail-label">IDEA → INTERFACE → CODE → DEPLOY</span>
          <h3>Eventually I wanted to build the thing, not only grow it.</h3>
          <p>
            That pushed me into Astro, HTML, CSS, responsive interfaces, GitHub, debugging, deployment, and product decisions. I like getting a rough idea far enough that somebody else can open it and immediately understand what to do.
          </p>
          <div class="receipt-list" aria-label="Web product experience">
            <span><b>STACK</b> Astro + Tailwind</span>
            <span><b>CODE</b> HTML / CSS / JS</span>
            <span><b>FLOW</b> Git + GitHub</span>
            <span><b>SHIP</b> build + deploy</span>
          </div>
        </div>
      </article>

      <article class="trail-item trail-item--workflow">
        <div class="trail-index"><span>03</span><i></i></div>
        <div class="trail-visual"><TechnicalWorkbench variant="workflow" /></div>
        <div class="trail-copy">
          <span class="trail-label">ISSUE → BUILD → QA → RELEASE</span>
          <h3>Now the work regularly crosses product, Android, automation, QA, and releases.</h3>
          <p>
            I’m comfortable using Android Studio, Kotlin, Gradle, GitHub workflows, emulator testing, build artifacts, release checks, and agent-assisted workflows when they shorten the path from an issue to a verified release.
          </p>
          <div class="receipt-list" aria-label="Android and workflow experience">
            <span><b>ANDROID</b> Kotlin + Studio</span>
            <span><b>BUILD</b> Gradle + artifacts</span>
            <span><b>QA</b> emulator + smoke tests</span>
            <span><b>CI</b> GitHub Actions</span>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="page-section evidence-section shell shell--wide" aria-labelledby="evidence-title">
    <div class="experience-heading">
      <span>02 / RECEIPTS</span>
      <div>
        <h2 id="evidence-title">A few outcomes that forced me to learn properly.</h2>
        <p>The useful proof is the work where traffic, users, technical problems, or release pressure made the result matter.</p>
      </div>
    </div>

    <div class="evidence-board">
      <article class="evidence-card evidence-card--traffic">
        <div class="evidence-card__top"><span>CONTENT PROJECT</span><b>A</b></div>
        <strong>Up to 1M</strong>
        <h3>monthly visitors</h3>
        <p>I grew one of my own content projects to roughly a million visitors per month at its peak.</p>
        <div class="mini-analytics" aria-hidden="true">
          <span>organic</span><b>↗ 1,000,000</b>
          <svg viewBox="0 0 220 58" preserveAspectRatio="none"><polyline points="0,52 30,48 54,44 82,46 105,31 130,35 154,24 180,18 220,5" /></svg>
        </div>
      </article>

      <article class="evidence-card evidence-card--acquired">
        <div class="evidence-card__top"><span>OUTCOME</span><b>B</b></div>
        <strong>Acquired</strong>
        <h3>an entertainment project</h3>
        <p>A US-focused entertainment site I worked on was later acquired by WealthOfGeeks Media.</p>
        <div class="acquisition-flow" aria-hidden="true"><span>content site</span><i>→</i><span>media company</span><em>DONE</em></div>
      </article>

      <article class="evidence-card evidence-card--current">
        <div class="evidence-card__top"><span>CURRENT LAB</span><b>C</b></div>
        <strong>Still building</strong>
        <h3>the next layer</h3>
        <p>SmallMB, Astro SEO Audit, Get Random Letter, Calm WP and this site are where the newer product, Android and tooling skills get tested.</p>
        <div class="current-files" aria-hidden="true">
          <span>smallmb.apk</span><span>astro-seo-audit</span><span>getrandomletter.com</span>
        </div>
      </article>
    </div>
  </section>

  <section class="page-section toolbox-section shell shell--wide" aria-labelledby="tools-title">
    <div class="experience-heading">
      <span>03 / TOOLBOX</span>
      <div>
        <h2 id="tools-title">Tools I use as parts of systems, not decorations.</h2>
        <p>The logo is not the skill. Knowing where it belongs in the workflow is.</p>
      </div>
    </div>

    <div class="tool-system">
      {toolGroups.map((group, groupIndex) => (
        <div class="tool-system__row">
          <div class="tool-system__label"><span>0{groupIndex + 1}</span><b>{group.label}</b></div>
          <div class="tool-system__tools">
            {group.tools.map((tool) => (
              <div class="tool-tile">
                <img src={tool.icon} alt="" loading="lazy" />
                <span>{tool.name}</span>
              </div>
            ))}
          </div>
          <div class="tool-system__arrow" aria-hidden="true">→</div>
          <div class="tool-system__output">
            {groupIndex === 0 && <><b>useful page</b><span>indexed + measurable</span></>}
            {groupIndex === 1 && <><b>working product</b><span>built + deployed</span></>}
            {groupIndex === 2 && <><b>verified release</b><span>tested + shipped</span></>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="experience-end shell shell--wide">
    <div>
      <span>THE COMMON THREAD</span>
      <p>I like understanding how something works, making a real version of it, and staying with it long enough to make the version better.</p>
    </div>
    <div class="experience-end__links">
      <a class="arrow-link" href={`${base}projects/`}>Projects <span aria-hidden="true">→</span></a>
      <a class="arrow-link" href={`${base}about/`}>More about me <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>

<style>
  .experience-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(21rem, 0.9fr);
    gap: clamp(3rem, 7vw, 6rem);
    align-items: center;
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }

  .experience-kicker,
  .experience-heading > span,
  .trail-label,
  .experience-end > div > span {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .experience-hero h1 {
    max-width: 10ch;
    margin: 0.85rem 0 0;
    font-family: var(--reading);
    font-size: clamp(3rem, 7vw, 5.8rem);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: -0.06em;
  }

  .experience-hero__copy > p {
    max-width: 58ch;
    margin: 1rem 0 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .experience-hero__copy .experience-lede {
    margin-top: 1.5rem;
    color: var(--ink);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.55;
  }

  .experience-hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 1.4rem;
  }

  .experience-console {
    border: 1px solid color-mix(in srgb, var(--ink) 65%, transparent);
    background: #11352d;
    box-shadow: 1rem 1rem 0 #ff7658;
    transform: rotate(1deg);
    overflow: hidden;
  }

  .experience-console__bar {
    height: 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding-inline: 0.8rem;
    border-bottom: 1px solid #31594e;
    color: #95b9ae;
    font-family: var(--mono);
    font-size: 0.55rem;
  }

  .experience-console__bar i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: #7fa59a;
  }

  .experience-console__bar span { margin-left: auto; }

  .experience-console__body {
    padding: clamp(1rem, 3vw, 1.8rem);
  }

  .console-line {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.7rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid #31594e;
    color: #dff4eb;
    font-family: var(--mono);
    font-size: clamp(0.58rem, 1vw, 0.72rem);
  }

  .console-line b { color: #77a99c; font-weight: 500; }
  .console-line em { color: #f3df72; font-size: 0.55rem; font-style: normal; }

  .experience-console pre {
    margin: 1rem 0 0;
    color: #b7d1c8;
    font-family: var(--mono);
    font-size: clamp(0.58rem, 1vw, 0.72rem);
    line-height: 1.7;
  }

  .experience-console pre span { color: #73e1aa; }
  .experience-console pre strong { color: #ff8a72; font-weight: 500; }

  .experience-heading {
    display: grid;
    grid-template-columns: minmax(7rem, 0.3fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--rule-strong);
  }

  .experience-heading h2 {
    max-width: 18ch;
    margin: 0;
    font-family: var(--display);
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.052em;
  }

  .experience-heading p {
    max-width: 60ch;
    margin: 0.8rem 0 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .work-trail {
    display: grid;
    gap: clamp(4rem, 9vw, 8rem);
  }

  .trail-item {
    position: relative;
    display: grid;
    grid-template-columns: 4rem minmax(21rem, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(1rem, 4vw, 3.5rem);
    align-items: center;
  }

  .trail-item:nth-child(even) .trail-visual { order: 3; }
  .trail-item:nth-child(even) .trail-copy { order: 2; }

  .trail-index {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.62rem;
  }

  .trail-index i {
    width: 1px;
    min-height: 8rem;
    flex: 1;
    background: linear-gradient(var(--rule-strong), transparent);
  }

  .trail-visual { min-width: 0; }

  .trail-copy h3 {
    max-width: 18ch;
    margin: 0.7rem 0 0;
    font-family: var(--reading);
    font-size: clamp(1.9rem, 4vw, 3.25rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .trail-copy p {
    max-width: 58ch;
    margin: 1rem 0 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .receipt-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
    margin-top: 1.25rem;
  }

  .receipt-list span {
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--rule);
    color: var(--muted);
    background: color-mix(in srgb, var(--surface) 66%, transparent);
    font-family: var(--mono);
    font-size: 0.6rem;
  }

  .receipt-list b { color: var(--ink); font-size: 0.52rem; }

  .evidence-section { border-top: 1px solid var(--rule); }

  .evidence-board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.7rem);
  }

  .evidence-card {
    min-height: 25rem;
    display: flex;
    flex-direction: column;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border: 1px solid color-mix(in srgb, var(--ink) 28%, transparent);
    overflow: hidden;
  }

  .evidence-card--traffic { background: #f1d950; }
  .evidence-card--acquired { background: #9bd7cc; }
  .evidence-card--current { color: #e7f5ef; background: #15382f; }

  .evidence-card__top {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 0.55rem;
    letter-spacing: 0.07em;
  }

  .evidence-card > strong {
    margin-top: clamp(2.5rem, 7vw, 5rem);
    font-family: var(--reading);
    font-size: clamp(2.5rem, 5vw, 4.4rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .evidence-card h3 {
    margin: 0.4rem 0 0;
    font-size: clamp(1rem, 2vw, 1.35rem);
    letter-spacing: -0.035em;
  }

  .evidence-card p {
    margin: 0.75rem 0 0;
    color: color-mix(in srgb, currentColor 70%, transparent);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .mini-analytics,
  .acquisition-flow,
  .current-files {
    margin-top: auto;
  }

  .mini-analytics {
    padding-top: 1rem;
    border-top: 1px solid rgba(23, 25, 21, 0.25);
  }

  .mini-analytics span,
  .mini-analytics b {
    font-family: var(--mono);
    font-size: 0.55rem;
  }

  .mini-analytics b { float: right; color: #126d49; }
  .mini-analytics svg { width: 100%; height: 4rem; margin-top: 0.6rem; }
  .mini-analytics polyline { fill: none; stroke: #143b31; stroke-width: 2.5; vector-effect: non-scaling-stroke; }

  .acquisition-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.45rem;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid rgba(23, 25, 21, 0.25);
    font-family: var(--mono);
    font-size: 0.55rem;
  }

  .acquisition-flow span { padding: 0.55rem; border: 1px solid rgba(23,25,21,.35); background: #f7f2e4; text-align: center; }
  .acquisition-flow em { grid-column: 3; justify-self: end; padding: 0.15rem 0.3rem; color: #0d5f3a; background: #d8efe0; font-style: normal; }

  .current-files {
    display: grid;
    gap: 0.35rem;
    padding-top: 1rem;
    border-top: 1px solid #3f665b;
  }

  .current-files span {
    padding: 0.45rem 0.55rem;
    border: 1px solid #52796e;
    color: #c5ded6;
    font-family: var(--mono);
    font-size: 0.55rem;
  }

  .toolbox-section { border-top: 1px solid var(--rule); }

  .tool-system {
    border-top: 1px solid var(--rule-strong);
  }

  .tool-system__row {
    display: grid;
    grid-template-columns: minmax(9rem, 0.6fr) minmax(0, 1.8fr) auto minmax(9rem, 0.75fr);
    gap: clamp(0.8rem, 2.5vw, 1.7rem);
    align-items: center;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--rule-strong);
  }

  .tool-system__label {
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
    font-family: var(--mono);
  }

  .tool-system__label span { color: var(--faint); font-size: 0.55rem; }
  .tool-system__label b { font-size: 0.62rem; letter-spacing: 0.05em; }

  .tool-system__tools {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.4rem;
  }

  .tool-tile {
    min-width: 0;
    min-height: 4.2rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem;
    border: 1px solid var(--rule);
    background: var(--surface);
  }

  .tool-tile img { width: 1.45rem; height: 1.45rem; object-fit: contain; }
  .tool-tile span { overflow: hidden; font-size: 0.65rem; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }

  .tool-system__arrow { color: var(--accent); font-size: 1.4rem; }

  .tool-system__output b,
  .tool-system__output span { display: block; }
  .tool-system__output b { font-family: var(--reading); font-size: 1rem; font-weight: 400; }
  .tool-system__output span { margin-top: 0.15rem; color: var(--faint); font-family: var(--mono); font-size: 0.52rem; }

  .experience-end {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) auto;
    gap: 2rem;
    align-items: end;
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--rule-strong);
  }

  .experience-end p {
    max-width: 37ch;
    margin: 0.6rem 0 0;
    font-family: var(--reading);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    line-height: 1.18;
    letter-spacing: -0.035em;
  }

  .experience-end__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.2rem;
  }

  @media (max-width: 980px) {
    .experience-hero { grid-template-columns: 1fr; }
    .experience-console { max-width: 38rem; }
    .trail-item { grid-template-columns: 2.5rem 1fr; }
    .trail-visual,
    .trail-copy,
    .trail-item:nth-child(even) .trail-visual,
    .trail-item:nth-child(even) .trail-copy { order: initial; grid-column: 2; }
    .trail-index { grid-row: 1 / span 2; }
    .evidence-board { grid-template-columns: 1fr; }
    .evidence-card { min-height: 21rem; }
    .tool-system__row { grid-template-columns: 1fr; }
    .tool-system__arrow { transform: rotate(90deg); justify-self: start; }
    .tool-system__output { padding-left: 0.2rem; }
  }

  @media (max-width: 700px) {
    .experience-heading { grid-template-columns: 1fr; gap: 0.65rem; }
    .trail-item { grid-template-columns: 1fr; }
    .trail-index { display: none; }
    .trail-visual,
    .trail-copy,
    .trail-item:nth-child(even) .trail-visual,
    .trail-item:nth-child(even) .trail-copy { grid-column: 1; }
    .receipt-list { grid-template-columns: 1fr; }
    .tool-system__tools { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .experience-end { grid-template-columns: 1fr; align-items: start; }
  }

  @media (max-width: 460px) {
    .tool-system__tools { grid-template-columns: 1fr; }
  }
</style>
