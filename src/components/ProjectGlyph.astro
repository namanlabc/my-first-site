---
interface Props {
  kind: 'smallmb' | 'audit' | 'letters';
}

const { kind } = Astro.props;
---

<span class:list={['project-glyph', `project-glyph--${kind}`]} aria-hidden="true">
  {kind === 'smallmb' && (
    <svg viewBox="0 0 32 32" role="presentation">
      <rect class="glyph-tile" x="1" y="1" width="30" height="30" rx="8" />
      <g class="smallmb-compress-wrap">
        <path class="smallmb-arrow smallmb-arrow--top" d="M9 8.5 11.5 11 14 8.5" />
        <path class="smallmb-arrow smallmb-arrow--bottom" d="M18 23.5 20.5 21 23 23.5" />
      </g>
      <g class="smallmb-paper-wrap">
        <path class="smallmb-paper" d="M11 7.5h7l4 4v12.8H11z" />
        <path class="smallmb-fold" d="M18 7.5v4h4" />
        <path class="smallmb-line smallmb-line--one" d="M14 15h5" />
        <path class="smallmb-line smallmb-line--two" d="M14.8 18h3.4" />
      </g>
      <rect class="smallmb-meter-bg" x="9.5" y="26" width="13" height="1.5" rx=".75" />
      <rect class="smallmb-meter" x="9.5" y="26" width="13" height="1.5" rx=".75" />
    </svg>
  )}

  {kind === 'audit' && (
    <svg viewBox="0 0 32 32" role="presentation">
      <rect class="glyph-tile" x="1" y="1" width="30" height="30" rx="8" />
      <rect class="audit-window" x="7.5" y="7.5" width="17" height="16" rx="2.6" />
      <path class="audit-topbar" d="M7.8 11h16.4" />
      <circle class="audit-dot audit-dot--one" cx="10" cy="9.2" r=".8" />
      <circle class="audit-dot audit-dot--two" cx="12.5" cy="9.2" r=".8" />
      <path class="audit-copy audit-copy--one" d="M10.1 14.3h7.8" />
      <path class="audit-copy audit-copy--two" d="M10.1 17.2h5.3" />
      <path class="audit-check" d="m15.8 20.2 2 1.9 4.2-4.5" />
      <path class="audit-scan" d="M9.4 13h13.2" />
    </svg>
  )}

  {kind === 'letters' && (
    <svg viewBox="0 0 32 32" role="presentation">
      <rect class="glyph-tile" x="1" y="1" width="30" height="30" rx="8" />
      <g class="letters-orbit">
        <path d="M8.6 12.1c1.5-3.1 4.2-4.9 7.7-4.9 2.7 0 5.1 1.1 6.7 3" />
        <path d="m20.7 7.9 2.7 2.5-3.4 1" />
        <path d="M23.4 19.9c-1.5 3.1-4.2 4.9-7.7 4.9-2.7 0-5.1-1.1-6.7-3" />
        <path d="m11.3 24.1-2.7-2.5 3.4-1" />
      </g>
      <g class="letters-face letters-face--a">
        <path d="m11.7 21 3.4-10h1.8l3.4 10" />
        <path d="M13 17.2h6" />
      </g>
      <g class="letters-face letters-face--z">
        <path d="M11.8 11.2h8.4l-8.4 9.6h8.4" />
      </g>
      <circle class="letters-spark" cx="24.7" cy="7.4" r="1.2" />
    </svg>
  )}
</span>

<style>
  .project-glyph {
    display: grid;
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    place-items: center;
    overflow: visible;
    border-radius: 8px;
    transform-origin: center;
    -webkit-tap-highlight-color: transparent;
    transition: transform 180ms cubic-bezier(.2,.8,.2,1), filter 180ms ease;
  }

  .project-glyph svg {
    display: block;
    width: 30px;
    height: 30px;
    overflow: visible;
  }

  .glyph-tile { stroke: none; }
  .project-glyph--smallmb .glyph-tile { fill: #2f8068; }
  .project-glyph--audit .glyph-tile { fill: #171916; }
  .project-glyph--letters .glyph-tile { fill: #ead05a; }

  :global(:root.dark) .project-glyph--smallmb .glyph-tile { fill: #3b846f; }
  :global(:root.dark) .project-glyph--audit .glyph-tile { fill: #f1f2ed; }
  :global(:root.dark) .project-glyph--letters .glyph-tile { fill: #d8bc47; }

  .project-glyph--smallmb { color: #fff; }
  .project-glyph--audit { color: #f7f5ef; }
  .project-glyph--letters { color: #30321f; }
  :global(:root.dark) .project-glyph--audit { color: #171916; }

  .project-glyph path,
  .project-glyph rect:not(.glyph-tile),
  .project-glyph circle:not(.letters-spark):not(.audit-dot) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .project-glyph:hover,
  .project-glyph:active { transform: translateY(-1.5px) scale(1.07); filter: drop-shadow(0 5px 6px rgb(0 0 0 / .12)); }

  /* SmallMB — file visibly compresses by itself every few seconds. */
  .smallmb-paper-wrap { transform-origin: 16.5px 16px; animation: smallmb-paper-idle 6s .5s cubic-bezier(.2,.8,.2,1) infinite; }
  .smallmb-paper { fill: rgb(255 255 255 / .11) !important; }
  .smallmb-fold { opacity: .82; }
  .smallmb-line { stroke-width: 1.25 !important; opacity: .9; }
  .smallmb-compress-wrap { transform-origin: 16px 16px; animation: smallmb-arrows-idle 6s .5s cubic-bezier(.2,.8,.2,1) infinite; }
  .smallmb-arrow { stroke-width: 1.4 !important; }
  .smallmb-meter-bg { fill: rgb(255 255 255 / .18) !important; stroke: none !important; }
  .smallmb-meter { fill: #fff !important; stroke: none !important; transform-box: fill-box; transform-origin: left center; animation: smallmb-meter-idle 6s .5s cubic-bezier(.2,.8,.2,1) infinite; }

  /* Audit — scan sweeps, then check redraws. */
  .audit-window { fill: rgb(255 255 255 / .025) !important; }
  :global(:root.dark) .audit-window { fill: rgb(0 0 0 / .025) !important; }
  .audit-topbar, .audit-copy { opacity: .72; stroke-width: 1.25 !important; }
  .audit-dot { fill: currentColor; stroke: none; opacity: .48; }
  .audit-dot--two { opacity: .28; }
  .audit-scan { stroke: #8fd0af !important; opacity: 0; transform-origin: center; animation: audit-scan-idle 6.6s 1.8s ease-in-out infinite; }
  :global(:root.dark) .audit-scan { stroke: #416b5a !important; }
  .audit-check { stroke: #8fd0af !important; stroke-width: 1.8 !important; stroke-dasharray: 10; stroke-dashoffset: 0; animation: audit-check-idle 6.6s 1.8s ease-in-out infinite; }
  :global(:root.dark) .audit-check { stroke: #416b5a !important; }

  /* Random Letter — A flips to Z while arrows make one deliberate turn. */
  .letters-orbit { transform-origin: 16px 16px; opacity: .62; animation: letters-orbit-idle 7.2s 3s cubic-bezier(.2,.8,.2,1) infinite; }
  .letters-orbit path { stroke-width: 1.35 !important; }
  .letters-face { transform-origin: 16px 16px; }
  .letters-face path { stroke-width: 1.65 !important; }
  .letters-face--a { animation: letter-a-idle 7.2s 3s cubic-bezier(.2,.8,.2,1) infinite; }
  .letters-face--z { opacity: 0; transform: rotateY(-90deg); animation: letter-z-idle 7.2s 3s cubic-bezier(.2,.8,.2,1) infinite; }
  .letters-spark { fill: #fff7bd; stroke: none; opacity: .35; animation: letter-spark-idle 7.2s 3s ease-in-out infinite; }

  @keyframes smallmb-paper-idle {
    0%, 54%, 100% { transform: translateY(0) scaleY(1); }
    63% { transform: translateY(.8px) scaleY(.78); }
    69% { transform: translateY(-.2px) scaleY(1.05); }
    74% { transform: translateY(0) scaleY(1); }
  }

  @keyframes smallmb-arrows-idle {
    0%, 54%, 100% { transform: scaleY(1); }
    63% { transform: scaleY(.55); }
    70% { transform: scaleY(1.06); }
    74% { transform: scaleY(1); }
  }

  @keyframes smallmb-meter-idle {
    0%, 54%, 100% { transform: scaleX(1); }
    63% { transform: scaleX(.55); }
    72% { transform: scaleX(.72); }
    78% { transform: scaleX(1); }
  }

  @keyframes audit-scan-idle {
    0%, 47%, 100% { opacity: 0; transform: translateY(-2.4px); }
    53% { opacity: .92; }
    65% { opacity: .92; transform: translateY(7.2px); }
    70% { opacity: 0; transform: translateY(8px); }
  }

  @keyframes audit-check-idle {
    0%, 50%, 100% { stroke-dashoffset: 0; }
    52% { stroke-dashoffset: 10; }
    66% { stroke-dashoffset: 10; }
    74% { stroke-dashoffset: 0; }
  }

  @keyframes letters-orbit-idle {
    0%, 42%, 100% { transform: rotate(0); }
    58% { transform: rotate(180deg); }
    70% { transform: rotate(360deg); }
    76%, 100% { transform: rotate(360deg); }
  }

  @keyframes letter-a-idle {
    0%, 48%, 100% { opacity: 1; transform: rotateY(0); }
    57%, 70% { opacity: 0; transform: rotateY(90deg); }
    79% { opacity: 1; transform: rotateY(0); }
  }

  @keyframes letter-z-idle {
    0%, 51%, 78%, 100% { opacity: 0; transform: rotateY(-90deg); }
    61%, 70% { opacity: 1; transform: rotateY(0); }
  }

  @keyframes letter-spark-idle {
    0%, 46%, 100% { opacity: .25; transform: scale(.8); }
    62% { opacity: 1; transform: scale(1.35); }
    72% { opacity: .32; transform: scale(.8); }
  }

  @media (max-width: 640px) {
    .project-glyph, .project-glyph svg { width: 29px; height: 29px; }
    .project-glyph { flex-basis: 29px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-glyph, .project-glyph * { animation: none !important; transition: none !important; }
  }
</style>
