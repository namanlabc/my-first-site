---
interface Props {
  kind: 'smallmb' | 'audit' | 'letters';
}

const { kind } = Astro.props;
---

<span class:list={['project-glyph', `project-glyph--${kind}`]} aria-hidden="true">
  {kind === 'smallmb' && (
    <svg viewBox="0 0 32 32" role="presentation">
      <rect class="glyph-tile" x="1" y="1" width="30" height="30" rx="8" />
      <g class="smallmb-mark">
        <rect class="smallmb-ring smallmb-ring--outer" x="8" y="8" width="16" height="16" rx="4.2" />
        <rect class="smallmb-ring smallmb-ring--middle" x="11" y="11" width="10" height="10" rx="3" />
        <rect class="smallmb-ring smallmb-ring--inner" x="13.5" y="13.5" width="5" height="5" rx="1.7" />
        <circle class="smallmb-core" cx="16" cy="16" r="1.25" />
      </g>
    </svg>
  )}

  {kind === 'audit' && (
    <svg viewBox="0 0 32 32" role="presentation">
      <rect class="glyph-tile" x="1" y="1" width="30" height="30" rx="8" />
      <rect class="audit-window" x="7.5" y="7.5" width="17" height="16" rx="2.6" />
      <path class="audit-topbar" d="M7.8 11h16.4" />
      <circle class="audit-dot audit-dot--one" cx="10" cy="9.2" r=".8" />
      <circle class="audit-dot audit-dot--two" cx="12.5" cy="9.2" r=".8" />
      <path class="audit-copy audit-copy--one" d="M10.1 14.3h7.8" />
      <path class="audit-copy audit-copy--two" d="M10.1 17.2h5.3" />
      <path class="audit-check" d="m15.8 20.2 2 1.9 4.2-4.5" />
      <path class="audit-scan" d="M9.4 13h13.2" />
    </svg>
  )}

  {kind === 'letters' && (
    <svg viewBox="0 0 32 32" role="presentation">
      <rect class="glyph-tile" x="1" y="1" width="30" height="30" rx="8" />
      <g class="letters-orbit">
        <path d="M8.6 12.1c1.5-3.1 4.2-4.9 7.7-4.9 2.7 0 5.1 1.1 6.7 3" />
        <path d="m20.7 7.9 2.7 2.5-3.4 1" />
        <path d="M23.4 19.9c-1.5 3.1-4.2 4.9-7.7 4.9-2.7 0-5.1-1.1-6.7-3" />
        <path d="m11.3 24.1-2.7-2.5 3.4-1" />
      </g>
      <g class="letters-face letters-face--a">
        <path d="m11.7 21 3.4-10h1.8l3.4 10" />
        <path d="M13 17.2h6" />
      </g>
      <g class="letters-face letters-face--z">
        <path d="M11.8 11.2h8.4l-8.4 9.6h8.4" />
      </g>
      <circle class="letters-spark" cx="24.7" cy="7.4" r="1.2" />
    </svg>
  )}
</span>

<style>
  .project-glyph {
    display: grid;
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    place-items: center;
    overflow: visible;
    border-radius: 8px;
    transform-origin: center;
    -webkit-tap-highlight-color: transparent;
    transition: transform 180ms cubic-bezier(.2,.8,.2,1), filter 180ms ease;
  }

  .project-glyph svg {
    display: block;
    width: 30px;
    height: 30px;
    overflow: visible;
  }

  .glyph-tile { stroke: none; }
  .project-glyph--smallmb .glyph-tile { fill: #2f8068; }
  .project-glyph--audit .glyph-tile { fill: #171916; }
  .project-glyph--letters .glyph-tile { fill: #ead05a; }

  :global(:root.dark) .project-glyph--smallmb .glyph-tile { fill: #3b846f; }
  :global(:root.dark) .project-glyph--audit .glyph-tile { fill: #f1f2ed; }
  :global(:root.dark) .project-glyph--letters .glyph-tile { fill: #d8bc47; }

  .project-glyph--smallmb { color: #fff; }
  .project-glyph--audit { color: #f7f5ef; }
  .project-glyph--letters { color: #30321f; }
  :global(:root.dark) .project-glyph--audit { color: #171916; }

  .project-glyph path,
  .project-glyph rect:not(.glyph-tile),
  .project-glyph circle:not(.letters-spark):not(.audit-dot):not(.smallmb-core) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .project-glyph:hover,
  .project-glyph:active {
    transform: translateY(-1.5px) scale(1.07);
    filter: drop-shadow(0 5px 6px rgb(0 0 0 / .12));
  }

  /* SmallMB — abstract nested mark: always alive, never literal. */
  .smallmb-mark { transform-origin: 16px 16px; animation: smallmb-mark-breathe 3.8s ease-in-out infinite; }
  .smallmb-ring { transform-box: fill-box; transform-origin: center; }
  .smallmb-ring--outer { stroke-width: 1.45 !important; opacity: .95; animation: smallmb-outer 3.8s ease-in-out infinite; }
  .smallmb-ring--middle { stroke-width: 1.35 !important; opacity: .72; animation: smallmb-middle 3.8s .18s ease-in-out infinite; }
  .smallmb-ring--inner { stroke-width: 1.3 !important; opacity: .48; animation: smallmb-inner 3.8s .34s ease-in-out infinite; }
  .smallmb-core { fill: currentColor; stroke: none; transform-box: fill-box; transform-origin: center; animation: smallmb-core-pulse 1.9s ease-in-out infinite; }

  /* Audit — continuous scanner + rhythmic check redraw. */
  .audit-window { fill: rgb(255 255 255 / .025) !important; }
  :global(:root.dark) .audit-window { fill: rgb(0 0 0 / .025) !important; }
  .audit-topbar, .audit-copy { opacity: .72; stroke-width: 1.25 !important; }
  .audit-dot { fill: currentColor; stroke: none; opacity: .48; }
  .audit-dot--two { opacity: .28; }
  .audit-scan {
    stroke: #8fd0af !important;
    opacity: .8;
    transform-origin: center;
    animation: audit-scan-loop 2.8s ease-in-out infinite;
  }
  :global(:root.dark) .audit-scan { stroke: #416b5a !important; }
  .audit-check {
    stroke: #8fd0af !important;
    stroke-width: 1.8 !important;
    stroke-dasharray: 10;
    stroke-dashoffset: 0;
    animation: audit-check-loop 2.8s ease-in-out infinite;
  }
  :global(:root.dark) .audit-check { stroke: #416b5a !important; }

  /* Random Letter — orbit never stops; A and Z continuously trade places. */
  .letters-orbit {
    transform-origin: 16px 16px;
    opacity: .62;
    animation: letters-orbit-loop 5.8s linear infinite;
  }
  .letters-orbit path { stroke-width: 1.35 !important; }
  .letters-face { transform-origin: 16px 16px; }
  .letters-face path { stroke-width: 1.65 !important; }
  .letters-face--a { animation: letter-a-loop 5.8s ease-in-out infinite; }
  .letters-face--z { opacity: 0; transform: rotateY(-90deg); animation: letter-z-loop 5.8s ease-in-out infinite; }
  .letters-spark {
    fill: #fff7bd;
    stroke: none;
    opacity: .4;
    animation: letter-spark-loop 2.9s ease-in-out infinite;
  }

  @keyframes smallmb-mark-breathe {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(.96) rotate(2deg); }
  }

  @keyframes smallmb-outer {
    0%, 100% { transform: scale(1); opacity: .95; }
    50% { transform: scale(.9); opacity: .78; }
  }

  @keyframes smallmb-middle {
    0%, 100% { transform: scale(1); opacity: .72; }
    50% { transform: scale(.82); opacity: .9; }
  }

  @keyframes smallmb-inner {
    0%, 100% { transform: scale(1); opacity: .48; }
    50% { transform: scale(.72); opacity: 1; }
  }

  @keyframes smallmb-core-pulse {
    0%, 100% { transform: scale(.82); opacity: .68; }
    50% { transform: scale(1.28); opacity: 1; }
  }

  @keyframes audit-scan-loop {
    0% { transform: translateY(-2.2px); opacity: .15; }
    25% { opacity: .9; }
    50% { transform: translateY(7px); opacity: .9; }
    75% { opacity: .35; }
    100% { transform: translateY(-2.2px); opacity: .15; }
  }

  @keyframes audit-check-loop {
    0%, 18% { stroke-dashoffset: 10; opacity: .45; }
    38%, 72% { stroke-dashoffset: 0; opacity: 1; }
    92%, 100% { stroke-dashoffset: 10; opacity: .45; }
  }

  @keyframes letters-orbit-loop {
    to { transform: rotate(360deg); }
  }

  @keyframes letter-a-loop {
    0%, 34% { opacity: 1; transform: rotateY(0); }
    48%, 52% { opacity: 0; transform: rotateY(90deg); }
    66%, 100% { opacity: 1; transform: rotateY(0); }
  }

  @keyframes letter-z-loop {
    0%, 34%, 66%, 100% { opacity: 0; transform: rotateY(-90deg); }
    48%, 52% { opacity: 1; transform: rotateY(0); }
  }

  @keyframes letter-spark-loop {
    0%, 100% { opacity: .25; transform: scale(.8); }
    50% { opacity: 1; transform: scale(1.35); }
  }

  @media (max-width: 640px) {
    .project-glyph, .project-glyph svg { width: 29px; height: 29px; }
    .project-glyph { flex-basis: 29px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-glyph, .project-glyph * { animation: none !important; transition: none !important; }
  }
</style>
