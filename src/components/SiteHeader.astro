---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname;
const navItems = [{href:base+'projects/',label:'Work'},{href:base+'archive/',label:'Notes'},{href:base+'about/',label:'About'}];
const active = (href:string) => path.startsWith(href) || (href.endsWith('archive/') && path.startsWith(base+'blog/'));
---
<header class="site-header">
 <a class="site-brand" href={base} aria-label="Naman.blog home"><span class="folio-monogram" aria-hidden="true">n.</span></a>
 <div class="header-controls">
  <nav class="desktop-nav" aria-label="Primary navigation">{navItems.map(item=><a href={item.href} aria-current={active(item.href)?'page':undefined}><span>{item.label}</span></a>)}</nav>
  <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false"><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"/></svg></button>
 </div>
</header>
