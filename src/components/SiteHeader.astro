---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const path = Astro.url.pathname;

const navItems = [
  { href: `${base}projects/`, label: 'Projects', active: path.startsWith(`${base}projects`) },
  {
    href: `${base}archive/`,
    label: 'Writing',
    active: path.startsWith(`${base}archive`) || path.startsWith(`${base}blog/`),
  },
  { href: `${base}about/`, label: 'About', active: path.startsWith(`${base}about`) },
];
---

<header class="site-header">
  <div class="shell shell--wide site-header__inner">
    <a class="site-brand" href={base} aria-label="Naman Patel — Naman.blog home">
      <span class="site-brand__mark" aria-hidden="true">N</span>
      <span class="site-brand__name"><b>Naman</b> <em>Patel</em><span aria-hidden="true">.</span></span>
    </a>

    <div class="site-header__routes">
      <nav class="primary-nav" aria-label="Primary navigation">
        {navItems.map((item) => (
          <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>

      <div class="site-tools" role="group" aria-label="Site tools">
        <a
          class="site-tools__icon"
          href="https://github.com/namanlabc/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Naman on GitHub (opens in a new tab)"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 .7a11.3 11.3 0 0 0-3.6 22c.6.1.8-.2.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.2c0 .4.2.7.8.6A11.3 11.3 0 0 0 12 .7Z" />
          </svg>
        </a>
        <a
          class="site-tools__icon"
          href="https://x.com/namanlabs"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Naman on X (opens in a new tab)"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18.2 2.3h3.3l-7.2 8.2 8.5 11.2h-6.7L11 14.9l-6 6.8H1.7l7.7-8.8L1.3 2.3h6.8l4.7 6.2 5.4-6.2Zm-1.1 17.5h1.8L7.1 4.1h-2l12 15.7Z" />
          </svg>
        </a>
        <a class="site-tools__text" href={`${base}rss.xml`}>RSS</a>
        <button
          class="theme-toggle"
          id="theme-toggle"
          type="button"
          aria-label="Switch to dark theme"
          aria-pressed="false"
        >
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.2 15.2A8.3 8.3 0 0 1 8.8 3.8a8.4 8.4 0 1 0 11.4 11.4Z" />
          </svg>
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
        <details class="mobile-menu">
          <summary aria-label="Open navigation menu">
            <span></span><span></span><span></span>
          </summary>
          <nav aria-label="Mobile navigation">
            {navItems.map((item) => (
              <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
            ))}
            <a href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            <a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer">X ↗</a>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>
