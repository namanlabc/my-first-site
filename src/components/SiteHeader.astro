---
import SiteIcon from './SiteIcon.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname;
const navItems = [
  { href: `${base}projects/`, label: 'Work', icon: 'work' as const },
  { href: `${base}archive/`, label: 'Notes', icon: 'writing' as const },
  { href: `${base}about/`, label: 'About', icon: 'about' as const },
];
const active = (href: string) => path.startsWith(href) || (href.endsWith('archive/') && path.startsWith(`${base}blog/`));
---

<header class="site-header">
  <a class="site-brand" href={base} aria-label="Naman.blog home">
    <svg class="brand-mascot" viewBox="0 0 32 32" aria-hidden="true">
      <circle class="mascot-dot" cx="16" cy="16" r="13.5"></circle>
      <g class="mascot-eyes">
        <ellipse class="mascot-eye" cx="11.7" cy="15" rx="2.3" ry="3.1"></ellipse>
        <ellipse class="mascot-eye" cx="20.3" cy="15" rx="2.3" ry="3.1"></ellipse>
      </g>
    </svg>
    <span class="brand-wordmark">naman<span class="brand-dot">.</span></span>
  </a>

  <div class="header-controls">
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navItems.map(item => (
        <a href={item.href} aria-current={active(item.href) ? 'page' : undefined} title={item.label}>
          <SiteIcon name={item.icon} />
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
      <svg class="theme-icon" viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet" focusable="false" aria-hidden="true">
        <defs>
          <clipPath id="theme-icon-clip">
            <circle cx="12" cy="12" r="7.5"></circle>
          </clipPath>
        </defs>
        <circle class="theme-icon__ring" cx="12" cy="12" r="7.5"></circle>
        <path class="theme-icon__mass" clip-path="url(#theme-icon-clip)" d="M12 4.5a7.5 7.5 0 0 1 0 15Z"></path>
        <circle class="theme-icon__center" cx="12" cy="12" r="1.15"></circle>
      </svg>
    </button>
  </div>
</header>

<script>
  const brand = document.querySelector<HTMLElement>('.site-brand');
  const theme = document.querySelector<HTMLElement>('#theme-toggle');
  let blinkTimer = 0;
  let scrollTimer = 0;
  let lastY = window.scrollY;

  function blink() {
    brand?.classList.add('is-blinking');
    window.setTimeout(() => brand?.classList.remove('is-blinking'), 150);
    blinkTimer = window.setTimeout(blink, 2600 + Math.random() * 4200);
  }

  brand?.addEventListener('pointermove', (event) => {
    const rect = brand.getBoundingClientRect();
    const x = Math.max(-3, Math.min(3, (event.clientX - (rect.left + 16)) / 12));
    const y = Math.max(-2, Math.min(2, (event.clientY - (rect.top + rect.height / 2)) / 14));
    brand.style.setProperty('--eye-x', x + 'px');
    brand.style.setProperty('--eye-y', y + 'px');
    brand.classList.add('is-tracking');
  });

  brand?.addEventListener('pointerleave', () => brand.classList.remove('is-tracking'));
  theme?.addEventListener('pointerenter', () => brand?.classList.add('is-menu-watching'));
  theme?.addEventListener('pointerleave', () => brand?.classList.remove('is-menu-watching'));

  window.addEventListener('scroll', () => {
    const goingDown = window.scrollY > lastY;
    lastY = window.scrollY;
    brand?.style.setProperty('--scroll-eye-y', goingDown ? '2px' : '-2px');
    brand?.classList.add('is-scrolling');
    window.clearTimeout(scrollTimer);
    scrollTimer = window.setTimeout(() => brand?.classList.remove('is-scrolling'), 240);
  }, { passive: true });

  blinkTimer = window.setTimeout(blink, 1800 + Math.random() * 2200);
  window.addEventListener('pagehide', () => window.clearTimeout(blinkTimer), { once: true });
</script>
