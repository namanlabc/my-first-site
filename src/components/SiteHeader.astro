---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname;
const isHome = path === base;
const navItems = [{href:`${base}projects/`,label:'Projects'},{href:`${base}archive/`,label:'Writing'},{href:`${base}about/`,label:'About'}];
const active = (href: string) => path.startsWith(href) || (href.endsWith('archive/') && path.startsWith(`${base}blog/`));
---
<header class="site-header">
  <a class="site-brand" href={base} aria-label="Naman.blog home" data-is-home={isHome ? 'true' : 'false'}>
    <span class="brand-wordmark">naman</span>
    <svg class="brand-mascot" viewBox="8 8 56 56" aria-hidden="true">
      <circle class="mascot-dot" cx="36" cy="36" r="25" />
      <g class="mascot-eyes">
        <ellipse class="mascot-eye" cx="29" cy="34" rx="4.5" ry="6" />
        <ellipse class="mascot-eye mascot-eye--late" cx="44" cy="34" rx="4.5" ry="6" />
      </g>
    </svg>
  </a>
  <div class="header-controls">
    <nav class="desktop-nav" aria-label="Primary navigation">{navItems.map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}<a class="header-contact" href="mailto:contact@naman.blog?subject=Let%27s%20build%20something%20useful">Contact</a></nav>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false"><span aria-hidden="true">◐</span></button>
    <details class="mobile-menu"><summary>Menu</summary><nav aria-label="Mobile navigation">{navItems.map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}<a href="mailto:contact@naman.blog?subject=Let%27s%20build%20something%20useful">Contact</a></nav></details>
  </div>
</header>

<script>
  const brand = document.querySelector<HTMLElement>('.site-brand');
  const themeButton = document.querySelector<HTMLElement>('#theme-toggle');
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');

  if (brand) {
    const mascot = brand.querySelector<SVGElement>('.brand-mascot');
    let trackingTimer = 0;
    let reactionTimer = 0;
    let scrollTimer = 0;
    let blinkTimer = 0;
    let pokeResetTimer = 0;
    let pokeCount = 0;
    let lastScrollY = window.scrollY;

    const react = (name: string, duration = 520) => {
      window.clearTimeout(reactionTimer);
      brand.classList.remove('is-poked', 'is-celebrating');
      brand.classList.add(name);
      reactionTimer = window.setTimeout(() => brand.classList.remove(name), duration);
    };

    const scheduleBlink = () => {
      window.clearTimeout(blinkTimer);
      blinkTimer = window.setTimeout(() => {
        brand.classList.add('is-blinking');
        window.setTimeout(() => brand.classList.remove('is-blinking'), 125);
        scheduleBlink();
      }, 2200 + Math.random() * 4200);
    };

    window.addEventListener('pointermove', (event) => {
      const rect = mascot?.getBoundingClientRect() ?? brand.getBoundingClientRect();
      const dx = event.clientX - (rect.left + rect.width / 2);
      const dy = event.clientY - (rect.top + rect.height / 2);
      const distance = Math.max(44, Math.hypot(dx, dy));
      brand.style.setProperty('--eye-x', `${(dx / distance) * 2.8}px`);
      brand.style.setProperty('--eye-y', `${(dy / distance) * 2.1}px`);
      brand.classList.add('is-tracking');
      window.clearTimeout(trackingTimer);
      trackingTimer = window.setTimeout(() => brand.classList.remove('is-tracking'), 1200);
    }, { passive: true });

    brand.addEventListener('pointerdown', (event) => {
      react('is-poked', 420);
      if (brand.dataset.isHome !== 'true') return;
      event.preventDefault();
      pokeCount += 1;
      window.clearTimeout(pokeResetTimer);
      pokeResetTimer = window.setTimeout(() => { pokeCount = 0; }, 1800);
      if (pokeCount === 5) {
        pokeCount = 0;
        window.clearTimeout(reactionTimer);
        brand.classList.remove('is-poked');
        void brand.offsetWidth;
        brand.classList.add('is-dizzy');
        reactionTimer = window.setTimeout(() => brand.classList.remove('is-dizzy'), 1450);
      }
    });
    brand.addEventListener('click', (event) => {
      if (brand.dataset.isHome === 'true') event.preventDefault();
    });

    window.addEventListener('scroll', () => {
      const direction = window.scrollY > lastScrollY ? 1 : -1;
      lastScrollY = window.scrollY;
      brand.style.setProperty('--scroll-eye-y', `${direction * 3}px`);
      brand.classList.add('is-scrolling');
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => brand.classList.remove('is-scrolling'), 260);
    }, { passive: true });

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) scheduleBlink();
  }

  themeButton?.addEventListener('click', () => {
    if (!brand) return;
    window.setTimeout(() => {
      brand.classList.remove('is-celebrating');
      void brand.offsetWidth;
      brand.classList.add('is-celebrating');
      window.setTimeout(() => brand.classList.remove('is-celebrating'), 760);
    });
  });

  menu?.addEventListener('toggle', () => brand?.classList.toggle('is-menu-watching', menu.open));
</script>
