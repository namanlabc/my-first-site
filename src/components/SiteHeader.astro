---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname;
const navItems = [
  { href: `${base}projects/`, label: 'work' },
  { href: `${base}archive/`, label: 'notes' },
  { href: `${base}about/`, label: 'about' },
];
const active = (href: string) => path.startsWith(href) || (href.endsWith('archive/') && path.startsWith(`${base}blog/`));
---

<header class="site-header">
  <a class="site-brand" href={base} aria-label="Naman.blog home">
    <span class="brand-wordmark">naman</span>
  </a>

  <div class="header-controls">
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navItems.map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
      <a class="header-contact" href="mailto:contact@naman.blog?subject=Hello%20Naman">say hi</a>
    </nav>

    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
      <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="7.5"></circle>
        <path d="M12 4.5a7.5 7.5 0 0 1 0 15Z"></path>
      </svg>
    </button>

    <details class="mobile-menu">
      <summary>menu</summary>
      <nav aria-label="Mobile navigation">
        {navItems.map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
        <a href={`${base}experience/`}>experience</a>
        <a href="mailto:contact@naman.blog?subject=Hello%20Naman">say hi ↗</a>
      </nav>
    </details>
  </div>
</header>
