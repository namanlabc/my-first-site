---
import SiteIcon from './SiteIcon.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname;
const navItems = [
  { href: `${base}projects/`, label: 'Work', icon: 'work' as const },
  { href: `${base}archive/`, label: 'Notes', icon: 'writing' as const },
  { href: `${base}about/`, label: 'About', icon: 'about' as const },
];
const active = (href: string) => path.startsWith(href) || (href.endsWith('archive/') && path.startsWith(`${base}blog/`));
---

<header class="site-header">
  <a class="site-brand" href={base} aria-label="Naman.blog home">
    <svg class="brand-mascot" viewBox="0 0 32 32" aria-hidden="true">
      <circle class="mascot-dot" cx="16" cy="16" r="13.5"></circle>
      <g class="mascot-eyes">
        <ellipse class="mascot-eye" cx="11.7" cy="15" rx="2.3" ry="3.1"></ellipse>
        <ellipse class="mascot-eye" cx="20.3" cy="15" rx="2.3" ry="3.1"></ellipse>
      </g>
    </svg>
    <span class="brand-wordmark">naman<span class="brand-dot">.</span></span>
  </a>

  <div class="header-controls">
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navItems.map(item => (
        <a href={item.href} aria-current={active(item.href) ? 'page' : undefined} title={item.label}>
          <SiteIcon name={item.icon} />
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
      <svg class="theme-icon" viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet" focusable="false" aria-hidden="true">
        <defs>
          <clipPath id="theme-icon-clip">
            <circle cx="12" cy="12" r="7.5"></circle>
          </clipPath>
        </defs>
        <circle class="theme-icon__ring" cx="12" cy="12" r="7.5"></circle>
        <path class="theme-icon__mass" clip-path="url(#theme-icon-clip)" d="M12 4.5a7.5 7.5 0 0 1 0 15Z"></path>
        <circle class="theme-icon__center" cx="12" cy="12" r="1.15"></circle>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-brand.is-nav-curious .mascot-dot {
    transform: scale(1.055,.955);
  }

  .site-brand.is-nav-curious .brand-mascot {
    animation: nav-mascot-curious 520ms cubic-bezier(.2,.8,.2,1) both;
  }

  .site-brand.is-arriving .brand-mascot {
    animation: nav-mascot-arrive 680ms cubic-bezier(.2,.9,.2,1) both;
  }

  .site-brand.is-departing .brand-mascot {
    animation: nav-mascot-depart 260ms ease-in both;
  }

  @keyframes nav-mascot-curious {
    0%, 100% { transform: translateY(0) rotate(0); }
    46% { transform: translateY(-2px) rotate(5deg); }
  }

  @keyframes nav-mascot-arrive {
    0% { opacity: 0; transform: translateX(17px) rotate(190deg) scale(.78); }
    62% { opacity: 1; transform: translateX(-2px) rotate(-12deg) scale(1.04); }
    100% { opacity: 1; transform: translateX(0) rotate(0) scale(1); }
  }

  @keyframes nav-mascot-depart {
    to { opacity: .2; transform: translateX(12px) rotate(130deg) scale(.78); }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-brand.is-nav-curious .brand-mascot,
    .site-brand.is-arriving .brand-mascot,
    .site-brand.is-departing .brand-mascot { animation: none; }
  }
</style>

<script>
  const brand = document.querySelector<HTMLElement>('.site-brand');
  const theme = document.querySelector<HTMLElement>('#theme-toggle');
  const navigation = Array.from(document.querySelectorAll<HTMLElement>('.desktop-nav a'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let blinkTimer = 0;
  let scrollTimer = 0;
  let curiousTimer = 0;
  let lastY = window.scrollY;

  function blink() {
    if (!document.hidden && !reduceMotion.matches) {
      brand?.classList.add('is-blinking');
      window.setTimeout(() => brand?.classList.remove('is-blinking'), 150);
    }
    blinkTimer = window.setTimeout(blink, 2600 + Math.random() * 4200);
  }

  function watchElement(element: HTMLElement) {
    if (!brand) return;
    const brandRect = brand.getBoundingClientRect();
    const targetRect = element.getBoundingClientRect();
    const direction = targetRect.left > brandRect.right ? 3 : -3;
    brand.style.setProperty('--eye-x', direction + 'px');
    brand.style.setProperty('--eye-y', '-.7px');
    brand.classList.add('is-menu-watching', 'is-nav-curious');
    window.clearTimeout(curiousTimer);
    curiousTimer = window.setTimeout(() => brand.classList.remove('is-nav-curious'), 540);
  }

  brand?.addEventListener('pointermove', (event) => {
    const rect = brand.getBoundingClientRect();
    const x = Math.max(-3, Math.min(3, (event.clientX - (rect.left + 16)) / 12));
    const y = Math.max(-2, Math.min(2, (event.clientY - (rect.top + rect.height / 2)) / 14));
    brand.style.setProperty('--eye-x', x + 'px');
    brand.style.setProperty('--eye-y', y + 'px');
    brand.classList.add('is-tracking');
  });

  brand?.addEventListener('pointerleave', () => brand.classList.remove('is-tracking'));
  brand?.addEventListener('pointerdown', () => {
    brand.classList.add('is-poked');
    window.setTimeout(() => brand.classList.remove('is-poked'), 640);
  });

  navigation.forEach(link => {
    link.addEventListener('pointerenter', () => watchElement(link));
    link.addEventListener('pointerleave', () => brand?.classList.remove('is-menu-watching'));
    link.addEventListener('pointerdown', () => {
      if (reduceMotion.matches) return;
      brand?.classList.add('is-departing');
      try { sessionStorage.setItem('naman-mascot-travelled', 'yes'); } catch {}
    });
  });

  theme?.addEventListener('pointerenter', () => {
    if (theme) watchElement(theme);
  });
  theme?.addEventListener('pointerleave', () => brand?.classList.remove('is-menu-watching'));

  window.addEventListener('scroll', () => {
    const goingDown = window.scrollY > lastY;
    lastY = window.scrollY;
    brand?.style.setProperty('--scroll-eye-y', goingDown ? '2px' : '-2px');
    brand?.classList.add('is-scrolling');
    window.clearTimeout(scrollTimer);
    scrollTimer = window.setTimeout(() => brand?.classList.remove('is-scrolling'), 240);
  }, { passive: true });

  let travelled = false;
  try {
    travelled = sessionStorage.getItem('naman-mascot-travelled') === 'yes';
    if (travelled) sessionStorage.removeItem('naman-mascot-travelled');
  } catch {}
  if (travelled && !reduceMotion.matches) {
    requestAnimationFrame(() => brand?.classList.add('is-arriving'));
    window.setTimeout(() => brand?.classList.remove('is-arriving'), 720);
  }

  blinkTimer = window.setTimeout(blink, 1800 + Math.random() * 2200);
  window.addEventListener('pagehide', () => {
    [blinkTimer, scrollTimer, curiousTimer].forEach(window.clearTimeout);
  }, { once: true });
</script>
