---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname;
const navItems = [{href:`${base}projects/`,label:'Projects'},{href:`${base}archive/`,label:'Writing'},{href:`${base}experience/`,label:'Experience'},{href:`${base}about/`,label:'About'}];
const active = (href: string) => path.startsWith(href) || (href.endsWith('archive/') && path.startsWith(`${base}blog/`));
---
<header class="site-header">
  <a class="site-brand" href={base} aria-label="Naman.blog home">
    <svg class="brand-mascot" viewBox="0 0 48 48" role="img" aria-label="Small backpack mascot">
      <circle cx="24" cy="24" r="21" fill="var(--accent)" opacity=".12" />
      <path d="M14.5 22.5c0-6.7 3.5-10.4 9.5-10.4s9.5 3.7 9.5 10.4v5.4c0 5.1-3.7 8.1-9.5 8.1s-9.5-3-9.5-8.1Z" fill="currentColor" />
      <path d="M17.8 18.2c1.1-4.4 3.2-6.2 6.2-6.2 3.2 0 5.4 1.9 6.3 6.2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
      <circle cx="21" cy="24" r="1.7" fill="var(--paper)" /><circle cx="27" cy="24" r="1.7" fill="var(--paper)" />
      <path d="M21.2 29c1.8 1.2 3.8 1.2 5.6 0" fill="none" stroke="var(--paper)" stroke-width="1.5" stroke-linecap="round" />
      <path d="M14.7 24.2c-2.8.4-4.5 2.2-4.5 5v5.4h6.3M33.3 24.2c2.8.4 4.5 2.2 4.5 5v5.4h-6.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
  <div class="header-controls">
    <nav class="desktop-nav" aria-label="Primary navigation">{navItems.map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false"><span aria-hidden="true">◐</span></button>
    <details class="mobile-menu"><summary>Menu</summary><nav aria-label="Mobile navigation">{navItems.map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav></details>
  </div>
</header>
