---
import SiteIcon from './SiteIcon.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname;
const navItems = [
  { href: `${base}projects/`, label: 'Work', icon: 'work' as const },
  { href: `${base}archive/`, label: 'Notes', icon: 'writing' as const },
  { href: `${base}about/`, label: 'About', icon: 'about' as const },
];
const active = (href: string) => path.startsWith(href) || (href.endsWith('archive/') && path.startsWith(`${base}blog/`));
---

<header class="site-header">
  <a class="site-brand" href={base} aria-label="Naman.blog home">
    <svg class="brand-mascot" viewBox="0 0 32 32" aria-hidden="true">
      <circle class="mascot-dot" cx="16" cy="16" r="13.5"></circle>
      <g class="mascot-eyes">
        <ellipse class="mascot-eye" cx="11.7" cy="15" rx="2.3" ry="3.1"></ellipse>
        <ellipse class="mascot-eye" cx="20.3" cy="15" rx="2.3" ry="3.1"></ellipse>
      </g>
    </svg>
    <span class="brand-wordmark">naman<span class="brand-dot">.</span></span>
  </a>

  <div class="header-controls">
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navItems.map(item => (
        <a href={item.href} aria-current={active(item.href) ? 'page' : undefined} title={item.label}>
          <SiteIcon name={item.icon} />
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
      <span class="theme-invitation" aria-hidden="true">let it spread</span>
      <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="7.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
        <path class="theme-icon__mass" d="M12 4.5a7.5 7.5 0 0 1 0 15Z" fill="currentColor" stroke="none"></path>
        <path class="theme-icon__fissure" d="M18.4 8.4l1.6-1.1 1.1.15" fill="none" stroke="currentColor"></path>
        <path class="theme-icon__tendril theme-icon__tendril--a" d="M18.5 8.2c2.3-1.4 1.7-4.3 5.2-5.7 2.4-1 3.1-2.3 2.5-3.8" fill="none" stroke="currentColor"></path>
        <path class="theme-icon__tendril theme-icon__tendril--b" d="M19.5 12c2.6-.7 4.1 1.15 7.9-.25 1.2-.45 2.35-.25 3.1.45" fill="none" stroke="currentColor"></path>
        <path class="theme-icon__tendril theme-icon__tendril--c" d="M18.35 16.2c2.8.45 2.7 3.45 6.3 5.4 1.55.85 2.1 2.2 1.5 3.45" fill="none" stroke="currentColor"></path>
      </svg>
    </button>

  </div>
</header>
