---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const path = Astro.url.pathname;

const navItems = [
  { href: `${base}projects/`, label: 'Projects', active: path.startsWith(`${base}projects`) },
  {
    href: `${base}archive/`,
    label: 'Writing',
    active: path.startsWith(`${base}archive`) || path.startsWith(`${base}blog/`),
  },
  { href: `${base}experience/`, label: 'Experience', active: path.startsWith(`${base}experience`) },
  { href: `${base}about/`, label: 'About', active: path.startsWith(`${base}about`) },
];
---

<header class="site-header">
  <div class="shell shell--wide site-header__inner">
    <a class="site-brand" href={base} aria-label="Naman Patel — Naman.blog home">
      <span class="site-brand__mark" aria-hidden="true">
        <img src={`${base}images/avatar.webp`} alt="" width="192" height="192" />
      </span>
      <span class="site-brand__name"><b>Naman</b> <em>Patel</em><span aria-hidden="true">.</span></span>
    </a>

    <div class="site-header__routes">
      <nav class="primary-nav" aria-label="Primary navigation">
        {navItems.map((item) => (
          <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>

      <div class="site-tools" role="group" aria-label="Site tools">
        <a class="site-tools__github" href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer">
          GitHub ↗
          <span class="visually-hidden"> (opens in a new tab)</span>
        </a>
        <button
          class="theme-toggle"
          id="theme-toggle"
          type="button"
          aria-label="Switch to dark theme"
          aria-pressed="false"
        >
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.2 15.2A8.3 8.3 0 0 1 8.8 3.8a8.4 8.4 0 1 0 11.4 11.4Z" />
          </svg>
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
        <details class="mobile-menu">
          <summary aria-label="Open navigation menu"><span></span><span></span><span></span></summary>
          <nav aria-label="Mobile navigation">
            {navItems.map((item) => (
              <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
            ))}
            <a href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            <a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer">X ↗</a>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>