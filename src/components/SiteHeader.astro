---
import SiteIcon from './SiteIcon.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname;
const navItems = [
  { href: `${base}projects/`, label: 'Work', icon: 'work' as const },
  { href: `${base}archive/`, label: 'Notes', icon: 'writing' as const },
  { href: `${base}about/`, label: 'About', icon: 'about' as const },
];
const active = (href: string) => path.startsWith(href) || (href.endsWith('archive/') && path.startsWith(`${base}blog/`));
---

<header class="site-header">
  <a class="site-brand" href={base} aria-label="Naman.blog home">
    <svg class="brand-mascot" viewBox="0 0 32 32" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <path class="mascot-dot" d="M16 2.6c8.2 0 13.6 5.8 13.2 13.8-.3 7.8-5.8 13-13.5 12.9C7.6 29.2 2.3 23.8 2.7 15.8 3 8.1 8.4 2.6 16 2.6Z"></path>
      <path class="mascot-brow mascot-brow--left" d="M8.8 10.9c1.4-1 3-.9 4.2-.2"></path>
      <path class="mascot-brow mascot-brow--right" d="M19 10.7c1.3-.8 2.9-.7 4.2.2"></path>
      <g class="mascot-eyes">
        <ellipse class="mascot-eye" cx="11.2" cy="15.4" rx="2.7" ry="3.5"></ellipse>
        <ellipse class="mascot-eye" cx="20.8" cy="15.4" rx="2.7" ry="3.5"></ellipse>
        <circle class="mascot-pupil" cx="11.8" cy="15.7" r="1"></circle>
        <circle class="mascot-pupil" cx="21.4" cy="15.7" r="1"></circle>
      </g>
      <path class="mascot-mouth" d="M12.6 21.4c1.8 1.6 4.9 1.6 6.8 0"></path>
      <circle class="mascot-spark" cx="27.4" cy="5.7" r="1.25"></circle>
    </svg>
    <span class="brand-wordmark">naman<span class="brand-dot">.</span></span>
  </a>

  <div class="header-controls">
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navItems.map(item => (
        <a href={item.href} aria-current={active(item.href) ? 'page' : undefined} title={item.label}>
          <SiteIcon name={item.icon} />
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
      <svg class="theme-icon" viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet" focusable="false" aria-hidden="true">
        <defs>
          <clipPath id="theme-icon-clip">
            <circle cx="12" cy="12" r="7.5"></circle>
          </clipPath>
        </defs>
        <circle class="theme-icon__ring" cx="12" cy="12" r="7.5"></circle>
        <path class="theme-icon__mass" clip-path="url(#theme-icon-clip)" d="M12 4.5a7.5 7.5 0 0 1 0 15Z"></path>
        <circle class="theme-icon__center" cx="12" cy="12" r="1.15"></circle>
      </svg>
    </button>
  </div>
</header>
