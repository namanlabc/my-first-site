---
interface Props {
  name: 'home' | 'work' | 'writing' | 'about' | 'external' | 'android' | 'audit' | 'shuffle' | 'site' | 'book' | 'mail' | 'github' | 'x' | 'rss' | 'spark';
  size?: number;
}

const { name, size = 16 } = Astro.props;
---

<svg
  class="site-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'home' && <><path d="m3 11 9-8 9 8"/><path d="M5.5 9.5V21h13V9.5"/><path d="M9 21v-7h6v7"/></>}
  {name === 'work' && <><rect x="3" y="6" width="18" height="14" rx="2"/><path d="M8 6V4h8v2M3 11h18M9.5 11v2h5v-2"/></>}
  {name === 'writing' && <><path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H20v17H7.5A2.5 2.5 0 0 0 5 21.5z"/><path d="M5 4.5v17M9 7h7M9 11h5"/></>}
  {name === 'about' && <><circle cx="12" cy="8" r="3"/><path d="M5.5 21a6.5 6.5 0 0 1 13 0"/></>}
  {name === 'external' && <><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"/></>}
  {name === 'android' && <><path d="m8 6-2-3M16 6l2-3M6 9h12M5 9v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9"/><path d="M8.5 13h.01M15.5 13h.01M8 19v3M16 19v3M3 10v7M21 10v7"/></>}
  {name === 'audit' && <><path d="M4 5h10M4 10h7M4 15h6"/><circle cx="16" cy="15" r="4"/><path d="m19 18 2 2"/></>}
  {name === 'shuffle' && <><path d="M3 7h3c4 0 5 10 9 10h6"/><path d="m18 14 3 3-3 3M3 17h3c1.7 0 2.8-1.8 4-4M14 7h7M18 4l3 3-3 3"/></>}
  {name === 'site' && <><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/></>}
  {name === 'book' && <><path d="M3 5.5A3.5 3.5 0 0 1 6.5 2H11v18H6.5A3.5 3.5 0 0 0 3 23.5z"/><path d="M21 5.5A3.5 3.5 0 0 0 17.5 2H13v18h4.5a3.5 3.5 0 0 1 3.5 3.5z"/></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></>}
  {name === 'github' && <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7.5A5.8 5.8 0 0 0 19.3 3 5.4 5.4 0 0 0 19.1 0S17.9-.4 15 1.5a13.4 13.4 0 0 0-7 0C5.1-.4 3.9 0 3.9 0a5.4 5.4 0 0 0-.2 3A5.8 5.8 0 0 0 2.2 7c0 5.9 3.5 7.1 6.8 7.5A4.8 4.8 0 0 0 8 18v4M8 19c-3 .9-3-1.5-4.2-2"/>}
  {name === 'x' && <><path d="M5 4l14 16M19 4 5 20"/></>}
  {name === 'rss' && <><path d="M5 5a14 14 0 0 1 14 14M5 10.5a8.5 8.5 0 0 1 8.5 8.5"/><circle cx="5" cy="19" r="1" fill="currentColor" stroke="none"/></>}
  {name === 'spark' && <><path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="m5.6 5.6 2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8"/></>}
</svg>
