---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const href = project.href
  ? project.href.startsWith('/')
    ? `${base}${project.href.replace(/^\//, '')}`
    : project.href
  : `${base}projects/`;
---

<article class:list={['project-poster', `project-poster--${project.visual ?? 'notes'}`]}>
  <a
    class="project-poster__link"
    href={href}
    target={project.external ? '_blank' : undefined}
    rel={project.external ? 'noopener noreferrer' : undefined}
  >
    <div class="project-poster__art" aria-hidden="true">
      {project.visual === 'audit' && (
        <div class="audit-window">
          <div class="audit-window__bar"><i></i><i></i><i></i><span>astro-seo-audit</span></div>
          <code><b>$</b> npx astro-seo-audit --page /new-post/</code>
          <div class="audit-check"><span>✓</span> title and description</div>
          <div class="audit-check"><span>✓</span> canonical URL</div>
          <div class="audit-check"><span>✓</span> social and schema</div>
          <strong>Ready to publish.</strong>
        </div>
      )}

      {project.visual === 'wheel' && (
        <div class="wheel-scene">
          <span class="wheel-scene__word">A SMALL TOOL<br />GOT OUT OF HAND</span>
          <div class="letter-wheel">
            <span class="letter-wheel__pointer"></span>
            <i>A</i><i>G</i><i>M</i><i>R</i>
            <b>spin</b>
          </div>
        </div>
      )}

      {project.visual === 'calm' && (
        <div class="calm-page">
          <div class="calm-page__top"><span>calm</span><i></i><i></i></div>
          <div class="calm-page__copy">
            <small>THE QUIET WEB</small>
            <strong>Less noise.<br />More reading.</strong>
            <p></p><p></p><p></p>
          </div>
          <div class="calm-page__leaf">✦</div>
        </div>
      )}

      {project.visual === 'notes' && (
        <div class="notes-stack">
          <span class="notes-stack__label">naman.blog</span>
          <div><small>NOTE 08</small><strong>I like One Piece.<br />That’s the post.</strong></div>
          <div><small>NOTE 07</small><strong>I wanted Yoast for Astro,<br />so I built it.</strong></div>
        </div>
      )}
    </div>

    <div class="project-poster__caption">
      <div>
        <span>{project.kind} · {project.status}</span>
        <h3>{project.name}</h3>
      </div>
      <p>{project.description}</p>
      <b aria-hidden="true">↗</b>
    </div>
    {project.external && <span class="visually-hidden"> (opens in a new tab)</span>}
  </a>
</article>
