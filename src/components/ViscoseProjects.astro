---
import ProjectPoster from './ProjectPoster.astro';
import type { Project } from '../data/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="viscose-carousel" data-viscose-carousel tabindex="0" aria-label="Project carousel. Drag, use the arrow buttons, or press the left and right arrow keys.">
  <div class="viscose-carousel__stage" data-viscose-stage>
    <div class="viscose-carousel__liquid" aria-hidden="true" data-viscose-liquid></div>

    <div class="viscose-carousel__track">
      {projects.map((project, index) => (
        <div class="viscose-carousel__item" data-viscose-item data-index={index} aria-hidden={index === 0 ? 'false' : 'true'}>
          <ProjectPoster project={project} />
        </div>
      ))}
    </div>
  </div>

  <div class="viscose-carousel__meta" aria-live="polite">
    {projects.map((project, index) => (
      <div class="viscose-carousel__meta-item" data-viscose-meta data-index={index} hidden={index !== 0}>
        <div>
          <span>{project.kind} · {project.status}</span>
          <h3>{project.name}</h3>
        </div>
        <p>{project.description}</p>
      </div>
    ))}
  </div>

  <div class="viscose-carousel__footer">
    <div class="viscose-carousel__progress"><span data-viscose-current>01</span><i aria-hidden="true"></i><span>{String(projects.length).padStart(2, '0')}</span></div>
    <p>Drag to explore <span aria-hidden="true">↔</span></p>
    <div class="viscose-carousel__controls">
      <button type="button" data-viscose-prev aria-label="Previous project">←</button>
      <button type="button" data-viscose-next aria-label="Next project">→</button>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-viscose-carousel]').forEach((carousel) => {
    const items = Array.from(carousel.querySelectorAll('[data-viscose-item]'));
    const metas = Array.from(carousel.querySelectorAll('[data-viscose-meta]'));
    const stage = carousel.querySelector('[data-viscose-stage]');
    const liquid = carousel.querySelector('[data-viscose-liquid]');
    const currentLabel = carousel.querySelector('[data-viscose-current]');
    const prevButton = carousel.querySelector('[data-viscose-prev]');
    const nextButton = carousel.querySelector('[data-viscose-next]');
    const count = items.length;
    if (!count || !stage) return;

    let position = 0;
    let target = 0;
    let pointerId = null;
    let startX = 0;
    let startTarget = 0;
    let dragged = false;
    let raf = 0;

    const shortestOffset = (index, current) => {
      let delta = index - current;
      while (delta > count / 2) delta -= count;
      while (delta < -count / 2) delta += count;
      return delta;
    };

    const render = () => {
      position += (target - position) * 0.12;
      if (Math.abs(target - position) < 0.001) position = target;

      const active = ((Math.round(position) % count) + count) % count;
      const motion = Math.min(Math.abs(target - position), 1);

      items.forEach((item, index) => {
        const offset = shortestOffset(index, position);
        const abs = Math.abs(offset);
        const x = offset * 86;
        const y = Math.min(abs, 1.5) * 10;
        const rotate = offset * -3.8;
        const scale = abs < 0.55 ? 1 : 0.88;
        const opacity = abs < 1.55 ? Math.max(0.08, 1 - abs * 0.78) : 0;

        item.style.setProperty('--x', `${x}%`);
        item.style.setProperty('--y', `${y}px`);
        item.style.setProperty('--r', `${rotate}deg`);
        item.style.setProperty('--scale', `${scale}`);
        item.style.setProperty('--opacity', `${opacity}`);
        item.style.setProperty('--z', `${Math.round(100 - abs * 20)}`);
        item.toggleAttribute('data-active', index === active);
        item.setAttribute('aria-hidden', index === active ? 'false' : 'true');

        const link = item.querySelector('a');
        if (link) index === active ? link.removeAttribute('tabindex') : link.setAttribute('tabindex', '-1');
      });

      metas.forEach((meta, index) => meta.toggleAttribute('hidden', index !== active));

      if (liquid) {
        liquid.style.setProperty('--motion', `${motion}`);
        liquid.style.setProperty('--lean', `${(target - position) * 18}deg`);
      }

      if (currentLabel) currentLabel.textContent = String(active + 1).padStart(2, '0');

      if (position !== target) raf = requestAnimationFrame(render);
      else raf = 0;
    };

    const wake = () => { if (!raf) raf = requestAnimationFrame(render); };
    const step = (direction) => { target = Math.round(target) + direction; wake(); };

    prevButton?.addEventListener('click', () => step(-1));
    nextButton?.addEventListener('click', () => step(1));

    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); step(-1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); step(1); }
    });

    stage.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      pointerId = event.pointerId;
      startX = event.clientX;
      startTarget = target;
      dragged = false;
      stage.setPointerCapture(pointerId);
      carousel.setAttribute('data-dragging', '');
    });

    stage.addEventListener('pointermove', (event) => {
      if (pointerId !== event.pointerId) return;
      const distance = event.clientX - startX;
      if (Math.abs(distance) > 5) dragged = true;
      target = startTarget - distance / Math.max(260, stage.clientWidth * 0.78);
      wake();
    });

    const finishDrag = (event) => {
      if (pointerId !== event.pointerId) return;
      target = Math.round(target);
      wake();
      carousel.removeAttribute('data-dragging');
      try { stage.releasePointerCapture(pointerId); } catch {}
      pointerId = null;
    };

    stage.addEventListener('pointerup', finishDrag);
    stage.addEventListener('pointercancel', finishDrag);
    stage.addEventListener('click', (event) => {
      if (!dragged) return;
      event.preventDefault();
      event.stopPropagation();
      dragged = false;
    }, true);

    render();
  });
</script>

<style>
  .viscose-carousel { width: 100%; outline: none; }
  .viscose-carousel:focus-visible { outline: 1px solid var(--accent); outline-offset: 8px; }

  .viscose-carousel__stage {
    position: relative;
    height: clamp(23rem, 43vw, 32rem);
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
  }

  .viscose-carousel[data-dragging] .viscose-carousel__stage { cursor: grabbing; }
  .viscose-carousel__track { position: absolute; inset: 0; }

  .viscose-carousel__item {
    position: absolute;
    top: 1rem;
    left: 50%;
    z-index: var(--z);
    width: min(67vw, 45rem);
    opacity: var(--opacity);
    transform: translateX(calc(-50% + var(--x))) translateY(var(--y)) rotate(var(--r)) scale(var(--scale));
    transition: opacity 180ms ease, filter 180ms ease;
    will-change: transform, opacity;
    pointer-events: none;
  }

  .viscose-carousel__item[data-active] { pointer-events: auto; }
  .viscose-carousel__item:not([data-active]) { filter: saturate(0.55) brightness(0.58); }
  .viscose-carousel__item :global(.project-poster) { margin: 0; box-shadow: 0 1rem 2.6rem color-mix(in srgb, var(--ink) 12%, transparent); }
  .viscose-carousel__item:not([data-active]) :global(.project-poster__caption) { opacity: 0; }

  .viscose-carousel__liquid {
    --motion: 0;
    --lean: 0deg;
    position: absolute;
    left: 50%;
    top: 31%;
    z-index: 0;
    width: min(31vw, 22rem);
    aspect-ratio: 1.8;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 45%, color-mix(in srgb, var(--accent) 52%, transparent), transparent 58%),
      radial-gradient(circle at 68% 55%, color-mix(in srgb, var(--accent-soft) 68%, transparent), transparent 62%);
    filter: blur(calc(18px + var(--motion) * 14px));
    opacity: calc(0.02 + var(--motion) * 0.38);
    transform: translateX(-50%) scaleX(calc(0.78 + var(--motion) * 0.62)) rotate(var(--lean));
    transition: opacity 220ms ease;
    pointer-events: none;
  }

  .viscose-carousel__meta { min-height: 7rem; padding-top: 0.55rem; }
  .viscose-carousel__meta-item { display: grid; grid-template-columns: minmax(12rem, 0.8fr) minmax(16rem, 1.2fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: start; animation: viscose-meta-in 240ms ease both; }
  .viscose-carousel__meta-item[hidden] { display: none; }
  .viscose-carousel__meta-item span { display: block; margin-bottom: 0.25rem; color: var(--faint); font-family: var(--mono); font-size: 0.56rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .viscose-carousel__meta-item h3 { margin: 0; font-size: clamp(1.45rem, 3vw, 2.35rem); line-height: 0.98; letter-spacing: -0.045em; }
  .viscose-carousel__meta-item p { max-width: 38rem; margin: 0; color: var(--muted); font-size: 0.86rem; line-height: 1.62; }

  .viscose-carousel__footer { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; padding-top: 0.8rem; border-top: 1px solid var(--rule); font-family: var(--mono); font-size: 0.56rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .viscose-carousel__footer > p { margin: 0; color: var(--faint); }
  .viscose-carousel__progress { display: flex; align-items: center; gap: 0.55rem; }
  .viscose-carousel__progress i { width: clamp(2.4rem, 7vw, 5.5rem); height: 1px; background: var(--rule-strong); }
  .viscose-carousel__controls { justify-self: end; display: flex; gap: 0.4rem; }
  .viscose-carousel__controls button { width: 2.15rem; height: 2.15rem; display: grid; place-items: center; border: 1px solid var(--rule-strong); border-radius: 999px; color: var(--ink); background: transparent; font: inherit; font-size: 0.82rem; cursor: pointer; }
  .viscose-carousel__controls button:hover { background: var(--accent-soft); }

  @keyframes viscose-meta-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 720px) {
    .viscose-carousel__stage { height: clamp(17rem, 68vw, 22rem); margin-inline: calc(50% - 50vw); }
    .viscose-carousel__item { width: min(76vw, 30rem); }
    .viscose-carousel__item:not([data-active]) { opacity: calc(var(--opacity) * 0.4); filter: saturate(0.35) brightness(0.45); }
    .viscose-carousel__liquid { width: 42vw; top: 35%; }
    .viscose-carousel__meta { min-height: 9.5rem; padding-top: 0.35rem; }
    .viscose-carousel__meta-item { grid-template-columns: 1fr; gap: 0.45rem; }
    .viscose-carousel__meta-item h3 { font-size: clamp(1.35rem, 6.8vw, 1.9rem); }
    .viscose-carousel__meta-item p { font-size: 0.76rem; line-height: 1.52; }
    .viscose-carousel__footer { grid-template-columns: 1fr 1fr; }
    .viscose-carousel__footer > p { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .viscose-carousel__liquid { display: none; }
    .viscose-carousel__item, .viscose-carousel__meta-item { transition: none; animation: none; }
  }
</style>
