---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const href = project.href
  ? project.href.startsWith('/')
    ? `${base}${project.href.replace(/^\//, '')}`
    : project.href
  : undefined;
---

<article class:list={['project-item', { 'project-item--linked': href }]}>
  <span class="project-item__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  <div class="project-item__main">
    <div class="project-item__meta">
      <span>{project.kind}</span>
      <span class="project-item__status">{project.status}</span>
    </div>
    <h3>
      {href ? (
        <a href={href} target={project.external ? '_blank' : undefined} rel={project.external ? 'noopener noreferrer' : undefined}>
          {project.name}<span aria-hidden="true"> {project.external ? '↗' : '→'}</span>
          {project.external && <span class="visually-hidden"> (opens in a new tab)</span>}
        </a>
      ) : <span class="project-item__title">{project.name}</span>}
    </h3>
    <p>{project.description}</p>
  </div>
  <ul class="project-item__details" aria-label={`${project.name} details`}>
    {project.details.map((detail) => <li>{detail}</li>)}
  </ul>
</article>
