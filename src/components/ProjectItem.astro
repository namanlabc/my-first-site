---
import type { Project } from '../data/projects';
import Invention from './Invention.astro';
interface Props { project: Project; index?: number; }
const { project, index = 0 } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = project.href ? project.href.startsWith('/') ? `${base}${project.href.replace(/^\//, '')}` : project.href : undefined;
const interactive = project.visual === 'smallmb' || project.visual === 'audit' || project.visual === 'wheel' ? project.visual : null;
---
<article class="project-item">
  <div class="project-exhibit">
    {interactive ? <Invention kind={interactive} id={`project-${index}`} /> : <div class="reading-exhibit">
      <span>{project.visual === 'calm' ? 'Calm WP / reading study' : 'Naman.blog / from the notebook'}</span>
      <h4>{project.visual === 'calm' ? 'Room for the words.' : 'The internet is better when it feels small.'}</h4>
      <p>{project.visual === 'calm' ? 'A WordPress theme with space to read. Quiet typography, clear hierarchy, and very little getting in the way.' : 'Personal sites, useful little tools, and the people behind them. That is the part I want to keep.'}</p>
    </div>}
  </div>
  <div class="project-item__body">
    <div class="project-item__meta"><span>{String(index+1).padStart(2,'0')} / {project.kind}</span><span>·</span><span>{project.status}</span></div>
    <h3>{href ? <a href={href} target={project.external ? '_blank' : undefined} rel={project.external ? 'noopener noreferrer' : undefined}>{project.name} <span aria-hidden="true">↗</span></a> : project.name}</h3>
    <p>{project.description}</p>
    <ul class="project-item__details" aria-label={`${project.name} details`}>{project.details.map(detail => <li>{detail}</li>)}</ul>
  </div>
</article>
