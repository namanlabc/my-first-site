<div class="naman-orb" aria-hidden="true">
  <svg viewBox="0 0 72 72" role="presentation">
    <g class="naman-orb__orbit">
      <circle class="naman-orb__ring" cx="36" cy="36" r="30.5" />
      <circle class="naman-orb__orbit-dot naman-orb__orbit-dot--one" cx="36" cy="5.5" r="1.45" />
      <circle class="naman-orb__orbit-dot naman-orb__orbit-dot--two" cx="62.4" cy="51.2" r="1.1" />
    </g>

    <g class="naman-orb__body">
      <path class="naman-orb__face" d="M36 9.7C51.1 9.7 62.5 21.3 62.1 36.2C61.7 51.1 50.6 62.2 35.7 62C20.6 61.8 9.6 50.4 9.9 35.5C10.2 20.7 21.3 9.7 36 9.7Z" />
      <path class="naman-orb__shine" d="M20.4 21.9c2.8-3.7 6.8-6.2 11.4-7" />

      <g class="naman-orb__gaze">
        <g class="naman-orb__blink">
          <ellipse class="naman-orb__eye" cx="28.7" cy="34.2" rx="5.5" ry="7" />
          <ellipse class="naman-orb__eye" cx="44.9" cy="34.2" rx="5.5" ry="7" />
        </g>
      </g>
    </g>

    <g class="naman-orb__spark naman-orb__spark--main">
      <path d="M60.7 12.1v6.1M57.7 15.1h6.1" />
    </g>
    <g class="naman-orb__spark naman-orb__spark--tiny">
      <path d="M12.2 54.5v3.7M10.4 56.3h3.7" />
    </g>
  </svg>
</div>

<style>
  .naman-orb {
    width: 50px;
    height: 50px;
    margin: 0 0 13px -2px;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .naman-orb svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .naman-orb__orbit {
    transform-origin: 36px 36px;
    animation: orbit-turn 17s linear infinite;
  }

  .naman-orb__ring {
    fill: none;
    stroke: color-mix(in srgb, var(--ink) 15%, transparent);
    stroke-width: .9;
    stroke-dasharray: 2 5.4;
  }

  .naman-orb__orbit-dot { fill: var(--accent); }
  .naman-orb__orbit-dot--two { fill: var(--coral); opacity: .8; }

  .naman-orb__body {
    transform-origin: 36px 36px;
    animation: body-alive 7.6s cubic-bezier(.45,0,.25,1) infinite;
  }

  .naman-orb__face { fill: var(--ink); }

  .naman-orb__shine {
    fill: none;
    stroke: color-mix(in srgb, var(--paper) 19%, transparent);
    stroke-width: 1.25;
    stroke-linecap: round;
  }

  .naman-orb__eye { fill: var(--paper); }

  .naman-orb__gaze {
    transform-box: fill-box;
    transform-origin: center;
    animation: gaze-around 8.8s cubic-bezier(.45,0,.25,1) infinite;
  }

  .naman-orb__blink {
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 6.1s ease-in-out infinite;
  }

  .naman-orb__spark {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.45;
    stroke-linecap: round;
    transform-box: fill-box;
    transform-origin: center;
  }

  .naman-orb__spark--main { animation: spark-main 4.8s ease-in-out infinite; }
  .naman-orb__spark--tiny { stroke: var(--coral); opacity: .5; animation: spark-tiny 5.7s 1.2s ease-in-out infinite; }

  .naman-orb:hover .naman-orb__body,
  .naman-orb:active .naman-orb__body { animation: hello 620ms cubic-bezier(.2,.9,.2,1) both; }

  .naman-orb:hover .naman-orb__gaze,
  .naman-orb:active .naman-orb__gaze { animation: none; transform: translate(2.6px, -1.2px); }

  .naman-orb:hover .naman-orb__orbit,
  .naman-orb:active .naman-orb__orbit { animation-duration: 4.5s; }

  @keyframes orbit-turn { to { transform: rotate(360deg); } }

  @keyframes body-alive {
    0%, 12%, 100% { transform: translateY(0) rotate(0) scale(1); }
    44% { transform: translateY(-1.4px) rotate(-.8deg) scale(1.018,.988); }
    50% { transform: translateY(-1.8px) rotate(.6deg) scale(.992,1.02); }
    57% { transform: translateY(-1px) rotate(0) scale(1); }
  }

  @keyframes gaze-around {
    0%, 15%, 43%, 100% { transform: translate(0); }
    20%, 34% { transform: translate(2.1px, -.5px); }
    58%, 70% { transform: translate(-1.8px, 1px); }
    82%, 90% { transform: translate(.8px, -1.1px); }
  }

  @keyframes blink {
    0%, 31%, 34%, 68%, 71%, 100% { transform: scaleY(1); }
    32.5%, 69.5% { transform: scaleY(.08); }
  }

  @keyframes spark-main {
    0%, 18%, 100% { opacity: .28; transform: scale(.72) rotate(0); }
    31% { opacity: 1; transform: scale(1.18) rotate(12deg); }
    42% { opacity: .5; transform: scale(.9) rotate(18deg); }
  }

  @keyframes spark-tiny {
    0%, 55%, 100% { opacity: .18; transform: scale(.65); }
    67% { opacity: .72; transform: scale(1.05) rotate(-10deg); }
    76% { opacity: .3; transform: scale(.8); }
  }

  @keyframes hello {
    0% { transform: translateY(0) rotate(0) scale(1); }
    34% { transform: translateY(-4.5px) rotate(-7deg) scale(1.055,.96); }
    62% { transform: translateY(-1px) rotate(5deg) scale(.985,1.025); }
    82% { transform: translateY(-2px) rotate(-2deg) scale(1.015); }
    100% { transform: translateY(0) rotate(0) scale(1); }
  }

  @media (max-width: 640px) {
    .naman-orb { width: 48px; height: 48px; margin-bottom: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .naman-orb *, .naman-orb__body, .naman-orb__orbit, .naman-orb__gaze, .naman-orb__blink { animation: none !important; transition: none !important; }
  }
  /* Same drawing, more personality: these states only move the original parts. */
  .naman-orb.is-watching .naman-orb__gaze {
    animation: none;
    transform: translate(var(--gaze-x, 0), var(--gaze-y, 0));
  }

  .naman-orb.is-bouncy .naman-orb__body { animation: orb-bouncy 760ms cubic-bezier(.2,.9,.2,1) both; }
  .naman-orb.is-bouncy .naman-orb__orbit { animation-duration: 1.8s; }
  .naman-orb.is-dizzy .naman-orb__body { animation: orb-dizzy 1.15s cubic-bezier(.4,0,.2,1) both; }
  .naman-orb.is-dizzy .naman-orb__gaze { animation: orb-dizzy-eyes 1.15s ease-in-out both; }
  .naman-orb.is-shy .naman-orb__body { animation: orb-shy 920ms cubic-bezier(.2,.8,.2,1) both; }
  .naman-orb.is-shy .naman-orb__gaze { animation: none; transform: translate(-1px, 2px); }
  .naman-orb.is-celebrating .naman-orb__body { animation: orb-celebrate 820ms cubic-bezier(.2,.9,.2,1) both; }
  .naman-orb.is-celebrating .naman-orb__spark { animation: orb-firework 820ms ease-out both; }
  .naman-orb.is-scrolling .naman-orb__body { animation: orb-scroll-peek 420ms ease-out both; }
  .naman-orb.is-scrolling .naman-orb__gaze { animation: none; transform: translateY(var(--scroll-look, 1.8px)); }

  @keyframes orb-bouncy {
    0%, 100% { transform: translateY(0) scale(1); }
    26% { transform: translateY(-6px) scale(.94,1.07); }
    48% { transform: translateY(1px) scale(1.08,.91); }
    68% { transform: translateY(-2px) scale(.98,1.02); }
  }

  @keyframes orb-dizzy {
    0%, 100% { transform: rotate(0) scale(1); }
    25% { transform: rotate(-9deg) scale(1.03,.97); }
    50% { transform: rotate(9deg) scale(.98,1.02); }
    75% { transform: rotate(-5deg) scale(1.015,.985); }
  }

  @keyframes orb-dizzy-eyes {
    0%, 100% { transform: translate(0); }
    20% { transform: translate(2px,-2px); }
    40% { transform: translate(-2px,-1px); }
    60% { transform: translate(-1px,2px); }
    80% { transform: translate(2px,1px); }
  }

  @keyframes orb-shy {
    0%, 100% { transform: rotate(0) translateY(0); }
    35%, 72% { transform: rotate(-6deg) translate(-1px,2px) scale(.98); }
  }

  @keyframes orb-celebrate {
    0%, 100% { transform: translateY(0) rotate(0) scale(1); }
    22% { transform: translateY(-5px) rotate(-6deg) scale(1.04,.96); }
    44% { transform: translateY(-1px) rotate(7deg) scale(.98,1.03); }
    66% { transform: translateY(-4px) rotate(-3deg) scale(1.025,.98); }
  }

  @keyframes orb-firework {
    0% { opacity: .25; transform: scale(.65) rotate(0); }
    45% { opacity: 1; transform: scale(1.5) rotate(25deg); }
    100% { opacity: .35; transform: scale(.85) rotate(45deg); }
  }

  @keyframes orb-scroll-peek {
    0%, 100% { transform: translateY(0) scale(1); }
    48% { transform: translateY(var(--scroll-bob, -2px)) scale(1.03,.97); }
  }

</style>

<script>
  const orb = document.querySelector<HTMLElement>('.naman-orb');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const activities = [
    { name: 'is-bouncy', duration: 780 },
    { name: 'is-shy', duration: 940 },
    { name: 'is-dizzy', duration: 1180 },
    { name: 'is-celebrating', duration: 850 },
  ];
  let activityIndex = 0;
  let activityTimer = 0;
  let scrollTimer = 0;
  let lastScrollY = window.scrollY;

  function playActivity(name: string, duration: number) {
    if (!orb || reducedMotion.matches) return;
    activities.forEach(activity => orb.classList.remove(activity.name));
    orb.classList.remove('is-watching', 'is-scrolling');
    void orb.offsetWidth;
    orb.classList.add(name);
    window.clearTimeout(activityTimer);
    activityTimer = window.setTimeout(() => orb.classList.remove(name), duration);
  }

  orb?.addEventListener('pointermove', (event) => {
    if (reducedMotion.matches) return;
    const rect = orb.getBoundingClientRect();
    const x = Math.max(-2.4, Math.min(2.4, (event.clientX - (rect.left + rect.width / 2)) / 10));
    const y = Math.max(-1.8, Math.min(1.8, (event.clientY - (rect.top + rect.height / 2)) / 12));
    orb.style.setProperty('--gaze-x', x + 'px');
    orb.style.setProperty('--gaze-y', y + 'px');
    orb.classList.add('is-watching');
  });

  orb?.addEventListener('pointerleave', () => orb.classList.remove('is-watching'));

  orb?.addEventListener('pointerdown', () => {
    const activity = activities[activityIndex % activities.length];
    activityIndex += 1;
    playActivity(activity.name, activity.duration);
  });

  window.addEventListener('scroll', () => {
    if (!orb || reducedMotion.matches) return;
    const goingDown = window.scrollY > lastScrollY;
    lastScrollY = window.scrollY;
    orb.style.setProperty('--scroll-look', goingDown ? '1.8px' : '-1.8px');
    orb.style.setProperty('--scroll-bob', goingDown ? '2px' : '-2px');
    orb.classList.add('is-scrolling');
    window.clearTimeout(scrollTimer);
    scrollTimer = window.setTimeout(() => orb.classList.remove('is-scrolling'), 260);
  }, { passive: true });
</script>
