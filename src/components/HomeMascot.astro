<div class="naman-orb" aria-hidden="true">
  <svg viewBox="0 0 72 72" role="presentation">
    <g class="naman-orb__orbit">
      <circle class="naman-orb__ring" cx="36" cy="36" r="30.5" />
      <circle class="naman-orb__orbit-dot naman-orb__orbit-dot--one" cx="36" cy="5.5" r="1.45" />
      <circle class="naman-orb__orbit-dot naman-orb__orbit-dot--two" cx="62.4" cy="51.2" r="1.1" />
    </g>

    <g class="naman-orb__body">
      <path class="naman-orb__face" d="M36 9.7C51.1 9.7 62.5 21.3 62.1 36.2C61.7 51.1 50.6 62.2 35.7 62C20.6 61.8 9.6 50.4 9.9 35.5C10.2 20.7 21.3 9.7 36 9.7Z" />
      <path class="naman-orb__shine" d="M20.4 21.9c2.8-3.7 6.8-6.2 11.4-7" />

      <g class="naman-orb__gaze">
        <g class="naman-orb__blink">
          <ellipse class="naman-orb__eye" cx="28.7" cy="34.2" rx="5.5" ry="7" />
          <ellipse class="naman-orb__eye" cx="44.9" cy="34.2" rx="5.5" ry="7" />
        </g>
      </g>
    </g>

    <g class="naman-orb__spark naman-orb__spark--main">
      <path d="M60.7 12.1v6.1M57.7 15.1h6.1" />
    </g>
    <g class="naman-orb__spark naman-orb__spark--tiny">
      <path d="M12.2 54.5v3.7M10.4 56.3h3.7" />
    </g>
  </svg>
</div>

<style>
  .naman-orb {
    width: 50px;
    height: 50px;
    margin: 0 0 13px -2px;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .naman-orb svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .naman-orb__orbit {
    transform-origin: 36px 36px;
    animation: orbit-turn 17s linear infinite;
  }

  .naman-orb__ring {
    fill: none;
    stroke: color-mix(in srgb, var(--ink) 15%, transparent);
    stroke-width: .9;
    stroke-dasharray: 2 5.4;
  }

  .naman-orb__orbit-dot { fill: var(--accent); }
  .naman-orb__orbit-dot--two { fill: var(--coral); opacity: .8; }

  .naman-orb__body {
    transform-origin: 36px 36px;
    animation: body-alive 7.6s cubic-bezier(.45,0,.25,1) infinite;
  }

  .naman-orb__face { fill: var(--ink); }

  .naman-orb__shine {
    fill: none;
    stroke: color-mix(in srgb, var(--paper) 19%, transparent);
    stroke-width: 1.25;
    stroke-linecap: round;
  }

  .naman-orb__eye { fill: var(--paper); }

  .naman-orb__gaze {
    transform-box: fill-box;
    transform-origin: center;
    animation: gaze-around 8.8s cubic-bezier(.45,0,.25,1) infinite;
  }

  .naman-orb__blink {
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 6.1s ease-in-out infinite;
  }

  .naman-orb__spark {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.45;
    stroke-linecap: round;
    transform-box: fill-box;
    transform-origin: center;
  }

  .naman-orb__spark--main { animation: spark-main 4.8s ease-in-out infinite; }
  .naman-orb__spark--tiny { stroke: var(--coral); opacity: .5; animation: spark-tiny 5.7s 1.2s ease-in-out infinite; }

  .naman-orb:hover .naman-orb__body,
  .naman-orb:active .naman-orb__body { animation: hello 620ms cubic-bezier(.2,.9,.2,1) both; }

  .naman-orb:hover .naman-orb__gaze,
  .naman-orb:active .naman-orb__gaze { animation: none; transform: translate(2.6px, -1.2px); }

  .naman-orb:hover .naman-orb__orbit,
  .naman-orb:active .naman-orb__orbit { animation-duration: 4.5s; }

  @keyframes orbit-turn { to { transform: rotate(360deg); } }

  @keyframes body-alive {
    0%, 12%, 100% { transform: translateY(0) rotate(0) scale(1); }
    44% { transform: translateY(-1.4px) rotate(-.8deg) scale(1.018,.988); }
    50% { transform: translateY(-1.8px) rotate(.6deg) scale(.992,1.02); }
    57% { transform: translateY(-1px) rotate(0) scale(1); }
  }

  @keyframes gaze-around {
    0%, 15%, 43%, 100% { transform: translate(0); }
    20%, 34% { transform: translate(2.1px, -.5px); }
    58%, 70% { transform: translate(-1.8px, 1px); }
    82%, 90% { transform: translate(.8px, -1.1px); }
  }

  @keyframes blink {
    0%, 31%, 34%, 68%, 71%, 100% { transform: scaleY(1); }
    32.5%, 69.5% { transform: scaleY(.08); }
  }

  @keyframes spark-main {
    0%, 18%, 100% { opacity: .28; transform: scale(.72) rotate(0); }
    31% { opacity: 1; transform: scale(1.18) rotate(12deg); }
    42% { opacity: .5; transform: scale(.9) rotate(18deg); }
  }

  @keyframes spark-tiny {
    0%, 55%, 100% { opacity: .18; transform: scale(.65); }
    67% { opacity: .72; transform: scale(1.05) rotate(-10deg); }
    76% { opacity: .3; transform: scale(.8); }
  }

  @keyframes hello {
    0% { transform: translateY(0) rotate(0) scale(1); }
    34% { transform: translateY(-4.5px) rotate(-7deg) scale(1.055,.96); }
    62% { transform: translateY(-1px) rotate(5deg) scale(.985,1.025); }
    82% { transform: translateY(-2px) rotate(-2deg) scale(1.015); }
    100% { transform: translateY(0) rotate(0) scale(1); }
  }

  @media (max-width: 640px) {
    .naman-orb { width: 48px; height: 48px; margin-bottom: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .naman-orb *, .naman-orb__body, .naman-orb__orbit, .naman-orb__gaze, .naman-orb__blink { animation: none !important; transition: none !important; }
  }
  /* The original drawing never changes; only its existing parts move. */
  .naman-orb {
    position: relative;
    z-index: 1;
    cursor: pointer;
    touch-action: manipulation;
    will-change: transform;
  }

  .naman-orb.is-watching .naman-orb__gaze,
  .naman-orb.is-theme-watching .naman-orb__gaze {
    animation: none;
    transform: translate(var(--gaze-x, 0), var(--gaze-y, 0));
  }

  .naman-orb.is-bouncy .naman-orb__body { animation: orb-bouncy 760ms cubic-bezier(.2,.9,.2,1) both; }
  .naman-orb.is-bouncy .naman-orb__orbit { animation-duration: 1.8s; }
  .naman-orb.is-dizzy .naman-orb__body { animation: orb-dizzy 1.15s cubic-bezier(.4,0,.2,1) both; }
  .naman-orb.is-dizzy .naman-orb__gaze { animation: orb-dizzy-eyes 1.15s ease-in-out both; }
  .naman-orb.is-shy .naman-orb__body { animation: orb-shy 920ms cubic-bezier(.2,.8,.2,1) both; }
  .naman-orb.is-shy .naman-orb__gaze { animation: none; transform: translate(-1px, 2px); }
  .naman-orb.is-celebrating .naman-orb__body { animation: orb-celebrate 820ms cubic-bezier(.2,.9,.2,1) both; }
  .naman-orb.is-celebrating .naman-orb__spark { animation: orb-firework 820ms ease-out both; }
  .naman-orb.is-scrolling .naman-orb__body { animation: orb-scroll-peek 420ms ease-out both; }
  .naman-orb.is-scrolling .naman-orb__gaze { animation: none; transform: translateY(var(--scroll-look, 1.8px)); }

  .naman-orb.is-orbit-chasing .naman-orb__orbit { animation: orbit-turn 1.15s linear 2; }
  .naman-orb.is-orbit-chasing .naman-orb__gaze { animation: orb-follow-orbit 2.3s ease-in-out both; }
  .naman-orb.is-orbit-chasing .naman-orb__body { animation: orb-curious-tilt 2.3s ease-in-out both; }

  .naman-orb.is-napping .naman-orb__body { animation: orb-nap 2.8s ease-in-out infinite; }
  .naman-orb.is-napping .naman-orb__blink { animation: none; transform: scaleY(.08); }
  .naman-orb.is-napping .naman-orb__orbit { animation-duration: 42s; opacity: .52; }
  .naman-orb.is-napping .naman-orb__spark { opacity: .12; animation: none; }

  .naman-orb.is-startled .naman-orb__body { animation: orb-startled 620ms cubic-bezier(.18,.9,.2,1) both; }
  .naman-orb.is-startled .naman-orb__eye { animation: orb-wide-eyes 620ms ease both; }
  .naman-orb.is-theme-scared .naman-orb__body { animation: orb-theme-scoot 720ms cubic-bezier(.2,.85,.2,1) both; }
  .naman-orb.is-theme-scared .naman-orb__gaze { animation: none; transform: translate(2.4px,-1.2px); }
  .naman-orb.is-adventuring .naman-orb__orbit { animation-duration: .72s; }
  .naman-orb.is-adventuring .naman-orb__gaze { animation: none; transform: translate(2.4px,0); }
  .naman-orb.is-lapping .naman-orb__spark { animation: orb-firework 800ms ease-out infinite; }

  @keyframes orb-bouncy {
    0%, 100% { transform: translateY(0) scale(1); }
    26% { transform: translateY(-6px) scale(.94,1.07); }
    48% { transform: translateY(1px) scale(1.08,.91); }
    68% { transform: translateY(-2px) scale(.98,1.02); }
  }

  @keyframes orb-dizzy {
    0%, 100% { transform: rotate(0) scale(1); }
    25% { transform: rotate(-9deg) scale(1.03,.97); }
    50% { transform: rotate(9deg) scale(.98,1.02); }
    75% { transform: rotate(-5deg) scale(1.015,.985); }
  }

  @keyframes orb-dizzy-eyes {
    0%, 100% { transform: translate(0); }
    20% { transform: translate(2px,-2px); }
    40% { transform: translate(-2px,-1px); }
    60% { transform: translate(-1px,2px); }
    80% { transform: translate(2px,1px); }
  }

  @keyframes orb-shy {
    0%, 100% { transform: rotate(0) translateY(0); }
    35%, 72% { transform: rotate(-6deg) translate(-1px,2px) scale(.98); }
  }

  @keyframes orb-celebrate {
    0%, 100% { transform: translateY(0) rotate(0) scale(1); }
    22% { transform: translateY(-5px) rotate(-6deg) scale(1.04,.96); }
    44% { transform: translateY(-1px) rotate(7deg) scale(.98,1.03); }
    66% { transform: translateY(-4px) rotate(-3deg) scale(1.025,.98); }
  }

  @keyframes orb-firework {
    0% { opacity: .25; transform: scale(.65) rotate(0); }
    45% { opacity: 1; transform: scale(1.5) rotate(25deg); }
    100% { opacity: .35; transform: scale(.85) rotate(45deg); }
  }

  @keyframes orb-scroll-peek {
    0%, 100% { transform: translateY(0) scale(1); }
    48% { transform: translateY(var(--scroll-bob, -2px)) scale(1.03,.97); }
  }

  @keyframes orb-follow-orbit {
    0%, 100% { transform: translate(0); }
    18% { transform: translate(2.3px,-1.5px); }
    42% { transform: translate(2px,1.6px); }
    66% { transform: translate(-2.1px,1.2px); }
    84% { transform: translate(-1.6px,-1.5px); }
  }

  @keyframes orb-curious-tilt {
    0%, 100% { transform: rotate(0); }
    28%, 45% { transform: rotate(3deg); }
    68%, 82% { transform: rotate(-3deg); }
  }

  @keyframes orb-nap {
    0%, 100% { transform: translateY(2px) scale(1,.985); }
    50% { transform: translateY(2.8px) scale(1.01,.975); }
  }

  @keyframes orb-startled {
    0%, 100% { transform: translateY(0) scale(1); }
    22% { transform: translateY(-7px) scale(.92,1.1); }
    48% { transform: translateY(1px) scale(1.07,.93); }
    70% { transform: translateY(-2px) scale(.99,1.02); }
  }

  @keyframes orb-wide-eyes {
    0%, 100% { transform: scale(1); }
    24%, 58% { transform: scale(1.13); }
  }

  @keyframes orb-theme-scoot {
    0%, 100% { transform: translateX(0) rotate(0); }
    24% { transform: translateX(-5px) rotate(-7deg) scale(1.03,.97); }
    48% { transform: translateX(-7px) rotate(-9deg) scale(.98,1.02); }
    76% { transform: translateX(-2px) rotate(3deg); }
  }

</style>

<script>
  const orb = document.querySelector<HTMLElement>('.naman-orb');
  const heading = document.querySelector<HTMLElement>('.bear-intro h1');
  const themeButton = document.querySelector<HTMLElement>('#theme-toggle');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const activityClasses = [
    'is-bouncy',
    'is-shy',
    'is-dizzy',
    'is-celebrating',
    'is-orbit-chasing',
    'is-startled',
    'is-theme-scared',
  ];
  const tapActivities = [
    { name: 'is-bouncy', duration: 780 },
    { name: 'is-shy', duration: 940 },
    { name: 'is-dizzy', duration: 1180 },
    { name: 'is-celebrating', duration: 850 },
  ];

  let activityIndex = 0;
  let activityTimer = 0;
  let scrollTimer = 0;
  let tapTimer = 0;
  let napTimer = 0;
  let idleTimer = 0;
  let signatureTimer = 0;
  let lastScrollY = window.scrollY;
  let lastHumanActivity = Date.now();
  let rapidTaps: number[] = [];
  let currentAnimation: Animation | null = null;
  let busyKind = '';
  let adventureStartedAt = 0;
  let interrupted = false;

  const isVisible = () => {
    if (!orb || document.hidden) return false;
    const rect = orb.getBoundingClientRect();
    return rect.bottom > 0 && rect.top < window.innerHeight;
  };

  const clearActivityClasses = () => {
    if (!orb) return;
    activityClasses.forEach(name => orb.classList.remove(name));
    orb.classList.remove('is-watching', 'is-scrolling', 'is-theme-watching');
  };

  const playClassActivity = (name: string, duration: number) => {
    if (!orb || reducedMotion.matches || busyKind) return;
    clearActivityClasses();
    void orb.offsetWidth;
    orb.classList.add(name);
    window.clearTimeout(activityTimer);
    activityTimer = window.setTimeout(() => orb.classList.remove(name), duration);
  };

  const clipPage = (clip: boolean) => {
    document.documentElement.style.overflowX = clip ? 'clip' : '';
    document.body.style.overflowX = clip ? 'clip' : '';
  };

  const finishAdventure = () => {
    if (!orb) return;
    currentAnimation = null;
    busyKind = '';
    orb.classList.remove('is-adventuring', 'is-lapping');
    orb.style.removeProperty('transform');
    orb.style.removeProperty('opacity');
    clipPage(false);
  };

  const cancelAdventure = (reaction = true) => {
    if (!currentAnimation) return;
    interrupted = true;
    currentAnimation.cancel();
    finishAdventure();
    if (reaction) playClassActivity('is-startled', 640);
  };

  async function runEscape(wrongSide = false) {
    if (!orb || reducedMotion.matches || busyKind || !isVisible()) return;
    busyKind = 'escape';
    interrupted = false;
    adventureStartedAt = performance.now();
    clearActivityClasses();
    orb.classList.add('is-adventuring');
    orb.style.setProperty('--gaze-x', '2.4px');
    orb.style.setProperty('--gaze-y', '0px');
    clipPage(true);

    const rect = orb.getBoundingClientRect();
    const exitRight = window.innerWidth - rect.left + 68;
    const entryLeft = -(rect.right + 68);
    const leftPeek = -(rect.left + rect.width * .68);
    const rightPeek = window.innerWidth - rect.left - rect.width * .32;

    const normalFrames: Keyframe[] = [
      { transform: 'translateX(0) rotate(0deg)', opacity: 1, offset: 0 },
      { transform: 'translateX(-5px) rotate(-8deg)', opacity: 1, offset: .08 },
      { transform: 'translateX(2px) rotate(3deg)', opacity: 1, offset: .15 },
      { transform: 'translateX(' + exitRight + 'px) rotate(760deg)', opacity: 1, offset: .46 },
      { transform: 'translateX(' + exitRight + 'px) rotate(760deg)', opacity: 0, offset: .47 },
      { transform: 'translateX(' + entryLeft + 'px) rotate(-720deg)', opacity: 0, offset: .49 },
      { transform: 'translateX(' + leftPeek + 'px) rotate(-28deg)', opacity: 1, offset: .62 },
      { transform: 'translateX(' + (leftPeek - 9) + 'px) rotate(-34deg)', opacity: 1, offset: .71 },
      { transform: 'translateX(' + leftPeek + 'px) rotate(-25deg)', opacity: 1, offset: .78 },
      { transform: 'translateX(0) rotate(0deg)', opacity: 1, offset: 1 },
    ];

    const wrongSideFrames: Keyframe[] = [
      { transform: 'translateX(0) rotate(0deg)', opacity: 1, offset: 0 },
      { transform: 'translateX(-5px) rotate(-8deg)', opacity: 1, offset: .06 },
      { transform: 'translateX(' + exitRight + 'px) rotate(720deg)', opacity: 1, offset: .3 },
      { transform: 'translateX(' + exitRight + 'px) rotate(720deg)', opacity: 0, offset: .31 },
      { transform: 'translateX(' + rightPeek + 'px) rotate(26deg)', opacity: 0, offset: .34 },
      { transform: 'translateX(' + rightPeek + 'px) rotate(26deg)', opacity: 1, offset: .43 },
      { transform: 'translateX(' + (rightPeek + 9) + 'px) rotate(32deg)', opacity: 1, offset: .52 },
      { transform: 'translateX(' + rightPeek + 'px) rotate(22deg)', opacity: 1, offset: .59 },
      { transform: 'translateX(' + exitRight + 'px) rotate(160deg)', opacity: 1, offset: .68 },
      { transform: 'translateX(' + exitRight + 'px) rotate(160deg)', opacity: 0, offset: .69 },
      { transform: 'translateX(' + entryLeft + 'px) rotate(-540deg)', opacity: 0, offset: .71 },
      { transform: 'translateX(' + leftPeek + 'px) rotate(-24deg)', opacity: 1, offset: .8 },
      { transform: 'translateX(0) rotate(0deg)', opacity: 1, offset: 1 },
    ];

    currentAnimation = orb.animate(wrongSide ? wrongSideFrames : normalFrames, {
      duration: wrongSide ? 4300 : 3300,
      easing: 'cubic-bezier(.45,0,.2,1)',
      fill: 'both',
    });

    try {
      await currentAnimation.finished;
    } catch {}
    if (!interrupted) finishAdventure();
  }

  async function runHeadingHide() {
    if (!orb || !heading || reducedMotion.matches || busyKind || !isVisible()) return;
    busyKind = 'hide';
    clearActivityClasses();
    orb.classList.add('is-adventuring');
    const orbRect = orb.getBoundingClientRect();
    const headingRect = heading.getBoundingClientRect();
    const x = Math.min(headingRect.width - orbRect.width * .7, 78);
    const y = headingRect.top - orbRect.top + headingRect.height * .28;

    currentAnimation = orb.animate([
      { transform: 'translate(0,0) rotate(0deg)', offset: 0 },
      { transform: 'translate(' + x + 'px,' + (y - 8) + 'px) rotate(12deg)', offset: .3 },
      { transform: 'translate(' + x + 'px,' + (y + 10) + 'px) rotate(6deg)', offset: .43 },
      { transform: 'translate(' + (x + 8) + 'px,' + (y - 5) + 'px) rotate(-5deg)', offset: .61 },
      { transform: 'translate(' + (x + 8) + 'px,' + (y + 9) + 'px) rotate(4deg)', offset: .72 },
      { transform: 'translate(0,0) rotate(0deg)', offset: 1 },
    ], { duration: 2800, easing: 'cubic-bezier(.4,0,.2,1)', fill: 'both' });

    try { await currentAnimation.finished; } catch {}
    if (!interrupted) finishAdventure();
  }

  async function runSecretLap() {
    if (!orb || !heading || reducedMotion.matches) return;
    cancelAdventure(false);
    busyKind = 'lap';
    interrupted = false;
    clearActivityClasses();
    orb.classList.add('is-adventuring', 'is-lapping');
    clipPage(true);

    const orbRect = orb.getBoundingClientRect();
    const headingRect = heading.getBoundingClientRect();
    const right = Math.max(72, headingRect.right - orbRect.left - orbRect.width);
    const down = Math.max(44, headingRect.bottom - orbRect.top + 12);

    currentAnimation = orb.animate([
      { transform: 'translate(0,0) rotate(0deg)', offset: 0 },
      { transform: 'translate(' + (right * .48) + 'px,-14px) rotate(180deg)', offset: .2 },
      { transform: 'translate(' + right + 'px,' + (down * .22) + 'px) rotate(390deg)', offset: .4 },
      { transform: 'translate(' + (right * .65) + 'px,' + down + 'px) rotate(590deg)', offset: .62 },
      { transform: 'translate(-14px,' + (down * .72) + 'px) rotate(790deg)', offset: .82 },
      { transform: 'translate(0,0) rotate(1080deg)', offset: 1 },
    ], { duration: 2500, easing: 'cubic-bezier(.35,.05,.2,1)', fill: 'both' });

    try { await currentAnimation.finished; } catch {}
    if (!interrupted) {
      finishAdventure();
      playClassActivity('is-celebrating', 850);
    }
  }

  const wakeUp = () => {
    if (!orb?.classList.contains('is-napping')) return;
    orb.classList.remove('is-napping');
    playClassActivity('is-startled', 640);
  };

  const noteHumanActivity = () => {
    lastHumanActivity = Date.now();
    wakeUp();
  };

  const scheduleNapCheck = () => {
    window.clearTimeout(napTimer);
    napTimer = window.setTimeout(() => {
      if (orb && !busyKind && isVisible() && Date.now() - lastHumanActivity >= 58000 && !reducedMotion.matches) {
        clearActivityClasses();
        orb.classList.add('is-napping');
      }
      scheduleNapCheck();
    }, 5000);
  };

  const scheduleIdleQuirk = () => {
    window.clearTimeout(idleTimer);
    idleTimer = window.setTimeout(async () => {
      if (!busyKind && isVisible() && Date.now() - lastHumanActivity > 9000) {
        if (Math.random() > .48) playClassActivity('is-orbit-chasing', 2350);
        else await runHeadingHide();
      }
      scheduleIdleQuirk();
    }, 78000 + Math.random() * 52000);
  };

  const scheduleSignatureEscape = () => {
    let alreadySeen = false;
    try { alreadySeen = sessionStorage.getItem('naman-mascot-escaped') === 'yes'; } catch {}
    if (alreadySeen) return;
    signatureTimer = window.setTimeout(async () => {
      if (Date.now() - lastHumanActivity < 6500 || !isVisible() || busyKind) {
        scheduleSignatureEscape();
        return;
      }
      try { sessionStorage.setItem('naman-mascot-escaped', 'yes'); } catch {}
      await runEscape(Math.random() < .22);
    }, 28000 + Math.random() * 17000);
  };

  orb?.addEventListener('pointermove', (event) => {
    noteHumanActivity();
    if (reducedMotion.matches || busyKind) return;
    const rect = orb.getBoundingClientRect();
    const x = Math.max(-2.4, Math.min(2.4, (event.clientX - (rect.left + rect.width / 2)) / 10));
    const y = Math.max(-1.8, Math.min(1.8, (event.clientY - (rect.top + rect.height / 2)) / 12));
    orb.style.setProperty('--gaze-x', x + 'px');
    orb.style.setProperty('--gaze-y', y + 'px');
    orb.classList.add('is-watching');
  });

  orb?.addEventListener('pointerleave', () => orb.classList.remove('is-watching'));

  orb?.addEventListener('pointerdown', () => {
    noteHumanActivity();
    const now = performance.now();
    rapidTaps = rapidTaps.filter(time => now - time < 1450);
    rapidTaps.push(now);

    if (rapidTaps.length >= 5) {
      rapidTaps = [];
      window.clearTimeout(tapTimer);
      runSecretLap();
      return;
    }

    window.clearTimeout(tapTimer);
    tapTimer = window.setTimeout(() => {
      if (busyKind) return;
      if (activityIndex < tapActivities.length) {
        const activity = tapActivities[activityIndex];
        activityIndex += 1;
        playClassActivity(activity.name, activity.duration);
      } else {
        activityIndex = 0;
        runEscape(Math.random() < .18);
      }
    }, 250);
  });

  document.addEventListener('pointermove', (event) => {
    if (busyKind !== 'escape' || performance.now() - adventureStartedAt < 520 || !orb) return;
    const rect = orb.getBoundingClientRect();
    const distance = Math.hypot(event.clientX - (rect.left + rect.width / 2), event.clientY - (rect.top + rect.height / 2));
    if (distance < 78) cancelAdventure(true);
  }, { passive: true });

  window.addEventListener('scroll', () => {
    noteHumanActivity();
    if (!orb || reducedMotion.matches) return;
    if (busyKind) cancelAdventure(false);
    const goingDown = window.scrollY > lastScrollY;
    lastScrollY = window.scrollY;
    orb.style.setProperty('--scroll-look', goingDown ? '1.8px' : '-1.8px');
    orb.style.setProperty('--scroll-bob', goingDown ? '2px' : '-2px');
    orb.classList.add('is-scrolling');
    window.clearTimeout(scrollTimer);
    scrollTimer = window.setTimeout(() => orb.classList.remove('is-scrolling'), 260);
  }, { passive: true });

  themeButton?.addEventListener('pointerenter', () => {
    if (!orb || busyKind) return;
    orb.style.setProperty('--gaze-x', '2.4px');
    orb.style.setProperty('--gaze-y', '-1.2px');
    orb.classList.add('is-theme-watching');
  });
  themeButton?.addEventListener('pointerleave', () => orb?.classList.remove('is-theme-watching'));
  themeButton?.addEventListener('pointerdown', () => {
    noteHumanActivity();
    cancelAdventure(false);
    playClassActivity('is-theme-scared', 740);
  });

  ['keydown', 'touchstart'].forEach(type => {
    window.addEventListener(type, noteHumanActivity, { passive: true });
  });

  scheduleNapCheck();
  scheduleIdleQuirk();
  scheduleSignatureEscape();

  window.addEventListener('pagehide', () => {
    [activityTimer, scrollTimer, tapTimer, napTimer, idleTimer, signatureTimer].forEach(window.clearTimeout);
    currentAnimation?.cancel();
    clipPage(false);
  }, { once: true });
</script>
