---
interface Props { kind: 'smallmb' | 'audit' | 'wheel'; id: string; }
const { kind, id } = Astro.props;
const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---

<div class={`invention invention--${kind}`} data-invention={kind}>
  {kind === 'smallmb' && <>
    <div class="invention-caption"><span>01 / SmallMB</span><span>Illustrative preview</span></div>
    <div class="compression-experiment" style="--squeeze: .72">
      <div class="compression-before"><span>PHOTO.JPG</span><strong>8 MB</strong><span>too big to send</span></div>
      <div class="compression-gap" aria-hidden="true"><span>↓</span></div>
      <div class="compression-after"><span>same idea.</span><strong data-size>1.7 MB</strong><span>less baggage.</span></div>
      <span class="hand-note compression-note">a little smaller?</span>
    </div>
    <div class="invention-controls">
      <label for={`${id}-squeeze`}>Give it a squeeze <span aria-hidden="true">↔</span></label>
      <input id={`${id}-squeeze`} type="range" min="0" max="100" value="72" aria-label="Illustrative compression amount" aria-valuetext="Illustrative output size: 1.7 MB" data-squeeze />
    </div>
    <p class="invention-footnote">Demo only. Your files stay on your device in the real app.</p>
  </>}
  {kind === 'audit' && <>
    <div class="invention-caption"><span>02 / Astro SEO Audit</span><span>Example HTML</span></div>
    <div class="audit-experiment" data-audit-index="0">
      <div class="audit-paper">
        <span class="audit-url">/a-useful-page/</span>
        <strong>A page worth finding.</strong>
        <p>A useful idea, properly described.</p>
        <div class="audit-code"><span>&lt;title&gt;</span>A useful page<span>&lt;/title&gt;</span></div>
        <div class="audit-code"><span>name=</span>"description" <span>content=</span>"…"</div>
        <div class="audit-code"><span>rel=</span>"canonical" <span>href=</span>"/…"</div>
      </div>
      <button type="button" class="audit-lens" data-inspect aria-label="Inspect the next example HTML check"><span aria-hidden="true">✓</span></button>
      <span class="hand-note audit-note">look a little closer</span>
    </div>
    <div class="invention-controls audit-controls">
      <div class="audit-choices" role="group" aria-label="Inspect example HTML">
        {['Title', 'Description', 'Canonical'].map((label, index) => <button type="button" data-audit-choice={index} aria-pressed={index === 0 ? 'true' : 'false'}>{label}</button>)}
      </div>
      <p class="audit-result" data-audit-result aria-live="polite">✓ A descriptive title is present.</p>
    </div>
    <p class="invention-footnote">Example checks, not a scan of your website.</p>
  </>}
  {kind === 'wheel' && <>
    <div class="invention-caption"><span>03 / Get Random Letter</span><span>Go on, spin it</span></div>
    <div class="wheel-experiment">
      <div class="wheel-pointer" aria-hidden="true">▼</div>
      <svg class="alphabet-dial" viewBox="0 0 300 300" aria-hidden="true" data-dial>
        <circle cx="150" cy="150" r="139" fill="var(--wheel-paper)" stroke="currentColor" stroke-width="2" />
        <circle cx="150" cy="150" r="92" fill="none" stroke="currentColor" stroke-width="1" />
        {alphabet.map((letter, index) => {
          const angle = index * Math.PI * 2 / 26 - Math.PI / 2;
          return <g>
            <line x1={150 + Math.cos(angle + Math.PI / 26) * 93} y1={150 + Math.sin(angle + Math.PI / 26) * 93} x2={150 + Math.cos(angle + Math.PI / 26) * 139} y2={150 + Math.sin(angle + Math.PI / 26) * 139} stroke="currentColor" stroke-width=".65" />
            <text x={150 + Math.cos(angle) * 116} y={150 + Math.sin(angle) * 116} text-anchor="middle" dominant-baseline="central" transform={`rotate(${index * 360 / 26}, ${150 + Math.cos(angle) * 116}, ${150 + Math.sin(angle) * 116})`}>{letter}</text>
          </g>;
        })}
      </svg>
      <output class="wheel-letter" data-letter aria-live="polite" aria-label="Selected random letter">A</output>
      <span class="hand-note wheel-note">leave this one<br />to chance.</span>
    </div>
    <div class="invention-controls wheel-controls"><button type="button" data-spin>Spin the alphabet <span aria-hidden="true">↻</span></button></div>
    <p class="invention-footnote">A working little wheel. No sign-up, no big decision.</p>
  </>}
</div>

<script>
  const results = ['✓ A descriptive title is present.', '✓ A meta description is present.', '✓ A canonical link is present.'];
  document.querySelectorAll<HTMLElement>('[data-invention]').forEach((root) => {
    const slider = root.querySelector<HTMLInputElement>('[data-squeeze]');
    const size = root.querySelector<HTMLElement>('[data-size]');
    const experiment = root.querySelector<HTMLElement>('.compression-experiment');
    slider?.addEventListener('input', () => {
      const amount = Number(slider.value) / 100;
      const megabytes = 8 * Math.pow(0.12, amount);
      const formatted = megabytes < 1 ? `${Math.round(megabytes * 1024)} KB` : `${megabytes.toFixed(1)} MB`;
      experiment?.style.setProperty('--squeeze', String(amount));
      if (size) size.textContent = formatted;
      slider.setAttribute('aria-valuetext', `Illustrative output size: ${formatted}`);
    });
    let checkIndex = 0;
    const inspect = (index: number) => {
      checkIndex = index;
      const panel = root.querySelector<HTMLElement>('.audit-experiment');
      if (panel) panel.dataset.auditIndex = String(index);
      root.querySelectorAll<HTMLButtonElement>('[data-audit-choice]').forEach(button => button.setAttribute('aria-pressed', String(Number(button.dataset.auditChoice) === index)));
      const result = root.querySelector<HTMLElement>('[data-audit-result]');
      if (result) result.textContent = results[index];
    };
    root.querySelectorAll<HTMLButtonElement>('[data-audit-choice]').forEach(button => button.addEventListener('click', () => inspect(Number(button.dataset.auditChoice))));
    root.querySelector('[data-inspect]')?.addEventListener('click', () => inspect((checkIndex + 1) % 3));
    const spin = root.querySelector<HTMLButtonElement>('[data-spin]');
    const dial = root.querySelector<SVGElement>('[data-dial]');
    const letter = root.querySelector<HTMLOutputElement>('[data-letter]');
    let rotation = 0;
    spin?.addEventListener('click', () => {
      if (!dial || !letter) return;
      const number = crypto.getRandomValues(new Uint32Array(1))[0];
      const index = Math.floor(number / 4294967296 * 26);
      const target = (360 - index * 360 / 26) % 360;
      rotation += 1080 + ((target - rotation % 360 + 360) % 360);
      spin.disabled = true;
      letter.textContent = '…';
      dial.style.transform = `rotate(${rotation}deg)`;
      const duration = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 1400;
      window.setTimeout(() => {
        letter.textContent = String.fromCharCode(65 + index);
        spin.disabled = false;
      }, duration);
    });
  });
</script>
