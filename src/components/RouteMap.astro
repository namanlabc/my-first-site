---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const routes = [
  { label: 'building', detail: 'Get Random Letter + Calm WP', href: `${base}projects/` },
  { label: 'exploring', detail: 'AI + SEO, practically', href: `${base}about/#exploring` },
  { label: 'writing', detail: 'what I’m learning', href: `${base}archive/` },
  { label: 'off-screen', detail: 'One Piece + chai', href: `${base}about/#off-screen` },
];
---

<nav class="route-map" aria-label="Explore Naman's interests">
  <div class="route-map__heading">
    <p class="route-map__origin">current coordinates</p>
    <span class="route-map__compass" aria-hidden="true">
      <span>N</span>
    </span>
  </div>
  <ul>
    {routes.map((route, index) => (
      <li>
        <a href={route.href}>
          <span class="route-map__dot" aria-hidden="true">{index + 1}</span>
          <span class="route-map__copy">
            <strong>{route.label}</strong>
            <small>{route.detail}</small>
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>
