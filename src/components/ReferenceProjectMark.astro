---
interface Props { kind: 'smallmb' | 'audit' | 'letters'; }
const { kind } = Astro.props;
---

<span class:list={["reference-mark", `reference-mark--${kind}`]} aria-hidden="true">
  {kind === 'smallmb' && (
    <svg viewBox="0 0 48 48"><rect x="5" y="5" width="38" height="38" rx="11" class="mark-bg"/><path d="M16 14h12l7 7v13H16Z" class="mark-paper"/><path d="M28 14v8h8" class="mark-fold"/></svg>
  )}
  {kind === 'audit' && (
    <svg viewBox="0 0 48 48"><rect x="5" y="5" width="38" height="38" rx="11" class="mark-bg"/><path d="M15 33 24 15l4 8 5-8 7 18h-7l-5-12-7 12Z" class="mark-a"/></svg>
  )}
  {kind === 'letters' && (
    <svg viewBox="0 0 48 48"><rect x="5" y="5" width="38" height="38" rx="11" class="mark-bg"/><rect x="14" y="14" width="20" height="20" rx="7" class="mark-outline"/><circle cx="24" cy="24" r="3.6" class="mark-dot"/></svg>
  )}
</span>

<style>
  .reference-mark{display:inline-flex;width:56px;height:56px;align-items:center;justify-content:center;flex:0 0 auto}
  .reference-mark svg{width:56px;height:56px;display:block}
  .reference-mark--smallmb .mark-bg{fill:#a9e59b}
  .reference-mark--smallmb .mark-paper{fill:#fff;stroke:#fff;stroke-width:1.4}
  .reference-mark--smallmb .mark-fold{fill:none;stroke:#dfeadf;stroke-width:1.6}
  .reference-mark--audit .mark-bg{fill:#171717}
  .reference-mark--audit .mark-a{fill:#fff}
  .reference-mark--letters .mark-bg{fill:#f5f5f5;stroke:#e7e7e7;stroke-width:1}
  .reference-mark--letters .mark-outline{fill:none;stroke:#111;stroke-width:2}
  .reference-mark--letters .mark-dot{fill:#111}
  @media(max-width:640px){.reference-mark,.reference-mark svg{width:46px;height:46px}}
</style>
