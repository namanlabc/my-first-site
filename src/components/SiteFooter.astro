---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="site-footer">
  <button class="footer-life" type="button" aria-label="A tiny living dot. Tap to see what happens.">
    <canvas class="footer-life-canvas" aria-hidden="true">A tiny circle quietly doing something different.</canvas>
  </button>
  <span class="visually-hidden footer-life-announcer" aria-live="polite"></span>

  <div class="footer-row">
    <p>© {new Date().getFullYear()} Naman Patel</p>
    <nav aria-label="Footer navigation"><a href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer">GitHub</a><a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer">X</a><a href={`${base}rss.xml`}>RSS</a></nav>
  </div>
</footer>

<script>
  const footer = document.querySelector<HTMLElement>('.site-footer');
  const stage = footer?.querySelector<HTMLButtonElement>('.footer-life');
  const canvas = stage?.querySelector<HTMLCanvasElement>('.footer-life-canvas');
  const announcer = footer?.querySelector<HTMLElement>('.footer-life-announcer');
  const context = canvas?.getContext('2d');

  if (footer && stage && canvas && context) {
    const activities = ['water', 'read', 'stack', 'ball', 'sleep', 'lamp', 'code', 'plane'] as const;
    type Activity = typeof activities[number];
    const activityNames: Record<Activity, string> = {
      water: 'watering a tiny idea', read: 'reading one more note', stack: 'stacking small things',
      ball: 'passing time with a ball', sleep: 'taking a very serious nap', lamp: 'thinking after dark',
      code: 'pulling at a stubborn bug', plane: 'watching a thought drift by',
    };
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const now = performance.now();
    const state = {
      width: 0, height: 0, ground: 0, radius: 14,
      activity: activities[Math.floor(Math.random() * activities.length)] as Activity,
      activityAt: now, nextActivityAt: now + 11000 + Math.random() * 5000,
      reactionAt: -2000, taps: 0, dotX: 0, linkX: null as number | null,
      pointerX: 0, pointerY: 0, pointerUntil: 0, visible: false,
      blinkAt: now + 1600 + Math.random() * 2600, blinkUntil: 0,
    };

    let colors = {
      paper: '#fff', ink: '#181a18', muted: '#626762', rule: '#e5e8e3',
      accent: '#356551', cobalt: '#536fa8', mustard: '#bd9632', coral: '#b94b52',
    };

    const random = (min: number, max: number) => min + Math.random() * (max - min);
    const clamp = (value: number, min: number, max: number) => Math.max(min, Math.min(max, value));
    const wave = (time: number, speed = 1) => Math.sin(time * .001 * speed);
    const roundedRect = (x: number, y: number, width: number, height: number, radius: number) => {
      context.beginPath();
      context.roundRect(x, y, width, height, radius);
    };
    const line = (...points: number[]) => {
      context.beginPath();
      context.moveTo(points[0], points[1]);
      for (let index = 2; index < points.length; index += 2) context.lineTo(points[index], points[index + 1]);
      context.stroke();
    };

    const refreshColors = () => {
      const style = getComputedStyle(document.documentElement);
      colors = {
        paper: style.getPropertyValue('--paper').trim(), ink: style.getPropertyValue('--ink').trim(),
        muted: style.getPropertyValue('--muted').trim(), rule: style.getPropertyValue('--rule').trim(),
        accent: style.getPropertyValue('--accent').trim(), cobalt: style.getPropertyValue('--cobalt').trim(),
        mustard: style.getPropertyValue('--mustard').trim(), coral: style.getPropertyValue('--coral').trim(),
      };
    };

    const chooseActivity = (time: number) => {
      const options = activities.filter((activity) => activity !== state.activity);
      state.activity = options[Math.floor(Math.random() * options.length)];
      state.activityAt = time;
      state.nextActivityAt = time + random(10000, 15500);
      state.reactionAt = -2000;
      state.taps = 0;
    };

    const resize = () => {
      const box = stage.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      state.width = Math.max(1, box.width);
      state.height = Math.max(1, box.height);
      state.ground = state.height - 19;
      state.radius = state.width < 520 ? 12 : 14;
      if (!state.dotX) state.dotX = state.width / 2;
      canvas.width = Math.round(state.width * ratio);
      canvas.height = Math.round(state.height * ratio);
      canvas.style.width = `${state.width}px`;
      canvas.style.height = `${state.height}px`;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      draw(performance.now());
    };

    const reaction = (time: number) => {
      const elapsed = time - state.reactionAt;
      if (elapsed < 0 || elapsed > 1200) return 0;
      return Math.sin((elapsed / 1200) * Math.PI);
    };

    const drawDot = (x: number, y: number, time: number, options: { sleeping?: boolean; lookX?: number; scaleX?: number; scaleY?: number; hop?: number } = {}) => {
      const radius = state.radius;
      const sleeping = options.sleeping ?? false;
      const scaleX = options.scaleX ?? 1;
      const scaleY = options.scaleY ?? 1;
      const hop = options.hop ?? 0;
      const dotY = y - hop;

      context.save();
      context.globalAlpha = clamp(.17 - hop / 180, .05, .17);
      context.fillStyle = colors.ink;
      context.beginPath();
      context.ellipse(x, state.ground + 1, radius * clamp(1 - hop / 70, .45, 1), 2, 0, 0, Math.PI * 2);
      context.fill();
      context.restore();

      context.save();
      context.translate(x, dotY + radius * (1 - scaleY));
      context.scale(scaleX, scaleY);
      context.fillStyle = colors.ink;
      context.beginPath();
      context.arc(0, 0, radius, 0, Math.PI * 2);
      context.fill();

      const pointerActive = time < state.pointerUntil;
      const lookTarget = pointerActive ? state.pointerX : options.lookX ?? x;
      const glance = clamp((lookTarget - x) / 45, -2.6, 2.6);
      const blinking = time < state.blinkUntil;
      context.fillStyle = colors.paper;
      context.strokeStyle = colors.paper;
      context.lineWidth = 1.6;

      if (sleeping && !reaction(time)) {
        line(-radius * .48, -1, -radius * .2, -1);
        line(radius * .14, -1, radius * .42, -1);
      } else {
        const eyeWidth = Math.max(2.1, radius * .19);
        const eyeHeight = blinking ? .8 : reaction(time) > .65 ? radius * .43 : radius * .3;
        roundedRect(-radius * .43 + glance, -2 - eyeHeight / 2, eyeWidth, eyeHeight, eyeWidth);
        context.fill();
        roundedRect(radius * .18 + glance, -2 - eyeHeight / 2, eyeWidth, eyeHeight, eyeWidth);
        context.fill();
      }
      context.restore();
    };

    const drawPlant = (center: number, time: number, react: number) => {
      const sway = wave(time, 1.5) * 1.3;
      const height = 13 + react * 9;
      context.strokeStyle = colors.accent;
      context.fillStyle = colors.accent;
      context.lineWidth = 1.5;
      line(center, state.ground, center + sway, state.ground - height);
      context.beginPath();
      context.ellipse(center - 4 + sway, state.ground - height + 4, 5, 2.5, -.55, 0, Math.PI * 2);
      context.globalAlpha = .18; context.fill(); context.globalAlpha = 1; context.stroke();
      context.beginPath();
      context.ellipse(center + 4 + sway, state.ground - height + 1, 5, 2.5, .55, 0, Math.PI * 2);
      context.globalAlpha = .18; context.fill(); context.globalAlpha = 1; context.stroke();
    };

    const drawWater = (time: number, center: number, react: number) => {
      const dotX = center - 34;
      drawPlant(center + 38, time, react);
      context.strokeStyle = colors.cobalt;
      context.fillStyle = colors.cobalt;
      context.lineWidth = 1.4;
      roundedRect(dotX + 13, state.ground - 19, 17, 12, 3);
      context.globalAlpha = .12; context.fill(); context.globalAlpha = 1; context.stroke();
      context.beginPath(); context.arc(dotX + 14, state.ground - 13, 5, Math.PI * .5, Math.PI * 1.5); context.stroke();
      line(dotX + 29, state.ground - 17, dotX + 39, state.ground - 20);
      for (let i = 0; i < 3; i++) {
        const fall = ((time * .035 + i * 7) % 18) + react * 4;
        context.fillStyle = colors.cobalt;
        context.globalAlpha = .35;
        context.beginPath(); context.arc(dotX + 43 + i * 4, state.ground - 24 + fall, 1.2, 0, Math.PI * 2); context.fill();
      }
      context.globalAlpha = 1;
      drawDot(dotX, state.ground - state.radius, time, { lookX: center + 38, scaleY: 1 + react * .04 });
    };

    const drawRead = (time: number, center: number, react: number) => {
      const bob = wave(time, 1.1) * .8;
      drawDot(center, state.ground - state.radius - 5 + bob, time, { lookX: center + 6, scaleY: .96 });
      const bookY = state.ground - 12;
      context.strokeStyle = colors.coral;
      context.fillStyle = colors.coral;
      context.lineWidth = 1.5;
      context.beginPath();
      context.moveTo(center, bookY + 8); context.lineTo(center - 18, bookY + react * 2); context.lineTo(center - 18, bookY - 10);
      context.lineTo(center, bookY - 4); context.lineTo(center + 18, bookY - 10 + react * 5); context.lineTo(center + 18, bookY);
      context.closePath(); context.globalAlpha = .1; context.fill(); context.globalAlpha = 1; context.stroke();
      line(center, bookY - 4, center, bookY + 8);
    };

    const drawStack = (time: number, center: number, react: number) => {
      const dotX = center - 42;
      const blockX = center + 19;
      const sizes = [18, 16, 13];
      let y = state.ground;
      sizes.forEach((size, index) => {
        y -= size;
        context.save();
        const tumble = index === 2 ? react : 0;
        context.translate(blockX + tumble * 17, y + size / 2 + tumble * 7);
        context.rotate((wave(time, 2 + index) * .025) + tumble * .75);
        context.strokeStyle = [colors.cobalt, colors.mustard, colors.coral][index];
        context.fillStyle = [colors.cobalt, colors.mustard, colors.coral][index];
        context.lineWidth = 1.4;
        roundedRect(-size / 2, -size / 2, size, size, 3);
        context.globalAlpha = .12; context.fill(); context.globalAlpha = 1; context.stroke();
        context.restore();
      });
      drawDot(dotX, state.ground - state.radius, time, { lookX: blockX, hop: react * 4 });
    };

    const drawBall = (time: number, center: number, react: number) => {
      const travel = wave(time, 1.15);
      const ballX = center + travel * 55;
      const bounce = Math.abs(Math.sin(time * .0028)) * 7 + react * 19;
      context.fillStyle = colors.mustard;
      context.strokeStyle = colors.mustard;
      context.lineWidth = 1.3;
      context.beginPath(); context.arc(ballX, state.ground - 7 - bounce, 6.5, 0, Math.PI * 2);
      context.globalAlpha = .2; context.fill(); context.globalAlpha = 1; context.stroke();
      state.dotX += ((ballX - 28) - state.dotX) * .08;
      drawDot(state.dotX, state.ground - state.radius, time, { lookX: ballX, hop: Math.max(0, react * 7 - 2) });
    };

    const drawSleep = (time: number, center: number, react: number) => {
      const wake = react;
      drawDot(center, state.ground - state.radius + 3, time, { sleeping: true, scaleX: 1.12 - wake * .08, scaleY: .82 + wake * .18, hop: wake * 18 });
      context.strokeStyle = colors.cobalt;
      context.globalAlpha = .5 * (1 - wake);
      context.lineWidth = 1.2;
      const drift = (time * .012) % 12;
      line(center + 18, state.ground - 31 - drift, center + 24, state.ground - 31 - drift, center + 18, state.ground - 39 - drift, center + 24, state.ground - 39 - drift);
      context.globalAlpha = 1;
    };

    const drawLamp = (time: number, center: number, react: number) => {
      const dotX = center - 32;
      const lampX = center + 35;
      context.strokeStyle = colors.mustard;
      context.fillStyle = colors.mustard;
      context.lineWidth = 1.5;
      line(lampX, state.ground, lampX, state.ground - 30, lampX + 12, state.ground - 41);
      context.beginPath(); context.arc(lampX + 13, state.ground - 42, 6, Math.PI * .1, Math.PI * 1.15); context.stroke();
      const ray = 8 + react * 6 + wave(time, 2) * 1.2;
      context.globalAlpha = .55;
      line(lampX + 19, state.ground - 39, lampX + 19 + ray, state.ground - 34);
      line(lampX + 18, state.ground - 45, lampX + 25 + ray * .7, state.ground - 47);
      context.globalAlpha = 1;
      drawDot(dotX, state.ground - state.radius, time, { lookX: lampX + 13, scaleY: 1 + react * .06 });
    };

    const drawCode = (time: number, center: number, react: number) => {
      const dotX = center - 45;
      const tileX = center + 23 + react * 13;
      const tileY = state.ground - 27 - react * 8;
      context.strokeStyle = colors.cobalt;
      context.fillStyle = colors.cobalt;
      context.lineWidth = 1.4;
      roundedRect(tileX, tileY, 39, 27, 5);
      context.globalAlpha = .1; context.fill(); context.globalAlpha = 1; context.stroke();
      context.font = '12px Geist, sans-serif';
      context.textAlign = 'center';
      context.fillStyle = colors.cobalt;
      context.fillText('</>', tileX + 19.5, tileY + 18);
      context.strokeStyle = colors.muted;
      line(dotX + state.radius - 1, state.ground - 13, tileX, tileY + 18);
      drawDot(dotX - react * 5, state.ground - state.radius, time, { lookX: tileX, scaleX: 1 + react * .08, scaleY: 1 - react * .05 });
    };

    const drawPlane = (time: number, center: number, react: number) => {
      const loop = ((time - state.activityAt) * (.035 + react * .02)) % (state.width + 100);
      const planeX = loop - 50;
      const planeY = state.ground - 48 - Math.sin(loop * .025) * 7;
      context.strokeStyle = colors.coral;
      context.lineWidth = 1.3;
      context.beginPath(); context.moveTo(planeX - 11, planeY + 4); context.lineTo(planeX + 12, planeY - 5);
      context.lineTo(planeX + 4, planeY + 10); context.lineTo(planeX, planeY + 2); context.closePath(); context.stroke();
      drawDot(center, state.ground - state.radius, time, { lookX: planeX, hop: react * 8 });
    };

    const draw = (time: number) => {
      context.clearRect(0, 0, state.width, state.height);
      context.strokeStyle = colors.rule;
      context.lineWidth = 1;
      line(0, state.ground + .5, state.width, state.ground + .5);

      const enter = clamp((time - state.activityAt) / 360, 0, 1);
      context.save();
      context.globalAlpha = enter;
      const react = reaction(time);
      const center = state.linkX ?? state.width / 2;
      const defaultTarget = center + ({ water: -34, read: 0, stack: -42, ball: 0, sleep: 0, lamp: -32, code: -45, plane: 0 }[state.activity]);
      state.dotX += (defaultTarget - state.dotX) * .08;

      if (state.linkX !== null) {
        drawDot(state.dotX, state.ground - state.radius, time, { lookX: state.linkX, hop: Math.abs(wave(time, 4)) * 2 + react * 5 });
      } else if (state.activity === 'water') drawWater(time, center, react);
      else if (state.activity === 'read') drawRead(time, center, react);
      else if (state.activity === 'stack') drawStack(time, center, react);
      else if (state.activity === 'ball') drawBall(time, center, react);
      else if (state.activity === 'sleep') drawSleep(time, center, react);
      else if (state.activity === 'lamp') drawLamp(time, center, react);
      else if (state.activity === 'code') drawCode(time, center, react);
      else drawPlane(time, center, react);
      context.restore();
    };

    const tick = () => {
      const time = performance.now();
      if (time >= state.nextActivityAt && state.linkX === null) chooseActivity(time);
      if (time >= state.blinkAt) {
        state.blinkUntil = time + 105;
        state.blinkAt = time + random(1900, 4600);
      }
      draw(time);
    };

    const interact = () => {
      if (reducedMotion) return;
      const time = performance.now();
      state.reactionAt = time;
      state.taps += 1;
      state.nextActivityAt = time + (state.taps >= 3 ? 1400 : random(7000, 11000));
      if (announcer) announcer.textContent = `The dot is ${activityNames[state.activity]}.`;
    };

    stage.addEventListener('pointermove', (event) => {
      const box = stage.getBoundingClientRect();
      state.pointerX = event.clientX - box.left;
      state.pointerY = event.clientY - box.top;
      state.pointerUntil = performance.now() + 900;
    });
    stage.addEventListener('pointerdown', (event) => { event.preventDefault(); interact(); });
    stage.addEventListener('keydown', (event) => {
      if ((event.key === ' ' || event.key === 'Enter') && !event.repeat) { event.preventDefault(); interact(); }
    });

    footer.querySelectorAll<HTMLAnchorElement>('nav a').forEach((link) => {
      const visit = () => {
        const stageBox = stage.getBoundingClientRect();
        const linkBox = link.getBoundingClientRect();
        state.linkX = clamp(linkBox.left + linkBox.width / 2 - stageBox.left, 28, state.width - 28);
        state.reactionAt = performance.now();
      };
      link.addEventListener('pointerenter', visit);
      link.addEventListener('focus', visit);
      link.addEventListener('pointerleave', () => { state.linkX = null; });
      link.addEventListener('blur', () => { state.linkX = null; });
    });

    new MutationObserver(() => { refreshColors(); draw(performance.now()); }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    new ResizeObserver(resize).observe(stage);
    new IntersectionObserver(([entry]) => { state.visible = entry.isIntersecting; }, { threshold: .05 }).observe(stage);
    refreshColors();
    resize();

    if (!reducedMotion) window.setInterval(() => { if (state.visible) tick(); }, 1000 / 30);
  }
</script>
