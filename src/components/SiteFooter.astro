---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="site-footer">
  <div class="footer-scene" aria-hidden="true">
    <svg class="footer-landscape" viewBox="0 0 960 90">
      <g class="footer-cloud">
        <path d="M414 18c4-8 17-8 21 1 8-5 19 1 18 10h-48c-1-5 3-10 9-11Z" />
      </g>

      <g class="footer-wind">
        <path d="M202 27c31-9 61-8 89 2" />
        <path d="M230 36c24-5 45-3 64 5" />
        <path d="M691 22c22-7 43-6 62 1" />
      </g>

      <g class="footer-tree footer-tree--left">
        <path class="footer-trunk" d="M322 68c3-17 3-28 0-43M322 43l-12-10M323 49l14-13" />
        <path class="footer-canopy" d="M322 12c-13 0-23 9-22 19-8 5-4 16 7 17 5 8 18 7 22 1 10 4 20-3 17-12 8-8 1-20-10-18-1-10-7-17-14-17Z" />
      </g>

      <g class="footer-tree footer-tree--right">
        <path class="footer-trunk" d="M657 68c-2-14-1-25 2-37M658 45l-11-8M658 51l12-10" />
        <path class="footer-canopy" d="M659 19c-10-5-21 2-21 12-10 1-13 13-5 18 1 9 13 13 20 7 7 8 20 5 21-5 10-3 10-17 1-21-1-7-8-12-16-11Z" />
      </g>

      <g class="footer-grass footer-grass--one"><path d="M276 70c-1-8-4-12-7-16M277 69c2-8 5-12 9-16M277 69c0-10 1-16 3-21" /></g>
      <g class="footer-grass footer-grass--two"><path d="M705 70c-1-8-4-12-7-16M706 69c2-8 5-12 9-16M706 69c0-10 1-16 3-21" /></g>
      <path class="footer-bank" d="M160 70c102-5 196-2 270 0 81 2 180-6 359 0" />

      <g class="footer-water">
        <path d="M193 77h116m48 0h151m48 0h200" />
        <path d="M241 84h154m48 0h108m38 0h125" />
      </g>

      <g class="footer-stones">
        <ellipse cx="420" cy="68" rx="12" ry="3.5" />
        <ellipse cx="480" cy="70" rx="14" ry="4" />
        <ellipse cx="543" cy="68" rx="11" ry="3.5" />
      </g>

      <path class="footer-leaf" d="M370 28c9-1 14 3 14 9-8 2-13-1-14-9Z" />
    </svg>

    <span class="footer-mascot" title="poke me">
      <svg viewBox="0 0 44 44">
        <circle class="footer-dot-disc" cx="22" cy="22" r="18" />
        <g class="footer-dot-eyes">
          <ellipse class="footer-dot-eye" cx="17" cy="21" rx="3.2" ry="4.6" />
          <ellipse class="footer-dot-eye footer-dot-eye--late" cx="28" cy="21" rx="3.2" ry="4.6" />
        </g>
      </svg>
    </span>
  </div>

  <div class="footer-row">
    <p>© {new Date().getFullYear()} Naman Patel</p>
    <nav aria-label="Footer navigation"><a href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer">GitHub</a><a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer">X</a><a href={`${base}rss.xml`}>RSS</a></nav>
  </div>
</footer>

<script>
  const footer = document.querySelector<HTMLElement>('.site-footer');
  const scene = footer?.querySelector<HTMLElement>('.footer-scene');
  const dot = footer?.querySelector<HTMLElement>('.footer-mascot');
  const links = footer?.querySelectorAll<HTMLAnchorElement>('nav a');
  let settleTimer = 0;
  let jumpTimer = 0;

  const moveDot = (target: HTMLElement) => {
    if (!scene || !dot) return;
    const sceneBox = scene.getBoundingClientRect();
    const targetBox = target.getBoundingClientRect();
    const x = ((targetBox.left + targetBox.width / 2 - sceneBox.left) / sceneBox.width) * 100;
    dot.style.setProperty('--footer-dot-x', `${Math.max(8, Math.min(92, x))}%`);
    dot.classList.add('is-rolling');
    window.clearTimeout(settleTimer);
    settleTimer = window.setTimeout(() => dot.classList.remove('is-rolling'), 720);
  };

  links?.forEach((link) => {
    link.addEventListener('pointerenter', () => moveDot(link));
    link.addEventListener('focus', () => moveDot(link));
  });

  footer?.addEventListener('pointerleave', () => {
    if (!dot) return;
    dot.style.setProperty('--footer-dot-x', '50%');
    dot.classList.add('is-rolling');
    window.clearTimeout(settleTimer);
    settleTimer = window.setTimeout(() => dot.classList.remove('is-rolling'), 720);
  });

  dot?.addEventListener('pointerdown', () => {
    window.clearTimeout(jumpTimer);
    dot.classList.remove('is-jumping');
    void dot.offsetWidth;
    dot.classList.add('is-jumping');
    jumpTimer = window.setTimeout(() => dot.classList.remove('is-jumping'), 680);
  });

  if (footer) {
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) footer.classList.add('is-awake');
    }, { threshold: .25 });
    observer.observe(footer);
  }
</script>
