---
import ReferenceArt from './ReferenceArt.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer class="site-footer">
  <div class="reference-footer__main">
    <div class="reference-footer__contact">
      <a class="reference-footer__email" href="mailto:contact@naman.blog?subject=Hello%20Naman">contact@naman.blog</a>
      <nav class="reference-footer__social" aria-label="Social links">
        <a href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.22c0 4.51 2.87 8.34 6.84 9.69.5.1.68-.22.68-.49 0-.24-.01-1.05-.02-1.91-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.72 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.91a9.2 9.2 0 0 1 2.5.35c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.93-2.35 4.8-4.58 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.24 10.24 0 0 0 22 12.22C22 6.58 17.52 2 12 2Z"/></svg>
        </a>
        <a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer" aria-label="X">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4l14 16M19 4 5 20" fill="none" stroke-width="1.8"/></svg>
        </a>
        <a href={`${base}rss.xml`} aria-label="RSS">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5c7.7 0 14 6.3 14 14M5 10.5c4.7 0 8.5 3.8 8.5 8.5" fill="none" stroke-width="1.8"/><circle cx="5.2" cy="18.8" r="1.8" stroke="none"/></svg>
        </a>
      </nav>
    </div>

    <div class="reference-footer__art">
      <ReferenceArt variant="footer" />
    </div>
  </div>

  <div class="reference-footer__bottom">
    <p>© {new Date().getFullYear()} Naman Patel. All rights reserved.</p>
    <p>Keep building.</p>
  </div>
</footer>
