---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<footer class="site-footer">
  <div>
    <a class="footer-brand" href={base}>naman.blog</a>
    <p>Useful things, unfinished thoughts, and the notes in between.</p>
  </div>
  <nav aria-label="Footer navigation">
    <a href={`${base}projects/`}>Projects</a>
    <a href={`${base}archive/`}>Writing</a>
    <a href={`${base}about/`}>About</a>
    <a href={`${base}rss.xml`}>RSS</a>
    <a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer">X ↗</a>
  </nav>
  <p class="site-footer__year">© {new Date().getFullYear()} Naman Patel</p>
</footer>
