---
import SiteIcon from './SiteIcon.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer class="site-footer">
  <div class="quiet-footer__top">
    <a class="quiet-footer__email" href="mailto:contact@naman.blog?subject=Hello%20Naman">
      <SiteIcon name="mail" />
      <span>contact@naman.blog</span>
    </a>
    <nav class="quiet-footer__social" aria-label="Social links">
      <a href="https://github.com/namanlabc/" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub"><SiteIcon name="github" /></a>
      <a href="https://x.com/namanlabs" target="_blank" rel="noopener noreferrer" aria-label="X" title="X"><SiteIcon name="x" /></a>
      <a href={`${base}rss.xml`} aria-label="RSS" title="RSS"><SiteIcon name="rss" /></a>
    </nav>
  </div>

  <div class="quiet-footer__bottom">
    <p>© {new Date().getFullYear()} Naman Patel</p>
    <p>naman.blog</p>
  </div>
</footer>
