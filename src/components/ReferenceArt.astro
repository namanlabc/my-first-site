---
interface Props { variant?: 'hero' | 'footer'; }
const { variant = 'hero' } = Astro.props;
---

{variant === 'hero' ? (
  <svg class="reference-art reference-art--hero" viewBox="0 0 620 470" role="img" aria-label="Hand-drawn rabbit looking toward a red sun">
    <g class="sun">
      <circle cx="455" cy="78" r="52" />
      <path d="M420 45c26-18 66-12 82 18M416 76c18-34 77-38 98-4M428 105c22 10 60 8 80-12" />
    </g>

    <g class="sky" fill="none">
      <path d="M531 95c11-2 19-8 27-6 7 2 11 8 18 6M506 105c8-1 14-6 20-5 7 1 11 6 18 5" />
      <path d="M352 122c8-8 17-8 25 0M392 138c8-8 17-8 25 0M470 244c8-8 17-8 25 0" />
      <path d="M457 269c40-22 69-18 105-2 19 8 34 8 56 1" />
      <path d="M475 272l20-13 13 9 24-17 26 16" />
    </g>

    <g class="cliff" fill="none">
      <path d="M80 315c47-12 101-8 153-14 42-6 69-17 104-12 14 2 22 11 20 25-6 43-19 82-26 118" />
      <path d="M325 307c-8 34-19 64-28 98M339 312c-5 37-13 70-18 101M352 320c-5 26-10 50-17 75" />
      <path d="M94 317c16-10 27-14 43-16M121 308c8-15 15-18 22-1M136 307c5-12 11-15 16-1" />
      <path d="M329 391c18 4 31 1 44-7M339 407c18 2 30-2 43-10" />
    </g>

    <g class="rabbit" fill="none">
      <path d="M270 205c-7-33-5-55 4-59 8-3 17 20 19 51M298 197c1-36 8-55 18-52 10 3 10 27 4 59" />
      <path d="M267 208c-1 25 17 42 39 41 22-2 37-21 34-43-3-20-20-34-40-35-18 0-32 15-33 37Z" fill="var(--ref-paper)" />
      <circle cx="286" cy="211" r="3.6" fill="currentColor" />
      <circle cx="318" cy="211" r="3.6" fill="currentColor" />
      <path d="M300 220l4 4 4-4M304 224v8" />
      <path d="M284 249c-6 24-10 44-8 60M320 249c10 20 15 38 16 59" />
      <path d="M276 273c-17 17-28 32-38 44M334 268c15 13 24 27 34 43" />
      <path d="M279 307c14 7 36 8 55 0" />
      <path d="M289 309c-3 13-3 24-2 34M321 309c3 13 3 24 2 34" />
      <path d="M281 344c10 4 18 4 28 0M312 344c11 4 20 4 30 0" />

      <path class="cape" d="M278 246c-24 4-42 14-61 30 17 2 32 8 43 20-19 8-36 18-47 31 27 1 53 8 76 20 9-22 13-51 8-78-7-9-12-17-19-23Z" fill="var(--ref-red)" />
      <path class="cape" d="M279 247c21 8 39 9 58 1l-5 20c-15 4-30 1-44-5Z" fill="var(--ref-red)" />
      <path class="cape-line" d="M255 265c-9 19-16 33-28 43M269 266c-1 26 4 50 17 72M286 260c7 18 12 39 13 61" />
    </g>

    <g class="ground" fill="none">
      <path d="M92 349c30 0 55 2 86 0M205 349c50 0 87 0 137-3" />
      <path d="M480 356c28 5 47 2 72-4M497 351c-2-19 2-31 10-39 9 10 10 21 6 39M520 350c-2-14 0-24 6-30 8 8 10 17 7 30" />
    </g>
  </svg>
) : (
  <svg class="reference-art reference-art--footer" viewBox="0 0 620 230" role="img" aria-label="Hand-drawn signpost on a quiet hill">
    <g fill="none">
      <path d="M37 184c72 2 117-3 168-19 53-16 92-12 143 1 65 17 142 16 238 1" />
      <path d="M180 166c22-11 37-23 57-32 19 8 31 18 49 29" />
      <path d="M162 169c18-8 37-16 54-23M205 168c20-12 39-20 58-20" />
      <path d="M387 166c0-23 3-44 9-62M397 106c18 3 35 6 52 10l-13 15c-13-2-27-3-42-5M395 132c18 3 37 5 57 6l-12 16c-15 0-31-1-48-3M393 157c19 2 39 2 59 1l-12 15c-16 1-32 1-49 1" />
      <path d="M404 118h31M405 143h33M404 163h30" />
      <path d="M355 170c-2-13 2-24 10-31M370 169c1-11 5-19 12-25M343 170c0-8-2-14-7-20" />
    </g>
  </svg>
)}

<style>
  .reference-art { display:block; width:100%; height:auto; overflow:visible; color:var(--ref-ink); }
  .reference-art * { vector-effect:non-scaling-stroke; }
  .reference-art path,
  .reference-art circle { stroke:currentColor; stroke-width:2.35; stroke-linecap:round; stroke-linejoin:round; }
  .reference-art .sun circle { fill:var(--ref-red); stroke:var(--ref-red); }
  .reference-art .sun path { stroke:color-mix(in srgb,var(--ref-red) 90%,black); opacity:.6; }
  .reference-art .cape { stroke:var(--ref-ink); }
  .reference-art .cape-line { stroke:color-mix(in srgb,var(--ref-ink) 80%,var(--ref-red)); }
  .reference-art--footer { max-width:560px; }
  @media (prefers-reduced-motion:no-preference) {
    .reference-art--hero .cape { animation:cape-breathe 6.8s ease-in-out infinite; transform-origin:280px 255px; }
    @keyframes cape-breathe { 0%,100%{transform:rotate(0deg)} 50%{transform:rotate(-1.2deg)} }
  }
</style>
