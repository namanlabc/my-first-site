---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const storyUrl = 'https://www.wattpad.com/story/416937465';
---
<div class="novel-feature">
 <a class="novel-cover" href={storyUrl} target="_blank" rel="noopener noreferrer" aria-label="Read The Idiot God on Wattpad"><img src={base+'images/the-idiot-god.webp'} alt="The Idiot God cover: a traveller beneath a chained stone god with a broken halo." width="640" height="960" loading="eager" decoding="async" /></a>
 <div class="novel-copy">
  <p class="novel-category">A fantasy adventure I’m writing</p>
  <h3>The Idiot God</h3>
  <p class="novel-description">Kaito has waited years to leave Lucine with his uncle. When the great red ship returns wrecked, its crew butchered and his uncle missing, he must face the world of those childhood stories himself.</p>
  <a class="novel-read" href={storyUrl} target="_blank" rel="noopener noreferrer">Read on Wattpad <span aria-hidden="true">↗</span></a>
 </div>
</div>
<style>
.novel-feature{display:grid;grid-template-columns:176px 1fr;gap:36px;align-items:center}
.novel-cover{display:block;line-height:0}.novel-cover img{display:block;width:100%;height:auto;outline:1px solid var(--rule);outline-offset:5px;filter:saturate(.88)}
.novel-category{font:400 11px/1.6 var(--font-body);color:var(--muted);margin:0 0 10px}
h3{font:400 38px/1.15 var(--font-display);letter-spacing:-.025em;margin:0 0 17px}
.novel-description{font:400 18px/1.7 var(--font-display);color:var(--muted);margin:0 0 20px}
.novel-read{font:400 12px/1.5 var(--font-body);text-decoration:underline;text-underline-offset:5px;text-decoration-color:var(--accent);color:var(--ink)}.novel-read span{margin-left:5px}
@media(max-width:600px){.novel-feature{grid-template-columns:94px 1fr;gap:22px;align-items:start}h3{font-size:28px;margin-bottom:12px}.novel-category{font-size:10px;margin-bottom:7px}.novel-description{font-size:16px;line-height:1.65;margin-bottom:18px}.novel-read{font-size:11px}}
</style>
