---
type Variant = 'seo' | 'web' | 'workflow';

interface Props {
  variant: Variant;
  compact?: boolean;
}

const { variant, compact = false } = Astro.props;

const logos = {
  google: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/google/google-original.svg',
  wordpress: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/wordpress/wordpress-plain.svg',
  astro: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/astro/astro-original.svg',
  tailwind: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tailwindcss/tailwindcss-original.svg',
  vscode: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/vscode/vscode-original.svg',
  github: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg',
  npm: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/npm/npm-original-wordmark.svg',
  androidstudio: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/androidstudio/androidstudio-original.svg',
  kotlin: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/kotlin/kotlin-original.svg',
  gradle: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/gradle/gradle-original.svg',
  android: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/android/android-original.svg',
};
---

<div class:list={['tech-workbench', `tech-workbench--${variant}`, { 'tech-workbench--compact': compact }]} aria-hidden="true">
  {variant === 'seo' && (
    <>
      <div class="tech-grid"></div>
      <div class="tech-brand-row tech-brand-row--top">
        <span class="brand-chip brand-chip--white"><img src={logos.google} alt="" loading="lazy" />Search Console</span>
        <span class="brand-chip brand-chip--white"><img src={logos.wordpress} alt="" loading="lazy" />WordPress</span>
        <span class="brand-chip brand-chip--dark"><b>Ahrefs</b></span>
      </div>

      <div class="search-console-window">
        <div class="window-topline"><span>Performance</span><small>Last 3 months</small></div>
        <div class="metric-row">
          <span><small>CLICKS</small><b>4.8K</b></span>
          <span><small>IMPRESSIONS</small><b>128K</b></span>
          <span><small>AVG POSITION</small><b>11.4</b></span>
        </div>
        <div class="chart-area">
          <svg viewBox="0 0 300 90" preserveAspectRatio="none">
            <polyline points="0,72 28,68 55,73 86,54 112,59 139,43 165,47 194,28 222,34 252,19 300,11" />
          </svg>
          <i></i><i></i><i></i>
        </div>
      </div>

      <div class="serp-card">
        <small>google.com / search</small>
        <b>compress image to exact size</b>
        <p>Useful page · clean intent · schema-ready</p>
        <span>position 3.2 ↗</span>
      </div>

      <div class="code-slip code-slip--seo">
        <div><em>schema</em><span>JSON-LD</span></div>
        <code>{`{"@type":"WebApplication"}`}</code>
        <code>{`"name":"Useful Tool"`}</code>
        <code>{`"isAccessibleForFree":true`}</code>
      </div>

      <div class="file-tabs">
        <span>robots.txt</span>
        <span>sitemap.xml</span>
        <span>canonical ✓</span>
      </div>
    </>
  )}

  {variant === 'web' && (
    <>
      <div class="tech-grid"></div>
      <div class="tech-brand-row tech-brand-row--top">
        <span class="brand-chip brand-chip--white"><img src={logos.astro} alt="" loading="lazy" />Astro</span>
        <span class="brand-chip brand-chip--white"><img src={logos.tailwind} alt="" loading="lazy" />Tailwind</span>
        <span class="brand-chip brand-chip--white"><img src={logos.github} alt="" loading="lazy" />GitHub</span>
      </div>

      <div class="editor-window">
        <div class="editor-sidebar">
          <img src={logos.vscode} alt="" loading="lazy" />
          <i></i><i></i><i></i><i></i>
        </div>
        <div class="editor-main">
          <div class="editor-tabs"><span>index.astro</span><span>global.css</span></div>
          <pre><code><b>---</b>
const idea = <em>'useful'</em>;
<b>---</b>
&lt;main class=<em>"ship-it"</em>&gt;
  &lt;Tool idea={`{idea}`} /&gt;
&lt;/main&gt;</code></pre>
        </div>
      </div>

      <div class="browser-fragment">
        <div class="browser-bar"><i></i><i></i><i></i><span>localhost:4321</span></div>
        <div class="browser-layout"><b></b><span></span><span></span><span></span></div>
      </div>

      <div class="terminal-card">
        <span>$ pnpm build</span>
        <span class="ok">✓ 12 pages built</span>
        <span class="ok">✓ lighthouse 98</span>
        <b>ready to ship.</b>
      </div>

      <div class="web-mini-logos">
        <span><img src={logos.npm} alt="" loading="lazy" /></span>
        <small>git: main ↑</small>
      </div>
    </>
  )}

  {variant === 'workflow' && (
    <>
      <div class="tech-grid"></div>
      <div class="tech-brand-row tech-brand-row--top tech-brand-row--workflow">
        <span class="brand-chip brand-chip--white"><img src={logos.androidstudio} alt="" loading="lazy" />Android Studio</span>
        <span class="brand-chip brand-chip--white"><img src={logos.kotlin} alt="" loading="lazy" />Kotlin</span>
        <span class="brand-chip brand-chip--white"><img src={logos.github} alt="" loading="lazy" />GitHub</span>
      </div>

      <div class="pipeline">
        <div class="pipeline-node pipeline-node--issue"><small>ISSUE</small><b>NAM-134</b><span>ready</span></div>
        <i class="pipeline-link pipeline-link--one"></i>
        <div class="pipeline-node pipeline-node--build"><small>BUILD</small><img src={logos.gradle} alt="" loading="lazy" /><b>Gradle</b><span>passing</span></div>
        <i class="pipeline-link pipeline-link--two"></i>
        <div class="pipeline-node pipeline-node--qa"><small>QA</small><b>emulator</b><span>✓ smoke</span></div>
        <i class="pipeline-link pipeline-link--three"></i>
        <div class="pipeline-node pipeline-node--release"><small>RELEASE</small><img src={logos.android} alt="" loading="lazy" /><b>.aab</b><span>signed</span></div>
      </div>

      <div class="actions-card">
        <div><img src={logos.github} alt="" loading="lazy" /><b>android-smoke.yml</b></div>
        <span><i></i> assembleDebug <b>24s</b></span>
        <span><i></i> emulator smoke <b>41s</b></span>
        <span><i></i> upload artifacts <b>3s</b></span>
      </div>

      <div class="release-card">
        <span>mobile / release</span>
        <b>app-release.aab</b>
        <small>versionCode 10 · API 36</small>
        <em>READY</em>
      </div>

      <div class="agent-strip">
        <span>research</span><i>→</i><span>build</span><i>→</i><span>QA</span><i>→</i><span>ship</span>
      </div>
    </>
  )}
</div>

<style>
  .tech-workbench {
    --paper: #f6f1e3;
    --ink-dark: #111914;
    --deep: #11352d;
    position: relative;
    width: 100%;
    min-height: clamp(22rem, 40vw, 33rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ink) 17%, transparent);
    background: #dbe3dd;
    isolation: isolate;
  }

  .tech-workbench--seo { background: #f1d950; }
  .tech-workbench--web { background: #9bd7cc; }
  .tech-workbench--workflow { background: #8fa9e8; }

  .tech-workbench--compact {
    min-height: 0;
    aspect-ratio: 1.08;
  }

  .tech-grid {
    position: absolute;
    inset: 0;
    opacity: 0.28;
    background-image:
      linear-gradient(color-mix(in srgb, var(--ink-dark) 18%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--ink-dark) 18%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,.5), transparent 82%);
  }

  .tech-brand-row {
    position: absolute;
    z-index: 8;
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
  }

  .tech-brand-row--top {
    top: 5%;
    left: 5%;
    right: 5%;
  }

  .brand-chip {
    min-height: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid rgba(18, 23, 20, 0.36);
    font-family: var(--mono);
    font-size: clamp(0.48rem, 0.8vw, 0.62rem);
    font-weight: 650;
    box-shadow: 0.18rem 0.18rem 0 rgba(17, 25, 20, 0.13);
  }

  .brand-chip img {
    width: 1rem;
    height: 1rem;
    object-fit: contain;
  }

  .brand-chip--white { background: rgba(255, 253, 248, 0.94); }
  .brand-chip--dark { color: #f9f5e9; background: #171b18; }

  .search-console-window {
    position: absolute;
    z-index: 2;
    top: 22%;
    left: 6%;
    width: 70%;
    padding: clamp(0.65rem, 1.4vw, 1rem);
    border: 1px solid #242720;
    background: rgba(255, 253, 248, 0.96);
    box-shadow: 0.65rem 0.65rem 0 #ff7658;
    transform: rotate(-1.2deg);
  }

  .window-topline,
  .metric-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .window-topline {
    padding-bottom: 0.55rem;
    border-bottom: 1px solid #d9d4c8;
    font-family: var(--mono);
    font-size: 0.56rem;
  }

  .window-topline small { color: #716e66; }

  .metric-row {
    gap: 0.4rem;
    padding-top: 0.65rem;
  }

  .metric-row span { min-width: 0; flex: 1; }
  .metric-row small { display: block; color: #77736b; font-family: var(--mono); font-size: 0.42rem; }
  .metric-row b { display: block; margin-top: 0.1rem; font-size: clamp(0.68rem, 1.4vw, 1rem); }

  .chart-area {
    position: relative;
    height: clamp(4rem, 9vw, 6.5rem);
    margin-top: 0.5rem;
    border-top: 1px solid #e2ded3;
    border-bottom: 1px solid #e2ded3;
  }

  .chart-area i {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: #e4dfd4;
  }

  .chart-area i:nth-of-type(1) { top: 25%; }
  .chart-area i:nth-of-type(2) { top: 50%; }
  .chart-area i:nth-of-type(3) { top: 75%; }
  .chart-area svg { position: absolute; z-index: 2; inset: 10% 0; width: 100%; height: 80%; }
  .chart-area polyline { fill: none; stroke: #2368d8; stroke-width: 3; vector-effect: non-scaling-stroke; }

  .serp-card {
    position: absolute;
    z-index: 6;
    right: 4%;
    bottom: 10%;
    width: 45%;
    padding: clamp(0.55rem, 1.4vw, 0.85rem);
    border: 1px solid #20211f;
    background: #f6f1e3;
    box-shadow: 0.45rem 0.45rem 0 #173b32;
    transform: rotate(1.5deg);
  }

  .serp-card small,
  .serp-card span {
    display: block;
    color: #6b6a62;
    font-family: var(--mono);
    font-size: 0.42rem;
  }

  .serp-card b { display: block; margin-top: 0.28rem; font-family: var(--reading); font-size: clamp(0.68rem, 1.4vw, 1.05rem); font-weight: 400; line-height: 1.05; }
  .serp-card p { margin: 0.25rem 0; color: #5d5c56; font-size: clamp(0.45rem, 0.85vw, 0.62rem); line-height: 1.3; }
  .serp-card span { color: #1d6f48; font-weight: 700; }

  .code-slip {
    position: absolute;
    z-index: 7;
    width: 39%;
    padding: 0.6rem;
    border: 1px solid #17352e;
    color: #dff3ea;
    background: #11352d;
    box-shadow: 0.4rem 0.4rem 0 rgba(15, 35, 29, 0.2);
  }

  .code-slip--seo { left: 5%; bottom: 5%; transform: rotate(-2deg); }
  .code-slip div { display: flex; justify-content: space-between; margin-bottom: 0.35rem; color: #8eb7ab; font-family: var(--mono); font-size: 0.42rem; }
  .code-slip code { display: block; margin-top: 0.18rem; font-family: var(--mono); font-size: clamp(0.38rem, 0.67vw, 0.52rem); white-space: nowrap; }

  .file-tabs {
    position: absolute;
    z-index: 7;
    top: 14%;
    right: 4%;
    display: grid;
    gap: 0.2rem;
  }

  .file-tabs span {
    padding: 0.22rem 0.4rem;
    border: 1px solid rgba(17, 25, 20, 0.4);
    background: #f8f2df;
    font-family: var(--mono);
    font-size: 0.4rem;
  }

  .editor-window {
    position: absolute;
    z-index: 3;
    top: 20%;
    left: 5%;
    width: 68%;
    height: 57%;
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    border: 1px solid #102c25;
    color: #dff4eb;
    background: #12362e;
    box-shadow: 0.65rem 0.65rem 0 #ff7658;
    transform: rotate(1deg);
  }

  .editor-sidebar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    padding-top: 0.6rem;
    border-right: 1px solid #31574d;
    background: #0e2c25;
  }

  .editor-sidebar img { width: 1rem; height: 1rem; }
  .editor-sidebar i { width: 0.75rem; height: 0.75rem; border: 1px solid #678b81; }

  .editor-main { min-width: 0; overflow: hidden; }
  .editor-tabs { height: 2rem; display: flex; align-items: end; gap: 0.2rem; border-bottom: 1px solid #31574d; }
  .editor-tabs span { padding: 0.45rem 0.55rem; border-right: 1px solid #31574d; color: #9fbdb4; font-family: var(--mono); font-size: 0.43rem; }
  .editor-tabs span:first-child { color: #edf9f4; background: #173f35; }
  .editor-main pre { margin: 0; padding: clamp(0.75rem, 2vw, 1.2rem); font-family: var(--mono); font-size: clamp(0.48rem, 0.9vw, 0.7rem); line-height: 1.55; white-space: pre-wrap; }
  .editor-main code b { color: #ff826a; font-weight: 500; }
  .editor-main code em { color: #f0dc72; font-style: normal; }

  .browser-fragment {
    position: absolute;
    z-index: 6;
    right: 4%;
    top: 35%;
    width: 39%;
    border: 1px solid #1a1c19;
    background: #f8f4e9;
    box-shadow: 0.4rem 0.4rem 0 rgba(17, 25, 20, 0.2);
    transform: rotate(-2deg);
  }

  .browser-bar { height: 1.55rem; display: flex; align-items: center; gap: 0.25rem; padding: 0 0.45rem; border-bottom: 1px solid #d5d0c4; }
  .browser-bar i { width: 0.28rem; height: 0.28rem; border-radius: 50%; background: #b6b2aa; }
  .browser-bar span { margin-left: 0.3rem; color: #66635c; font-family: var(--mono); font-size: 0.38rem; }
  .browser-layout { display: grid; grid-template-columns: 1fr 0.55fr; gap: 0.35rem; padding: 0.5rem; }
  .browser-layout b { grid-row: span 3; min-height: 4.5rem; background: #f1d950; }
  .browser-layout span { min-height: 1rem; background: #d9e3dd; }

  .terminal-card {
    position: absolute;
    z-index: 7;
    left: 8%;
    bottom: 4%;
    width: 45%;
    padding: 0.55rem 0.65rem;
    border: 1px solid #171a17;
    color: #ebf7f1;
    background: #101b17;
    transform: rotate(-1deg);
  }

  .terminal-card span { display: block; margin-top: 0.15rem; font-family: var(--mono); font-size: clamp(0.4rem, 0.72vw, 0.56rem); }
  .terminal-card .ok { color: #75e2ad; }
  .terminal-card b { display: block; margin-top: 0.35rem; color: #ff826a; font-family: var(--reading); font-size: clamp(0.7rem, 1.2vw, 0.95rem); font-weight: 400; }

  .web-mini-logos {
    position: absolute;
    z-index: 8;
    right: 5%;
    bottom: 5%;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .web-mini-logos span { width: 2.1rem; height: 2.1rem; display: grid; place-items: center; border: 1px solid #242720; background: #fffdf8; }
  .web-mini-logos img { width: 1.5rem; height: 1.5rem; }
  .web-mini-logos small { padding: 0.25rem 0.4rem; border: 1px solid #242720; background: #fffdf8; font-family: var(--mono); font-size: 0.4rem; }

  .pipeline {
    position: absolute;
    z-index: 4;
    top: 24%;
    left: 5%;
    right: 5%;
    height: 38%;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 5%;
    align-items: center;
  }

  .pipeline-node {
    position: relative;
    z-index: 2;
    min-height: 5.7rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.55rem;
    border: 1px solid #1c211f;
    background: #f7f1df;
    box-shadow: 0.32rem 0.32rem 0 rgba(17, 25, 20, 0.16);
  }

  .pipeline-node img { width: 1.1rem; height: 1.1rem; margin: 0.18rem 0; }
  .pipeline-node small { color: #77736b; font-family: var(--mono); font-size: 0.38rem; }
  .pipeline-node b { font-family: var(--mono); font-size: clamp(0.5rem, 0.9vw, 0.68rem); }
  .pipeline-node span { margin-top: 0.25rem; color: #1e7b50; font-family: var(--mono); font-size: 0.4rem; }
  .pipeline-node--build { transform: translateY(-0.65rem) rotate(-1deg); }
  .pipeline-node--qa { transform: translateY(0.55rem) rotate(1deg); }
  .pipeline-node--release { transform: translateY(-0.25rem); }

  .pipeline-link {
    position: absolute;
    z-index: 1;
    top: 50%;
    width: 10%;
    height: 1px;
    background: #272c29;
  }

  .pipeline-link::after { content: "›"; position: absolute; right: -0.1rem; top: -0.65rem; font-size: 1rem; }
  .pipeline-link--one { left: 20%; }
  .pipeline-link--two { left: 45%; }
  .pipeline-link--three { left: 70%; }

  .actions-card {
    position: absolute;
    z-index: 7;
    left: 6%;
    bottom: 5%;
    width: 46%;
    padding: 0.6rem;
    border: 1px solid #12362e;
    color: #dff4eb;
    background: #11352d;
    transform: rotate(-1deg);
  }

  .actions-card > div { display: flex; align-items: center; gap: 0.4rem; padding-bottom: 0.4rem; border-bottom: 1px solid #355d52; }
  .actions-card > div img { width: 0.8rem; height: 0.8rem; filter: invert(1); }
  .actions-card > div b { font-family: var(--mono); font-size: 0.48rem; }
  .actions-card > span { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.35rem; margin-top: 0.28rem; color: #9cc0b6; font-family: var(--mono); font-size: 0.4rem; }
  .actions-card > span i { width: 0.42rem; height: 0.42rem; border-radius: 50%; background: #54d492; }
  .actions-card > span b { color: #dff4eb; font-size: inherit; }

  .release-card {
    position: absolute;
    z-index: 8;
    right: 5%;
    bottom: 7%;
    width: 39%;
    padding: 0.65rem;
    border: 1px solid #20231f;
    background: #f8f2df;
    box-shadow: 0.45rem 0.45rem 0 #ff7658;
    transform: rotate(1.5deg);
  }

  .release-card span,
  .release-card small { display: block; color: #706e67; font-family: var(--mono); font-size: 0.38rem; }
  .release-card b { display: block; margin-top: 0.3rem; font-family: var(--mono); font-size: clamp(0.5rem, 1vw, 0.72rem); }
  .release-card em { display: inline-block; margin-top: 0.45rem; padding: 0.15rem 0.3rem; color: #0d5f3a; background: #cdebd8; font-family: var(--mono); font-size: 0.36rem; font-style: normal; }

  .agent-strip {
    position: absolute;
    z-index: 7;
    top: 13%;
    right: 5%;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.28rem 0.45rem;
    border: 1px solid #20231f;
    background: rgba(248, 242, 223, 0.94);
    font-family: var(--mono);
    font-size: 0.38rem;
  }

  .agent-strip i { color: #c34a27; font-style: normal; }

  .tech-workbench--compact .brand-chip { min-height: 1.7rem; }
  .tech-workbench--compact .search-console-window { top: 23%; }
  .tech-workbench--compact .serp-card { bottom: 9%; }
  .tech-workbench--compact .editor-window { top: 21%; height: 55%; }
  .tech-workbench--compact .pipeline { top: 26%; }

  @media (max-width: 640px) {
    .tech-workbench { min-height: 23rem; }
    .tech-workbench--compact { aspect-ratio: 1.15; min-height: 0; }
    .tech-brand-row--top { top: 4%; left: 4%; right: 4%; }
    .brand-chip:nth-child(n+3) { display: none; }
    .search-console-window { left: 4%; width: 78%; top: 20%; }
    .serp-card { right: 3%; width: 47%; }
    .code-slip--seo { left: 4%; width: 46%; }
    .file-tabs { display: none; }
    .editor-window { left: 4%; width: 76%; top: 19%; height: 56%; }
    .browser-fragment { right: 3%; width: 42%; top: 40%; }
    .terminal-card { left: 5%; width: 52%; }
    .web-mini-logos { display: none; }
    .pipeline { left: 4%; right: 4%; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; top: 21%; height: 48%; }
    .pipeline-node { min-height: 4.6rem; }
    .pipeline-link { display: none; }
    .actions-card { left: 4%; width: 52%; bottom: 3%; }
    .release-card { right: 3%; width: 41%; bottom: 4%; }
    .agent-strip { display: none; }
  }
</style>
