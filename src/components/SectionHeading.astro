---
interface Props {
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  id?: string;
}

const { title, description, href, linkLabel, id } = Astro.props;
---

<div class="section-heading">
  <div>
    <h2 id={id}>{title}</h2>
    {description && <p>{description}</p>}
  </div>
  {href && linkLabel && (
    <a class="arrow-link" href={href}>
      {linkLabel}<span aria-hidden="true">→</span>
    </a>
  )}
</div>
