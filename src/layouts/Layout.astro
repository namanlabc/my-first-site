---
import '../styles/global.css';
import '../styles/minimal.css';
import '../styles/manuscript.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
}

const {
  title = 'Naman Patel',
  description = 'Naman Patel makes useful software for stubborn file limits, invisible SEO mistakes, and other little frictions.',
  type = 'website',
  image,
} = Astro.props;

const pageTitle = title === 'Naman Patel'
  ? 'Naman Patel · Software & stories'
  : `${title} · Naman Patel`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const rssUrl = new URL('rss.xml', Astro.site);
const socialImage = image ? new URL(image, Astro.site) : undefined;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta id="theme-color" name="theme-color" content="#f3eee3" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Naman.blog RSS" href={rssUrl} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Naman Patel" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <script is:inline>
      (() => {
        let savedTheme = null;
        try { savedTheme = localStorage.getItem('theme'); } catch {}
        const isDark = savedTheme ? savedTheme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', isDark);
        document.querySelector('#theme-color')?.setAttribute('content', isDark ? '#1a1916' : '#f3eee3');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-frame">
      <SiteHeader />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>

    <script>
      const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
      function syncTheme() {
        const dark = document.documentElement.classList.contains('dark');
        button?.setAttribute('aria-pressed', String(dark));
        button?.setAttribute('aria-label', 'Switch to ' + (dark ? 'light' : 'dark') + ' theme');
        document.querySelector('#theme-color')?.setAttribute('content', dark ? '#1a1916' : '#f3eee3');
      }
      syncTheme();
      button?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
        syncTheme();
      });
    </script>
  </body>
</html>
