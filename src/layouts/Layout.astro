---
import '../styles/global.css';
import '../styles/inventions.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
}

const {
  title = 'Naman Patel',
  description = 'Naman Patel works on SEO, builds websites and useful tools, and writes about what he learns along the way.',
  type = 'website',
  image,
} = Astro.props;

const pageTitle = title === 'Naman Patel'
  ? 'Naman Patel — SEO, websites and useful tools'
  : `${title} · Naman Patel`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const rssUrl = new URL('rss.xml', Astro.site);
const socialImage = image ? new URL(image, Astro.site) : undefined;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta id="theme-color" name="theme-color" content="#d9d6cf" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Naman.blog RSS" href={rssUrl} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Naman Patel" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <script is:inline>
      (() => {
        let savedTheme = null;
        let savedAccent = null;
        try { savedTheme = localStorage.getItem('theme'); savedAccent = localStorage.getItem('accent'); } catch {}
        const isDark = savedTheme ? savedTheme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        const allowedAccents = ['coral', 'blue', 'green', 'yellow'];
        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.dataset.accent = allowedAccents.includes(savedAccent) ? savedAccent : 'blue';
        document.querySelector('#theme-color')?.setAttribute('content', isDark ? '#24231f' : '#d9d6cf');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-frame">
      <SiteHeader />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>

    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('#theme-toggle');

      function updateThemeControl() {
        const isDark = document.documentElement.classList.contains('dark');
        themeButton?.setAttribute('aria-pressed', String(isDark));
        themeButton?.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} theme`);
        document.querySelector('#theme-color')?.setAttribute('content', isDark ? '#24231f' : '#d9d6cf');
      }

      updateThemeControl();
      themeButton?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch {}
        updateThemeControl();
      });

      document.querySelectorAll<HTMLButtonElement>('[data-accent-choice]').forEach((button) => {
        button.addEventListener('click', () => {
          const accent = button.dataset.accentChoice;
          if (!accent) return;
          document.documentElement.dataset.accent = accent;
          try { localStorage.setItem('accent', accent); } catch {}
          document.querySelectorAll('[data-accent-choice]').forEach((item) => {
            item.setAttribute('aria-pressed', String(item === button));
          });
        });
      });

      const activeAccent = document.documentElement.dataset.accent;
      document.querySelectorAll<HTMLElement>('[data-accent-choice]').forEach((item) => {
        item.setAttribute('aria-pressed', String(item.dataset.accentChoice === activeAccent));
      });
    </script>
  </body>
</html>
