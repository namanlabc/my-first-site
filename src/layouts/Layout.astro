---
import '../styles/global.css';
import '../styles/minimal.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
}

const {
  title = 'Naman Patel',
  description = 'Naman Patel makes useful software for stubborn file limits, invisible SEO mistakes, and other little frictions.',
  type = 'website',
  image,
} = Astro.props;

const pageTitle = title === 'Naman Patel'
  ? 'Naman Patel — software for little frictions'
  : `${title} · Naman Patel`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const rssUrl = new URL('rss.xml', Astro.site);
const socialImage = image ? new URL(image, Astro.site) : undefined;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<style is:global>
  :root {
    --canvas: #ffffff;
    --paper: #ffffff;
    --paper-soft: #f6f6f4;
  }

  :root.dark {
    --canvas: #111110;
    --paper: #111110;
    --paper-soft: #191918;
  }

  .theme-virus {
    --virus-color: #111110;
    --virus-x: 50vw;
    --virus-y: 50vh;
    --virus-scale: 1;
    position: fixed;
    inset: 0;
    z-index: 2147483646;
    overflow: hidden;
    visibility: hidden;
    pointer-events: none;
  }

  .theme-virus.is-active {
    visibility: visible;
  }

  .theme-virus__core,
  .theme-virus__cell {
    position: absolute;
    left: var(--virus-x);
    top: var(--virus-y);
    display: block;
    background: var(--virus-color);
    will-change: transform, opacity, border-radius;
  }

  .theme-virus__core {
    width: 64px;
    height: 64px;
    margin: -32px;
    border-radius: 44% 56% 51% 49% / 58% 42% 58% 42%;
    transform: scale(.01);
  }

  .theme-virus.is-active .theme-virus__core {
    animation: theme-virus-core 780ms cubic-bezier(.62, .02, .22, 1) both;
  }

  .theme-virus__core::before,
  .theme-virus__core::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background: inherit;
  }

  .theme-virus__core::before {
    width: 42%;
    height: 38%;
    left: -18%;
    top: 12%;
  }

  .theme-virus__core::after {
    width: 34%;
    height: 46%;
    right: -14%;
    bottom: 8%;
  }

  .theme-virus__cell {
    width: var(--cell-size, 13px);
    height: var(--cell-size, 13px);
    margin: calc(var(--cell-size, 13px) / -2);
    border-radius: 46% 54% 42% 58% / 55% 44% 56% 45%;
    opacity: 0;
    transform: scale(.1);
  }

  .theme-virus.is-active .theme-virus__cell {
    animation: theme-virus-cell 580ms var(--cell-delay, 0ms) cubic-bezier(.2, .72, .28, 1) both;
  }

  @keyframes theme-virus-core {
    0% {
      opacity: 1;
      border-radius: 44% 56% 51% 49% / 58% 42% 58% 42%;
      transform: scale(.01) rotate(0deg);
    }
    24% {
      border-radius: 61% 39% 43% 57% / 39% 61% 46% 54%;
      transform: scale(.72) rotate(-9deg);
    }
    68%, 82% {
      opacity: 1;
      border-radius: 48% 52% 60% 40% / 55% 45% 51% 49%;
      transform: scale(var(--virus-scale)) rotate(18deg);
    }
    100% {
      opacity: 0;
      transform: scale(var(--virus-scale)) rotate(18deg);
    }
  }

  @keyframes theme-virus-cell {
    0% { opacity: 0; transform: translate(0, 0) scale(.1) rotate(0); }
    14% { opacity: 1; }
    64% { opacity: 1; transform: translate(var(--cell-x), var(--cell-y)) scale(var(--cell-scale, 1.8)) rotate(35deg); }
    100% { opacity: 0; transform: translate(var(--cell-x), var(--cell-y)) scale(var(--cell-scale, 1.8)) rotate(55deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-virus.is-active .theme-virus__core {
      animation: theme-virus-core-reduced 320ms ease-out both;
    }

    .theme-virus__cell:nth-of-type(n + 5) {
      display: none;
    }

    .theme-virus.is-active .theme-virus__cell {
      animation-duration: 230ms;
    }

    @keyframes theme-virus-core-reduced {
      0% { opacity: 1; transform: scale(.01); }
      68%, 82% { opacity: 1; transform: scale(var(--virus-scale)); }
      100% { opacity: 0; transform: scale(var(--virus-scale)); }
    }
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta id="theme-color" name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Naman.blog RSS" href={rssUrl} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Naman Patel" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <script is:inline>
      (() => {
        let savedTheme = null;
        try { savedTheme = localStorage.getItem('theme'); } catch {}
        const isDark = savedTheme ? savedTheme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', isDark);
        document.querySelector('#theme-color')?.setAttribute('content', isDark ? '#111110' : '#ffffff');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div id="theme-virus" class="theme-virus" aria-hidden="true">
      <span class="theme-virus__core"></span>
      <span class="theme-virus__cell" style="--cell-x:-9vw;--cell-y:-4vh;--cell-size:11px;--cell-scale:2.1;--cell-delay:10ms"></span>
      <span class="theme-virus__cell" style="--cell-x:7vw;--cell-y:-6vh;--cell-size:8px;--cell-scale:2.5;--cell-delay:35ms"></span>
      <span class="theme-virus__cell" style="--cell-x:11vw;--cell-y:3vh;--cell-size:14px;--cell-scale:1.7;--cell-delay:20ms"></span>
      <span class="theme-virus__cell" style="--cell-x:5vw;--cell-y:9vh;--cell-size:9px;--cell-scale:2.2;--cell-delay:55ms"></span>
      <span class="theme-virus__cell" style="--cell-x:-7vw;--cell-y:8vh;--cell-size:15px;--cell-scale:1.5;--cell-delay:25ms"></span>
      <span class="theme-virus__cell" style="--cell-x:-12vw;--cell-y:3vh;--cell-size:7px;--cell-scale:2.6;--cell-delay:70ms"></span>
      <span class="theme-virus__cell" style="--cell-x:2vw;--cell-y:-10vh;--cell-size:12px;--cell-scale:1.8;--cell-delay:45ms"></span>
    </div>
    <div class="site-frame">
      <SiteHeader />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>

    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const themeVirus = document.querySelector<HTMLElement>('#theme-virus');
      const root = document.documentElement;
      let themeIsChanging = false;

      function updateThemeControl() {
        const isDark = root.classList.contains('dark');
        themeButton?.setAttribute('aria-pressed', String(isDark));
        themeButton?.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} theme`);
        document.querySelector('#theme-color')?.setAttribute('content', isDark ? '#111110' : '#ffffff');
      }

      function applyNextTheme() {
        const isDark = root.classList.toggle('dark');
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch {}
        updateThemeControl();
      }

      updateThemeControl();

      themeButton?.addEventListener('click', () => {
        if (themeIsChanging) return;

        const target: 'dark' | 'light' = root.classList.contains('dark') ? 'light' : 'dark';
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!themeVirus) {
          applyNextTheme();
          return;
        }

        const rect = themeButton.getBoundingClientRect();
        const x = rect.left + rect.width / 2;
        const y = rect.top + rect.height / 2;
        const farthestX = Math.max(x, window.innerWidth - x);
        const farthestY = Math.max(y, window.innerHeight - y);
        const coverRadius = Math.hypot(farthestX, farthestY);

        themeIsChanging = true;
        root.dataset.themeTarget = target;
        themeVirus.style.setProperty('--virus-color', target === 'dark' ? '#111110' : '#ffffff');
        themeVirus.style.setProperty('--virus-x', `${x}px`);
        themeVirus.style.setProperty('--virus-y', `${y}px`);
        themeVirus.style.setProperty('--virus-scale', String((coverRadius * 2.35) / 64));
        themeVirus.classList.remove('is-active');
        void themeVirus.offsetWidth;
        themeVirus.classList.add('is-active');

        window.setTimeout(applyNextTheme, reduceMotion ? 145 : 500);
        window.setTimeout(() => {
          themeVirus.classList.remove('is-active');
          delete root.dataset.themeTarget;
          themeIsChanging = false;
        }, reduceMotion ? 350 : 820);
      });
    </script>
  </body>
</html>
