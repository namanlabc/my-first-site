---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
}

const {
  title = 'Naman Patel',
  description = 'Naman Patel makes useful software for stubborn file limits, invisible SEO mistakes, and other little frictions.',
  type = 'website',
  image,
} = Astro.props;

const pageTitle = title === 'Naman Patel'
  ? 'Naman Patel — software for little frictions'
  : `${title} · Naman Patel`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const rssUrl = new URL('rss.xml', Astro.site);
const socialImage = image ? new URL(image, Astro.site) : undefined;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<style is:global>
  :root {
    --canvas: #fff;
    --paper: #fff;
    --paper-soft: #fff;
    --theme-blink-cover: #090a09;
    --theme-blink-line: rgb(155 200 176 / .34);
    --theme-blink-open-brightness: .94;
  }

  /* The page itself blinks with the mascot. The theme changes while shut. */
  ::view-transition {
    background: var(--theme-blink-cover);
  }

  ::view-transition-group(root) {
    animation-duration: 780ms;
    animation-timing-function: linear;
  }

  ::view-transition-image-pair(root) {
    isolation: isolate;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    mix-blend-mode: normal;
    backface-visibility: hidden;
    transform-origin: 50% 50%;
  }

  ::view-transition-old(root) {
    z-index: 2;
    animation: naman-theme-blink-close 780ms cubic-bezier(.62, .02, .36, 1) both;
  }

  ::view-transition-new(root) {
    z-index: 3;
    animation: naman-theme-blink-open 780ms cubic-bezier(.22, .78, .24, 1) both;
  }

  :root[data-theme-target='dark']::view-transition-new(root) {
    --theme-blink-open-brightness: .88;
  }

  :root[data-theme-target='light']::view-transition-new(root) {
    --theme-blink-open-brightness: 1.12;
  }

  @keyframes naman-theme-blink-close {
    0% {
      clip-path: ellipse(112% 112% at 50% 50%);
      transform: scale(1);
      filter: brightness(1) saturate(1);
      opacity: 1;
    }
    29% {
      clip-path: ellipse(112% 44% at 50% 50%);
      transform: scaleX(1.002) scaleY(.998);
      filter: brightness(.985) saturate(.98);
      opacity: 1;
    }
    43% {
      clip-path: ellipse(114% 3.8% at 50% 50%);
      transform: scaleX(1.008) scaleY(.995);
      filter: brightness(.92) saturate(.9) drop-shadow(0 0 5px var(--theme-blink-line));
      opacity: 1;
    }
    49% {
      clip-path: ellipse(116% .34% at 50% 50%);
      transform: scaleX(1.012) scaleY(.994);
      filter: brightness(.84) saturate(.82) drop-shadow(0 0 9px var(--theme-blink-line));
      opacity: 1;
    }
    50%, 100% {
      clip-path: ellipse(116% .18% at 50% 50%);
      transform: scaleX(1.012) scaleY(.994);
      filter: brightness(.8) saturate(.8);
      opacity: 0;
    }
  }

  @keyframes naman-theme-blink-open {
    0%, 48% {
      clip-path: ellipse(116% .18% at 50% 50%);
      transform: scaleX(1.012) scaleY(.994);
      filter: brightness(var(--theme-blink-open-brightness)) saturate(.88);
      opacity: 0;
    }
    50% {
      clip-path: ellipse(116% .34% at 50% 50%);
      transform: scaleX(1.012) scaleY(.994);
      filter: brightness(var(--theme-blink-open-brightness)) saturate(.9) drop-shadow(0 0 10px var(--theme-blink-line));
      opacity: 1;
    }
    57% {
      clip-path: ellipse(114% 5.5% at 50% 50%);
      transform: scaleX(1.007) scaleY(.996);
      filter: brightness(calc((var(--theme-blink-open-brightness) + 1) / 2)) saturate(.94) drop-shadow(0 0 5px var(--theme-blink-line));
      opacity: 1;
    }
    73% {
      clip-path: ellipse(112% 52% at 50% 50%);
      transform: scaleX(1.002) scaleY(.999);
      filter: brightness(1.015) saturate(1.01);
      opacity: 1;
    }
    100% {
      clip-path: ellipse(112% 112% at 50% 50%);
      transform: scale(1);
      filter: none;
      opacity: 1;
    }
  }

  /* Keep the mascot's eyes shut for the same physical beat as the page. */
  .site-brand.is-theme-blinking .mascot-eyes {
    animation: none !important;
    transform: translate(0) !important;
  }

  .site-brand.is-theme-blinking .mascot-eye {
    transform: scaleY(.07) !important;
    transition: transform 105ms cubic-bezier(.55, 0, .45, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none !important;
    }
    .site-brand.is-theme-blinking .mascot-eye {
      transition: none !important;
    }
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta id="theme-color" name="theme-color" content="#fff" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Naman.blog RSS" href={rssUrl} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Naman Patel" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <script is:inline>
      (() => {
        let savedTheme = null;
        try { savedTheme = localStorage.getItem('theme'); } catch {}
        const isDark = savedTheme ? savedTheme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', isDark);
        document.querySelector('#theme-color')?.setAttribute('content', isDark ? '#090a09' : '#fff');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-frame">
      <SiteHeader />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>

    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const root = document.documentElement;

      function updateThemeControl() {
        const isDark = root.classList.contains('dark');
        themeButton?.setAttribute('aria-pressed', String(isDark));
        themeButton?.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} theme`);
        document.querySelector('#theme-color')?.setAttribute('content', isDark ? '#090a09' : '#fff');
      }

      function applyNextTheme() {
        const isDark = root.classList.toggle('dark');
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch {}
        updateThemeControl();
      }

      function announceThemeTransition(name: 'start' | 'complete', target: 'dark' | 'light') {
        document.dispatchEvent(new CustomEvent(`theme-transition-${name}`, { detail: { theme: target } }));
      }

      updateThemeControl();

      themeButton?.addEventListener('click', () => {
        const target: 'dark' | 'light' = root.classList.contains('dark') ? 'light' : 'dark';
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const startViewTransition = (document as any).startViewTransition;

        if (reduceMotion || typeof startViewTransition !== 'function') {
          applyNextTheme();
          announceThemeTransition('complete', target);
          return;
        }

        root.dataset.themeTarget = target;
        root.style.setProperty('--theme-blink-cover', target === 'dark' ? '#090a09' : '#fff');
        root.style.setProperty('--theme-blink-line', target === 'dark' ? 'rgb(155 200 176 / .34)' : 'rgb(214 183 92 / .32)');

        announceThemeTransition('start', target);
        const transition = startViewTransition.call(document, applyNextTheme);

        Promise.resolve(transition.finished).finally(() => {
          announceThemeTransition('complete', target);
          delete root.dataset.themeTarget;
        });
      });
    </script>
  </body>
</html>