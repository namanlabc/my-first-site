---
import '../styles/global.css';
import '../styles/minimal.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
}

const {
  title = 'Naman Patel',
  description = 'Naman Patel makes useful software for stubborn file limits, invisible SEO mistakes, and other little frictions.',
  type = 'website',
  image,
} = Astro.props;

const pageTitle = title === 'Naman Patel'
  ? 'Naman Patel — software for little frictions'
  : `${title} · Naman Patel`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const rssUrl = new URL('rss.xml', Astro.site);
const socialImage = image ? new URL(image, Astro.site) : undefined;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<style is:global>
  :root {
    --canvas: #ffffff;
    --paper: #ffffff;
    --paper-soft: #f6f6f4;
  }

  :root.dark {
    --canvas: #111110;
    --paper: #111110;
    --paper-soft: #191918;
  }

  .theme-infection {
    position: fixed;
    inset: 0;
    z-index: 2147483646;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    will-change: opacity;
  }

  .theme-infection.is-active {
    opacity: 1;
    visibility: visible;
  }

  html[data-theme-target] .theme-toggle {
    color: var(--ink);
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta id="theme-color" name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Naman.blog RSS" href={rssUrl} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Naman Patel" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <script is:inline>
      (() => {
        let savedTheme = null;
        try { savedTheme = localStorage.getItem('theme'); } catch {}
        const isDark = savedTheme ? savedTheme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', isDark);
        document.querySelector('#theme-color')?.setAttribute('content', isDark ? '#111110' : '#ffffff');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <canvas id="theme-infection" class="theme-infection" aria-hidden="true"></canvas>
    <div class="site-frame">
      <SiteHeader />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>

    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const themeInfection = document.querySelector<HTMLCanvasElement>('#theme-infection');
      const root = document.documentElement;
      let themeIsChanging = false;
      let infectionFrame = 0;

      function updateThemeControl() {
        const isDark = root.classList.contains('dark');
        themeButton?.setAttribute('aria-pressed', String(isDark));
        themeButton?.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} theme`);
        document.querySelector('#theme-color')?.setAttribute('content', isDark ? '#111110' : '#ffffff');
      }

      function applyNextTheme() {
        const isDark = root.classList.toggle('dark');
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch {}
        updateThemeControl();
      }

      updateThemeControl();
      try {
        if (sessionStorage.getItem('theme-spread-seen') === '1') {
          themeButton?.classList.add('has-spread');
        }
      } catch {}

      type Point = { x: number; y: number };
      type Vein = { points: Point[]; width: number; delay: number };

      const clamp = (value: number, min = 0, max = 1) => Math.min(max, Math.max(min, value));
      const easeInOut = (value: number) => {
        const t = clamp(value);
        return t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      };
      const easeOut = (value: number) => 1 - Math.pow(1 - clamp(value), 3);

      function seededRandom(seed: number) {
        let value = seed >>> 0;
        return () => {
          value = (value * 1664525 + 1013904223) >>> 0;
          return value / 4294967296;
        };
      }

      function makeVeins(x: number, y: number, radius: number, sparse = false): Vein[] {
        const random = seededRandom(Math.round(x * 31 + y * 17));
        const count = sparse ? 6 : 13;
        const veins: Vein[] = [];

        for (let index = 0; index < count; index++) {
          const angle = (Math.PI * 2 * index) / count + (random() - .5) * .62;
          const length = radius * (.24 + random() * .52);
          const steps = sparse ? 4 : 6;
          const points: Point[] = [{ x, y }];
          let px = x;
          let py = y;

          for (let step = 1; step <= steps; step++) {
            const distance = length * (step / steps);
            const kink = (random() - .5) * radius * .055;
            const taper = 1 - step / (steps + 1);
            px = x + Math.cos(angle) * distance + Math.cos(angle + Math.PI / 2) * kink * taper;
            py = y + Math.sin(angle) * distance + Math.sin(angle + Math.PI / 2) * kink * taper;
            points.push({ x: px, y: py });
          }

          veins.push({ points, width: .55 + random() * .9, delay: random() * .2 });

          if (!sparse && index % 2 === 0) {
            const splitAt = 2 + Math.floor(random() * 2);
            const origin = points[splitAt];
            const branchAngle = angle + (random() > .5 ? 1 : -1) * (.22 + random() * .42);
            const branchLength = length * (.18 + random() * .2);
            veins.push({
              points: [
                origin,
                {
                  x: origin.x + Math.cos(branchAngle) * branchLength * .48,
                  y: origin.y + Math.sin(branchAngle) * branchLength * .48,
                },
                {
                  x: origin.x + Math.cos(branchAngle) * branchLength,
                  y: origin.y + Math.sin(branchAngle) * branchLength,
                },
              ],
              width: .4 + random() * .38,
              delay: .12 + random() * .22,
            });
          }
        }

        return veins;
      }

      function drawVein(ctx: CanvasRenderingContext2D, vein: Vein, progress: number) {
        const amount = clamp((progress - vein.delay) / (1 - vein.delay));
        if (amount <= 0) return;

        const segmentProgress = amount * (vein.points.length - 1);
        const finalSegment = Math.min(vein.points.length - 2, Math.floor(segmentProgress));
        ctx.beginPath();
        ctx.moveTo(vein.points[0].x, vein.points[0].y);

        for (let index = 1; index <= finalSegment + 1; index++) {
          const point = vein.points[index];
          if (index === finalSegment + 1) {
            const previous = vein.points[index - 1];
            const partial = segmentProgress - finalSegment;
            ctx.lineTo(
              previous.x + (point.x - previous.x) * partial,
              previous.y + (point.y - previous.y) * partial,
            );
          } else {
            ctx.lineTo(point.x, point.y);
          }
        }

        ctx.lineWidth = vein.width;
        ctx.stroke();
      }

      function drawMembrane(
        ctx: CanvasRenderingContext2D,
        x: number,
        y: number,
        radius: number,
        progress: number,
        time: number,
      ) {
        if (progress <= 0) return;
        const growth = easeInOut(progress);
        const baseRadius = radius * (.008 + growth * 1.13);
        const points = 196;
        const edgeLife = 1 - growth * .68;
        ctx.beginPath();

        for (let index = 0; index <= points; index++) {
          const angle = (index / points) * Math.PI * 2;
          const noise =
            Math.sin(angle * 3 + .8) * .035 +
            Math.sin(angle * 7 - 1.9) * .022 +
            Math.sin(angle * 13 + time * .004) * .012 +
            Math.sin(angle * 23 - time * .006) * .006;
          const capillary = Math.max(0, Math.sin(angle * 11 + 2.2)) ** 18 * .07 * edgeLife;
          const currentRadius = baseRadius * (1 + noise * edgeLife + capillary);
          const px = x + Math.cos(angle) * currentRadius;
          const py = y + Math.sin(angle) * currentRadius;
          if (index === 0) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
        }

        ctx.closePath();
        ctx.fill();
      }

      themeButton?.addEventListener('click', () => {
        if (themeIsChanging) return;

        const target: 'dark' | 'light' = root.classList.contains('dark') ? 'light' : 'dark';
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!themeInfection) {
          applyNextTheme();
          return;
        }

        const rect = themeButton.getBoundingClientRect();
        const x = rect.left + rect.width / 2;
        const y = rect.top + rect.height / 2;
        const farthestX = Math.max(x, window.innerWidth - x);
        const farthestY = Math.max(y, window.innerHeight - y);
        const coverRadius = Math.hypot(farthestX, farthestY) * 1.04;
        const context = themeInfection.getContext('2d');

        if (!context) {
          applyNextTheme();
          return;
        }

        themeIsChanging = true;
        root.dataset.themeTarget = target;
        themeButton.classList.add('has-spread');
        themeButton.classList.add('is-infecting');
        try { sessionStorage.setItem('theme-spread-seen', '1'); } catch {}
        themeInfection.classList.add('is-active');

        const ratio = Math.min(window.devicePixelRatio || 1, 2);
        themeInfection.width = Math.round(window.innerWidth * ratio);
        themeInfection.height = Math.round(window.innerHeight * ratio);
        context.setTransform(ratio, 0, 0, ratio, 0, 0);

        const color = target === 'dark' ? '#111110' : '#ffffff';
        const duration = reduceMotion ? 760 : 1720;
        const themeAt = reduceMotion ? .7 : .74;
        const veins = makeVeins(x, y, coverRadius, reduceMotion);
        const startedAt = performance.now();
        let themeApplied = false;

        const animate = (now: number) => {
          const progress = clamp((now - startedAt) / duration);
          context.clearRect(0, 0, window.innerWidth, window.innerHeight);
          context.fillStyle = color;
          context.strokeStyle = color;
          context.lineCap = 'round';
          context.lineJoin = 'round';

          const veinProgress = easeOut(clamp(progress / (reduceMotion ? .42 : .48)));
          veins.forEach(vein => drawVein(context, vein, veinProgress));

          const membraneProgress = clamp((progress - (reduceMotion ? .1 : .16)) / (themeAt - (reduceMotion ? .1 : .16)));
          drawMembrane(context, x, y, coverRadius, membraneProgress, now - startedAt);

          if (!themeApplied && progress >= themeAt) {
            applyNextTheme();
            themeApplied = true;
          }

          if (progress >= .88) {
            themeInfection.style.opacity = String(1 - easeOut((progress - .88) / .12));
          }

          if (progress < 1) {
            infectionFrame = requestAnimationFrame(animate);
            return;
          }

          if (!themeApplied) applyNextTheme();
          context.clearRect(0, 0, window.innerWidth, window.innerHeight);
          themeInfection.classList.remove('is-active');
          themeInfection.style.removeProperty('opacity');
          themeButton.classList.remove('is-infecting');
          delete root.dataset.themeTarget;
          themeIsChanging = false;
        };

        cancelAnimationFrame(infectionFrame);
        infectionFrame = requestAnimationFrame(animate);
      });
    </script>
  </body>
</html>
