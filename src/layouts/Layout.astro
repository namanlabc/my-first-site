---
import '../styles/global.css';
import '../styles/field.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
}

const {
  title = 'Naman Patel',
  description = 'Naman Patel makes useful software for stubborn file limits, invisible SEO mistakes, and other little frictions.',
  type = 'website',
  image,
} = Astro.props;

const pageTitle = title === 'Naman Patel'
  ? 'Naman Patel — software for little frictions'
  : `${title} · Naman Patel`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const rssUrl = new URL('rss.xml', Astro.site);
const socialImage = image ? new URL(image, Astro.site) : undefined;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<style is:global>
  :root {
    --canvas: #f7f6ef;
    --paper: #f7f6ef;
    --paper-soft: #efeee6;
    --theme-blink-cover: #0d0d0c;
    --theme-blink-line: rgb(225 38 28 / .34);
    --theme-blink-open-brightness: .96;
  }

  :root.dark {
    --canvas: #0d0d0c;
    --paper: #0d0d0c;
    --paper-soft: #171715;
  }

  ::view-transition {
    background: var(--theme-blink-cover);
  }

  ::view-transition-group(root) {
    animation-duration: 620ms;
    animation-timing-function: linear;
  }

  ::view-transition-image-pair(root) {
    isolation: isolate;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    mix-blend-mode: normal;
    backface-visibility: hidden;
    transform-origin: 50% 50%;
  }

  ::view-transition-old(root) {
    z-index: 2;
    animation: naman-theme-blink-close 620ms cubic-bezier(.62, .02, .36, 1) both;
  }

  ::view-transition-new(root) {
    z-index: 3;
    animation: naman-theme-blink-open 620ms cubic-bezier(.22, .78, .24, 1) both;
  }

  :root[data-theme-target='dark']::view-transition-new(root) {
    --theme-blink-open-brightness: .9;
  }

  :root[data-theme-target='light']::view-transition-new(root) {
    --theme-blink-open-brightness: 1.06;
  }

  @keyframes naman-theme-blink-close {
    0% { clip-path: ellipse(112% 112% at 50% 50%); opacity: 1; }
    46% { clip-path: ellipse(114% 2.8% at 50% 50%); opacity: 1; }
    50%, 100% { clip-path: ellipse(116% .18% at 50% 50%); opacity: 0; }
  }

  @keyframes naman-theme-blink-open {
    0%, 48% { clip-path: ellipse(116% .18% at 50% 50%); opacity: 0; }
    52% { clip-path: ellipse(114% 3.8% at 50% 50%); opacity: 1; }
    100% { clip-path: ellipse(112% 112% at 50% 50%); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) { animation: none !important; }
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta id="theme-color" name="theme-color" content="#f7f6ef" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Naman.blog RSS" href={rssUrl} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Naman Patel" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <script is:inline>
      (() => {
        let savedTheme = null;
        try { savedTheme = localStorage.getItem('theme'); } catch {}
        const isDark = savedTheme ? savedTheme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', isDark);
        document.querySelector('#theme-color')?.setAttribute('content', isDark ? '#0d0d0c' : '#f7f6ef');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-frame">
      <SiteHeader />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>

    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const root = document.documentElement;

      function updateThemeControl() {
        const isDark = root.classList.contains('dark');
        themeButton?.setAttribute('aria-pressed', String(isDark));
        themeButton?.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} theme`);
        document.querySelector('#theme-color')?.setAttribute('content', isDark ? '#0d0d0c' : '#f7f6ef');
      }

      function applyNextTheme() {
        const isDark = root.classList.toggle('dark');
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch {}
        updateThemeControl();
      }

      updateThemeControl();

      themeButton?.addEventListener('click', () => {
        const target: 'dark' | 'light' = root.classList.contains('dark') ? 'light' : 'dark';
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const startViewTransition = (document as any).startViewTransition;

        if (reduceMotion || typeof startViewTransition !== 'function') {
          applyNextTheme();
          return;
        }

        root.dataset.themeTarget = target;
        root.style.setProperty('--theme-blink-cover', target === 'dark' ? '#0d0d0c' : '#f7f6ef');
        const transition = startViewTransition.call(document, applyNextTheme);

        Promise.resolve(transition.finished).finally(() => {
          delete root.dataset.themeTarget;
        });
      });
    </script>
  </body>
</html>