---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags = [], image, imageAlt } = post.data;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const featuredImage = image ? `${base}${image.replace(/^\//, '')}` : undefined;

const wordCount = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = sortedPosts.findIndex((entry) => entry.id === post.id);
const olderPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const newerPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={title} description={description} type="article" image={image}>
  <div class="shell shell--reading article-shell">
    <a class="back-link" href={`${base}archive/`}><span aria-hidden="true">←</span> All writing</a>
    <article>
      <header class="article-header">
        <h1>{title}</h1>
        <p>{description}</p>
        <div class="article-meta">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime} min read</span>
        </div>
        {tags.length > 0 && (
          <ul class="tag-list" aria-label="Tags">
            {tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )}
      </header>

      {featuredImage && (
        <figure class="article-featured">
          <img
            src={featuredImage}
            alt={imageAlt ?? ''}
            width="1536"
            height="1024"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}

      <div class="prose">
        <slot />
      </div>
    </article>

    <nav class="post-nav" aria-label="More writing">
      {olderPost ? (
        <a href={`${base}blog/${olderPost.id}/`}>
          <span>Older note</span>
          <strong>{olderPost.data.title}</strong>
        </a>
      ) : <span></span>}
      {newerPost ? (
        <a class="post-nav__newer" href={`${base}blog/${newerPost.id}/`}>
          <span>Newer note</span>
          <strong>{newerPost.data.title}</strong>
        </a>
      ) : <span></span>}
    </nav>
  </div>
</Layout>
