---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import PreferredSource from '../components/PreferredSource.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, image, imageAlt } = post.data;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const featuredImage = image ? `${base}${image.replace(/^\//, '')}` : undefined;
const isAiEssay = post.id === 'ai-is-not-magic-it-is-leverage';

const wordCount = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = sortedPosts.findIndex((entry) => entry.id === post.id);
const olderPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const newerPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={title} description={description} type="article" image={image}>
  <div class:list={["quiet-article-page", { "ai-essay": isAiEssay }]}>
    <div class="article-shell">
      <a class="back-link" href={`${base}archive/`}><span aria-hidden="true">←</span> All writing</a>

      <article>
        <header class="article-header">
          <h1>{title}</h1>
          <p>{description}</p>
          <div class="article-meta">
            <a class="article-author" href={`${base}about/`}>By Naman Patel</a>
            <span aria-hidden="true">·</span>
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            <span aria-hidden="true">·</span>
            <span>{readingTime} min read</span>
          </div>
        </header>

        {featuredImage && (
          <figure class="article-featured">
            <img
              src={featuredImage}
              alt={imageAlt ?? ''}
              width="1536"
              height="1024"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        )}

        <div class="prose">
          <slot />
        </div>

        <PreferredSource variant="article" />
      </article>

      <nav class="post-nav" aria-label="More writing">
        {olderPost ? (
          <a href={`${base}blog/${olderPost.id}/`}>
            <span>Older note</span>
            <strong>{olderPost.data.title}</strong>
          </a>
        ) : <span></span>}
        {newerPost ? (
          <a class="post-nav__newer" href={`${base}blog/${newerPost.id}/`}>
            <span>Newer note</span>
            <strong>{newerPost.data.title}</strong>
          </a>
        ) : <span></span>}
      </nav>
    </div>
  </div>
</Layout>

<style>
  :global(.quiet-article-page .post-nav) {
    margin-top: 32px;
    padding-top: 0;
    border-top: 0;
  }

  :global(.ai-essay) { width: min(640px, calc(100% - 40px)); }
  :global(.ai-essay .article-shell),
  :global(.ai-essay .back-link),
  :global(.ai-essay .article-header),
  :global(.ai-essay .prose),
  :global(.ai-essay .post-nav) {
    width: 100%;
    max-width: none;
    margin-inline: auto;
  }
  :global(.ai-essay .article-header) { margin: 37px 0 30px; }
  :global(.ai-essay .article-header h1) {
    max-width: 610px;
    margin-bottom: 15px;
    font-size: clamp(32px, 4.6vw, 43px);
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -.045em;
  }
  :global(.ai-essay .article-header > p) {
    max-width: 590px;
    margin-bottom: 16px;
    font-size: 16px;
    line-height: 1.62;
  }
  :global(.ai-essay .article-featured) {
    width: 100%;
    margin: 6px 0 42px;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--paper-soft);
  }
  :global(.ai-essay .article-featured img) {
    width: 100%;
    border-radius: 0;
    box-shadow: none;
  }
  :global(.ai-essay .prose) {
    max-width: 620px;
    font-size: 17px;
    line-height: 1.78;
  }
  :global(.ai-essay .prose h2) {
    margin-top: 54px;
    font-size: 24px;
    line-height: 1.22;
    letter-spacing: -.03em;
  }
  :global(.ai-essay .prose strong) { font-weight: 670; }
  :global(.ai-essay .prose .ai-breakout) { width: 100%; margin-left: 0; transform: none; }

  :global(.ai-thesis),
  :global(.ai-formula-stack),
  :global(.ai-final-equation) {
    margin: 38px 0 42px;
    padding: 26px 0;
    border: 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    color: var(--ink);
    background: transparent;
  }
  :global(.ai-thesis .ai-eyebrow),
  :global(.ai-formula-stack .ai-eyebrow) {
    display: block;
    margin-bottom: 12px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 650;
    letter-spacing: .12em;
  }
  :global(.ai-thesis strong) {
    display: block;
    font-family: var(--mono);
    font-size: clamp(17px, 2.7vw, 23px);
    line-height: 1.45;
    letter-spacing: -.025em;
  }
  :global(.ai-thesis small) {
    display: block;
    max-width: 560px;
    margin-top: 11px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }
  :global(.ai-thesis--inverse),
  :global(.ai-thesis--inverse strong),
  :global(.ai-thesis--inverse small),
  :global(.ai-thesis--inverse .ai-eyebrow) {
    color: inherit;
    background: transparent;
  }
  :global(.ai-thesis--inverse small),
  :global(.ai-thesis--inverse .ai-eyebrow) { color: var(--muted); }

  :global(.ai-equation) {
    display: block;
    margin: 36px 0 42px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  :global(.ai-equation > div) {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 18px;
    align-items: baseline;
    padding: 14px 0;
    background: transparent;
  }
  :global(.ai-equation > div + div) { border-top: 1px solid var(--rule); }
  :global(.ai-equation span) {
    margin: 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: .1em;
  }
  :global(.ai-equation strong) {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 540;
    line-height: 1.65;
  }

  :global(.ai-matrix) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 38px 0 42px;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: transparent;
  }
  :global(.ai-matrix > div) {
    min-height: 108px;
    padding: 18px 19px;
    background: transparent;
  }
  :global(.ai-matrix > div:nth-of-type(even)) { border-left: 1px solid var(--rule); }
  :global(.ai-matrix > div:nth-of-type(n+3)) { border-top: 1px solid var(--rule); }
  :global(.ai-matrix .ai-matrix__corner) { display: none; }
  :global(.ai-matrix span) {
    display: block;
    margin-bottom: 17px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: .07em;
  }
  :global(.ai-matrix strong) {
    display: block;
    font-size: 17px;
    letter-spacing: -.02em;
  }
  :global(.ai-matrix .is-hot) {
    color: var(--ink);
    background: color-mix(in srgb, var(--accent) 8%, var(--paper));
  }
  :global(.ai-matrix .is-hot span) { color: var(--accent); }
  :global(.ai-matrix .is-hot strong) { color: var(--ink); }

  :global(.ai-formula-stack p) {
    margin: 0;
    color: var(--ink);
    font-family: var(--mono);
    font-size: clamp(15px, 2.5vw, 20px);
    line-height: 1.55;
  }
  :global(.ai-formula-stack p.muted) {
    margin-top: 12px;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.62;
  }
  :global(.ai-final-equation) { text-align: left; }
  :global(.ai-final-equation span) {
    display: block;
    margin-bottom: 10px;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .08em;
  }
  :global(.ai-final-equation strong) {
    display: block;
    color: var(--ink);
    font-size: clamp(25px, 4.5vw, 35px);
    line-height: 1.12;
    letter-spacing: -.04em;
  }

  @media (max-width: 640px) {
    :global(.quiet-article-page .post-nav) { margin-top: 27px; }
    :global(.ai-essay) { width: calc(100% - 40px); }
    :global(.ai-essay .article-header) { margin-top: 30px; }
    :global(.ai-essay .article-header h1) { font-size: 31px; line-height: 1.1; }
    :global(.ai-essay .article-header > p) { font-size: 15px; }
    :global(.ai-essay .article-featured) { margin-bottom: 35px; border-radius: 8px; }
    :global(.ai-essay .prose) { font-size: 16.5px; }
    :global(.ai-essay .prose h2) { margin-top: 46px; font-size: 22px; }
    :global(.ai-thesis),
    :global(.ai-formula-stack),
    :global(.ai-final-equation) { margin-block: 32px 36px; padding-block: 21px; }
    :global(.ai-equation) { margin-block: 31px 36px; }
    :global(.ai-equation > div) { grid-template-columns: 62px minmax(0, 1fr); gap: 12px; padding: 12px 0; }
    :global(.ai-equation strong) { font-size: 12px; }
    :global(.ai-matrix) { margin-block: 31px 36px; }
    :global(.ai-matrix > div) { min-height: 96px; padding: 15px; }
    :global(.ai-matrix strong) { font-size: 15px; }
  }
</style>
